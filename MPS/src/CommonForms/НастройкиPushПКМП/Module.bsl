// Открывает клиентский диалог выбора JSON/.p8 для заполнения нового секрета.
//
// Параметры:
//  Команда - КомандаФормы - Команда, вызвавшая обработчик; прикладные данные не содержит.
//
// Выбор асинхронный; сам по себе не сохраняет секрет в базе и не вызывает провайдера.
//
&НаКлиенте
Процедура ЗагрузитьСекрет(Команда)
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Фильтр = "Настройки push (*.json;*.p8)|*.json;*.p8";
    Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораСекрета", ЭтотОбъект));
КонецПроцедуры
// Читает выбранный локальный файл UTF-8 в поле нового секрета формы.
//
// Параметры:
//  Файлы - Массив из Строка, Неопределено - Выбранные имена файлов; Неопределено при отмене диалога.
//  ДополнительныеПараметры - Произвольный - Служебные данные обратного вызова; не используются.
//
// Отмена ничего не меняет. Секрет сохраняется только отдельной командой Сохранить.
//
&НаКлиенте
Процедура ПослеВыбораСекрета(Файлы, ДополнительныеПараметры) Экспорт
    Если Файлы = Неопределено Тогда Возврат; КонецЕсли;
    ДокументСекрета = Новый ТекстовыйДокумент;
    ДокументСекрета.Прочитать(Файлы[0], КодировкаТекста.UTF8);
    Токен = ДокументСекрета.ПолучитьТекст();
КонецПроцедуры
