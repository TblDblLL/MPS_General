// Настраивает условное оформление тревожных строк и заполняет таблицу заданиями ПКМП.
//
// Параметры:
//  Отказ - Булево - выходной признак отказа открытия формы; обработчик его не изменяет.
//  СтандартнаяОбработка - Булево - параметр стандартной обработки события платформы.
//
// Особенности:
//  Красным цветом выделяются строки с признаком Тревога. Требует права администрирования.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Элемент = УсловноеОформление.Элементы.Добавить();
    Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
    Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Задания.Тревога");
    Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    Отбор.ПравоеЗначение = Истина;
    Отбор.Использование = Истина;
    Поле = Элемент.Поля.Элементы.Добавить();
    Поле.Поле = Новый ПолеКомпоновкиДанных("Задания");
    Поле.Использование = Истина;
    Элемент.Использование = Истина;
    МониторЗаданийПКМП.ЗаполнитьФорму(ЭтотОбъект);
КонецПроцедуры

// Обрабатывает команду обновления списка заданий.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик.
//
// Особенности:
//  Перечитывает состояние заданий на сервере; несохранённые изменения в таблице теряются.
&НаКлиенте
Процедура Обновить(Команда)
    ОбновитьНаСервере();
КонецПроцедуры

// Перечитывает состояние заданий ПКМП и заполняет таблицу формы.
//
// Параметры: отсутствуют.
&НаСервере
Процедура ОбновитьНаСервере()
    МониторЗаданийПКМП.ЗаполнитьФорму(ЭтотОбъект);
КонецПроцедуры

// Сохраняет включение, порог и допуск текущей строки таблицы заданий.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик.
//
// Особенности:
//  При отсутствии текущей строки ничего не делает. Расписание этой командой не изменяется.
&НаКлиенте
Процедура Сохранить(Команда)
    Данные = Элементы.Задания.ТекущиеДанные;
    Если Данные <> Неопределено Тогда
        СохранитьНаСервере(Данные.Задание, Данные.Включено, Данные.Порог, Данные.Допуск);
    КонецЕсли;
КонецПроцедуры

// Открывает диалог настройки расписания для текущей строки таблицы заданий.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик.
//
// Особенности:
//  При отсутствии текущей строки диалог не открывается. Сохранение выполняется после выбора расписания.
&НаКлиенте
Процедура НастроитьРасписание(Команда)
    Данные = Элементы.Задания.ТекущиеДанные;
    Если Данные <> Неопределено Тогда
        Настройки = Новый Структура("Задание,Включено,Порог,Допуск",
            Данные.Задание, Данные.Включено, Данные.Порог, Данные.Допуск);
        Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ПрочитатьРасписаниеНаСервере(Данные.Задание));
        Диалог.Показать(Новый ОписаниеОповещения("РасписаниеВыбрано", ЭтотОбъект, Настройки));
    КонецЕсли;
КонецПроцедуры

// Сохраняет задание с расписанием, выбранным в диалоге.
//
// Параметры:
//  Расписание - РасписаниеРегламентногоЗадания, Неопределено - выбранное расписание; Неопределено при отмене диалога.
//  Настройки - Структура - Задание, Включено, Порог и Допуск строки, для которой открывался диалог.
//
// Особенности:
//  При отмене диалога ничего не изменяет.
&НаКлиенте
Процедура РасписаниеВыбрано(Расписание, Настройки) Экспорт
    Если Расписание <> Неопределено Тогда
        СохранитьНаСервере(Настройки.Задание, Настройки.Включено, Настройки.Порог, Настройки.Допуск, Расписание);
    КонецЕсли;
КонецПроцедуры

// Возвращает расписание задания для диалога настройки.
//
// Параметры:
//  ВидЗадания - ПеречислениеСсылка.ВидыРегламентныхЗаданийПКМП - вид задания.
//
// Возвращаемое значение:
//  РасписаниеРегламентногоЗадания - действующее расписание либо расписание по умолчанию для ещё не созданного задания.
&НаСервереБезКонтекста
Функция ПрочитатьРасписаниеНаСервере(ВидЗадания)
    Возврат МониторЗаданийПКМП.ПрочитатьРасписание(ВидЗадания);
КонецФункции

// Сохраняет настройки задания и обновляет таблицу формы.
//
// Параметры:
//  ВидЗадания - ПеречислениеСсылка.ВидыРегламентныхЗаданийПКМП - вид задания.
//  Включено - Булево - использовать ли задание.
//  Порог - Число - число пропущенных плановых окон подряд для тревоги.
//  Допуск - Число - допустимое отклонение начала запуска в секундах.
//  Расписание - РасписаниеРегламентногоЗадания, Неопределено - новое расписание; Неопределено оставляет действующее.
&НаСервере
Процедура СохранитьНаСервере(ВидЗадания, Включено, Порог, Допуск, Расписание = Неопределено)
    МониторЗаданийПКМП.Сохранить(ВидЗадания, Включено, Порог, Допуск, Расписание);
    МониторЗаданийПКМП.ЗаполнитьФорму(ЭтотОбъект);
КонецПроцедуры

// Открывает штатную форму настройки регламентных заданий.
//
// Параметры:
//  Команда - КомандаФормы - команда, вызвавшая обработчик.
&НаКлиенте
Процедура ОткрытьШтатнуюФорму(Команда)
    РегламентныеЗаданияКлиент.ПерейтиКНастройкеРегламентныхЗаданий();
КонецПроцедуры
