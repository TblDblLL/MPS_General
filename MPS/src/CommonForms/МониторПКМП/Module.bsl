&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Элемент = УсловноеОформление.Элементы.Добавить();
    Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
    Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Задания.Тревога");
    Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    Отбор.ПравоеЗначение = Истина;
    Отбор.Использование = Истина;
    Поле = Элемент.Поля.Элементы.Добавить();
    Поле.Поле = Новый ПолеКомпоновкиДанных("Задания");
    Поле.Использование = Истина;
    Элемент.Использование = Истина;
    МониторЗаданийПКМП.ЗаполнитьФорму(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
    ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
    МониторЗаданийПКМП.ЗаполнитьФорму(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
    Данные = Элементы.Задания.ТекущиеДанные;
    Если Данные <> Неопределено Тогда
        СохранитьНаСервере(Данные.Задание, Данные.Включено, Данные.Порог, Данные.Допуск);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписание(Команда)
    Данные = Элементы.Задания.ТекущиеДанные;
    Если Данные <> Неопределено Тогда
        Настройки = Новый Структура("Задание,Включено,Порог,Допуск",
            Данные.Задание, Данные.Включено, Данные.Порог, Данные.Допуск);
        Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ПрочитатьРасписаниеНаСервере(Данные.Задание));
        Диалог.Показать(Новый ОписаниеОповещения("РасписаниеВыбрано", ЭтотОбъект, Настройки));
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасписаниеВыбрано(Расписание, Настройки) Экспорт
    Если Расписание <> Неопределено Тогда
        СохранитьНаСервере(Настройки.Задание, Настройки.Включено, Настройки.Порог, Настройки.Допуск, Расписание);
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьРасписаниеНаСервере(ВидЗадания)
    Возврат МониторЗаданийПКМП.ПрочитатьРасписание(ВидЗадания);
КонецФункции

&НаСервере
Процедура СохранитьНаСервере(ВидЗадания, Включено, Порог, Допуск, Расписание = Неопределено)
    МониторЗаданийПКМП.Сохранить(ВидЗадания, Включено, Порог, Допуск, Расписание);
    МониторЗаданийПКМП.ЗаполнитьФорму(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьШтатнуюФорму(Команда)
    РегламентныеЗаданияКлиент.ПерейтиКНастройкеРегламентныхЗаданий();
КонецПроцедуры
