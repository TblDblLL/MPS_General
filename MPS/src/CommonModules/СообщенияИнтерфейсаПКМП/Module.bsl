Функция HTMLТаймера(ПараметрыШаблона)
    HTML = "<div class=""popmechanic-timer""><p class=""timer-title"">"
        + ЗначениеШаблона(ПараметрыШаблона, "timer_title", Ложь) + "</p><div class=""mps-timer-units"">";
    Подписи = Новый Соответствие;
    Подписи.Вставить("days", "дней");
    Подписи.Вставить("hours", "часов");
    Подписи.Вставить("minutes", "минут");
    Подписи.Вставить("seconds", "секунд");
    Для Каждого Единица Из СтрРазделить("days,hours,minutes,seconds", ",") Цикл
        HTML = HTML + "<div class=""popmechanic-timer-item " + Единица + """>"
            + "<div class=""mps-timer-number"" data-popmechanic-timer=""timer:" + Единица + """></div>"
            + "<span class=""mps-timer-label"">" + Подписи[Единица] + "</span></div>";
    КонецЦикла;
    Возврат HTML + "</div></div>";
