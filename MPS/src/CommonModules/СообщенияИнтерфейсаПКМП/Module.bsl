Функция ВJSON(Данные) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(Текст) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Функция JSONУсловий(ОбъектСообщения) Экспорт
    Правила = Новый Структура;
    Для Каждого ИмяРеквизита Из СтрРазделить("ПутьПоказа,СобытиеЗапуска,ЗадержкаПоказа,ПриоритетПоказа,ИнтервалПоказа,ЛимитПоказов,ПоказыватьAndroid,ПоказыватьIOS,ПоложениеОкна", ",") Цикл
        Правила.Вставить(ИмяРеквизита, ОбъектСообщения[ИмяРеквизита]);
    КонецЦикла;
    Возврат ВJSON(Правила);
КонецФункции

Процедура ПроверитьУсловия(ОбъектСообщения) Экспорт
    Если Лев(ОбъектСообщения.ПутьПоказа, 1) <> "/" Или СтрДлина(ОбъектСообщения.ПутьПоказа) > 300 Тогда
        ВызватьИсключение "Путь показа должен начинаться с / и содержать не более 300 символов.";
    КонецЕсли;
    Для Каждого ИмяРеквизита Из СтрРазделить("ЗадержкаПоказа,ПриоритетПоказа,ИнтервалПоказа,ЛимитПоказов", ",") Цикл
        ЗначениеРеквизита = ОбъектСообщения[ИмяРеквизита];
        Если ЗначениеРеквизита < 0 Или ЗначениеРеквизита > 31536000 Или Цел(ЗначениеРеквизита) <> ЗначениеРеквизита Тогда
            ВызватьИсключение "Недопустимое значение условия: " + ИмяРеквизита;
        КонецЕсли;
    КонецЦикла;
    Если ОбъектСообщения.ПоложениеОкна < 1 Или ОбъектСообщения.ПоложениеОкна > 9 Или Цел(ОбъектСообщения.ПоложениеОкна) <> ОбъектСообщения.ПоложениеОкна Тогда
        ВызватьИсключение "Выберите положение окна от 1 до 9.";
    КонецЕсли;
    Если ОбъектСообщения.ЛимитПоказов < 1 Тогда
        ВызватьИсключение "Лимит показов должен быть не меньше 1.";
    КонецЕсли;
    Если ТипЗнч(ОбъектСообщения) = Тип("СправочникОбъект.СообщенияВПриложение") Тогда
        Если Не ОбъектСообщения.ПоказыватьAndroid И Не ОбъектСообщения.ПоказыватьIOS Тогда
            ВызватьИсключение "Выберите хотя бы одну платформу приложения.";
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Функция КаналСообщения(Ссылка)
    Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.СообщенияНаСайт") Тогда
        Возврат "web";
    ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.СообщенияВПриложение") Тогда
        Возврат "app";
    КонецЕсли;
    ВызватьИсключение "Неподдерживаемый тип сообщения.";
КонецФункции

Процедура ЗаблокироватьСообщение(Ссылка)
    ИмяСправочника = ?(КаналСообщения(Ссылка) = "web", "СообщенияНаСайт", "СообщенияВПриложение");
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить("Справочник." + ИмяСправочника);
    ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
    Блокировка.Заблокировать();
КонецПроцедуры

Функция Опубликовать(Ссылка, ОжидаемыйJSON, ОжидаемыеУсловия) Экспорт
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьСообщение(Ссылка);
        ОбъектСообщения = Ссылка.ПолучитьОбъект();
        Если ОбъектСообщения.ПометкаУдаления Тогда
            ВызватьИсключение "Нельзя публиковать помеченное на удаление сообщение.";
        КонецЕсли;
        Если ОбъектСообщения.PopupПараметрыJSON <> ОжидаемыйJSON Или JSONУсловий(ОбъектСообщения) <> ОжидаемыеУсловия Тогда
            ВызватьИсключение "Черновик изменён другим пользователем. Загрузите его заново.";
        КонецЕсли;
        ПроверитьУсловия(ОбъектСообщения);
        ТекстHTML = НРег(ОбъектСообщения.PopupHTML);
        Если ПустаяСтрока(ТекстHTML) Тогда
            ВызватьИсключение "Сначала сформируйте и сохраните шаблон.";
        КонецЕсли;
        Для Каждого ЗапрещенныйФрагмент Из СтрРазделить("<script|<iframe|<input|<form|<select|<textarea|data-popmechanic-submit|data-popmechanic-timer|javascript:", "|") Цикл
            Если СтрНайти(ТекстHTML, ЗапрещенныйФрагмент) > 0 Тогда
                ВызватьИсключение "Первая версия показа не поддерживает формы, таймеры и произвольный JS. Отключите эти возможности в шаблоне.";
            КонецЕсли;
        КонецЦикла;
        НастройкиШаблона = ИзJSON(ОбъектСообщения.PopupПараметрыJSON);
        ДействиеКнопки = "";
        Если НастройкиШаблона.profiles[НастройкиШаблона.mode].Свойство("btn_action", ДействиеКнопки) И ДействиеКнопки = "form" Тогда
            ВызватьИсключение "Действие открытия формы пока не поддерживается. Выберите ссылку или закрытие.";
        КонецЕсли;
        ИдентификаторВерсии = Строка(Новый УникальныйИдентификатор);
        Каналы = Новый Массив;
        Если КаналСообщения(Ссылка) = "web" Тогда
            Каналы.Добавить("web");
        Иначе
            Если ОбъектСообщения.ПоказыватьAndroid Тогда
                Каналы.Добавить("android");
            КонецЕсли;
            Если ОбъектСообщения.ПоказыватьIOS Тогда
                Каналы.Добавить("ios");
            КонецЕсли;
        КонецЕсли;
        Правила = Новый Структура("pathPrefix,event,delaySeconds,priority,intervalSeconds,maxShows,windowPosition",
            ОбъектСообщения.ПутьПоказа, ОбъектСообщения.СобытиеЗапуска,
            ОбъектСообщения.ЗадержкаПоказа, ОбъектСообщения.ПриоритетПоказа,
            ОбъектСообщения.ИнтервалПоказа, ОбъектСообщения.ЛимитПоказов, ОбъектСообщения.ПоложениеОкна);
        ДанныеПубликации = Новый Структура("id,publicationId,channels,html,css,rules",
            КаналСообщения(Ссылка) + ":" + Строка(Ссылка.УникальныйИдентификатор()),
            ИдентификаторВерсии, Каналы, ОбъектСообщения.PopupHTML, ОбъектСообщения.PopupCSS, Правила);
        Запись = РегистрыСведений.ПубликацииСообщенийПКМП.СоздатьМенеджерЗаписи();
        Запись.Идентификатор = ИдентификаторВерсии;
        Запись.ДанныеJSON = ВJSON(ДанныеПубликации);
        Запись.Записать();
        ОбъектСообщения.ПубликацияИдентификатор = ИдентификаторВерсии;
        ОбъектСообщения.Опубликован = Истина;
        ОбъектСообщения.Записать();
        ЗафиксироватьТранзакцию();
        Возврат ИдентификаторВерсии;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Процедура СнятьСПубликации(Ссылка) Экспорт
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьСообщение(Ссылка);
        ОбъектСообщения = Ссылка.ПолучитьОбъект();
        ОбъектСообщения.Опубликован = Ложь;
        ОбъектСообщения.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция Манифест(Канал) Экспорт
    Если Канал <> "web" И Канал <> "android" И Канал <> "ios" Тогда
        ВызватьИсключение "messages:invalid";
    КонецЕсли;
    ИмяСправочника = ?(Канал = "web", "СообщенияНаСайт", "СообщенияВПриложение");
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Публикации.ДанныеJSON КАК ДанныеJSON
    |ИЗ Справочник." + ИмяСправочника + " КАК Сообщения
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПубликацииСообщенийПКМП КАК Публикации
    |ПО Сообщения.ПубликацияИдентификатор = Публикации.Идентификатор
    |ГДЕ Сообщения.Опубликован И НЕ Сообщения.ПометкаУдаления";
    Сообщения = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Публикация = ИзJSON(Выборка.ДанныеJSON);
        Если Публикация.channels.Найти(Канал) <> Неопределено Тогда
            Сообщения.Добавить(Публикация);
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("version,messages", 1, Сообщения);
КонецФункции

Функция ПроверитьUUID(ЗначениеUUID) Экспорт
    Если ТипЗнч(ЗначениеUUID) <> Тип("Строка") Или СтрДлина(ЗначениеUUID) <> 36 Тогда
        ВызватьИсключение "messages:invalid";
    КонецЕсли;
    Попытка
        КаноническийUUID = Строка(Новый УникальныйИдентификатор(ЗначениеUUID));
    Исключение
        ВызватьИсключение "messages:invalid";
    КонецПопытки;
    Если КаноническийUUID <> НРег(ЗначениеUUID) Или КаноническийUUID = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "messages:invalid";
    КонецЕсли;
    Возврат КаноническийUUID;
КонецФункции

Функция ПроверитьСобытия(Данные)
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        ВызватьИсключение "messages:invalid";
    КонецЕсли;
    МассивСобытий = Неопределено;
    Если Не Данные.Свойство("events", МассивСобытий) Тогда
        ВызватьИсключение "messages:invalid";
    КонецЕсли;
    Если ТипЗнч(МассивСобытий) <> Тип("Массив") Тогда
        ВызватьИсключение "messages:invalid";
    КонецЕсли;
    Если МассивСобытий.Количество() = 0 Или МассивСобытий.Количество() > 50 Тогда
        ВызватьИсключение "messages:invalid";
    КонецЕсли;
    Результат = Новый Массив;
    Для Каждого Событие Из МассивСобытий Цикл
        Если ТипЗнч(Событие) <> Тип("Структура") Тогда
            ВызватьИсключение "messages:invalid";
        КонецЕсли;
        Если Не Событие.Свойство("eventId") Или Не Событие.Свойство("publicationId") Или Не Событие.Свойство("type") Тогда
            ВызватьИсключение "messages:invalid";
        КонецЕсли;
        Идентификатор = ПроверитьUUID(Событие.eventId);
        Публикация = ПроверитьUUID(Событие.publicationId);
        Если ТипЗнч(Событие.type) <> Тип("Строка") Тогда
            ВызватьИсключение "messages:invalid";
        КонецЕсли;
        Если Событие.type <> "shown" И Событие.type <> "click" И Событие.type <> "dismiss" Тогда
            ВызватьИсключение "messages:invalid";
        КонецЕсли;
        Устройство = "";
        Если Событие.Свойство("deviceUUID") Тогда
            Устройство = ПроверитьUUID(Событие.deviceUUID);
        КонецЕсли;
        ЗаписьПубликации = РегистрыСведений.ПубликацииСообщенийПКМП.СоздатьМенеджерЗаписи();
        ЗаписьПубликации.Идентификатор = Публикация;
        ЗаписьПубликации.Прочитать();
        Если Не ЗаписьПубликации.Выбран() Тогда
            ВызватьИсключение "messages:invalid";
        КонецЕсли;
        Результат.Добавить(Новый Структура("Идентификатор,ПубликацияИдентификатор,ВидСобытия,ИдентификаторУстройства",
            Идентификатор, Публикация, Событие.type, Устройство));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПринятьСобытия(Данные) Экспорт
    События = ПроверитьСобытия(Данные);
    НачатьТранзакцию();
    Попытка
        // Единая блокировка всей пачки исключает изменение записи с тем же eventId.
        Блокировка = Новый БлокировкаДанных;
        Для Каждого Событие Из События Цикл
            ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СобытияСообщенийПКМП");
            ЭлементБлокировки.УстановитьЗначение("Идентификатор", Событие.Идентификатор);
        КонецЦикла;
        Блокировка.Заблокировать();
        Для Каждого Событие Из События Цикл
            Запись = РегистрыСведений.СобытияСообщенийПКМП.СоздатьМенеджерЗаписи();
            Запись.Идентификатор = Событие.Идентификатор;
            Запись.Прочитать();
            Если Запись.Выбран() Тогда
                Если Запись.ПубликацияИдентификатор <> Событие.ПубликацияИдентификатор
                    Или Запись.ВидСобытия <> Событие.ВидСобытия
                    Или Запись.ИдентификаторУстройства <> Событие.ИдентификаторУстройства Тогда
                    ВызватьИсключение "messages:conflict";
                КонецЕсли;
            Иначе
                ЗаполнитьЗначенияСвойств(Запись, Событие);
                Запись.МоментПолучения = ТекущаяУниверсальнаяДата();
                Запись.Записать();
            КонецЕсли;
        КонецЦикла;
        ЗафиксироватьТранзакцию();
        Возврат Новый Структура("accepted", События.Количество());
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция HTTPОтвет(Код, Тело, ТипСодержимого = "application/json")
    Результат = Новый HTTPСервисОтвет(Код);
    Результат.Заголовки.Вставить("Content-Type", ТипСодержимого + "; charset=utf-8");
    Результат.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
    Результат.Заголовки.Вставить("Cache-Control", "no-store");
    Результат.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Результат;
КонецФункции

Функция HTTPМанифест(Канал) Экспорт
    Если Канал <> "web" И Канал <> "android" И Канал <> "ios" Тогда
        Возврат HTTPОтвет(400, "{""error"":""invalid_channel""}");
    КонецЕсли;
    Попытка
        Возврат HTTPОтвет(200, ВJSON(Манифест(Канал)));
    Исключение
        ЗаписьЖурналаРегистрации("СообщенияИнтерфейса.Манифест", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка чтения публикаций");
        Возврат HTTPОтвет(500, "{""error"":""storage_error""}");
    КонецПопытки;
КонецФункции

Функция HTTPКлиент() Экспорт
    Возврат HTTPОтвет(200, КодКлиента(), "application/javascript");
КонецФункции

Функция HTTPСобытия(ТипСодержимого, Тело) Экспорт
    Если ТипЗнч(ТипСодержимого) <> Тип("Строка") Тогда
        Возврат HTTPОтвет(415, "{""error"":""json_required""}");
    КонецЕсли;
    Если НРег(СокрЛП(СтрРазделить(ТипСодержимого, ";", Истина)[0])) <> "application/json" Тогда
        Возврат HTTPОтвет(415, "{""error"":""json_required""}");
    КонецЕсли;
    Если СтрДлина(Тело) > 32768 Тогда
        Возврат HTTPОтвет(413, "{""error"":""batch_too_large""}");
    КонецЕсли;
    Попытка
        Данные = ИзJSON(Тело);
    Исключение
        Возврат HTTPОтвет(400, "{""error"":""invalid_json""}");
    КонецПопытки;
    Попытка
        Результат = ПринятьСобытия(Данные);
        Возврат HTTPОтвет(200, ВJSON(Результат));
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        Если СтрНайти(ТекстОшибки, "messages:invalid") > 0 Тогда
            Возврат HTTPОтвет(400, "{""error"":""invalid_events""}");
        ИначеЕсли СтрНайти(ТекстОшибки, "messages:conflict") > 0 Тогда
            Возврат HTTPОтвет(409, "{""error"":""event_conflict""}");
        КонецЕсли;
        ЗаписьЖурналаРегистрации("СообщенияИнтерфейса.События", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка записи событий");
        Возврат HTTPОтвет(500, "{""error"":""storage_error""}");
    КонецПопытки;
КонецФункции

Функция КодКлиента() Экспорт
    Возврат "/* Shared popup/in-app runtime. No Mindbox secrets, SDK or PopMechanic dependency. */
|(function () {
|  'use strict';
|  if (window.MPSMessages) return;
|  const script = document.currentScript;
|  const defaultBase = script ? new URL('.', script.src).href : null;
|  const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
