|    const app = ua.match(/(?:^|\s)BykosmetikaApp\/(\d+(?:\.\d+)*)(?=\s|$)/);
|    if (!app) return {channel: 'web', appVersion: null};
|    const explicit = ua.match(/\bPlatform\/(Android|iOS)\b/i)?.[1].toLowerCase();
|    const platform = explicit || (/android/i.test(ua) ? 'android' : /iphone|ipad|\bios\b/i.test(ua) ? 'ios' : 'unknown');
|    return {channel: platform, appVersion: app[1]};
|  };
|  function storageReady() {
|    try { const key = 'mpsmessages:probe'; localStorage.setItem(key, '1'); localStorage.removeItem(key); return true; }
|    catch (_) { report('storage_unavailable'); return false; }
