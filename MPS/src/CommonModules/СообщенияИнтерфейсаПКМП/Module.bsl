Функция НормализоватьВебЦвет(ЦветЗначение) Экспорт
    Если ЦветЗначение.Вид = ВидЦвета.Абсолютный Тогда
        Возврат ЦветЗначение;
    КонецЕсли;
    Если ЦветЗначение.Вид = ВидЦвета.WebЦвет Тогда
        СоставляющиеЦветов = МониторингЦелевыхПоказателейПовтИсп.СоставляющиеВебЦветов();
        ЦветПалитры = СоставляющиеЦветов.Найти(ЦветЗначение, "ВебЦвет");
        Если ЦветПалитры <> Неопределено Тогда
            Возврат Новый Цвет(ЦветПалитры.Красный, ЦветПалитры.Зеленый, ЦветПалитры.Синий);
        КонецЕсли;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ОформлениеШрифтаCSS(Полужирный, Курсив, Подчеркивание) Экспорт
    СтильШрифта = "";
    Если Полужирный Тогда
        СтильШрифта = СтильШрифта + "font-weight:700;";
    КонецЕсли;
    Если Курсив Тогда
        СтильШрифта = СтильШрифта + "font-style:italic;";
    КонецЕсли;
    Если Подчеркивание Тогда
        СтильШрифта = СтильШрифта + "text-decoration:underline;";
    КонецЕсли;
    Возврат СтильШрифта;
КонецФункции

Функция ШрифтСообщенияCSS(ПараметрыШаблона)
    ИмяШрифта = "form_font";
    СтильШрифта = ОформлениеШрифтаCSS(
        ЧисловойПараметрОформления(ПараметрыШаблона, ИмяШрифта + "_bold") = 1,
        ЧисловойПараметрОформления(ПараметрыШаблона, ИмяШрифта + "_italic") = 1,
        ЧисловойПараметрОформления(ПараметрыШаблона, ИмяШрифта + "_underline") = 1);
    Если ПустаяСтрока(СтильШрифта) Тогда
        Возврат "";
    КонецЕсли;
    Селекторы = Новый Массив;
    ТекстовыеЭлементы = ".popmechanic-sub-title,.popmechanic-title,.popmechanic-title span,.timer-title,"
        + ".popmechanic-timer,.popmechanic-timer-digit,.mps-timer-label,.popmechanic-button";
    Для Каждого ЭлементCSS Из СтрРазделить(ТекстовыеЭлементы, ",") Цикл
        Селектор = "#popmechanic-form " + ЭлементCSS;
        Селекторы.Добавить(Селектор);
        Селекторы.Добавить(".popmechanic-desktop " + Селектор);
        Селекторы.Добавить(".popmechanic-tablet " + Селектор);
        Селекторы.Добавить(".popmechanic-mobile " + Селектор);
    КонецЦикла;
    Возврат Символы.ПС + СтрСоединить(Селекторы, ",") + "{" + СтильШрифта + "}";
КонецФункции

Функция ЧисловойПараметрОформления(ПараметрыШаблона, ИмяПараметра)
    ЗначениеПараметра = 0;
    ПараметрыШаблона.Свойство(ИмяПараметра, ЗначениеПараметра);
    Если ТипЗнч(ЗначениеПараметра) = Тип("Число") Тогда
        Возврат ЗначениеПараметра;
    КонецЕсли;
    Возврат 0;
КонецФункции

Функция СмещениеЭлементаCSS(ПараметрыШаблона, КлючЭлемента, СуффиксСелектора, ВидСмещения, Режим)
    КлючСмещения = КлючЭлемента + "_offset_";
    Горизонталь = ЧисловойПараметрОформления(ПараметрыШаблона, КлючСмещения + "x");
    Вертикаль = ЧисловойПараметрОформления(ПараметрыШаблона, КлючСмещения + "y");
    МобильнаяГоризонталь = ЧисловойПараметрОформления(ПараметрыШаблона, КлючСмещения + "x_mob");
    МобильнаяВертикаль = ЧисловойПараметрОформления(ПараметрыШаблона, КлючСмещения + "y_mob");
    Если Горизонталь = 0 И Вертикаль = 0 И МобильнаяГоризонталь = 0 И МобильнаяВертикаль = 0 Тогда
        Возврат "";
    КонецЕсли;
    Селектор = "#popmechanic-form" + СуффиксСелектора;
    СелекторМобильных = ".popmechanic-mobile " + Селектор;
    Если Режим = "full" Тогда
        СелекторМобильных = СелекторМобильных + ",.popmechanic-tablet " + Селектор;
    КонецЕсли;
    Возврат Символы.ПС + Селектор + "{" + КоординатыCSS(Горизонталь, Вертикаль, ВидСмещения) + "}"
        + Символы.ПС + СелекторМобильных + "{" + КоординатыCSS(МобильнаяГоризонталь, МобильнаяВертикаль, ВидСмещения) + "}";
КонецФункции

Функция КоординатыCSS(Горизонталь, Вертикаль, ВидСмещения)
    ОтступСлева = Формат(Горизонталь, "ЧГ=0;ЧН=0") + "px";
    ОтступСверху = Формат(Вертикаль, "ЧГ=0;ЧН=0") + "px";
    Если ВидСмещения = "background" Тогда
        Возврат "background-position:calc(50% + " + ОтступСлева + ") calc(50% + " + ОтступСверху + ");";
    ИначеЕсли ВидСмещения = "absolute" Тогда
        Возврат "transform:translate(" + ОтступСлева + "," + ОтступСверху + ");";
    КонецЕсли;
    Возврат "position:relative;left:" + ОтступСлева + ";top:" + ОтступСверху + ";";
КонецФункции

#КонецОбласти


