                + ",.popmechanic-tablet #popmechanic-form .popmechanic-" + СтрЗаменить(Элемент, "_", "-") + "{width:"
                + РазмерБлокаCSS(ПараметрыШаблона, Элемент + "_box_width_mob") + ";height:"
