// Формирует дерево точек сценария по данным графической схемы из реквизита
// СхемаПроцесса справочника Сценарии. Структура колонок совпадает с табличной
// частью Точки. Первый уровень — точка Старт; ниже — точки, достижимые из неё
// по соединительным линиям (с учётом висячих линий из точки действия — это
// терминаторы ветки, у них потомков нет).
//
// Параметры:
//  СценарийОбъект - СправочникОбъект.Сценарии - элемент справочника,
//                   из реквизита СхемаПроцесса которого берётся графическая схема.
//  ПроверятьКорректность - Булево - если Истина, перед построением выполняется
//                         проверка корректности схемы; при ошибках возвращается
//                         пустое дерево.
//  ГСиТочки - Соответствие - соответствие графических схем и справочников точек сценария.
//
// Возвращаемое значение:
//  ДеревоЗначений - с колонками:
//    * ИмяТочки         - Строка - имя точки в графической схеме.
//    * Точка            - ОпределяемыйТип.ТочкиСценария - ссылка на точку маршрута.
//    * ВидТочки         - ПеречислениеСсылка.ВидыТочекСценария - вид точки.
//    * НаименованиеТочки - Строка - наименование точки в графической схеме.
//
Функция СформироватьДеревоТочекПоСхеме(СценарийОбъект, ГСиТочки, ПроверятьКорректность = Ложь) Экспорт

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("ИмяТочки",         Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Точка",            Метаданные.ОпределяемыеТипы.ТочкиСценария.Тип);
	Дерево.Колонки.Добавить("ВидТочки",         Новый ОписаниеТипов("ПеречислениеСсылка.ВидыТочекСценария"));
	Дерево.Колонки.Добавить("НаименованиеТочки", Новый ОписаниеТипов("Строка"));

	Если СценарийОбъект = Неопределено Тогда
		Возврат Дерево;
	КонецЕсли;

	Схема = СценарийОбъект.СхемаПроцесса.Получить();
	Если Схема = Неопределено Тогда
		Возврат Дерево;
	КонецЕсли;

	Если ПроверятьКорректность Тогда
		РезультатПроверки = ГрафическаяСхемаКлиентСерверПКМП.ПроверитьКорректностьГрафическойСхемы(Схема);
		Если НЕ РезультатПроверки.Успех Тогда
			Возврат Дерево;
		КонецЕсли;
	КонецЕсли;

	ТочкаСтарта = ГрафическаяСхемаКлиентСерверПКМП.НайтиТочкуСтарта(Схема);
	Если ТочкаСтарта = Неопределено Тогда
		Возврат Дерево;
	КонецЕсли;

	ПотомкиПоТочкам = ГрафическаяСхемаКлиентСерверПКМП.ПостроитьКартуПотомков(Схема);

	Использовано = Новый Соответствие;
	ДобавитьТочкуВДерево(Дерево.Строки, ТочкаСтарта, ПотомкиПоТочкам, ГСиТочки, Использовано);

	Возврат Дерево;

КонецФункции

// Рекурсивно добавляет точку и её потомков в коллекцию строк дерева.
// Использовано защищает от зацикливания, если в схеме есть петли.
Процедура ДобавитьТочкуВДерево(Строки, Точка, ПотомкиПоТочкам, ГСиТочки, Использовано)

	Если Использовано.Получить(Точка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Использовано.Вставить(Точка, Истина);

	СтрокаДерева = Строки.Добавить();
	СтрокаДерева.ИмяТочки         = Точка.Имя;
	СтрокаДерева.Точка            = ГСиТочки.Получить(Точка);
	СтрокаДерева.ВидТочки         = ГрафическаяСхемаКлиентСерверПКМП.ВидТочкиПоТипуЭлемента(Точка);
	СтрокаДерева.НаименованиеТочки = Точка.Наименование;

	МассивПотомков = ПотомкиПоТочкам.Получить(Точка);
	Если МассивПотомков = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Потомок Из МассивПотомков Цикл
		ДобавитьТочкуВДерево(СтрокаДерева.Строки, Потомок, ПотомкиПоТочкам, ГСиТочки, Использовано);
	КонецЦикла;

КонецПроцедуры
