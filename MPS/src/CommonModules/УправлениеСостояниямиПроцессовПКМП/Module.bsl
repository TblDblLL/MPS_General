// Возвращает статус объекта и его цветовое оформление по данным регистра сведений состояний.
//
// Параметры:
//   ЗначениеПервогоИзмерения - СправочникСсылка.Сценарии, СправочникСсылка.ПрограммыАкций, СправочникСсылка.НаборыПромокодов,
//                              ОпределяемыйТип.Рассылки, ОпределяемыйТип.Персонализация - объект, для которого определяется статус.
//   СтруктураДопИзмерений - Структура - дополнительные измерения регистра состояний: ключ - имя измерения, значение - значение измерения.
//   ЭлементНадписьСтатус - ЭлементФормы - элемент формы для отображения статуса.
//
// Возвращаемое значение:
//   Структура:
//     * Статус - Перечисления.СтатусыСценариев, Перечисления.СтатусыПрограммЛояльности, Перечисления.СтатусыРассылок,
//                Перечисления.СтатусыПрограммПерсонализации - текущий статус объекта; если статус не установлен, возвращается статус по умолчанию "Черновик".
//     * ЦветТекста - Цвет - цвет текста для отображения статуса.
//     * ЦветФона - Цвет - цвет фона для отображения статуса.
//	   * МожноЗапустить - Булево - см. УправлениеСостояниямиПроцессовПКМП.ДополнитьСтруктуруДаннымиСтатусов
//	   * МожноОстановить - Булево - см. УправлениеСостояниямиПроцессовПКМП.ДополнитьСтруктуруДаннымиСтатусов
//	   * МожноПриостановить - Булево - см. УправлениеСостояниямиПроцессовПКМП.ДополнитьСтруктуруДаннымиСтатусов
Функция ПолучитьДанныеСтатуса(ЗначениеПервогоИзмерения, СтруктураДопИзмерений = Неопределено, ЭлементНадписьСтатус = Неопределено) Экспорт
	
	
	СтруктураРезультата = Новый Структура("Статус,ЦветТекста,ЦветФона",Неопределено,Неопределено,Неопределено);
	ДополнитьСтруктуруДаннымиСтатусов(СтруктураРезультата);
	
	Если ТипЗнч(ЗначениеПервогоИзмерения) = Тип("СправочникСсылка.Сценарии") Тогда
		ИмяРегистраСтатуса = "СостоянияСценариев";
		СтатусПоУмолчанию = Перечисления.СтатусыСценариев.Черновик;
	ИначеЕсли ТипЗнч(ЗначениеПервогоИзмерения) = Тип("СправочникСсылка.ПрограммыАкций") Тогда
		ИмяРегистраСтатуса = "СостоянияПрограммАкций";
		СтатусПоУмолчанию = Перечисления.СтатусыПрограммЛояльности.Черновик;
	ИначеЕсли ТипЗнч(ЗначениеПервогоИзмерения) = Тип("СправочникСсылка.НаборыПромокодов") Тогда
		ИмяРегистраСтатуса = "СостоянияНаборовПромокодов";
		СтатусПоУмолчанию = Перечисления.СтатусыПрограммЛояльности.Черновик;
	ИначеЕсли Метаданные.ОпределяемыеТипы.Рассылки.Тип.СодержитТип(ТипЗнч(ЗначениеПервогоИзмерения)) Тогда
		ИмяРегистраСтатуса = "СостоянияРассылок";
		СтатусПоУмолчанию = Перечисления.СтатусыРассылок.Черновик;
	ИначеЕсли Метаданные.ОпределяемыеТипы.Персонализация.Тип.СодержитТип(ТипЗнч(ЗначениеПервогоИзмерения))  Тогда
		ИмяРегистраСтатуса = "СостоянияПерсонализаций";
		СтатусПоУмолчанию = Перечисления.СтатусыПрограммПерсонализации.Черновик;
	Иначе
		ВызватьИсключение "Неизвестный объект статуса.";
	КонецЕсли;
	
	ИмяПервогоИзмерения = Метаданные.РегистрыСведений[ИмяРегистраСтатуса].Измерения.Получить(0).Имя;
			
	МассивУсловий = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр(ИмяПервогоИзмерения, ЗначениеПервогоИзмерения);
	МассивУсловий.Добавить(СтрШаблон("%1 = &%1",ИмяПервогоИзмерения));
	
	
	Если ТипЗнч(СтруктураДопИзмерений) = Тип("Структура") Тогда
		Для Каждого Измерение Из СтруктураДопИзмерений Цикл
			Запрос.УстановитьПараметр(Измерение.Ключ, Измерение.Значение);
			МассивУсловий.Добавить(СтрШаблон("%1 = &%1", Измерение.Ключ));
		КонецЦикла;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СостояниеОбъекта.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.%1.СрезПоследних(, %2) КАК СостояниеОбъекта";
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, ИмяРегистраСтатуса, СтрСоединить(МассивУсловий," И "));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СтруктураРезультата.Статус = ВыборкаДетальныеЗаписи.Статус;
	Иначе	
		СтруктураРезультата.Статус = СтатусПоУмолчанию;
	КонецЕсли;
	
	ИмяЗначенияПеречисления = ОбщегоНазначения.ИмяЗначенияПеречисления(СтруктураРезультата.Статус);
	
	Если СтруктураРезультата.Статус = СтатусПоУмолчанию или 
	ИмяЗначенияПеречисления = "ГотовоКЗапуску" Тогда
		СтруктураРезультата.ЦветФона = WEBЦвета.СинеФиолетовый;
		СтруктураРезультата.ЦветТекста = WEBЦвета.Белый;
	ИначеЕсли ИмяЗначенияПеречисления	 = "Запущено" Тогда
		СтруктураРезультата.ЦветФона = WEBЦвета.ЗеленаяЛужайка;
		СтруктураРезультата.ЦветТекста = WEBЦвета.Белый;
	Иначе
		СтруктураРезультата.ЦветФона = WEBЦвета.СветлоСерый;
		СтруктураРезультата.ЦветТекста = WEBЦвета.Черный;
	КонецЕсли;	
	
	ИнформацияСледующихСтатусов = Перечисления[СтатусПоУмолчанию.Метаданные().Имя].ПолучитьВозможныеСледующиеСтатусы(СтруктураРезультата.Статус);
	
	Если не ЭлементНадписьСтатус = Неопределено Тогда
		ЭлементНадписьСтатус.ЦветФона = СтруктураРезультата.ЦветФона;
		ЭлементНадписьСтатус.ЦветТекста = СтруктураРезультата.ЦветТекста;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтруктураРезультата, ИнформацияСледующихСтатусов, СтруктураРезультата.СоставДанных);
	
	Возврат СтруктураРезультата;
	
 КонецФункции	
 
 // Дополняет переданную структуру признаками доступности операций со статусами
// и перечнем этих признаков.
//
// Параметры:
//   ВходящаяСтруктура - Структура - структура, в которую добавляются свойства. Если передано
//                       значение другого типа, создается новая структура.
//
// Возвращаемое значение:
//   Структура:
//     * МожноЗапустить - Булево - признак доступности запуска
//     * МожноОстановить - Булево - признак доступности остановки
//     * МожноПриостановить - Булево - признак доступности приостановки
//     * СоставДанных - Строка - имена добавленных свойств, перечисленные через запятую
Функция ДополнитьСтруктуруДаннымиСтатусов(ВходящаяСтруктура) Экспорт
 	
 	Если не ТипЗнч(ВходящаяСтруктура) = Тип("Структура") Тогда
 		ВходящаяСтруктура = Новый Структура;
 	КонецЕсли;	
 	
 	ВходящаяСтруктура.Вставить("МожноЗапустить", Ложь);
 	ВходящаяСтруктура.Вставить("МожноОстановить", Ложь);
 	ВходящаяСтруктура.Вставить("МожноПриостановить", Ложь);
 	ВходящаяСтруктура.Вставить("СоставДанных", "МожноЗапустить,МожноОстановить,МожноПриостановить");
 	Возврат ВходящаяСтруктура;
 	
 КонецФункции	