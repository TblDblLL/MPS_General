// Возвращает статус объекта из регистра сведений состояния по значению первого измерения
// и дополнительным измерениям.
//
// Параметры:
//   ЗначениеПервогоИзмерения - СправочникСсылка.Сценарии, СправочникСсылка.ПрограммыАкций - значение первого измерения регистра состояния.
//   СтруктураДопИзмерений - Структура, Неопределено - дополнительные измерения регистра состояния, где ключ - имя измерения, значение - значение измерения.
//
// Возвращаемое значение:
//   - Статус - значение статуса объекта из регистра сведений состояния.
//   - Неопределено - если тип значения первого измерения не поддерживается или запись не найдена.
Функция ПолучитьСтатус(ЗначениеПервогоИзмерения, СтруктураДопИзмерений = Неопределено, ЭлементНадписьСтатус = Неопределено) Экспорт
	
	
	СтруктураРезультата = Новый Структура("Статус,ЦветТекста,ЦветФона,МожноЗапустить,МожноОстановить,МожноПриостановить",Неопределено,Неопределено,Неопределено,Ложь,Ложь,Ложь);
	
	Если ТипЗнч(ЗначениеПервогоИзмерения) = Тип("СправочникСсылка.Сценарии") Тогда
		ИмяРегистраСтатуса = "СостоянияСценариев";
		СтатусПоУмолчанию = Перечисления.СтатусыСценариев.Черновик;
	ИначеЕсли ТипЗнч(ЗначениеПервогоИзмерения) = Тип("СправочникСсылка.ПрограммыАкций") Тогда
		ИмяРегистраСтатуса = "СостоянияПрограммАкций";
		СтатусПоУмолчанию = Перечисления.СтатусыПрограммЛояльности.Черновик;
	ИначеЕсли ТипЗнч(ЗначениеПервогоИзмерения) = Тип("СправочникСсылка.НаборыПромокодов") Тогда
		ИмяРегистраСтатуса = "СостоянияНаборовПромокодов";
		СтатусПоУмолчанию = Перечисления.СтатусыПрограммЛояльности.Черновик;
	ИначеЕсли Метаданные.ОпределяемыеТипы.Рассылки.Тип.СодержитТип(ТипЗнч(ЗначениеПервогоИзмерения)) Тогда
		ИмяРегистраСтатуса = "СостоянияРассылок";
		СтатусПоУмолчанию = Перечисления.СтатусыРассылок.Черновик;
	ИначеЕсли Метаданные.ОпределяемыеТипы.Персонализация.Тип.СодержитТип(ТипЗнч(ЗначениеПервогоИзмерения))  Тогда
		ИмяРегистраСтатуса = "СостоянияПерсонализаций";
		СтатусПоУмолчанию = Перечисления.СтатусыПрограммПерсонализации.Черновик;
	Иначе
		ВызватьИсключение "Неизвестный объект статуса.";
	КонецЕсли;
	
	ИмяПервогоИзмерения = Метаданные.РегистрыСведений[ИмяРегистраСтатуса].Измерения.Получить(0).Имя;
			
	МассивУсловий = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр(ИмяПервогоИзмерения, ЗначениеПервогоИзмерения);
	МассивУсловий.Добавить(СтрШаблон("%1 = &%1",ИмяПервогоИзмерения));
	
	
	Если ТипЗнч(СтруктураДопИзмерений) = Тип("Структура") Тогда
		Для Каждого Измерение Из СтруктураДопИзмерений Цикл
			Запрос.УстановитьПараметр(Измерение.Ключ, Измерение.Значение);
			МассивУсловий.Добавить(СтрШаблон("%1 = &%1", Измерение.Ключ));
		КонецЦикла;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СостояниеОбъекта.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.%1.СрезПоследних(, %2) КАК СостояниеОбъекта";
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, ИмяРегистраСтатуса, СтрСоединить(МассивУсловий," И "));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СтруктураРезультата.Статус = ВыборкаДетальныеЗаписи.Статус;
	Иначе	
		СтруктураРезультата.Статус = СтатусПоУмолчанию;
	КонецЕсли;
	
	ИмяСтатуса = ОбщегоНазначения.ИмяЗначенияПеречисления(СтруктураРезультата.Статус);
	
	Если СтруктураРезультата.Статус = СтатусПоУмолчанию Тогда
		//СтруктураРезультата.
	КонецЕсли;	
	
	Возврат СтруктураРезультата;
	
 КонецФункции	