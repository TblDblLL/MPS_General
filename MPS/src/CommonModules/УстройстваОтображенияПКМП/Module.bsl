#Область ИменаЭлементов

// Дубли полей разных устройств привязаны к одному реквизиту формы.
// Суффикс нужен только имени элемента, но не имени реквизита.
Функция ИмяИсходногоЭлемента(ИмяЭлемента) Экспорт
    ПозицияСуффикса = СтрНайти(ИмяЭлемента, "__");
    Если ПозицияСуффикса > 0 Тогда
        Возврат Лев(ИмяЭлемента, ПозицияСуффикса - 1);
    КонецЕсли;
    Возврат ИмяЭлемента;
КонецФункции

#КонецОбласти

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда

#Область Устройства

Функция КодCSS(Устройство) Экспорт
    Если Устройство = Перечисления.ТипыУстройствОтображения.Компьютер Тогда
        Возврат "desktop";
    ИначеЕсли Устройство = Перечисления.ТипыУстройствОтображения.Планшет Тогда
        Возврат "tablet";
    ИначеЕсли Устройство = Перечисления.ТипыУстройствОтображения.Телефон Тогда
        Возврат "mobile";
    КонецЕсли;
    ВызватьИсключение "Выберите устройство: компьютер, планшет или телефон.";
КонецФункции

Функция ШиринаПоУмолчанию(Устройство, ШиринаКомпьютера, ШиринаПланшета, ШиринаТелефона) Экспорт
    КодCSS(Устройство);
    Если Устройство = Перечисления.ТипыУстройствОтображения.Компьютер Тогда
        Возврат ШиринаКомпьютера;
    ИначеЕсли Устройство = Перечисления.ТипыУстройствОтображения.Планшет Тогда
        Возврат ШиринаПланшета;
    КонецЕсли;
    Возврат ШиринаТелефона;
КонецФункции

#КонецОбласти

#Область ВидимостьНастроек

// Одинаковое правило для popup и виджетов: устройство И режим И поиск.
// Неопределено в Устройстве привязки обозначает общую настройку.
Процедура ПрименитьВидимость(Форма, Устройство, Привязки, Группы, Поиск, Режим = "") Экспорт
    КодCSS(Устройство);
    ПоисковаяСтрока = НРег(СокрЛП(Поиск));
    Для Каждого Привязка Из Привязки Цикл
        ПодходитУстройство = Привязка.Устройство = Неопределено Или Привязка.Устройство = Устройство;
        ПодходитРежим = ПустаяСтрока(Привязка.Режим) Или Привязка.Режим = Режим;
        ПодходитПоиск = ПустаяСтрока(ПоисковаяСтрока) Или СтрНайти(НРег(Привязка.Поиск), ПоисковаяСтрока) > 0;
        Форма.Элементы[Привязка.Строка].Видимость = ПодходитУстройство И ПодходитРежим И ПодходитПоиск;
    КонецЦикла;
    // Дочерние группы перечислены перед родительскими.
    Для Каждого ОписаниеГруппы Из Группы Цикл
        ЕстьВидимые = Ложь;
        Для Каждого ИмяДочернего Из СтрРазделить(ОписаниеГруппы.Дочерние, ",", Ложь) Цикл
            ЕстьВидимые = ЕстьВидимые Или Форма.Элементы[ИмяДочернего].Видимость;
        КонецЦикла;
        Форма.Элементы[ОписаниеГруппы.Имя].Видимость = ЕстьВидимые;
    КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
