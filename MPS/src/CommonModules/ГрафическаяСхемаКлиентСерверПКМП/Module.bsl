// Проверяет корректность графической схемы по набору правил:
// - точка старта ровно одна и имеет ровно один выход;
// - каждая точка условия имеет ровно один вход и ровно два выхода;
// - каждая точка разделения имеет ровно один вход и ровно два выхода;
// - каждая точка действия имеет ровно один вход и не более одного выхода;
// - каждая точка обработки имеет ровно один вход и ровно один выход;
// - других точек в схеме быть не должно (завершение, слияние, вложенный
//   бизнес-процесс, выбор варианта и любые иные типы);
// - нет висящих соединительных линий; исключение — линии, выходящие из точки действия.
//
// Параметры:
//  Схема - ГрафическаяСхема - проверяемая графическая схема.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//    * Успех - Булево - Истина, если схема корректна.
//    * Ошибки - Массив из Строка - список найденных нарушений.
//    * ИмяТочкиСтарта - Строка - имя точки старта (пустая строка, если не найдена).
//    * КоличествоТочекУсловий - Число - количество точек условий.
//    * КоличествоТочекРазделений - Число - количество точек разделения.
//    * КоличествоТочекДействий - Число - количество точек действий.
//    * КоличествоТочекОбработок - Число - количество точек обработки.
//    * КоличествоНеизвестныхТочек - Число - количество точек неподдерживаемых типов.
//
Функция ПроверитьКорректностьГрафическойСхемы(Схема) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("ИмяТочкиСтарта", "");
	Результат.Вставить("КоличествоТочекУсловий", 0);
	Результат.Вставить("КоличествоТочекРазделений", 0);
	Результат.Вставить("КоличествоТочекДействий", 0);
	Результат.Вставить("КоличествоТочекОбработок", 0);
	Результат.Вставить("КоличествоНеизвестныхТочек", 0);

	Если Схема = Неопределено Тогда
		Результат.Ошибки.Добавить("Не передана графическая схема.");
		Возврат Результат;
	КонецЕсли;

	ТочкиСтарта = Новый Массив;
	ТочкиУсловий = Новый Массив;
	ТочкиРазделений = Новый Массив;
	ТочкиДействий = Новый Массив;
	ТочкиОбработок = Новый Массив;
	НеизвестныеТочки = Новый Массив;
	ВыходыПоТочкам = Новый Соответствие;
	ВходыПоТочкам = Новый Соответствие;

	// Первый проход: собираем точки интереса и фиксируем точки неподдерживаемых типов.
	Для Каждого Элемент Из Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыСтарт") Тогда
			ТочкиСтарта.Добавить(Элемент);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыУсловие") Тогда
			ТочкиУсловий.Добавить(Элемент);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыРазделение") Тогда
			ТочкиРазделений.Добавить(Элемент);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыДействие") Тогда
			ТочкиДействий.Добавить(Элемент);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыОбработка") Тогда
			ТочкиОбработок.Добавить(Элемент);
		ИначеЕсли ЭтоСлужебныйЭлемент(Элемент) Тогда
			Продолжить;
		Иначе
			НеизвестныеТочки.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	// Второй проход: считаем входы и выходы по соединительным линиям.
	Для Каждого Элемент Из Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") Тогда
			Продолжить;
		КонецЕсли;

		Источник = Элемент.НачалоЭлемент;
		Приемник = Элемент.КонецЭлемент;

		Если Источник <> Неопределено Тогда
			ВыходыПоТочкам.Вставить(Источник, КоличествоСвязей(ВыходыПоТочкам, Источник) + 1);
		КонецЕсли;
		Если Приемник <> Неопределено Тогда
			ВходыПоТочкам.Вставить(Приемник, КоличествоСвязей(ВходыПоТочкам, Приемник) + 1);
		КонецЕсли;
	КонецЦикла;

	Результат.КоличествоТочекУсловий = ТочкиУсловий.Количество();
	Результат.КоличествоТочекРазделений = ТочкиРазделений.Количество();
	Результат.КоличествоТочекДействий = ТочкиДействий.Количество();
	Результат.КоличествоТочекОбработок = ТочкиОбработок.Количество();
	Результат.КоличествоНеизвестныхТочек = НеизвестныеТочки.Количество();

	ПроверитьТочкуСтарта(ТочкиСтарта, ВыходыПоТочкам, Результат);

	ПроверитьТочкиПоПравилуВходовВыходов(ТочкиУсловий, ВходыПоТочкам, ВыходыПоТочкам,
		Результат, "точки условия", Границы(1, 1), Границы(2, 2));

	ПроверитьТочкиПоПравилуВходовВыходов(ТочкиРазделений, ВходыПоТочкам, ВыходыПоТочкам,
		Результат, "точки разделения", Границы(1, 1), Границы(2, 2));

	ПроверитьТочкиПоПравилуВходовВыходов(ТочкиДействий, ВходыПоТочкам, ВыходыПоТочкам,
		Результат, "точки действия", Границы(1, 1), Границы(0, 1));

	ПроверитьТочкиПоПравилуВходовВыходов(ТочкиОбработок, ВходыПоТочкам, ВыходыПоТочкам,
		Результат, "точки обработки", Границы(1, 1), Границы(1, 1));

	ПроверитьОтсутствиеНеизвестныхТочек(НеизвестныеТочки, Результат);
	ПроверитьОтсутствиеВисящихЛиний(Схема, Результат);

	Результат.Успех = Результат.Ошибки.Количество() = 0;
	Возврат Результат;

КонецФункции

// Вспомогательная: возвращает счётчик связей для точки из Соответствия.
Функция КоличествоСвязей(Соответствие, Точка)
	Значение = Соответствие.Получить(Точка);
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

// Строит описание допустимого диапазона. Неопределено означает "нет ограничения".
Функция Границы(Минимум = Неопределено, Максимум = Неопределено)
	Границы = Новый Структура;
	Границы.Вставить("Минимум", Минимум);
	Границы.Вставить("Максимум", Максимум);
	Возврат Границы;
КонецФункции

// Возвращает Истина, если значение внутри диапазона (Неопределено — нет границы).
Функция ЗначениеВДиапазоне(Значение, Границы)
	Если Границы.Минимум <> Неопределено И Значение < Границы.Минимум Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Границы.Максимум <> Неопределено И Значение > Границы.Максимум Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Текстовое представление диапазона: "ровно N", "не более N", "от N до M" и т.п.
Функция ОписаниеДиапазона(Границы)
	Минимум = Границы.Минимум;
	Максимум = Границы.Максимум;

	Если Минимум <> Неопределено И Максимум <> Неопределено И Минимум = Максимум Тогда
		Возврат СтрШаблон("ровно %1", Минимум);
	ИначеЕсли Минимум <> Неопределено И Максимум <> Неопределено Тогда
		Возврат СтрШаблон("от %1 до %2", Минимум, Максимум);
	ИначеЕсли Максимум <> Неопределено Тогда
		Возврат СтрШаблон("не более %1", Максимум);
	ИначеЕсли Минимум <> Неопределено Тогда
		Возврат СтрШаблон("не менее %1", Минимум);
	Иначе
		Возврат "любое количество";
	КонецЕсли;
КонецФункции

// Возвращает Истина для служебных элементов схемы (линии и декорации),
// которые не являются точками бизнес-логики.
Функция ЭтоСлужебныйЭлемент(Элемент)
	ТипЭлемента = ТипЗнч(Элемент);
	Возврат ТипЭлемента = Тип("ЭлементГрафическойСхемыСоединительнаяЛиния")
		ИЛИ ТипЭлемента = Тип("ЭлементГрафическойСхемыДекоративнаяЛиния")
		ИЛИ ТипЭлемента = Тип("ЭлементГрафическойСхемыДекорация");
КонецФункции

// Проверяет точку старта: ровно одна и с одним выходом.
Процедура ПроверитьТочкуСтарта(ТочкиСтарта, ВыходыПоТочкам, Результат)

	Если ТочкиСтарта.Количество() = 0 Тогда
		Результат.Ошибки.Добавить("В схеме отсутствует точка старта.");
		Возврат;
	ИначеЕсли ТочкиСтарта.Количество() > 1 Тогда
		Результат.Ошибки.Добавить(
			СтрШаблон("В схеме должна быть ровно одна точка старта, обнаружено: %1.",
				ТочкиСтарта.Количество()));
		Возврат;
	КонецЕсли;

	ТочкаСтарта = ТочкиСтарта[0];
	Результат.ИмяТочкиСтарта = ТочкаСтарта.Имя;

	КоличествоВыходов = КоличествоСвязей(ВыходыПоТочкам, ТочкаСтарта);

	Если КоличествоВыходов = 0 Тогда
		Результат.Ошибки.Добавить(
			"У точки старта отсутствуют исходящие соединительные линии.");
	ИначеЕсли КоличествоВыходов > 1 Тогда
		Результат.Ошибки.Добавить(
			СтрШаблон("У точки старта должен быть ровно один выход, обнаружено: %1.",
				КоличествоВыходов));
	КонецЕсли;

КонецПроцедуры

// Универсальная проверка точек по диапазонам входов и выходов.
Процедура ПроверитьТочкиПоПравилуВходовВыходов(Точки, ВходыПоТочкам, ВыходыПоТочкам,
	Результат, НазваниеТочек, ГраницыВходов, ГраницыВыходов)

	Для Каждого Точка Из Точки Цикл

		КоличествоВходов = КоличествоСвязей(ВходыПоТочкам, Точка);
		КоличествоВыходов = КоличествоСвязей(ВыходыПоТочкам, Точка);
		ИмяТочки = ?(ПустаяСтрока(Точка.Имя), "<без имени>", Точка.Имя);

		Если НЕ ЗначениеВДиапазоне(КоличествоВходов, ГраницыВходов) Тогда
			Результат.Ошибки.Добавить(
				СтрШаблон("У %1 ""%2"" ожидается %3 вход(ов), обнаружено: %4.",
					НазваниеТочек, ИмяТочки, ОписаниеДиапазона(ГраницыВходов), КоличествоВходов));
		КонецЕсли;

		Если НЕ ЗначениеВДиапазоне(КоличествоВыходов, ГраницыВыходов) Тогда
			Результат.Ошибки.Добавить(
				СтрШаблон("У %1 ""%2"" ожидается %3 выход(ов), обнаружено: %4.",
					НазваниеТочек, ИмяТочки, ОписаниеДиапазона(ГраницыВыходов), КоличествоВыходов));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Регистрирует ошибку по каждой точке неподдерживаемого типа.
Процедура ПроверитьОтсутствиеНеизвестныхТочек(НеизвестныеТочки, Результат)
	Для Каждого Точка Из НеизвестныеТочки Цикл
		ИмяТочки = ?(ПустаяСтрока(Точка.Имя), "<без имени>", Точка.Имя);
		Результат.Ошибки.Добавить(
			СтрШаблон("Обнаружена точка неподдерживаемого типа ""%1"" (%2). Допустимы только: старт, условие, разделение, действие, обработка.",
				ИмяТочки, Строка(ТипЗнч(Точка))));
	КонецЦикла;
КонецПроцедуры

// Регистрирует ошибку по каждой висящей соединительной линии.
// Висящая = хотя бы один из концов (НачалоЭлемент или КонецЭлемент) не подключён.
// Исключение: линия, выходящая из точки действия, — допустима даже без приёмника.
Процедура ПроверитьОтсутствиеВисящихЛиний(Схема, Результат)

	Для Каждого Элемент Из Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") Тогда
			Продолжить;
		КонецЕсли;

		НачалоПодключено = Элемент.НачалоЭлемент <> Неопределено;
		КонецПодключено = Элемент.КонецЭлемент <> Неопределено;

		Если НачалоПодключено И КонецПодключено Тогда
			Продолжить;
		КонецЕсли;

		// Висящая линия. Исключение — линии, выходящие из точки действия.
		Если ТипЗнч(Элемент.НачалоЭлемент) = Тип("ЭлементГрафическойСхемыДействие") Тогда
			Продолжить;
		КонецЕсли;

		ИмяЛинии = ?(ПустаяСтрока(Элемент.Имя), "<без имени>", Элемент.Имя);

		Если НЕ НачалоПодключено И НЕ КонецПодключено Тогда
			ОписаниеКонцов = "не подключены ни начало, ни конец";
		ИначеЕсли НЕ НачалоПодключено Тогда
			ОписаниеКонцов = "не подключено начало";
		Иначе
			ОписаниеКонцов = "не подключён конец";
		КонецЕсли;

		Результат.Ошибки.Добавить(
			СтрШаблон("Обнаружена висящая соединительная линия ""%1"": %2.",
				ИмяЛинии, ОписаниеКонцов));
	КонецЦикла;

КонецПроцедуры


// Формирует дерево точек сценария по данным графической схемы из реквизита
// СхемаПроцесса справочника Сценарии. Структура колонок совпадает с табличной
// частью Точки. Первый уровень — точка Старт; ниже — точки, достижимые из неё
// по соединительным линиям (с учётом висячих линий из точки действия — это
// терминаторы ветки, у них потомков нет).
//
// Параметры:
//  СценарийОбъект - СправочникОбъект.Сценарии - элемент справочника,
//                   из реквизита СхемаПроцесса которого берётся графическая схема.
//  ПроверятьКорректность - Булево - если Истина, перед построением выполняется
//                         проверка корректности схемы; при ошибках возвращается
//                         пустое дерево.
//
// Возвращаемое значение:
//  ДеревоЗначений - с колонками:
//    * ИмяТочки         - Строка - имя точки в графической схеме.
//    * Точка            - ОпределяемыйТип.ТочкиСценария - ссылка на точку маршрута.
//    * ВидТочки         - ПеречислениеСсылка.ВидыТочекСценария - вид точки.
//    * НаименованиеТочки - Строка - наименование точки в графической схеме.
//
Функция СформироватьДеревоТочекПоСхеме(СценарийОбъект, ПроверятьКорректность = Ложь) Экспорт

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("ИмяТочки",         Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Точка",            Новый ОписаниеТипов);
	Дерево.Колонки.Добавить("ВидТочки",         Новый ОписаниеТипов("ПеречислениеСсылка.ВидыТочекСценария"));
	Дерево.Колонки.Добавить("НаименованиеТочки", Новый ОписаниеТипов("Строка"));

	Если СценарийОбъект = Неопределено Тогда
		Возврат Дерево;
	КонецЕсли;

	Схема = СценарийОбъект.СхемаПроцесса.Получить();
	Если Схема = Неопределено Тогда
		Возврат Дерево;
	КонецЕсли;

	Если ПроверятьКорректность Тогда
		РезультатПроверки = ПроверитьКорректностьГрафическойСхемы(Схема);
		Если НЕ РезультатПроверки.Успех Тогда
			Возврат Дерево;
		КонецЕсли;
	КонецЕсли;

	ТочкаСтарта = НайтиТочкуСтарта(Схема);
	Если ТочкаСтарта = Неопределено Тогда
		Возврат Дерево;
	КонецЕсли;

	ПотомкиПоТочкам = ПостроитьКартуПотомков(Схема);

	Использовано = Новый Соответствие;
	ДобавитьТочкуВДерево(Дерево.Строки, ТочкаСтарта, ПотомкиПоТочкам, Использовано);

	Возврат Дерево;

КонецФункции

// Возвращает первый найденный элемент типа ЭлементГрафическойСхемыСтарт
// или Неопределено, если такого элемента в схеме нет.
Функция НайтиТочкуСтарта(Схема)

	Для Каждого Элемент Из Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыСтарт") Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Строит соответствие "точка -> массив её прямых потомков по соединительным линиям".
// Висячие линии (с незаданным концом) пропускаются.
Функция ПостроитьКартуПотомков(Схема)

	ПотомкиПоТочкам = Новый Соответствие;

	Для Каждого Элемент Из Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) <> Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") Тогда
			Продолжить;
		КонецЕсли;
		Источник = Элемент.НачалоЭлемент;
		Приемник = Элемент.КонецЭлемент;
		Если Источник = Неопределено ИЛИ Приемник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивПотомков = ПотомкиПоТочкам.Получить(Источник);
		Если МассивПотомков = Неопределено Тогда
			МассивПотомков = Новый Массив;
			ПотомкиПоТочкам.Вставить(Источник, МассивПотомков);
		КонецЕсли;
		МассивПотомков.Добавить(Приемник);
	КонецЦикла;

	Возврат ПотомкиПоТочкам;

КонецФункции

// Рекурсивно добавляет точку и её потомков в коллекцию строк дерева.
// Использовано защищает от зацикливания, если в схеме есть петли.
Процедура ДобавитьТочкуВДерево(Строки, Точка, ПотомкиПоТочкам, Использовано)

	Если Использовано.Получить(Точка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Использовано.Вставить(Точка, Истина);

	СтрокаДерева = Строки.Добавить();
	СтрокаДерева.ИмяТочки         = Точка.Имя;
	СтрокаДерева.Точка            = Точка.Значение;
	СтрокаДерева.ВидТочки         = ВидТочкиПоТипуЭлемента(Точка);
	СтрокаДерева.НаименованиеТочки = Точка.Наименование;

	МассивПотомков = ПотомкиПоТочкам.Получить(Точка);
	Если МассивПотомков = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Потомок Из МассивПотомков Цикл
		ДобавитьТочкуВДерево(СтрокаДерева.Строки, Потомок, ПотомкиПоТочкам, Использовано);
	КонецЦикла;

КонецПроцедуры

// Маппит тип элемента графической схемы на значение перечисления ВидыТочекСценария.
// В перечислении отсутствует значение для точки обработки — она мапится на Действие
// как ближайший по семантике вид. Измените при необходимости.
Функция ВидТочкиПоТипуЭлемента(Элемент)

	ТипЭлемента = ТипЗнч(Элемент);

	Если ТипЭлемента = Тип("ЭлементГрафическойСхемыСтарт") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ВидыТочекСценария.Старт");
	ИначеЕсли ТипЭлемента = Тип("ЭлементГрафическойСхемыУсловие") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ВидыТочекСценария.Условие");
	ИначеЕсли ТипЭлемента = Тип("ЭлементГрафическойСхемыРазделение") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ВидыТочекСценария.Разделение");
	ИначеЕсли ТипЭлемента = Тип("ЭлементГрафическойСхемыДействие") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ВидыТочекСценария.Действие");
	ИначеЕсли ТипЭлемента = Тип("ЭлементГрафическойСхемыОбработка") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ВидыТочекСценария.Действие");
	Иначе
		Возврат ПредопределенноеЗначение("Перечисление.ВидыТочекСценария.ПустаяСсылка");
	КонецЕсли;

КонецФункции
