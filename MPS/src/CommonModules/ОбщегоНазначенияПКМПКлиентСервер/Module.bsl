// Выполняет сериализацию объекта в XML
//
// Параметры:
//  Значение  - Произвольный - объект, который необходимо сериализовать в XML.
//
// Возвращаемое значение:
//   Строка   - объект, сериализованный в XML.
//
Функция ПолучитьXML(Значение) Экспорт
	
	Запись = Новый ЗаписьXML();
	Запись.УстановитьСтроку();
	//@skip-check undefined-variable
	СериализаторXDTO.ЗаписатьXML(Запись, Значение);
	Возврат Запись.Закрыть();
	
КонецФункции


// Вывод если заполнено.
// 
// Параметры:
//  Преф - Строка - Преффикс вывода
//  Зн - Произвольный - Значение
//  Пост - Строка - Постфикс вывода
// 
// Возвращаемое значение:
//  Строка - Вывод, если заполнено
Функция ВыводЕслиЗаполнено(Преф="",Зн,Пост="")Экспорт
	Если не ЗначениеЗаполнено(Зн) Тогда Возврат "";
	Иначе Возврат Преф+" "+Зн+Пост;
	КонецЕсли;	
КонецФункции

// Возвращает срез массива по указанному номеру страницы для постраничной навигации
//
// Параметры:
//   МассивЭлементов - Массив из Произвольный
//   НомерЗапроса - Число - номер запрашиваемой страницы (начинается с 1)
//   МаксимальноеКоличествоЭлементов - Число - количество элементов в одном срезе
//
// Возвращаемое значение:
//   Массив из Произвольный - часть исходного массива в соответствии с указанным номером страницы
Функция СрезМассива(МассивЭлементов, НомерЗапроса, МаксимальноеКоличествоЭлементов = 500)Экспорт

	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(МассивЭлементов) Тогда
		МаксимальныйИндекс = МассивЭлементов.ВГраница();

		НачальныйИндекс = МаксимальноеКоличествоЭлементов * (НомерЗапроса - 1);
		КонечныйИндекс  = Мин(МаксимальноеКоличествоЭлементов * НомерЗапроса - 1, МаксимальныйИндекс);
		
		Если НачальныйИндекс <= МаксимальныйИндекс Тогда
			Индекс = НачальныйИндекс;
			Пока Индекс <= КонечныйИндекс Цикл
				Результат.Добавить(МассивЭлементов[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции    

Функция ДатаИзСтроки(Знач СтрокаДаты, ISO = Ложь) Экспорт
	
    Если ТипЗнч(СтрокаДаты) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;

	СтрокаДаты = СокрЛП(СтрокаДаты);
	Если ISO Тогда
		СтрокаДаты = СтрЗаменить(СтрокаДаты, "Z", "");
		СтрокаДаты = СтрЗаменить(СтрокаДаты, "T", "");
		СтрокаДаты = СтрЗаменить(СтрокаДаты, "-", "");
		СтрокаДаты = СтрЗаменить(СтрокаДаты, ":", "");
		СтрокаДаты = СтрЗаменить(СтрокаДаты, "+0300", "");
	КонецЕсли;
		
    Части = СтрРазделить(СтрокаДаты, " ", Истина);
    Если Части.Количество() < 1 Или Части.Количество() > 2 Тогда
        Возврат Неопределено;
    КонецЕсли;

    ЧастиДаты = СтрРазделить(Части[0], ".", Истина);
    Если ЧастиДаты.Количество() <> 3 Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Порядок: день, месяц, год, час, минута.
    Компоненты = ЧастиДаты;

    Если Части.Количество() = 2 Тогда
        ЧастиВремени = СтрРазделить(Части[1], ":", Истина);
        Если ЧастиВремени.Количество() <> 2 Тогда
            Возврат Неопределено;
        КонецЕсли;

        Компоненты.Добавить(ЧастиВремени[0]);
        Компоненты.Добавить(ЧастиВремени[1]);
    Иначе
        Компоненты.Добавить("0");
        Компоненты.Добавить("0");
    КонецЕсли;

    Для Индекс = 0 По Компоненты.Количество() - 1 Цикл
        Компонента = Компоненты[Индекс];
        Длина = СтрДлина(Компонента);

        // Год: 1–4 цифры, остальные компоненты: 1–2.
        МаксимальнаяДлина = ?(Индекс = 2, 4, 2);
        Если Длина < 1 Или Длина > МаксимальнаяДлина Тогда
            Возврат Неопределено;
        КонецЕсли;

        Для Позиция = 1 По Длина Цикл
            Если СтрНайти("0123456789",
                Сред(Компонента, Позиция, 1)) = 0 Тогда
                Возврат Неопределено;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    ДеньЧисло = Число(Компоненты[0]);
    МесяцЧисло = Число(Компоненты[1]);
    ГодЧисло = Число(Компоненты[2]);
    ЧасЧисло = Число(Компоненты[3]);
    МинутаЧисло = Число(Компоненты[4]);

    Если ГодЧисло < 1 Или ГодЧисло > 9999
        Или МесяцЧисло < 1 Или МесяцЧисло > 12
        Или ДеньЧисло < 1 Или ДеньЧисло > 31
        Или ЧасЧисло < 0 Или ЧасЧисло > 23
        Или МинутаЧисло < 0 Или МинутаЧисло > 59 Тогда
        Возврат Неопределено;
    КонецЕсли;

    ПоследнийДень = День(
        КонецМесяца(Дата(ГодЧисло, МесяцЧисло, 1)));

    Если ДеньЧисло > ПоследнийДень Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Дата(
        ГодЧисло, МесяцЧисло, ДеньЧисло,
        ЧасЧисло, МинутаЧисло, 0);

КонецФункции

// Преобразует строковое представление числа в числовое значение. Удаляет пробелы, символ процента и заменяет запятую на точку. 
// Если преобразование невозможно или строка не заполнена, возвращает 0.
//
// Параметры:
//   ЧислоСтрокой - Строка - строковое представление числа, может содержать пробелы, запятые или символ процента
//
// Возвращаемое значение:
//   Число - преобразованное числовое значение или 0 при ошибке преобразования
Функция ПреобразоватьВЧисло(ЧислоСтрокой) Экспорт
	Рез = ?(не ЗначениеЗаполнено(ЧислоСтрокой),"0",СокрЛП(ЧислоСтрокой));  
	Рез = СтрЗаменить(Рез,Символы.НПП,"");
	Рез = СтрЗаменить(Рез,"%","");
	Рез = СтрЗаменить(Рез,",",".");
	Попытка
		Возврат Число(Рез);
	Исключение
		Возврат 0;
	КонецПопытки;	
КонецФункции	

Функция ИмяСвойстваКорректно(Знач ИмяСвойства) Экспорт

   ВременнаяСтруктура = Новый Структура;
   Попытка
       ВременнаяСтруктура.Вставить(ИмяСвойства);
       Возврат Истина;
   Исключение
       Возврат Ложь;
   КонецПопытки;

КонецФункции

// Возвращает строку с наименованиями дней недели по строке с их номерами.
// Например, для "135" вернёт "Понедельник, Среда, Пятница".
//
// Параметры:
//  НомераДнейНедели - Строка - строка с номерами дней недели (1 - понедельник ... 7 - воскресенье),
//                     например "1,3,5" или "135". Все символы, кроме цифр, игнорируются.
//  Разделитель      - Строка - разделитель наименований в результате, по умолчанию ", ".
//
// Возвращаемое значение:
//  Строка - наименования дней недели, разделённые указанным разделителем.
//
Функция НаименованияДнейНедели(НомераДнейНедели, Разделитель = ", ") Экспорт
	
	Наименования = Новый Массив;
	Наименования.Добавить("Понедельник");
	Наименования.Добавить("Вторник");
	Наименования.Добавить("Среда");
	Наименования.Добавить("Четверг");
	Наименования.Добавить("Пятница");
	Наименования.Добавить("Суббота");
	Наименования.Добавить("Воскресенье");
	
	Результат = Новый Массив;
	Для Индекс = 1 По СтрДлина(НомераДнейНедели) Цикл
		Позиция = СтрНайти("1234567", Сред(НомераДнейНедели, Индекс, 1));
		Если Позиция > 0 Тогда
			Результат.Добавить(Наименования[Позиция - 1]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, Разделитель);
	
КонецФункции

// Возвращает строку, сокращенную до указанной длины.
//
// Параметры:
//   ДанныеДляСокращения - Строка - строка для сокращения
//						 - СписокЗначений - набор значений для сокращения   
//                       - Массив из Произвольный - значения для сокращения; при указании ПолеСтроки
//                         из каждого элемента извлекается значение этого поля
//                       - ДанныеФормыСтруктура - значения для сокращения; при указании ПолеСтроки
//                         из каждого элемента извлекается значение этого поля
//   Длина - Число - максимальная длина результирующей строки
//   ДобавлятьТочки - Булево - если Истина, к сокращенной строке добавляется многоточие "..."
//   ПолеСтроки - Строка - имя поля элемента массива, значение которого участвует в сокращении
//              - Неопределено - поле не указано
//
// Возвращаемое значение:
//   Строка - сокращенная строка или пустая строка, если тип ДанныеДляСокращения не поддерживается
Функция СократитьСтроку(ДанныеДляСокращения, Длина, ДобавлятьТочки = Истина, ПолеСтроки = Неопределено) Экспорт
	
	Если ТипЗнч(ДанныеДляСокращения) = Тип("Строка") Тогда
		КСокращению = ДанныеДляСокращения;
	ИначеЕсли ТипЗнч(ДанныеДляСокращения) = Тип("СписокЗначений") Тогда
		КСокращению = СтрСоединить(ДанныеДляСокращения.ВыгрузитьЗначения(), ",");
	ИначеЕсли ТипЗнч(ДанныеДляСокращения) = Тип("Массив") И ПолеСтроки = Неопределено Тогда
		КСокращению = СтрСоединить(ДанныеДляСокращения, ",");
	ИначеЕсли (ТипЗнч(ДанныеДляСокращения) = Тип("Массив") Или ТипЗнч(ДанныеДляСокращения) = Тип(
		"ДанныеФормыСтруктура")) И Не ПолеСтроки = Неопределено Тогда
		КСокращению = Новый Массив;
		Для Каждого ЭлементМассива Из ДанныеДляСокращения Цикл
			КСокращению.Добавить(ЭлементМассива[ПолеСтроки]);
		КонецЦикла;
		КСокращению = СтрСоединить(КСокращению, ", ");
	Иначе
		Возврат "";
	КонецЕсли;	
		
	Если СтрДлина(КСокращению) <= Длина Тогда 	
		Возврат КСокращению;
	Иначе
		Возврат Лев(КСокращению, Длина) + ?(ДобавлятьТочки,"...","");
	КонецЕсли;		
КонецФункции	
	
// Округляет число в соответствии с выбранным вариантом округления.
//
// Параметры:
//   Число - Число - исходное число.
//   ВариантОкругления - ПеречислениеСсылка.ВариантыОкругления - вариант округления:
//     ВнизДоЦелого                     - округление вниз до целого;
//     ВнизДоЦелогоИлиПоловины          - округление вниз до целого или половины (шаг 0,5);
//     ДоБлижайшегоЦелого               - округление до ближайшего целого;
//     ДоБлижайшегоЦелогоМатематическое - округление до ближайшего целого по математическим правилам;
//     ВнизДоДесятков                   - округление вниз до десятков;
//     ДоБлижайшегоДесятка              - округление до ближайшего десятка по математическим правилам;
//     ВнизДоСотен                      - округление вниз до сотен;
//     ДоБлижайшейСотни                 - округление до ближайшей сотни по математическим правилам;
//     ВнизДоТысяч                      - округление вниз до тысяч;
//     ДоБлижайшейТысячи                - округление до ближайшей тысячи по математическим правилам.
//
// Возвращаемое значение:
//   Число - округленное число.
//
Функция ОкруглитьЧисло(Знач Число, Знач ВариантОкругления) Экспорт
	
	Если ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ВнизДоЦелого") Тогда
		Результат = ОкруглитьВниз(Число, 0);
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ВнизДоЦелогоИлиПоловины") Тогда
		Результат = ОкруглитьВниз(Число * 2, 0) / 2;
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ДоБлижайшегоЦелого")
		Или ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ДоБлижайшегоЦелогоМатематическое") Тогда
		Результат = Окр(Число, 0, РежимОкругления.Окр15как20);
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ВнизДоДесятков") Тогда
		Результат = ОкруглитьВниз(Число, -1);
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ДоБлижайшегоДесятка") Тогда
		Результат = Окр(Число, -1, РежимОкругления.Окр15как20);
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ВнизДоСотен") Тогда
		Результат = ОкруглитьВниз(Число, -2);
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ДоБлижайшейСотни") Тогда
		Результат = Окр(Число, -2, РежимОкругления.Окр15как20);
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ВнизДоТысяч") Тогда
		Результат = ОкруглитьВниз(Число, -3);
	ИначеЕсли ВариантОкругления = ПредопределенноеЗначение("Перечисление.ВариантыОкругления.ДоБлижайшейТысячи") Тогда
		Результат = Окр(Число, -3, РежимОкругления.Окр15как20);
	Иначе
		Результат = Число;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Округляет число вниз (в сторону меньшего значения) до указанной разрядности.
//
// Параметры:
//   Число - Число - исходное число.
//   Разрядность - Число - разрядность округления; отрицательное значение -
//       округление до соответствующего разряда целой части.
//
// Возвращаемое значение:
//   Число - число, округленное вниз.
//
Функция ОкруглитьВниз(Знач Число, Знач Разрядность)
	
	Множитель = Pow(10, Разрядность);
	Масштабированное = Число * Множитель;
	ЦелаяЧасть = Цел(Масштабированное);
	Если Масштабированное < ЦелаяЧасть Тогда
		ЦелаяЧасть = ЦелаяЧасть - 1;
	КонецЕсли;
	
	Возврат ЦелаяЧасть / Множитель;
	
КонецФункции

