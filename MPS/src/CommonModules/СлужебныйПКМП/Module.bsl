#Область ГруппаДеньНеделиВремя

// Размещает на форме элементы выбора дней недели и временного диапазона срабатывания.У Объекта формы должны быть
// реквизиты - НеОграничиватьВремяСрабатывания,ВремяС,ВремяПо,ЧасовойПояс
//
// Параметры:
//   Форма - УправляемаяФорма - форма, на которой размещаются элементы
//   ГруппаРазмещения - Строка - имя группы формы, в которую добавляются элементы
//   ЭлементПеред - ЭлементФормы, Неопределено - элемент формы, перед которым вставляются новые элементы.
//                              Если Неопределено, элементы добавляются в конец группы
Процедура ДеньНеделиВремяПриСозданииФормы(Форма, ГруппаРазмещения = "ГруппаДеньНеделиВремя", ЭлементПеред = Неопределено) Экспорт
	
	НеОграничиватьВремяСрабатывания = УправлениеФормамиПКМП.НовоеПолеФлажка(Форма, "НеОграничиватьВремяСрабатывания", "Объект.НеОграничиватьВремяСрабатывания", ГруппаРазмещения, ЭлементПеред);
	НеОграничиватьВремяСрабатывания.УстановитьДействие("ПриИзменении","Подключаемая_НеОграничиватьВремяСрабатыванияПриИзменении");
	
	ГруппаВремя = УправлениеФормамиПКМП.НоваяГруппа(Форма, "ГруппаВремя", "",, ГруппаРазмещения, ЭлементПеред);	
	ГруппаВремя.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	УправлениеФормамиПКМП.НоваяДекорацияФормы(Форма, "ДекорацияВремя", "Сработать с ", ГруппаВремя);
	ПолеВремя = УправлениеФормамиПКМП.НовоеПолеВвода(Форма, "ВремяС", "Объект.ВремяС", ГруппаВремя);
	ПолеВремя.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	УстановитьСписокВыбораДляПоляВводаВремени(ПолеВремя);
	
	УправлениеФормамиПКМП.НоваяДекорацияФормы(Форма, "ДекорацияДо", " - ", ГруппаВремя);
	ПолеВремя = УправлениеФормамиПКМП.НовоеПолеВвода(Форма, "ВремяПо", "Объект.ВремяПо", ГруппаВремя);
	ПолеВремя.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	УстановитьСписокВыбораДляПоляВводаВремени(ПолеВремя);
	
	ЧасовойПояс = УправлениеФормамиПКМП.НовоеПолеВвода(Форма, "ЧасовойПояс", "Объект.ЧасовойПояс", ГруппаВремя);
	ЧасовойПояс.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	ЧасовойПояс.ПодсказкаВвода = Константы.ЧасовойПоясПоУмолчанию.Получить();
	
	УправлениеФормамиПКМП.НоваяКомандаФормы(Форма, "КомандаВыбратьВремя", "Выбрать время", ОтображениеКнопки.КартинкаИТекст, "Подключаемая_ВыбратьДеньНедели");
	
	ГруппаДеньНедели = УправлениеФормамиПКМП.НоваяГруппа(Форма, "ГруппаДеньНедели", "",, ГруппаРазмещения);	
	ГруппаДеньНедели.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	БазоваяДата = '00010101';
	
	Для ДеньНедели = 1 по 7 Цикл
		КнопкаДень = УправлениеФормамиПКМП.НоваяКнопкаФормы(Форма, "ДеньНедели" + ДеньНедели, ВидКнопкиФормы.ОбычнаяКнопка,  "КомандаВыбратьВремя", ГруппаДеньНедели);
		КнопкаДень.Заголовок = ТРег(Формат(БазоваяДата+(ДеньНедели+1) * 86400,"ДФ=ddd;"));
		КнопкаДень.Фигура = ФигураКнопки.Овал;
	КонецЦикла;	
	
КонецПроцедуры	

// Заполняет список выбора поля формы значениями времени с шагом 15 минут
// и настраивает режим выбора из списка.
//
// Параметры:
//   Элемент - ПолеФормы - поле формы, для которого заполняется список выбора времени
Процедура УстановитьСписокВыбораДляПоляВводаВремени(Элемент) Экспорт
	
	Для Час = 0 По 23 Цикл
		Для Минута = 0 По 3 Цикл
			Время = Дата(1, 1, 1, Час, Минута*15, 0);
			ВремяСтрока = Формат(Время, "ДФ=ЧЧ:мм; ДП=00:00;");
			Элемент.СписокВыбора.Добавить(Время, ВремяСтрока);
		КонецЦикла;
	КонецЦикла;
	
	Элемент.РежимВыбораИзСписка = Истина;
	Элемент.КнопкаВыпадающегоСписка = Истина;
	Элемент.Формат = "ДФ=HH:mm";
	Элемент.ФорматРедактирования = "ДФ=HH:mm";
КонецПроцедуры	

#КонецОбласти 



#Область ОбработкаСписковЗначений

Процедура СписокВыбораИзРеквизитовПоТипу(Элемент, ОбъектСсылка, ТипРеквизита) Экспорт
	
	МД = 	ОбъектСсылка.Метаданные();
	Если не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(МД, "Реквизиты") Тогда Возврат; КонецЕсли;
	
	Для каждого Реквизит из МД.Реквизиты Цикл
		Если Реквизит.Тип.Типы().Количество()=1 и Реквизит.Тип.Типы()[0] = ТипРеквизита Тогда
			Элемент.СписокВыбора.Добавить(Реквизит.Имя,Реквизит.Синоним);
		КонецЕсли;	
	КонецЦикла;	

	Если УправлениеСвойствамиСлужебный.ЭтоОбъектМетаданныхСоСвойствами(МД, "ДополнительныеРеквизиты") Тогда
		ИмяНабораДопРеквизитов = СтрЗаменить(МД.ПолноеИмя(),".","_");
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТ_Наборы
			|ИЗ
			|	Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
			|ГДЕ
			|	НаборыДополнительныхРеквизитовИСведений.Предопределенный
			|	И НаборыДополнительныхРеквизитовИСведений.ИмяПредопределенныхДанных = &ИмяНабораДопРеквизитов
			|	И НаборыДополнительныхРеквизитовИСведений.Используется
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка,
			|	ДополнительныеРеквизитыИСведения.Имя КАК Имя
			|ИЗ
			|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Наборы КАК ВТ_Наборы
			|		ПО ВТ_Наборы.Ссылка = ДополнительныеРеквизитыИСведения.НаборСвойств";
		
		Запрос.УстановитьПараметр("ИмяНабораДопРеквизитов", ИмяНабораДопРеквизитов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СсылкаСвойства = ВыборкаДетальныеЗаписи.Ссылка;
			Если СсылкаСвойства.ТипЗначения.Типы().Количество()=1 и СсылкаСвойства.ТипЗначения.Типы()[0] = ТипРеквизита Тогда
				//в начало имени добавлен "+" для разделения источника 
				Элемент.СписокВыбора.Добавить("+"+СсылкаСвойства.Имя,СсылкаСвойства.Наименование+"(доп.рекв)");
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	

// Склоняет представления элементов перечислений в списке значений по заданному числовому значению и падежу.
//
// Параметры:
//  Список - СписокЗначений - список значений, содержащий элементы перечислений, представления которых необходимо склонять.
//             Элемент списка:
//               * Значение - ПеречислениеСсылка - значение перечисления, для которого выполняется склонение.
//               * Представление - Строка - склоненное представление значения перечисления.
//  ЧисловоеЗначение - Число - числовое значение, определяющее форму склонения.
//  Падеж - Строка - код падежа для склонения (например, "Именительный", "Родительный").
Процедура СклонениеПредставленийПеречисленийВСпискеПоЧисловомуЗначению(Список, ЧисловоеЗначение, Падеж) Экспорт
	Для каждого ЭлементСписка из Список Цикл
		Если не Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЭлементСписка.Значение)) Тогда Продолжить; КонецЕсли;
		ЗначениеИсходное = ОбщегоНазначения.ИмяЗначенияПеречисления(ЭлементСписка.Значение);
		мсСклонений = ПолучитьСклоненияСтрокиПоЧислу(ЗначениеИсходное, ЧисловоеЗначение,,, "ПД="+Падеж);
		Если не мсСклонений.Количество()=0 Тогда
			ЭлементСписка.Представление = мсСклонений[0];
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ДобавитьСтрокуГруппыСписка(Список, НазваниеГруппы) Экспорт
	Список.Добавить("ЭтоГруппа", Новый ФорматированнаяСтрока(НазваниеГруппы, Новый Шрифт(, 11, Истина, Истина)), , БиблиотекаКартинок.Группировка);
КонецПроцедуры
#КонецОбласти


#Область РаботаСОтборамиКомпоновкиДанных
// Проверяет корректность состава отбора компоновки данных.
//
// Параметры:
//  Настройки   - НастройкиКомпоновкиДанных - настройки компоновки данных.
//  Ошибки  - Массив из Строка       - (необязательный) массив, в который добавляются
//                                     описания нарушений. Если не передан, ошибки
//                                     выводятся через СообщениеПользователю.
//
// Возвращаемое значение:
//  Булево - Истина, если отбор заполнен корректно, иначе Ложь.
//
Функция ПроверитьОтборКомпоновки(Настройки, Ошибки = Неопределено) Экспорт

	Результат = Истина;
	
	Отбор = Настройки.Отбор;
	ДоступныеПоляОтбора = Настройки.ДоступныеПоляОтбора;
	ТаблицаПредставлений = Новый Соответствие;
	
	Если Отбор = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Отбор не определен.'");
		ДобавитьОшибку(Ошибки, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если Не ПроверитьЭлементОтбора(Элемент, "", Ошибки, ДоступныеПоляОтбора) Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции


Функция ПолучитьЗаголовокЭлементаОтбора(ЭлементОтбора, ДоступныеПоляОтбора)
	ИмяПоля = Строка(ЭлементОтбора.ЛевоеЗначение);
	МассивЧастейИмени = СтрРазделить(ИмяПоля,".",Ложь);
	НакопительноеИмя = "";
	Для каждого ЧастьИмени из МассивЧастейИмени Цикл
		НакопительноеИмя = НакопительноеИмя + ЧастьИмени + ".";
		
	КонецЦикла;	
КонецФункции	

Процедура ПолучитьЗаголовкиЭлементов(Элементы, ТаблицаПредставлений)
	Для каждого Элемент из Элементы Цикл
		ТаблицаПредставлений.Вставить(Элемент.Поле,Элемент.Заголовок);
		ПолучитьЗаголовкиЭлементов(Элемент.Элементы,ТаблицаПредставлений);
	КонецЦикла;	
КонецПроцедуры	

Функция ПроверитьЭлементОтбора(Элемент, Знач Путь, Ошибки, ДоступныеПоляОтбора)

	Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		Возврат ПроверитьГруппуОтбора(Элемент, Путь, Ошибки, ДоступныеПоляОтбора);
	ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
		Возврат ПроверитьОбычныйЭлементОтбора(Элемент, Путь, Ошибки, ДоступныеПоляОтбора);
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

Функция ПроверитьГруппуОтбора(Группа, Путь, Ошибки, ДоступныеПоляОтбора)

	ИмяГруппы = ?(ПустаяСтрока(Группа.Представление), "<группа>", Группа.Представление);
	ПутьГруппы = ?(ПустаяСтрока(Путь), ИмяГруппы, Путь + " / " + ИмяГруппы);

	Если Не ЭтоДопустимыйТипГруппы(Группа.ТипГруппы) Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Группа отбора ""%1"" имеет некорректный тип группы: %2 (ожидается И, ИЛИ или НЕ).'"),
			ПутьГруппы, Строка(Группа.ТипГруппы));
		ДобавитьОшибку(Ошибки, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	Если Группа.Элементы.Количество() = 0 Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Группа отбора ""%1"" (тип %2) не содержит элементов.'"),
			ПутьГруппы, Строка(Группа.ТипГруппы));
		ДобавитьОшибку(Ошибки, ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;

	Результат = Истина;
	Для Каждого ВложенныйЭлемент Из Группа.Элементы Цикл
		Если Не ПроверитьЭлементОтбора(ВложенныйЭлемент, ПутьГруппы, Ошибки, ДоступныеПоляОтбора) Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоДопустимыйТипГруппы(ТипГруппы)

	Возврат ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ
		ИЛИ ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли
		ИЛИ ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе;

КонецФункции


Функция ПроверитьОбычныйЭлементОтбора(Элемент, Путь, Ошибки, ДоступныеПоляОтбора)

	Результат = Истина;

	
	ДоступноеПолеОтбора = ДоступныеПоляОтбора.НайтиПоле(Элемент.ЛевоеЗначение);
	Если ДоступноеПолеОтбора = Неопределено Тогда
		ЛевоеЗначениеТекст = Строка(Элемент.ЛевоеЗначение);
		ИмяЭлемента = ?(ПустаяСтрока(ЛевоеЗначениеТекст), "<без имени>", ЛевоеЗначениеТекст);
		ПредставлениеЭлемента = ?(ПустаяСтрока(Путь), ИмяЭлемента, Путь + " / " + ИмяЭлемента);
	Иначе
		ПредставлениеЭлемента = 	ДоступноеПолеОтбора.Заголовок;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Элемент.ЛевоеЗначение)  Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Не заполнено поле отбора в элементе отбора ""%1"".'"),
			ПредставлениеЭлемента);
		ДобавитьОшибку(Ошибки, ТекстОшибки);
		Результат = Ложь;
	КонецЕсли;

	Если Элемент.ВидСравнения = Неопределено Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Не заполнен вид сравнения в элементе отбора ""%1"".'"),
			ПредставлениеЭлемента);
		ДобавитьОшибку(Ошибки, ТекстОшибки);
		Результат = Ложь;
	КонецЕсли;

	Если Не ПравоеЗначениеЗаполненоКорректно(Элемент) Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Некорректно заполнено значение отбора в элементе отбора ""%1"" (вид сравнения: %2).'"),
			ПредставлениеЭлемента, Строка(Элемент.ВидСравнения));
		ДобавитьОшибку(Ошибки, ТекстОшибки);
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПравоеЗначениеЗаполненоКорректно(Элемент)

	ВидСравненияОтбора = Элемент.ВидСравнения;

	// Для унарных видов сравнения правое значение не требуется.
	Если ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Заполнено
		ИЛИ ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Возврат Истина;
	КонецЕсли;

	// Для списочных видов сравнения ожидается непустой СписокЗначений.
	Если ЭтоСписочныйВидСравнения(ВидСравненияОтбора) Тогда
		Возврат ПравоеЗначениеЯвляетсяНепустымСписком(Элемент);
	КонецЕсли;

	// Для остальных видов сравнения правое значение должно быть заполнено.
	Возврат Элемент.ПравоеЗначение <> Неопределено И ЗначениеЗаполнено(Элемент.ПравоеЗначение);

КонецФункции

Функция ЭтоСписочныйВидСравнения(ВидСравненияОтбора)

	Возврат ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСписке
		ИЛИ ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеВСписке
		ИЛИ ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
		ИЛИ ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии;

КонецФункции

Функция ПравоеЗначениеЯвляетсяНепустымСписком(Элемент)

	Возврат ТипЗнч(Элемент.ПравоеЗначение) = Тип("СписокЗначений")
		И Элемент.ПравоеЗначение.Количество() > 0;

КонецФункции

Процедура ДобавитьОшибку(Ошибки, ТекстОшибки)

	Если Ошибки = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
	Иначе
		Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

