#Область ГруппаДеньНеделиВремя

// Размещает на форме элементы выбора дней недели и временного диапазона срабатывания.У Объекта формы должны быть
// реквизиты - НеОграничиватьВремяСрабатывания,ВремяС,ВремяПо,ЧасовойПояс
//
// Параметры:
//   Форма - УправляемаяФорма - форма, на которой размещаются элементы
//   ГруппаРазмещения - Строка - имя группы формы, в которую добавляются элементы
//   ЭлементПеред - ЭлементФормы, Неопределено - элемент формы, перед которым вставляются новые элементы.
//                              Если Неопределено, элементы добавляются в конец группы
Процедура ДеньНеделиВремяПриСозданииФормы(Форма, ГруппаРазмещения = "ГруппаДеньНеделиВремя", ЭлементПеред = Неопределено) Экспорт
	
	НеОграничиватьВремяСрабатывания = УправлениеФормамиПКМП.НовоеПолеФлажка(Форма, "НеОграничиватьВремяСрабатывания", "Объект.НеОграничиватьВремяСрабатывания", ГруппаРазмещения, ЭлементПеред);
	НеОграничиватьВремяСрабатывания.УстановитьДействие("ПриИзменении","Подключаемая_НеОграничиватьВремяСрабатыванияПриИзменении");
	
	ГруппаВремя = УправлениеФормамиПКМП.НоваяГруппа(Форма, "ГруппаВремя", "",, ГруппаРазмещения, ЭлементПеред);	
	ГруппаВремя.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	УправлениеФормамиПКМП.НоваяДекорацияФормы(Форма, "ДекорацияВремя", "Сработать с ", ГруппаВремя);
	ПолеВремя = УправлениеФормамиПКМП.НовоеПолеВвода(Форма, "ВремяС", "Объект.ВремяС", ГруппаВремя);
	ПолеВремя.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	УстановитьСписокВыбораДляПоляВводаВремени(ПолеВремя);
	
	УправлениеФормамиПКМП.НоваяДекорацияФормы(Форма, "ДекорацияДо", " - ", ГруппаВремя);
	ПолеВремя = УправлениеФормамиПКМП.НовоеПолеВвода(Форма, "ВремяПо", "Объект.ВремяПо", ГруппаВремя);
	ПолеВремя.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	УстановитьСписокВыбораДляПоляВводаВремени(ПолеВремя);
	
	ЧасовойПояс = УправлениеФормамиПКМП.НовоеПолеВвода(Форма, "ЧасовойПояс", "Объект.ЧасовойПояс", ГруппаВремя);
	ЧасовойПояс.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	ЧасовойПояс.ПодсказкаВвода = Константы.ЧасовойПоясПоУмолчанию.Получить();
	
	УправлениеФормамиПКМП.НоваяКомандаФормы(Форма, "КомандаВыбратьВремя", "Выбрать время", ОтображениеКнопки.КартинкаИТекст, "Подключаемая_ВыбратьДеньНедели");
	
	ГруппаДеньНедели = УправлениеФормамиПКМП.НоваяГруппа(Форма, "ГруппаДеньНедели", "",, ГруппаРазмещения);	
	ГруппаДеньНедели.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	БазоваяДата = '00010101';
	
	Для ДеньНедели = 1 по 7 Цикл
		КнопкаДень = УправлениеФормамиПКМП.НоваяКнопкаФормы(Форма, "ДеньНедели" + ДеньНедели, ВидКнопкиФормы.ОбычнаяКнопка,  "КомандаВыбратьВремя", ГруппаДеньНедели);
		КнопкаДень.Заголовок = ТРег(Формат(БазоваяДата+(ДеньНедели+1) * 86400,"ДФ=ddd;"));
		КнопкаДень.Фигура = ФигураКнопки.Овал;
	КонецЦикла;	
	
КонецПроцедуры	

// Заполняет список выбора поля формы значениями времени с шагом 15 минут
// и настраивает режим выбора из списка.
//
// Параметры:
//   Элемент - ПолеФормы - поле формы, для которого заполняется список выбора времени
Процедура УстановитьСписокВыбораДляПоляВводаВремени(Элемент) Экспорт
	
	Для Час = 0 По 23 Цикл
		Для Минута = 0 По 3 Цикл
			Время = Дата(1, 1, 1, Час, Минута*15, 0);
			ВремяСтрока = Формат(Время, "ДФ=ЧЧ:мм; ДП=00:00;");
			Элемент.СписокВыбора.Добавить(Время, ВремяСтрока);
		КонецЦикла;
	КонецЦикла;
	
	Элемент.РежимВыбораИзСписка = Истина;
	Элемент.КнопкаВыпадающегоСписка = Истина;
	Элемент.Формат = "ДФ=HH:mm";
	Элемент.ФорматРедактирования = "ДФ=HH:mm";
КонецПроцедуры	

#КонецОбласти 



#Область ОбработкаСписковЗначений

Процедура СписокВыбораИзРеквизитовПоТипу(Элемент, ОбъектСсылка, ТипРеквизита) Экспорт
	
	МД = 	ОбъектСсылка.Метаданные();
	Если не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(МД, "Реквизиты") Тогда Возврат; КонецЕсли;
	
	Для каждого Реквизит из МД.Реквизиты Цикл
		Если Реквизит.Тип.Типы().Количество()=1 и Реквизит.Тип.Типы()[0] = ТипРеквизита Тогда
			Элемент.СписокВыбора.Добавить(Реквизит.Имя,Реквизит.Синоним);
		КонецЕсли;	
	КонецЦикла;	

	Если УправлениеСвойствамиСлужебный.ЭтоОбъектМетаданныхСоСвойствами(МД, "ДополнительныеРеквизиты") Тогда
		ИмяНабораДопРеквизитов = СтрЗаменить(МД.ПолноеИмя(),".","_");
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТ_Наборы
			|ИЗ
			|	Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
			|ГДЕ
			|	НаборыДополнительныхРеквизитовИСведений.Предопределенный
			|	И НаборыДополнительныхРеквизитовИСведений.ИмяПредопределенныхДанных = &ИмяНабораДопРеквизитов
			|	И НаборыДополнительныхРеквизитовИСведений.Используется
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка,
			|	ДополнительныеРеквизитыИСведения.Имя КАК Имя
			|ИЗ
			|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Наборы КАК ВТ_Наборы
			|		ПО ВТ_Наборы.Ссылка = ДополнительныеРеквизитыИСведения.НаборСвойств";
		
		Запрос.УстановитьПараметр("ИмяНабораДопРеквизитов", ИмяНабораДопРеквизитов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СсылкаСвойства = ВыборкаДетальныеЗаписи.Ссылка;
			Если СсылкаСвойства.ТипЗначения.Типы().Количество()=1 и СсылкаСвойства.ТипЗначения.Типы()[0] = ТипРеквизита Тогда
				//в начало имени добавлен "+" для разделения источника 
				Элемент.СписокВыбора.Добавить("+"+СсылкаСвойства.Имя,СсылкаСвойства.Наименование+"(доп.рекв)");
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	

// Склоняет представления элементов перечислений в списке значений по заданному числовому значению и падежу.
//
// Параметры:
//  Список - СписокЗначений - список значений, содержащий элементы перечислений, представления которых необходимо склонять.
//             Элемент списка:
//               * Значение - ПеречислениеСсылка - значение перечисления, для которого выполняется склонение.
//               * Представление - Строка - склоненное представление значения перечисления.
//  ЧисловоеЗначение - Число - числовое значение, определяющее форму склонения.
//  Падеж - Строка - код падежа для склонения (например, "Именительный", "Родительный").
Процедура СклонениеПредставленийПеречисленийВСпискеПоЧисловомуЗначению(Список, ЧисловоеЗначение, Падеж) Экспорт
	Для каждого ЭлементСписка из Список Цикл
		Если не Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЭлементСписка.Значение)) Тогда Продолжить; КонецЕсли;
		ЗначениеИсходное = ОбщегоНазначения.ИмяЗначенияПеречисления(ЭлементСписка.Значение);
		мсСклонений = ПолучитьСклоненияСтрокиПоЧислу(ЗначениеИсходное, ЧисловоеЗначение,,, "ПД="+Падеж);
		Если не мсСклонений.Количество()=0 Тогда
			ЭлементСписка.Представление = мсСклонений[0];
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ДобавитьСтрокуГруппыСписка(Список, НазваниеГруппы) Экспорт
	Список.Добавить("ЭтоГруппа", Новый ФорматированнаяСтрока(НазваниеГруппы, Новый Шрифт(, 11, Истина, Истина)), , БиблиотекаКартинок.Группировка);
КонецПроцедуры
#КонецОбласти


#Область ОписаниеОтбора
// Формирует дерево значений со строковым описанием отбора компоновки данных.
// Группы условий (И, ИЛИ, НЕ) становятся родительскими узлами, вложенные элементы
// располагаются в подчиненных строках.
//
// Параметры:
//  ОтборКомпоновки - ОтборКомпоновкиДанных - отбор для анализа.
//
// Возвращаемое значение:
//  ДеревоЗначений - дерево с колонками:
//    * Представление - Строка - представление элемента или группы;
//    * Условие       - Строка - вид сравнения или тип группы;
//    * Значение      - Строка - правое значение, диапазон значений или пустая строка.
//
Функция ОписаниеОтбораВДерево(ОтборКомпоновки) Экспорт
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Условие", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	
	Корень = Дерево.Строки.Добавить();
	Корень.Представление = НСтр("ru = 'Отбор'");
	Корень.Условие = "";
	Корень.Значение = "";
	
	Если ОтборКомпоновки <> Неопределено Тогда
		ЗаполнитьДеревоЭлементамиОтбора(ОтборКомпоновки.Элементы, Корень.Строки);
	КонецЕсли;
	
	Возврат Дерево;
	
КонецФункции

Процедура ЗаполнитьДеревоЭлементамиОтбора(КоллекцияЭлементов, СтрокиДерева)
	
	Для Каждого Элемент Из КоллекцияЭлементов Цикл
		НоваяСтрока = СтрокиДерева.Добавить();
		НоваяСтрока.Представление = ПредставлениеЭлементаОтбора(Элемент);
		НоваяСтрока.Условие = УсловиеЭлементаОтбора(Элемент);
		НоваяСтрока.Значение = ЗначениеЭлементаОтбора(Элемент);
		НоваяСтрока.ЭтоГруппа = Ложь;
		
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НоваяСтрока.ЭтоГруппа = Истина;
			ЗаполнитьДеревоЭлементамиОтбора(Элемент.Элементы, НоваяСтрока.Строки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеЭлементаОтбора(Элемент)
	
	Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		Представление = ?(ПустаяСтрока(Элемент.Представление),
			"",
			" - " + Элемент.Представление);
		Возврат ТипГруппыВПредставление(Элемент.ТипГруппы) + Представление;
	КонецЕсли;
	
	Возврат ?(ПустаяСтрока(Элемент.Представление),
		Строка(Элемент.ЛевоеЗначение),
		Элемент.Представление);
	
КонецФункции

Функция УсловиеЭлементаОтбора(Элемент)
	
	Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		Возврат "Группа условий";
	КонецЕсли;
	
	Возврат ВидСравненияВПредставление(Элемент.ВидСравнения);
	
КонецФункции

Функция ЗначениеЭлементаОтбора(Элемент)
	
	Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		Возврат "";
	КонецЕсли;
	
	ВидСравненияЭлемента = Элемент.ВидСравнения;
	
	Если ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.Заполнено
		ИЛИ ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.ВСписке
		ИЛИ ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.НеВСписке
		ИЛИ ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
		ИЛИ ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
		Возврат СписокЗначенийВСтроку(Элемент.ПравоеЗначение);
	КонецЕсли;
	
	Если ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.Больше
		ИЛИ ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.БольшеИлиРавно
		ИЛИ ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.Меньше
		ИЛИ ВидСравненияЭлемента = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
		Возврат ДиапазонВСтроку(Элемент.ПравоеЗначения);
	КонецЕсли;
	
	Возврат Строка(Элемент.ПравоеЗначение);
	
КонецФункции

Функция ТипГруппыВПредставление(ТипГруппы)
	
	Если ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ Тогда
		Возврат "И";
	ИначеЕсли ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли Тогда
		Возврат "ИЛИ";
	ИначеЕсли ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда
		Возврат "НЕ";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ВидСравненияВПредставление(ВидСравнения)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.Равно, "=");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеРавно, "<>");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.Больше, ">");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.БольшеИлиРавно, ">=");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.Меньше, "<");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, "<=");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.ВСписке, "В списке");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеВСписке, "Не в списке");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии, "В списке по иерархии");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии, "Не в списке по иерархии");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.ВИерархии, "В иерархии");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеВИерархии, "Не в иерархии");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.Содержит, "Содержит");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеСодержит, "Не содержит");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НачинаетсяС, "Начинается с");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеНачинаетсяС, "Не начинается с");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.Подобно, "Подобно");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеПодобно, "Не подобно");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.Заполнено, "Заполнено");
	Соответствие.Вставить(ВидСравненияКомпоновкиДанных.НеЗаполнено, "Не заполнено");
	
	Результат = Соответствие.Получить(ВидСравнения);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	Иначе
		Возврат Строка(ВидСравнения);
	КонецЕсли;
	
КонецФункции

Функция СписокЗначенийВСтроку(СписокЗначений)
	
	Если СписокЗначений = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = "";
	Для Каждого ЭлементСписка Из СписокЗначений Цикл
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ", ";
		КонецЕсли;
		Результат = Результат + Строка(ЭлементСписка.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДиапазонВСтроку(Значение)
	
	Если ТипЗнч(Значение) = Тип("СтандартныйПериод") Тогда
		Если ЗначениеЗаполнено(Значение.ДатаНачала) И ЗначениеЗаполнено(Значение.ДатаОкончания) Тогда
			Возврат Строка(Значение.ДатаНачала) + " - " + Строка(Значение.ДатаОкончания);
		ИначеЕсли ЗначениеЗаполнено(Значение.ДатаНачала) Тогда
			Возврат НСтр("ru = 'от '") + Строка(Значение.ДатаНачала);
		ИначеЕсли ЗначениеЗаполнено(Значение.ДатаОкончания) Тогда
			Возврат НСтр("ru = 'до '") + Строка(Значение.ДатаОкончания);
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции
#КонецОбласти

