// Предварительная проверка маршрутизации. Никаких прикладных побочных эффектов.
// Причина — внутренний код, не JSON status и не согласованная ошибка Mindbox.
Функция ПроверитьОперацию(ИмяОперации, Маршрут, Канал) Экспорт
    Если ТипЗнч(ИмяОперации) <> Тип("Строка") Тогда
        Возврат "UnknownOperation";
    КонецЕсли;
    Реестр = РеестрОпераций();
    Описание = Реестр.Получить(ИмяОперации);
    Если Описание = Неопределено Тогда
        Возврат "UnknownOperation";
    КонецЕсли;
    Если Описание.Маршрут <> Маршрут Тогда
        Возврат "WrongTransport";
    КонецЕсли;
    Если Канал <> "Web" И Канал <> "Android" И Канал <> "iOS" Тогда
        Возврат "ChannelDenied";
    КонецЕсли;
    // Разрешение конкретных операций по каналам появится после аудита call sites.
    Возврат "NotImplemented";
КонецФункции
