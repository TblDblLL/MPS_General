// Серверный модуль. Нет вызовов PHP, промежуточного сервиса 1С или внешних процессов.
#Область ДоступИНастройки
// Проверяет административное право перед доступом к настройкам и назначением среды.
//
// При отсутствии права вызывает исключение; привилегированный режим не включает.
//
Процедура ПроверитьАдминистратора()
    Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
        ВызватьИсключение "Push: требуются административные права";
    КонецЕсли;
КонецПроцедуры

// Удаляет только push-настройки выбранного приложения и окружения из безопасного хранилища.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//
// Требует административных прав. Восстанавливает прежний привилегированный режим даже при ошибке.
//
Процедура УдалитьНастройкиПровайдера(Приложение, Окружение) Экспорт
    ПроверитьАдминистратора();
    Ключ = КлючНастроек(Приложение, Окружение);
    ПредыдущийРежим = ПривилегированныйРежим();
    Попытка
        УстановитьПривилегированныйРежим(Истина);
        ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Приложение, Ключ + "," + Ключ + "_JWT");
        УстановитьПривилегированныйРежим(ПредыдущийРежим);
    Исключение
        УстановитьПривилегированныйРежим(ПредыдущийРежим);
        ВызватьИсключение "Push: не удалось удалить настройки провайдера";
    КонецПопытки;
КонецПроцедуры

// Определяет транспорт по типу мобильного приложения.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//
// Возвращаемое значение:
//  Строка - fcm для Андроид либо apns для Эппл.
//
// Пустое приложение и неизвестный тип вызывают исключение.
//
Функция ПровайдерПриложения(Приложение)
    Если Не ЗначениеЗаполнено(Приложение) Тогда
        ВызватьИсключение "Push: не выбрано приложение";
    КонецЕсли;
    Если Приложение.ТипМобильногоПриложения = Перечисления.ТипыМобильныхПриложений.Андроид Тогда
        Возврат "fcm";
    ИначеЕсли Приложение.ТипМобильногоПриложения = Перечисления.ТипыМобильныхПриложений.Эппл Тогда
        Возврат "apns";
    КонецЕсли;
    ВызватьИсключение "Push: неизвестный тип приложения";
КонецФункции

// Проверяет, указано ли допустимое явное окружение APNs.
//
// Параметры:
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//
// Возвращаемое значение:
//  Булево - Истина только для Sandbox и Production; пустая ссылка и НеОпределено не допускаются.
//
Функция ИзвестноеОкружение(Окружение)
    Возврат Окружение = Перечисления.ОкруженияAPNsПКМП.Sandbox
        Или Окружение = Перечисления.ОкруженияAPNsПКМП.Production;
КонецФункции

// Формирует изолированный ключ push-настроек в безопасном хранилище.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//
// Возвращаемое значение:
//  Строка - Ключ с префиксом PushПКМП, провайдером и, для APNs, окружением.
//
// Ключи SMS не затрагиваются; для APNs обязательно известное окружение.
//
Функция КлючНастроек(Приложение, Окружение)
    Провайдер = ПровайдерПриложения(Приложение);
    Если Провайдер = "fcm" Тогда
        Возврат "PushПКМП_FCM";
    КонецЕсли;
    Если Не ИзвестноеОкружение(Окружение) Тогда
        ВызватьИсключение "Push: окружение APNs не определено";
    КонецЕсли;
    Если Окружение = Перечисления.ОкруженияAPNsПКМП.Sandbox Тогда
        Возврат "PushПКМП_APNs_Sandbox";
    КонецЕсли;
    Возврат "PushПКМП_APNs_Production";
КонецФункции

// Создаёт новую структуру настроек провайдера с отключённой отправкой.
//
// Возвращаемое значение:
//  Структура - ОтправкаВключена = Ложь; идентификатор, логин, пароль и токен — пустые строки.
//
Функция ПустыеНастройки()
    Возврат Новый Структура("ОтправкаВключена,ИдентификаторПриложения,Логин,Пароль,Токен,TeamID,KeyID",
        Ложь, "", "", "", "", "", "");
КонецФункции

// Читает серверные настройки и настоящие секреты провайдера из безопасного хранилища.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//
// Возвращаемое значение:
//  Структура - Сохранённые настройки либо значения по умолчанию, если запись отсутствует.
//
// Внутренний серверный метод. Восстанавливает привилегированный режим; не передаёт секреты на клиент.
//
Функция ПрочитатьДоступ(Приложение, Окружение)
    Ключ = КлючНастроек(Приложение, Окружение);
    ПредыдущийРежим = ПривилегированныйРежим();
    Попытка
        УстановитьПривилегированныйРежим(Истина);
        Данные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Приложение, Ключ);
        УстановитьПривилегированныйРежим(ПредыдущийРежим);
    Исключение
        УстановитьПривилегированныйРежим(ПредыдущийРежим);
        ВызватьИсключение "Push: не удалось прочитать безопасные настройки";
    КонецПопытки;
    НастройкиДоступа = ПустыеНастройки();
    Если ТипЗнч(Данные) = Тип("Структура") Тогда
        ЗаполнитьЗначенияСвойств(НастройкиДоступа, Данные);
    КонецЕсли;
    Возврат НастройкиДоступа;
КонецФункции

// Возвращает настройки провайдера администратору с необязательным маскированием секретов.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//  УИДФормыНастроек - Строка, УникальныйИдентификатор, Неопределено - При передаче заменяет непустые пароль и токен маркером перед возвратом в форму.
//
// Возвращаемое значение:
//  Структура - Настройки доступа; без маркера возвращаются настоящие секреты для серверного использования.
//
// Требует административных прав. Не возвращать результат без маскирования в клиентские HTTP-ответы.
//
Функция ПолучитьНастройкиПровайдера(Приложение, Окружение, УИДФормыНастроек = Неопределено) Экспорт
    ПроверитьАдминистратора();
    НастройкиПровайдера = ПрочитатьДоступ(Приложение, Окружение);
    Если УИДФормыНастроек <> Неопределено Тогда
        Если Не ПустаяСтрока(НастройкиПровайдера.Пароль) Тогда НастройкиПровайдера.Пароль = Строка(УИДФормыНастроек); КонецЕсли;
        Если Не ПустаяСтрока(НастройкиПровайдера.Токен) Тогда НастройкиПровайдера.Токен = Строка(УИДФормыНастроек); КонецЕсли;
    КонецЕсли;
    Возврат НастройкиПровайдера;
КонецФункции

// Сохраняет настройки провайдера, оставляя прежние секреты при пустом вводе или маркере формы.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//  УИДФормыНастроек - Строка, УникальныйИдентификатор, Неопределено - Маркер формы; совпавший маркер сохраняет прежний секрет.
//  Настройки - Структура - ОтправкаВключена, ИдентификаторПриложения, Логин, Пароль, Токен, TeamID и KeyID.
//
// Требует административных прав. При включении проверяет доступ; входную структуру не изменяет.
//
Процедура ЗаписатьНастройкиПровайдера(Приложение, Окружение, УИДФормыНастроек, Настройки) Экспорт
    ПроверитьАдминистратора();
    Ключ = КлючНастроек(Приложение, Окружение);
    СохраняемыеНастройки = ПрочитатьДоступ(Приложение, Окружение);
    СохраняемыеНастройки.ОтправкаВключена = Настройки.ОтправкаВключена;
    СохраняемыеНастройки.ИдентификаторПриложения = СокрЛП(Настройки.ИдентификаторПриложения);
    СохраняемыеНастройки.Логин = Настройки.Логин;
    Если Настройки.Свойство("TeamID") Тогда СохраняемыеНастройки.TeamID = СокрЛП(Настройки.TeamID); КонецЕсли;
    Если Настройки.Свойство("KeyID") Тогда СохраняемыеНастройки.KeyID = СокрЛП(Настройки.KeyID); КонецЕсли;
    Для Каждого Имя Из СтрРазделить("Пароль,Токен", ",") Цикл
        Если УИДФормыНастроек = Неопределено Или Настройки[Имя] <> Строка(УИДФормыНастроек) Тогда
            // Пустой ввод сохраняет секрет. Явное удаление доступа — отдельный административный вызов.
            Если Не ПустаяСтрока(Настройки[Имя]) Тогда СохраняемыеНастройки[Имя] = Настройки[Имя]; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если СохраняемыеНастройки.ОтправкаВключена Тогда ПроверитьДоступ(Приложение, Окружение, СохраняемыеНастройки); КонецЕсли;
    ПредыдущийРежим = ПривилегированныйРежим();
    Попытка
        УстановитьПривилегированныйРежим(Истина);
        ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Приложение, СохраняемыеНастройки, Ключ);
        УстановитьПривилегированныйРежим(ПредыдущийРежим);
    Исключение
        УстановитьПривилегированныйРежим(ПредыдущийРежим);
        ВызватьИсключение "Push: не удалось сохранить безопасные настройки";
    КонецПопытки;
КонецПроцедуры

// Проверяет формат и согласованность доступа до обращения к провайдеру.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//  НастройкиДоступа - Структура - ОтправкаВключена, ИдентификаторПриложения, Логин, Пароль, Токен, TeamID и KeyID.
//  ПроверятьПодпись - Булево - Проверять ключ криптографически при сохранении; обработчик очереди использует кеш.
//
// Для FCM проверяет JSON и project ID, для APNs — Team ID, Key ID и подпись ключом .p8. Сеть не вызывает и криптографическую действительность сертификата не подтверждает.
//
Процедура ПроверитьДоступ(Приложение, Окружение, НастройкиДоступа, ПроверятьПодпись = Истина)
    Если ПустаяСтрока(НастройкиДоступа.ИдентификаторПриложения) Или ПустаяСтрока(НастройкиДоступа.Токен) Тогда
        ВызватьИсключение "Push: не заполнен доступ провайдера";
    КонецЕсли;
    Если ПровайдерПриложения(Приложение) = "fcm" Тогда
        Попытка
            ДанныеСервиснойУчетнойЗаписи = ИзJSON(НастройкиДоступа.Токен);
            Если ДанныеСервиснойУчетнойЗаписи["type"] <> "service_account" Или ПустаяСтрока(ДанныеСервиснойУчетнойЗаписи["private_key"])
                Или ПустаяСтрока(ДанныеСервиснойУчетнойЗаписи["client_email"]) Или ДанныеСервиснойУчетнойЗаписи["project_id"] <> НастройкиДоступа.ИдентификаторПриложения Тогда
                ВызватьИсключение "invalid";
            КонецЕсли;
        Исключение
            ВызватьИсключение "Push: требуется JSON сервисной учётной записи выбранного Firebase project ID";
        КонецПопытки;
    Иначе
        Если Не ИзвестноеОкружение(Окружение) Тогда
            ВызватьИсключение "Push: окружение APNs не определено";
        КонецЕсли;
        // Содержимое ключа проверяется штатной подписью, без сети и временных файлов.
        ПроверитьФорматДоступаAPNs(НастройкиДоступа);
        Если ПроверятьПодпись Тогда СформироватьJWTAPNs(НастройкиДоступа, ТекущаяУниверсальнаяДата()); КонецЕсли;
    КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область Устройства
// Вычисляет SHA-256 строки в кодировке UTF-8.
//
// Параметры:
//  Значение - Строка - Токен или сериализованные данные для проверки неизменности.
//
// Возвращаемое значение:
//  Строка - 64 шестнадцатеричных символа нижнего регистра.
//
// Отпечаток не является аутентификацией и не должен попадать в диагностические логи.
//
Функция Отпечаток(Значение)
    Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Значение, КодировкаТекста.UTF8));
    Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

// Устанавливает управляемую блокировку записи регистра в текущей транзакции.
//
// Параметры:
//  ИмяРегистра - Строка - Имя регистра сведений без префикса РегистрСведений.
//  Поля - Структура - Имена измерений и значения ключа блокировки.
//
// Вызывающий код обязан открыть транзакцию и завершить её после работы с записью.
//
Процедура Блокировать(ИмяРегистра, Поля)
    Блокировка = Новый БлокировкаДанных;
    ЭлементБлокировки = Блокировка.Добавить("РегистрСведений." + ИмяРегистра);
    Для Каждого ПолеБлокировки Из Поля Цикл ЭлементБлокировки.УстановитьЗначение(ПолеБлокировки.Ключ, ПолеБлокировки.Значение); КонецЦикла;
    Блокировка.Заблокировать();
КонецПроцедуры

// Связывает окружение APNs с конкретным текущим токеном существующего устройства.
//
// Параметры:
//  Клиент - СправочникСсылка.Клиенты - Клиент, которому принадлежит устройство.
//  ИДУстройства - Строка - Существующий ИД устройства в регистре УстройстваКлиентов.
//  МобильноеПриложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//  ОжидаемыйТокен - Строка - Непустой токен, который должен совпасть с текущим значением регистра.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production; для FCM не используется.
//
// Требует административных прав. В транзакции меняет только среду и её отпечаток; отсутствующее устройство не создаёт. После фиксации пишет лог; ошибка лога не отменяет запись.
//
Процедура УстановитьОкружениеAPNs(Клиент, ИДУстройства, МобильноеПриложение, ОжидаемыйТокен, Окружение) Экспорт
    ПроверитьАдминистратора();
    Если Не ИзвестноеОкружение(Окружение) Или ПустаяСтрока(ОжидаемыйТокен) Тогда
        ВызватьИсключение "Push: неизвестное окружение или пустой токен";
    КонецЕсли;
    Если ПровайдерПриложения(МобильноеПриложение) <> "apns" Тогда
        ВызватьИсключение "Push: окружение APNs применимо только к iOS";
    КонецЕсли;
    КонтекстЛога = НовыйКонтекст("environment");
    НачатьТранзакцию();
    Попытка
        Блокировать("УстройстваКлиентов", Новый Структура("Клиент,ИДУстройства", Клиент, ИДУстройства));
        ЗаписьУстройства = ПрочитатьУстройство(Клиент, ИДУстройства);
        Если ЗаписьУстройства.МобильноеПриложение <> МобильноеПриложение Или ЗаписьУстройства.ТокенУстройства <> ОжидаемыйТокен Тогда
            ВызватьИсключение "Push: приложение или токен устройства изменились";
        КонецЕсли;
        ЗаписьУстройства.ОкружениеAPNs = Окружение;
        ЗаписьУстройства.ОтпечатокТокенаОкруженияAPNs = Отпечаток(ОжидаемыйТокен);
        ЗаписьУстройства.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Событие(КонтекстЛога, "", "environment", "updated");
КонецПроцедуры

// Читает существующую запись устройства по клиенту и ИД.
//
// Параметры:
//  Клиент - СправочникСсылка.Клиенты - Клиент, которому принадлежит устройство.
//  ИДУстройства - Строка - Существующий ИД устройства в регистре УстройстваКлиентов.
//
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.УстройстваКлиентов - Прочитанная существующая запись.
//
// Пустой ключ и отсутствие записи вызывают исключение.
//
Функция ПрочитатьУстройство(Клиент, ИДУстройства)
    Если Не ЗначениеЗаполнено(Клиент) Или ПустаяСтрока(ИДУстройства) Тогда
        ВызватьИсключение "Push: не указан получатель";
    КонецЕсли;
    ЗаписьУстройства = РегистрыСведений.УстройстваКлиентов.СоздатьМенеджерЗаписи();
    ЗаписьУстройства.Клиент = Клиент;
    ЗаписьУстройства.ИДУстройства = ИДУстройства;
    ЗаписьУстройства.Прочитать();
    Если Не ЗаписьУстройства.Выбран() Тогда ВызватьИсключение "Push: устройство не найдено"; КонецЕсли;
    Возврат ЗаписьУстройства;
КонецФункции

// Проверяет пригодность устройства и формирует адрес прямой отправки.
//
// Параметры:
//  Клиент - СправочникСсылка.Клиенты - Клиент, которому принадлежит устройство.
//  ИДУстройства - Строка - Существующий ИД устройства в регистре УстройстваКлиентов.
//
// Возвращаемое значение:
//  Структура - Приложение, Провайдер, Окружение, Токен и ОтпечатокТокена проверенного устройства.
//
// Проверяет активность, разрешение, токен, среду APNs, однозначность владельца и блокировки токена. При нарушении вызывает исключение; регистр устройств не изменяет.
//
Функция АдресУстройства(Клиент, ИДУстройства)
    ЗаписьУстройства = ПрочитатьУстройство(Клиент, ИДУстройства);
    Если Не ЗаписьУстройства.Активно Или Не ЗаписьУстройства.РазрешениеНаОповещение Или ПустаяСтрока(ЗаписьУстройства.ТокенУстройства) Тогда
        ВызватьИсключение "Push: устройство отключено, нет разрешения или токена";
    КонецЕсли;
    Провайдер = ПровайдерПриложения(ЗаписьУстройства.МобильноеПриложение);
    Окружение = Перечисления.ОкруженияAPNsПКМП.ПустаяСсылка();
    ОтпечатокТокена = Отпечаток(ЗаписьУстройства.ТокенУстройства);
    Если Провайдер = "apns" Тогда
        Окружение = ЗаписьУстройства.ОкружениеAPNs;
        Если Не ИзвестноеОкружение(Окружение) Или ЗаписьУстройства.ОтпечатокТокенаОкруженияAPNs <> ОтпечатокТокена Тогда
            ВызватьИсключение "Push: окружение текущего APNs-токена не подтверждено";
        КонецЕсли;
    КонецЕсли;
    // Ключ регистра допускает прежнего клиента того же устройства. При неоднозначности не отправлять никому.
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 У.Клиент ИЗ РегистрСведений.УстройстваКлиентов КАК У
        |ГДЕ У.ИДУстройства = &ИД И У.МобильноеПриложение = &П И У.Клиент <> &К И У.Активно");
    Запрос.УстановитьПараметр("ИД", ИДУстройства);
    Запрос.УстановитьПараметр("П", ЗаписьУстройства.МобильноеПриложение);
    Запрос.УстановитьПараметр("К", Клиент);
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "Push: неоднозначная принадлежность устройства";
    КонецЕсли;
    ЗаписьБлокировки = РегистрыСведений.БлокировкиТокеновPushПКМП.СоздатьМенеджерЗаписи();
    ЗаписьБлокировки.Приложение = ЗаписьУстройства.МобильноеПриложение;
    ЗаписьБлокировки.Провайдер = Провайдер;
    ЗаписьБлокировки.Окружение = Окружение;
    ЗаписьБлокировки.ОтпечатокТокена = ОтпечатокТокена;
    ЗаписьБлокировки.Прочитать();
    Если ЗаписьБлокировки.Выбран() Тогда ВызватьИсключение "Push: токен заблокирован провайдером"; КонецЕсли;
    Возврат Новый Структура("Приложение,Провайдер,Окружение,Токен,ОтпечатокТокена",
        ЗаписьУстройства.МобильноеПриложение, Провайдер, Окружение, ЗаписьУстройства.ТокенУстройства, ОтпечатокТокена);
КонецФункции
#КонецОбласти

#Область Очередь
// Строит детерминированный УИД для идемпотентной постановки события одному устройству.
//
// Параметры:
//  КлючСобытия - Строка - Стабильный ключ исходного бизнес-события.
//  Клиент - СправочникСсылка.Клиенты - Клиент, которому принадлежит устройство.
//  ИДУстройства - Строка - Существующий ИД устройства в регистре УстройстваКлиентов.
//  Приложение - СправочникСсылка.МобильныеПриложения - Мобильное приложение — владелец настроек доступа.
//
// Возвращаемое значение:
//  Строка - УИД длиной 36 символов, построенный из первых 128 бит SHA-256 составного ключа.
//
// Ключ включает клиента, устройство и приложение; повтор события даёт тот же УИД.
//
Функция ИдентификаторСообщения(КлючСобытия, Клиент, ИДУстройства, Приложение)
    Части = Новый Массив;
    Части.Добавить(КлючСобытия);
    Части.Добавить(Строка(Клиент.УникальныйИдентификатор()));
    Части.Добавить(ИДУстройства);
    Части.Добавить(Строка(Приложение.УникальныйИдентификатор()));
    ХешИдентификатора = Отпечаток(ВJSON(Части));
    Возврат Лев(ХешИдентификатора,8) + "-" + Сред(ХешИдентификатора,9,4) + "-" + Сред(ХешИдентификатора,13,4) + "-" + Сред(ХешИдентификатора,17,4) + "-" + Сред(ХешИдентификатора,21,12);
КонецФункции

// Идемпотентно ставит уведомление одному проверенному устройству в очередь 1С.
//
// Параметры:
//  КлючСобытия - Строка - Непустой стабильный ключ события; повтор не создаёт вторую отправку.
//  Клиент - СправочникСсылка.Клиенты - Клиент, которому принадлежит устройство.
//  ИДУстройства - Строка - Существующий ИД устройства в регистре УстройстваКлиентов.
//  Заголовок - Строка - Заголовок длиной не более 200 символов.
//  Текст - Строка - Непустое тело уведомления.
//  Ссылка - Строка - Ссылка для приложения; не должна содержать серверные секреты.
//  АктуальноДо - Дата - Предельное время начала отправки по UTC; должно находиться в будущем.
//
// Возвращаемое значение:
//  Строка - УИД новой либо уже существующей записи очереди.
//
// Записывает очередь в транзакции. Повтор с другим содержимым вызывает исключение; исходный срок не продлевается. Сеть не вызывает; лог очереди пишет фоновый обработчик после фиксации.
//
Функция ПоставитьВОчередь(КлючСобытия, Клиент, ИДУстройства, Заголовок, Текст, Ссылка, АктуальноДо) Экспорт
    Если ПустаяСтрока(КлючСобытия) Или ПустаяСтрока(Текст) Или СтрДлина(Заголовок) > 200
        Или АктуальноДо <= ТекущаяУниверсальнаяДата() Тогда
        ВызватьИсключение "Push: неверные параметры сообщения или истёк срок";
    КонецЕсли;
    Адрес = АдресУстройства(Клиент, ИДУстройства);
    УИД = ИдентификаторСообщения(КлючСобытия, Клиент, ИДУстройства, Адрес.Приложение);
    ОтпечатокСообщения = Отпечаток(ВJSON(Новый Структура("Заголовок,Текст,Ссылка", Заголовок, Текст, Ссылка)));
    // При вызове внутри транзакции события лог очереди выполняет фоновый отправитель.
    НачатьТранзакцию();
    Попытка
        Блокировать("ОчередьPushПКМП", Новый Структура("УИД", УИД));
        СообщениеОчереди = ЗаписьОчереди(УИД);
        Если СообщениеОчереди.Выбран() Тогда
            Если СообщениеОчереди.ОтпечатокСообщения <> ОтпечатокСообщения Тогда ВызватьИсключение "Push: повтор события с другим содержимым"; КонецЕсли;
        Иначе
            // Прочитать() отсутствующего менеджера очищает значения ключевых полей.
            СообщениеОчереди.УИД = УИД;
            СообщениеОчереди.Клиент = Клиент; СообщениеОчереди.ИДУстройства = ИДУстройства;
            СообщениеОчереди.Приложение = Адрес.Приложение; СообщениеОчереди.Провайдер = Адрес.Провайдер;
            СообщениеОчереди.Окружение = Адрес.Окружение; СообщениеОчереди.ОтпечатокТокена = Адрес.ОтпечатокТокена;
            СообщениеОчереди.ОтпечатокСообщения = ОтпечатокСообщения; СообщениеОчереди.Заголовок = Заголовок;
            СообщениеОчереди.Текст = Текст; СообщениеОчереди.Ссылка = Ссылка; СообщениеОчереди.АктуальноДо = АктуальноДо;
            СообщениеОчереди.Состояние = "queued"; СообщениеОчереди.ДатаСоздания = ТекущаяУниверсальнаяДата();
            СообщениеОчереди.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат УИД;
КонецФункции

// Создаёт менеджер и читает запись очереди по УИД.
//
// Параметры:
//  УИД - Строка - УИД записи очереди и идентификатор корреляции логов.
//
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.ОчередьPushПКМП - Менеджер записи; наличие определяется методом Выбран().
//
// После чтения отсутствующей записи ключевые поля очищены: перед созданием нужно заново присвоить УИД.
//
Функция ЗаписьОчереди(УИД)
    СообщениеОчереди = РегистрыСведений.ОчередьPushПКМП.СоздатьМенеджерЗаписи();
    СообщениеОчереди.УИД = УИД; СообщениеОчереди.Прочитать(); Возврат СообщениеОчереди;
КонецФункции

// Обрабатывает до 100 готовых записей очереди и восстанавливает истёкшие захваты.
//
// Обработчик регламентного задания. Фиксирует приёмник логов на запуск, вызывает прямой транспорт и очищает файловые push-логи. Недоступный лог останавливает запуск.
//
Процедура ВыполнитьОтправкуОчереди() Экспорт
    Если РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
        ВызватьИсключение "Отправка приостановлена штатной блокировкой внешних ресурсов";
    КонецЕсли;
    КонтекстЛога = НовыйКонтекст("queue");
    Сейчас = ТекущаяУниверсальнаяДата();
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 О.УИД ИЗ РегистрСведений.ОчередьPushПКМП КАК О
        |ГДЕ ((О.Состояние = &Ожидает ИЛИ О.Состояние = &Повтор) И О.СледующаяПопытка <= &Сейчас)
        |ИЛИ (О.Состояние = &Отправляется И О.ЗахватДо <= &Сейчас) УПОРЯДОЧИТЬ ПО О.ДатаСоздания");
    Запрос.УстановитьПараметр("Ожидает", "queued");
    Запрос.УстановитьПараметр("Повтор", "retry");
    Запрос.УстановитьПараметр("Отправляется", "sending");
    Запрос.УстановитьПараметр("Сейчас", Сейчас);
    Выборка = Запрос.Выполнить().Выбрать();
    Пул = Новый Соответствие;
    Попытка
        Пока Выборка.Следующий() Цикл ОбработатьСообщение(Выборка.УИД, КонтекстЛога, Пул); КонецЦикла;
    Исключение
        ЗакрытьТранспортыAPNs(Пул); ВызватьИсключение;
    КонецПопытки;
    ЗакрытьТранспортыAPNs(Пул);
    Логирование.ОчиститьФайлы(Перечисления.РазделыЛогирования.PushОтправка);
КонецПроцедуры

// Выполняет проверки, подготовку, захват и одну попытку отправки сообщения.
//
// Параметры:
//  УИД - Строка - УИД записи очереди и идентификатор корреляции логов.
//  КонтекстЛога - Структура - Контекст раздела PushОтправка, полученный от модуля Логирование.
//  Пул - Соответствие, Неопределено - Соединения HTTP/2, разделённые по приложению и ключу авторизации.
//
// Сеть вызывается вне транзакции. Неоднозначный сетевой исход сохраняется как unknown без автоматического повтора. Результат сохраняется до лога; ошибка лога не разрешает повтор. Активный захват другого исполнителя не восстанавливает.
//
Процедура ОбработатьСообщение(УИД, КонтекстЛога, Пул = Неопределено)
    // Сначала безопасные проверки. Исключения не содержат сырых ответов/токенов.
    СообщениеОчереди = ЗаписьОчереди(УИД);
    Если Не СообщениеОчереди.Выбран() Тогда Возврат; КонецЕсли;
    Если СообщениеОчереди.Состояние = "sending" Тогда
        Если СообщениеОчереди.ЗахватДо <= ТекущаяУниверсальнаяДата() Тогда
            ЗафиксироватьЗавершение(УИД, СообщениеОчереди.ТокенЗахвата, "unknown", "restart_after_send", Неопределено);
            Событие(КонтекстЛога, УИД, СообщениеОчереди.Провайдер, "unknown");
        КонецЕсли;
        Возврат;
    КонецЕсли;
    Если СообщениеОчереди.Состояние <> "queued" И СообщениеОчереди.Состояние <> "retry" Тогда Возврат; КонецЕсли;
    Если СообщениеОчереди.СледующаяПопытка > ТекущаяУниверсальнаяДата() Тогда Возврат; КонецЕсли;
    Событие(КонтекстЛога, УИД, СообщениеОчереди.Провайдер, СообщениеОчереди.Состояние);
    Если СообщениеОчереди.АктуальноДо <= ТекущаяУниверсальнаяДата() Тогда
        ЗавершитьОжидающее(УИД, "expired", "expired"); Событие(КонтекстЛога, УИД, СообщениеОчереди.Провайдер, "expired"); Возврат;
    КонецЕсли;
    Попытка
        Адрес = АдресУстройства(СообщениеОчереди.Клиент, СообщениеОчереди.ИДУстройства);
        Если Адрес.Приложение <> СообщениеОчереди.Приложение Или Адрес.Окружение <> СообщениеОчереди.Окружение
            Или Адрес.ОтпечатокТокена <> СообщениеОчереди.ОтпечатокТокена Тогда
            ВызватьИсключение "Push: адрес назначения изменился";
        КонецЕсли;
    Исключение
        ЗавершитьОжидающее(УИД, "cancelled", "device_validation_failed");
        Событие(КонтекстЛога, УИД, СообщениеОчереди.Провайдер, "device_validation_failed"); Возврат;
    КонецПопытки;
    Попытка
        Доступ = ПрочитатьДоступ(Адрес.Приложение, Адрес.Окружение);
        Если Не Доступ.ОтправкаВключена Тогда
            Событие(КонтекстЛога, УИД, СообщениеОчереди.Провайдер, "disabled"); Возврат;
        КонецЕсли;
        ПроверитьДоступ(Адрес.Приложение, Адрес.Окружение, Доступ, Ложь);
        Если Адрес.Провайдер = "fcm" Тогда
            Уведомление = ПодготовитьУведомление(Адрес, СообщениеОчереди.Заголовок, СообщениеОчереди.Текст, СообщениеОчереди.Ссылка, УИД, Доступ);
            Авторизация = ОтправкаДоставляемыхУведомлений.ПолучитьМаркерДоступа(
                ТипПодписчикаДоставляемыхУведомлений.FCM, "", Доступ.Токен);
        Иначе
            Если Пул = Неопределено Тогда Пул = Новый Соответствие; КонецЕсли;
            Компонента = КомпонентаAPNs(Пул, Доступ);
            Авторизация = ПолучитьJWTAPNs(Адрес.Приложение, Адрес.Окружение, Доступ);
            Подготовка = ПодготовитьЗапросAPNs(Адрес, СообщениеОчереди, Доступ, Авторизация);
        КонецЕсли;
    Исключение
        // На этой стадии сообщение ещё не отправлялось. Доступ может быть исправлен без потери сообщения.
        Событие(КонтекстЛога, УИД, СообщениеОчереди.Провайдер, "preparation_failed"); Возврат;
    КонецПопытки;
    Событие(КонтекстЛога, УИД, СообщениеОчереди.Провайдер, "attempt", СообщениеОчереди.Попытки + 1);
    Захват = Захватить(УИД);
    Если ПустаяСтрока(Захват) Тогда Возврат; КонецЕсли;
    Проблемы = Новый Массив; Исключенные = Новый Массив;
    Попытка
        Если Адрес.Провайдер = "fcm" Тогда
            ОтправкаДоставляемыхУведомлений.Отправить(Уведомление, Авторизация, Исключенные, Ложь, Проблемы);
            РезультатОтправки = РазобратьПроблемы(Проблемы, Исключенные, Адрес.Токен);
        Иначе
            РезультатОтправки = ОтправитьAPNs(Компонента, Подготовка);
        КонецЕсли;
    Исключение
        // Не читать ОписаниеОшибки(): оно может содержать секретный адрес/токен.
        РезультатОтправки = Новый Структура("Состояние,Код,Блокировать", "unknown", "transport_exception", Ложь);
    КонецПопытки;
    Если Не РезультатОтправки.Свойство("ИДПровайдера") Тогда РезультатОтправки.Вставить("ИДПровайдера", ""); КонецЕсли;
    Если Не РезультатОтправки.Свойство("КодHTTP") Тогда РезультатОтправки.Вставить("КодHTTP", 0); КонецЕсли;
    Если Не РезультатОтправки.Свойство("ПовторПосле") Тогда РезультатОтправки.Вставить("ПовторПосле", 0); КонецЕсли;
    ЗафиксироватьЗавершение(УИД, Захват, РезультатОтправки.Состояние, РезультатОтправки.Код, Адрес, РезультатОтправки.Блокировать,
        РезультатОтправки.ИДПровайдера, РезультатОтправки.КодHTTP, РезультатОтправки.ПовторПосле);
    // Только явное истечение JWT разрешает инвалидировать его кеш; прочие 403 не обновляют ключ.
    Если Адрес.Провайдер = "apns" И РезультатОтправки.Код = "ExpiredProviderToken" Тогда
        СброситьJWTAPNs(Адрес.Приложение, Адрес.Окружение, Авторизация);
    КонецЕсли;
    Итог = ЗаписьОчереди(УИД);
    Описание = Итог.КодОшибки;
    Если Итог.КодHTTP > 0 Тогда Описание = "HTTP " + Формат(Итог.КодHTTP, "ЧГ=0") + "; " + Описание; КонецЕсли;
    Событие(КонтекстЛога, УИД, Адрес.Провайдер, Итог.Состояние, Итог.Попытки, Итог.ИДПровайдера, Описание);
КонецПроцедуры

// Атомарно закрепляет готовое сообщение за одним исполнителем на 15 минут.
//
// Параметры:
//  УИД - Строка - УИД записи очереди и идентификатор корреляции логов.
//
// Возвращаемое значение:
//  Строка - Уникальный токен захвата либо пустая строка, если отправка сейчас недопустима.
//
// В короткой транзакции повторно проверяет адрес, срок и время повтора; увеличивает число попыток и переводит запись в sending.
//
Функция Захватить(УИД)
    ТокенЗахвата = Строка(Новый УникальныйИдентификатор);
    НачатьТранзакцию();
    Попытка
        Блокировать("ОчередьPushПКМП", Новый Структура("УИД", УИД));
        СообщениеОчереди = ЗаписьОчереди(УИД);
        Если СообщениеОчереди.Выбран() И (СообщениеОчереди.Состояние = "queued" Или СообщениеОчереди.Состояние = "retry")
            И СообщениеОчереди.АктуальноДо > ТекущаяУниверсальнаяДата() И СообщениеОчереди.СледующаяПопытка <= ТекущаяУниверсальнаяДата() Тогда
            // Повторная проверка непосредственно перед фиксацией намерения отправить.
            Адрес = АдресУстройства(СообщениеОчереди.Клиент, СообщениеОчереди.ИДУстройства);
            Если Адрес.Приложение <> СообщениеОчереди.Приложение Или Адрес.Окружение <> СообщениеОчереди.Окружение
                Или Адрес.ОтпечатокТокена <> СообщениеОчереди.ОтпечатокТокена Тогда
                ВызватьИсключение "Push: адрес назначения изменился перед отправкой";
            КонецЕсли;
            СообщениеОчереди.Состояние = "sending"; СообщениеОчереди.ТокенЗахвата = ТокенЗахвата;
            СообщениеОчереди.ЗахватДо = ТекущаяУниверсальнаяДата() + 900;
            СообщениеОчереди.Попытки = СообщениеОчереди.Попытки + 1; СообщениеОчереди.Записать();
        Иначе ТокенЗахвата = "";
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат ТокенЗахвата;
КонецФункции

// Завершает ещё ожидающую запись без сетевой отправки.
//
// Параметры:
//  УИД - Строка - УИД записи очереди и идентификатор корреляции логов.
//  Состояние - Строка - Внутреннее состояние обработки push-сообщения.
//  Код - Строка - Фиксированный обезличенный код причины; без сырых ответов провайдера.
//
// Под блокировкой изменяет только queued/retry; отправляемые и завершённые записи не затрагивает.
//
Процедура ЗавершитьОжидающее(УИД, Состояние, Код)
    НачатьТранзакцию();
    Попытка
        Блокировать("ОчередьPushПКМП", Новый Структура("УИД", УИД));
        СообщениеОчереди = ЗаписьОчереди(УИД);
        Если СообщениеОчереди.Выбран() И (СообщениеОчереди.Состояние = "queued" Или СообщениеОчереди.Состояние = "retry") Тогда
            СообщениеОчереди.Состояние = Состояние; СообщениеОчереди.КодОшибки = Код; СообщениеОчереди.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

// Сохраняет исход текущей попытки и при необходимости блокировку недействительного токена.
//
// Параметры:
//  УИД - Строка - УИД записи очереди и идентификатор корреляции логов.
//  Захват - Строка - Токен захвата, выданный текущему исполнителю очереди.
//  Состояние - Строка - Внутреннее состояние обработки push-сообщения.
//  Код - Строка - Фиксированный обезличенный код причины; без сырых ответов провайдера.
//  Адрес - Структура, Неопределено - Проверенный адрес; обязателен только при блокировке токена.
//  Заблокировать - Булево - Создавать ли блокировку конкретного токена в данном приложении и среде; по умолчанию Ложь.
//  ИДПровайдера - Строка - Проверенный apns-id; для FCM пусто.
//  КодHTTP - Число - Полученный HTTP-статус APNs либо 0.
//  ПовторПосле - Число - Минимальная задержка по Retry-After/ограничению провайдера в секундах.
//
// Проверяет sending и токен захвата под блокировкой. Для retry назначает задержку и ограничивает число попыток/срок; блокировку токена пишет в той же транзакции. Лог не пишет.
//
Процедура ЗафиксироватьЗавершение(УИД, Захват, Состояние, Код, Адрес, Заблокировать = Ложь, ИДПровайдера = "", КодHTTP = 0, ПовторПосле = 0)
    НачатьТранзакцию();
    Попытка
        Блокировать("ОчередьPushПКМП", Новый Структура("УИД", УИД));
        СообщениеОчереди = ЗаписьОчереди(УИД);
        Если Не СообщениеОчереди.Выбран() Или СообщениеОчереди.Состояние <> "sending" Или СообщениеОчереди.ТокенЗахвата <> Захват Тогда
            ВызватьИсключение "Push: состояние отправки изменилось";
        КонецЕсли;
        СообщениеОчереди.Состояние = Состояние; СообщениеОчереди.КодОшибки = Код;
        СообщениеОчереди.ИДПровайдера = ИДПровайдера; СообщениеОчереди.КодHTTP = КодHTTP;
        Если Состояние = "retry" Тогда
            Если СообщениеОчереди.Попытки >= 3 Тогда
                СообщениеОчереди.Состояние = "rejected"; СообщениеОчереди.КодОшибки = "retry_limit";
            Иначе
                СлучайныеЧисла = Новый ГенераторСлучайныхЧисел;
                СообщениеОчереди.СледующаяПопытка = ТекущаяУниверсальнаяДата() + Макс(60 * СообщениеОчереди.Попытки, ПовторПосле) + СлучайныеЧисла.СлучайноеЧисло(0,30);
                Если СообщениеОчереди.СледующаяПопытка >= СообщениеОчереди.АктуальноДо Тогда СообщениеОчереди.Состояние = "expired"; КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        СообщениеОчереди.Записать();
        Если Заблокировать Тогда
            Блокировать("БлокировкиТокеновPushПКМП", Новый Структура("Приложение,Провайдер,Окружение,ОтпечатокТокена",
                Адрес.Приложение, Адрес.Провайдер, Адрес.Окружение, Адрес.ОтпечатокТокена));
            ЗаписьБлокировки = РегистрыСведений.БлокировкиТокеновPushПКМП.СоздатьМенеджерЗаписи();
            ЗаполнитьЗначенияСвойств(ЗаписьБлокировки, Адрес);
            ЗаписьБлокировки.Дата = ТекущаяУниверсальнаяДата(); ЗаписьБлокировки.КодОшибки = Код; ЗаписьБлокировки.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
#КонецОбласти

#Область Транспорт
// Создаёт штатное уведомление 1С с получателем из нативного FCM/APNs-токена.
//
// Параметры:
//  Адрес - Структура - Приложение, Провайдер, Окружение, Токен и ОтпечатокТокена проверенного устройства.
//  Заголовок - Строка - Заголовок уведомления.
//  Текст - Строка - Тело уведомления.
//  Ссылка - Строка - Ссылка в дополнительных данных.
//  УИД - Строка - УИД записи очереди и идентификатор корреляции логов.
//  Доступ - Структура - ОтправкаВключена, ИдентификаторПриложения, Логин, Пароль, Токен, TeamID и KeyID.
//
// Возвращаемое значение:
//  ДоставляемоеУведомление - Уведомление с одним получателем и JSON-строкой Данные с notificationId и url.
//
// Использует системный XDTO-тип подписчика. Сеть не вызывает; обработку ссылки приложением нужно проверять отдельно.
//
Функция ПодготовитьУведомление(Адрес, Заголовок, Текст, Ссылка, УИД, Доступ)
    Тип = ФабрикаXDTO.Тип("http://v8.1c.ru/8.3/data/ext", "DeliverableNotificationSubscriberID");
    ДанныеПолучателяXDTO = ФабрикаXDTO.Создать(Тип);
    ДанныеПолучателяXDTO.subscriberType = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://v8.1c.ru/8.3/data/ext", "DeliverableNotificationSubscriberType"), ВРег(Адрес.Провайдер));
    ДанныеПолучателяXDTO.deviceID = Адрес.Токен;
    ДанныеПолучателяXDTO.applicationID = Доступ.ИдентификаторПриложения;
    ДанныеПолучателяXDTO.databaseID = "";
    Получатель = СериализаторXDTO.ПрочитатьXDTO(ДанныеПолучателяXDTO);
    Уведомление = Новый ДоставляемоеУведомление;
    Уведомление.Заголовок = Заголовок; Уведомление.Текст = Текст;
    Уведомление.Данные = ВJSON(Новый Структура("notificationId,url", УИД, Ссылка));
    Уведомление.Получатели.Добавить(Получатель);
    Возврат Уведомление;
КонецФункции

// Преобразует типизированные проблемы штатного отправителя в безопасный результат обработки.
//
// Параметры:
//  Проблемы - Массив - Объекты ИнформацияОПроблемеОтправкиДоставляемогоУведомления.
//  Исключенные - Массив - Идентификаторы устройств, исключённые штатным отправителем.
//  Токен - Строка - Токен текущего единственного получателя для проверки исключения.
//
// Возвращаемое значение:
//  Структура - Состояние, Код, Блокировать; accepted означает отсутствие сообщённых проблем, а не подтверждённую доставку.
//
// Несколько проблем и неизвестные типы дают unknown. Только однозначный квотный отказ разрешает retry; тексты ответов не читаются.
//
Функция РазобратьПроблемы(Проблемы, Исключенные, Токен)
    РезультатОтправки = Новый Структура("Состояние,Код,Блокировать", "accepted", "", Ложь);
    Если Проблемы.Количество() > 1 Тогда
        // Не превращать неоднозначную комбинацию ошибок в разрешение повторной отправки.
        РезультатОтправки.Состояние = "unknown"; РезультатОтправки.Код = "multiple_provider_issues"; Возврат РезультатОтправки;
    КонецЕсли;
    Если Исключенные.Найти(Токен) <> Неопределено Тогда
        РезультатОтправки.Состояние = "rejected"; РезультатОтправки.Код = "invalid_token"; РезультатОтправки.Блокировать = Истина;
    КонецЕсли;
    Для Каждого Проблема Из Проблемы Цикл
        Если Проблема.ТипОшибки = ТипОшибкиОтправкиДоставляемогоУведомления.ОшибкаИдентификатораПодписчика Тогда
            РезультатОтправки.Состояние = "rejected"; РезультатОтправки.Код = "invalid_token"; РезультатОтправки.Блокировать = Истина;
        ИначеЕсли Проблема.ТипОшибки = ТипОшибкиОтправкиДоставляемогоУведомления.ОшибкаДанныхАутентификации Тогда
            РезультатОтправки.Состояние = "rejected"; РезультатОтправки.Код = "authentication"; РезультатОтправки.Блокировать = Ложь;
        ИначеЕсли Проблема.ТипОшибки = ТипОшибкиОтправкиДоставляемогоУведомления.ОшибкаТелаУведомления Тогда
            РезультатОтправки.Состояние = "rejected"; РезультатОтправки.Код = "payload"; РезультатОтправки.Блокировать = Ложь;
        ИначеЕсли Проблема.ТипОшибки = ТипОшибкиОтправкиДоставляемогоУведомления.ПревышенЛимитОтправкиУведомлений Тогда
            РезультатОтправки.Состояние = "retry"; РезультатОтправки.Код = "quota"; РезультатОтправки.Блокировать = Ложь;
        Иначе
            РезультатОтправки.Состояние = "unknown"; РезультатОтправки.Код = "provider_issue"; РезультатОтправки.Блокировать = Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат РезультатОтправки;
КонецФункции

// Сериализует данные в компактную JSON-строку.
//
// Параметры:
//  Данные - Произвольный - Значение, поддерживаемое стандартной сериализацией JSON.
//
// Возвращаемое значение:
//  Строка - JSON без форматирующих переносов строк.
//
Функция ВJSON(Данные)
    ПисательJSON = Новый ЗаписьJSON; ПисательJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
    ЗаписатьJSON(ПисательJSON, Данные); Возврат ПисательJSON.Закрыть();
КонецФункции

// Читает JSON с преобразованием объектов в соответствия.
//
// Параметры:
//  СтрокаJSON - Строка - JSON, например настройки сервисной учётной записи FCM.
//
// Возвращаемое значение:
//  Произвольный - Результат стандартного чтения JSON; объекты представлены соответствиями.
//
// Некорректный JSON вызывает исключение; вызывающий код должен обезличить ошибку перед выводом.
//
Функция ИзJSON(СтрокаJSON)
    ЧитательJSON = Новый ЧтениеJSON; ЧитательJSON.УстановитьСтроку(СтрокаJSON);
    Данные = ПрочитатьJSON(ЧитательJSON, Истина); ЧитательJSON.Закрыть(); Возврат Данные;
КонецФункции
#КонецОбласти

#Область ЛогированиеИФорма
// Открывает сеанс существующего логгера для раздела PushОтправка.
//
// Параметры:
//  Способ - Строка - Имя операции логирования, например queue, environment или settings.
//
// Возвращаемое значение:
//  Структура - Контекст раздела PushОтправка, полученный от модуля Логирование.
//
// Фиксирует настроенный файловый/SQL-приёмник на сеанс; ошибка настройки или записи не скрывается.
//
Функция НовыйКонтекст(Способ)
    Возврат Логирование.ОткрытьСеанс(Перечисления.РазделыЛогирования.PushОтправка, Способ);
КонецФункции

// Записывает обезличенное событие состояния push через существующий модуль логирования.
//
// Параметры:
//  Контекст - Структура - Контекст раздела PushОтправка, полученный от модуля Логирование.
//  УИД - Строка - УИД сообщения; пустая строка для событий настройки или окружения.
//  Способ - Строка - Вид операции или провайдер: fcm/apns.
//  Состояние - Строка - Внутреннее состояние обработки push-сообщения.
//  ПопыткаОтправки - Число - Номер попытки; 0 для событий, к которым попытка неприменима.
//  ИДПровайдера - Строка - Проверенный идентификатор APNs; пусто, если не возвращён.
//  Описание - Строка - Обезличенный код из разрешённого списка, без сырого ответа.
//
// Не передаёт текст сообщения, токен, ключи и сырые исключения. Для FCM идентификатор остаётся пустым.
//
Процедура Событие(Контекст, УИД, Способ, Состояние, ПопыткаОтправки = 0, ИДПровайдера = "", Описание = "")
    Логирование.ЗаписатьСобытие(Контекст, УИД, Способ, Состояние, ИДПровайдера, ПопыткаОтправки, Описание);
КонецПроцедуры

// Заполняет форму настройками и новым маркером вместо сохранённых секретов.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма НастройкиPushПКМП с выбранными приложением и окружением.
//
// Требует административных прав; настоящие сохранённые пароль и токен на клиент не возвращаются.
//
Процедура ПрочитатьФорму(Форма) Экспорт
    ПроверитьАдминистратора();
    Форма.УИДМаркера = Строка(Новый УникальныйИдентификатор);
    НастройкиПровайдера = ПолучитьНастройкиПровайдера(Форма.Приложение, Форма.Окружение, Форма.УИДМаркера);
    ЗаполнитьЗначенияСвойств(Форма, НастройкиПровайдера);
КонецПроцедуры

// Сохраняет введённые настройки и перечитывает форму с маскированием секретов.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма НастройкиPushПКМП с выбранными приложением и окружением.
//
// Требует административных прав; прикладная запись выполняется в ЗаписатьНастройкиПровайдера.
//
Процедура СохранитьФорму(Форма) Экспорт
    ПроверитьАдминистратора();
    НастройкиПровайдера = ПустыеНастройки(); ЗаполнитьЗначенияСвойств(НастройкиПровайдера, Форма);
    ЗаписатьНастройкиПровайдера(Форма.Приложение, Форма.Окружение, Форма.УИДМаркера, НастройкиПровайдера);
    ПрочитатьФорму(Форма);
КонецПроцедуры

// Записывает тестовое событие в настроенный приёмник раздела PushОтправка.
//
// Требует административных прав. Создаёт сеанс и test_event; push-сообщения не отправляет.
//
Процедура ПроверитьЛог() Экспорт
    ПроверитьАдминистратора();
    КонтекстЛога = НовыйКонтекст("settings"); Событие(КонтекстЛога, "", "settings", "test_event");
КонецПроцедуры

// Назначает выбранную среду существующему iOS-устройству из административной формы.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма НастройкиPushПКМП с выбранными приложением и окружением.
//
// Читает текущий токен только на сервере и передаёт его для проверки в УстановитьОкружениеAPNs. Регистрацию и прочие ресурсы не меняет.
//
Процедура НазначитьОкружениеИзФормы(Форма) Экспорт
    ПроверитьАдминистратора();
    ЗаписьУстройства = ПрочитатьУстройство(Форма.Клиент, Форма.ИДУстройства);
    УстановитьОкружениеAPNs(Форма.Клиент, Форма.ИДУстройства, Форма.Приложение, ЗаписьУстройства.ТокенУстройства, Форма.Окружение);
КонецПроцедуры
#КонецОбласти

#Область APNsP8
// Формирует заголовок авторизации APNs, подписывая JWT штатным ES256 платформы.
//
// Параметры:
//  Настройки - Структура - TeamID, KeyID и Токен с содержимым PKCS#8 файла .p8.
//  Создан - Дата - Время формирования по UTC; передаётся явно для воспроизводимых тестов.
//
// Возвращаемое значение:
//  Строка - Заголовок Authorization в формате Bearer <JWT>.
//
// Сеть не вызывает, ключ не пишет во временные файлы. Ошибки криптографии обезличиваются.
Функция СформироватьJWTAPNs(Настройки, Создан)
    ПроверитьФорматДоступаAPNs(Настройки);
    Попытка
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("kid", Настройки.KeyID);
        Поля = Новый Соответствие;
        Поля.Вставить("iss", Настройки.TeamID);
        Поля.Вставить("iat", Создан - Дата(1970,1,1));
        JWT = Новый ТокенДоступа(Заголовки, Поля);
        JWT.Подписать(АлгоритмПодписиТокенаДоступа.ES256, Настройки.Токен);
        Запрос = Новый HTTPЗапрос;
        Запрос.ДобавитьТокенДоступа(JWT);
        Авторизация = Запрос.Заголовки["Authorization"];
        Части = СтрРазделить(Сред(Авторизация, 8), ".");
        Подпись = СтрЗаменить(СтрЗаменить(Части[2], "-", "+"), "_", "/");
        Пока СтрДлина(Подпись) / 4 <> Цел(СтрДлина(Подпись) / 4) Цикл Подпись = Подпись + "="; КонецЦикла;
        Если Base64Значение(Подпись).Размер() <> 64 Тогда ВызватьИсключение "curve"; КонецЕсли;
        Возврат Авторизация;
    Исключение
        ВызватьИсключение "Push: не удалось подписать JWT ключом Apple .p8";
    КонецПопытки;
КонецФункции

// Проверяет обязательные идентификаторы и контейнер PKCS#8 до подписи либо чтения кеша.
//
// Параметры:
//  Настройки - Структура - TeamID, KeyID, Токен; закрытый ключ не включается в текст ошибки.
//
// Некорректный формат вызывает обезличенное исключение; криптографию и сеть не выполняет.
Процедура ПроверитьФорматДоступаAPNs(Настройки)
    Если Не ИдентификаторApple(Настройки.TeamID) Или Не ИдентификаторApple(Настройки.KeyID) Тогда
        ВызватьИсключение "Push: Team ID и Key ID должны содержать 10 латинских заглавных букв или цифр";
    КонецЕсли;
    Если СтрНайти(Настройки.Токен, "-----BEGIN PRIVATE KEY-----") = 0
        Или СтрНайти(Настройки.Токен, "-----END PRIVATE KEY-----") = 0 Тогда
        ВызватьИсключение "Push: требуется содержимое закрытого ключа Apple .p8";
    КонецЕсли;
КонецПроцедуры

// Возвращает кешированный JWT APNs либо атомарно обновляет его через 45 минут.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Владелец безопасных настроек.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Подтверждённая среда устройства.
//  Настройки - Структура - Bundle ID, TeamID, KeyID и Токен с ключом .p8.
//
// Возвращаемое значение:
//  Строка - Готовый заголовок Authorization без выдачи закрытого ключа транспорту.
//
// Обновление синхронизируется блокировкой приложения. Кеш хранится отдельно от настроек формы.
Функция ПолучитьJWTAPNs(Приложение, Окружение, Настройки)
    Ключ = КлючНастроек(Приложение, Окружение) + "_JWT";
    ХешКлюча = Отпечаток(ВJSON(Новый Структура("BundleID,TeamID,KeyID,Токен",
        Настройки.ИдентификаторПриложения, Настройки.TeamID, Настройки.KeyID, Настройки.Токен)));
    Сейчас = ТекущаяУниверсальнаяДата();
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить("Справочник.МобильныеПриложения");
        ЭлементБлокировки.УстановитьЗначение("Ссылка", Приложение); Блокировка.Заблокировать();
        Кеш = ПрочитатьКешAPNs(Приложение, Ключ);
        Использовать = Ложь;
        Если ТипЗнч(Кеш) = Тип("Структура") Тогда
            Если Кеш.Свойство("Авторизация") И Кеш.Свойство("Создан") И Кеш.Свойство("ОтпечатокКлюча") Тогда
                Если ТипЗнч(Кеш.Создан) = Тип("Дата") И ТипЗнч(Кеш.Авторизация) = Тип("Строка") Тогда
                    Использовать = Кеш.ОтпечатокКлюча = ХешКлюча И Кеш.Создан <= Сейчас
                        И Кеш.Создан > Сейчас - 2700 И Не ПустаяСтрока(Кеш.Авторизация);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Если Не Использовать Тогда
            Кеш = Новый Структура("Авторизация,Создан,ОтпечатокКлюча", СформироватьJWTAPNs(Настройки, Сейчас), Сейчас, ХешКлюча);
            ЗаписатьКешAPNs(Приложение, Ключ, Кеш);
        КонецЕсли;
        Авторизация = Кеш.Авторизация;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    Возврат Авторизация;
КонецФункции

// Читает только отдельный ключ кеша JWT в безопасном хранилище.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Владелец кеша.
//  Ключ - Строка - Внутренний ключ PushПКМП_APNs_<среда>_JWT.
//
// Возвращаемое значение:
//  Структура, Неопределено - Сохранённый кеш либо отсутствие записи.
//
// Восстанавливает прежний привилегированный режим при любом исходе; на клиент не вызывается.
Функция ПрочитатьКешAPNs(Приложение, Ключ)
    Режим = ПривилегированныйРежим();
    Попытка
        УстановитьПривилегированныйРежим(Истина);
        Результат = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Приложение, Ключ);
        УстановитьПривилегированныйРежим(Режим);
    Исключение
        УстановитьПривилегированныйРежим(Режим);
        ВызватьИсключение "Push: не удалось прочитать кеш JWT APNs";
    КонецПопытки;
    Возврат Результат;
КонецФункции

// Записывает кеш JWT либо удаляет его при передаче Неопределено.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Владелец кеша.
//  Ключ - Строка - Внутренний ключ кеша APNs, изолированный от FCM и SMS.
//  Данные - Структура, Неопределено - Авторизация, Создан и ОтпечатокКлюча; Неопределено удаляет кеш.
//
// Не возвращает секреты и восстанавливает прежний привилегированный режим при исключении.
Процедура ЗаписатьКешAPNs(Приложение, Ключ, Данные)
    Режим = ПривилегированныйРежим();
    Попытка
        УстановитьПривилегированныйРежим(Истина);
        Если Данные = Неопределено Тогда
            ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Приложение, Ключ);
        Иначе
            ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Приложение, Данные, Ключ);
        КонецЕсли;
        УстановитьПривилегированныйРежим(Режим);
    Исключение
        УстановитьПривилегированныйРежим(Режим);
        ВызватьИсключение "Push: не удалось записать кеш JWT APNs";
    КонецПопытки;
КонецПроцедуры

// Удаляет JWT после явного ExpiredProviderToken, не меняя ключ .p8 и настройки.
//
// Параметры:
//  Приложение - СправочникСсылка.МобильныеПриложения - Владелец доступа APNs.
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Среда отвергнутого JWT.
//  ОжидаемаяАвторизация - Строка, Неопределено - Отвергнутый JWT; более новый кеш другого исполнителя сохраняется.
//
// Сравнение и удаление выполняются под той же блокировкой приложения, что и обновление кеша.
Процедура СброситьJWTAPNs(Приложение, Окружение, ОжидаемаяАвторизация = Неопределено)
    Ключ = КлючНастроек(Приложение, Окружение) + "_JWT";
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        ЭлементБлокировки = Блокировка.Добавить("Справочник.МобильныеПриложения");
        ЭлементБлокировки.УстановитьЗначение("Ссылка", Приложение); Блокировка.Заблокировать();
        Кеш = ПрочитатьКешAPNs(Приложение, Ключ);
        Если ОжидаемаяАвторизация = Неопределено Тогда
            ЗаписатьКешAPNs(Приложение, Ключ, Неопределено);
        ИначеЕсли ТипЗнч(Кеш) = Тип("Структура") Тогда
            Если Кеш.Свойство("Авторизация") И Кеш.Авторизация = ОжидаемаяАвторизация Тогда
                ЗаписатьКешAPNs(Приложение, Ключ, Неопределено);
            КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

// Подключает Native API из общего макета и получает транспорт из пула приложения и ключа Apple.
//
// Параметры:
//  Пул - Соответствие - Пул соединений текущего запуска очереди; изменяется при создании компоненты.
//  Настройки - Структура - Bundle ID, TeamID, KeyID и Токен для вычисления ключа пула.
//
// Возвращаемое значение:
//  ВнешняяКомпонента - AddIn.APNsHTTP2.PushHttp2 версии 2.0.0; закрытый ключ ей не передаётся.
Функция КомпонентаAPNs(Пул, Настройки)
    Ключ = Отпечаток(ВJSON(Новый Структура("BundleID,TeamID,KeyID,Токен",
        Настройки.ИдентификаторПриложения, Настройки.TeamID, Настройки.KeyID, Настройки.Токен)));
    Компонента = Пул[Ключ];
    Если Компонента = Неопределено Тогда
        Попытка
            Если Не ПодключитьВнешнююКомпоненту("ОбщийМакет.HTTP2APNsПКМП", "APNsHTTP2",
                ТипВнешнейКомпоненты.Native) Тогда
                ВызватьИсключение "attach";
            КонецЕсли;
            Компонента = Новый("AddIn.APNsHTTP2.PushHttp2");
            Если Компонента.Version <> "2.0.0" Тогда ВызватьИсключение "version"; КонецЕсли;
        Исключение
            ВызватьИсключение "Push: не удалось подключить Native API HTTP2APNsПКМП (Windows x64)";
        КонецПопытки;
        Пул.Вставить(Ключ, Компонента);
    КонецЕсли;
    Возврат Компонента;
КонецФункции

// Закрывает HTTP/2-соединения после обработки пакета, включая выход по исключению.
//
// Параметры:
//  Пул - Соответствие - Компоненты текущего запуска; после вызова очищается.
//
// Ошибка освобождения транспорта не меняет уже зафиксированный исход отправки.
Процедура ЗакрытьТранспортыAPNs(Пул)
    Для Каждого Элемент Из Пул Цикл
        Попытка Элемент.Значение.Close(); Исключение Продолжить; КонецПопытки;
    КонецЦикла;
    Пул.Очистить();
КонецПроцедуры

// Формирует стандартный alert-запрос APNs, не выполняя сеть.
//
// Параметры:
//  Адрес - Структура - Проверенные Окружение и Токен устройства.
//  Сообщение - РегистрСведенийМенеджерЗаписи.ОчередьPushПКМП - Снимок содержимого и срока UTC.
//  Настройки - Структура - ИдентификаторПриложения содержит Bundle ID.
//  Авторизация - Строка - Подписанный JWT с префиксом Bearer.
//
// Возвращаемое значение:
//  Структура - Сервер, Токен, Авторизация, BundleID, УИД, Истекает и Тело.
//
// Размер тела ограничен 4096 байт UTF-8. Срок передаётся провайдеру как apns-expiration.
Функция ПодготовитьЗапросAPNs(Адрес, Сообщение, Настройки, Авторизация)
    Alert = Новый Структура("title,body", Сообщение.Заголовок, Сообщение.Текст);
    APS = Новый Структура("alert", Alert);
    Тело = ВJSON(Новый Структура("aps,notificationId,url", APS, Сообщение.УИД, Сообщение.Ссылка));
    Если ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8).Размер() > 4096 Тогда
        ВызватьИсключение "Push: тело APNs превышает 4096 байт UTF-8";
    КонецЕсли;
    Истекает = Формат(Сообщение.АктуальноДо - Дата(1970,1,1), "ЧГ=0;ЧДЦ=0");
    Возврат Новый Структура("Сервер,Токен,Авторизация,BundleID,УИД,Истекает,Тело",
        СерверAPNs(Адрес.Окружение), Адрес.Токен, Авторизация,
        Настройки.ИдентификаторПриложения, Сообщение.УИД, Истекает, Тело);
КонецФункции

// Передаёт готовый запрос транспортной компоненте и разбирает ответ без повторной отправки.
//
// Параметры:
//  Компонента - ВнешняяКомпонента - Проверенный транспорт AddIn.APNsHTTP2.PushHttp2.
//  Запрос - Структура - Результат ПодготовитьЗапросAPNs; закрытого ключа в нём нет.
//
// Возвращаемое значение:
//  Структура - Состояние, Код, Блокировать, ИДПровайдера, КодHTTP и ПовторПосле.
Функция ОтправитьAPNs(Компонента, Запрос)
    СтрокаОтвета = Компонента.SendAPNs(Запрос.Сервер, Запрос.Токен, Запрос.Авторизация,
        Запрос.BundleID, Запрос.УИД, Запрос.Истекает, Запрос.Тело, 30);
    Возврат РазобратьОтветAPNs(СтрокаОтвета, Запрос.УИД);
КонецФункции

// Классифицирует ответ HTTP/2-компоненты по HTTP-статусу и разрешённым причинам APNs.
//
// Параметры:
//  СтрокаОтвета - Строка - Ограниченный JSON транспорта; сырое тело и JWT не логируются.
//  ОжидаемыйУИД - Строка - apns-id исходного запроса; должен совпасть с идентификатором ответа.
//
// Возвращаемое значение:
//  Структура - Безопасный результат для очереди: Состояние, Код, Блокировать,
//   ИДПровайдера, КодHTTP, ПовторПосле. Сетевой неизвестный исход не разрешает повтор.
Функция РазобратьОтветAPNs(СтрокаОтвета, ОжидаемыйУИД)
    РезультатОтправки = Новый Структура("Состояние,Код,Блокировать,ИДПровайдера,КодHTTP,ПовторПосле",
        "unknown", "invalid_provider_response", Ложь, "", 0, 0);
    Попытка
        Ответ = ИзJSON(СтрокаОтвета);
        Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда Возврат РезультатОтправки; КонецЕсли;
        Если Ответ["error"] <> "" Тогда
            РезультатОтправки.Код = "transport_failure";
            Если Ответ["sent"] = Ложь Тогда РезультатОтправки.Состояние = "rejected"; КонецЕсли;
            Возврат РезультатОтправки;
        КонецЕсли;
        Если Ответ["http2"] <> Истина Или Ответ["sent"] <> Истина Тогда Возврат РезультатОтправки; КонецЕсли;
        Если ТипЗнч(Ответ["status"]) <> Тип("Число") Или ТипЗнч(Ответ["body"]) <> Тип("Строка") Тогда Возврат РезультатОтправки; КонецЕсли;
        РезультатОтправки.КодHTTP = Ответ["status"];
        Если ТипЗнч(Ответ["apnsId"]) <> Тип("Строка") Или СтрДлина(Ответ["apnsId"]) <> 36 Тогда Возврат РезультатОтправки; КонецЕсли;
        ИД = Строка(Новый УникальныйИдентификатор(Ответ["apnsId"]));
        Если НРег(ИД) <> НРег(ОжидаемыйУИД) Тогда Возврат РезультатОтправки; КонецЕсли;
        РезультатОтправки.ИДПровайдера = ИД;
        Если РезультатОтправки.КодHTTP = 200 И ПустаяСтрока(СокрЛП(Ответ["body"])) Тогда
            РезультатОтправки.Состояние = "accepted"; РезультатОтправки.Код = ""; Возврат РезультатОтправки;
        КонецЕсли;
        Данные = ИзJSON(Ответ["body"]);
        Если ТипЗнч(Данные) <> Тип("Соответствие") Или ТипЗнч(Данные["reason"]) <> Тип("Строка") Тогда Возврат РезультатОтправки; КонецЕсли;
        Причина = Данные["reason"];
        Если ТипЗнч(Ответ["retryAfterSeconds"]) = Тип("Число") Тогда РезультатОтправки.ПовторПосле = Макс(0, Ответ["retryAfterSeconds"]); КонецЕсли;
        Если РезультатОтправки.КодHTTP = 410 И Причина = "Unregistered" Тогда
            РезультатОтправки.Состояние = "rejected"; РезультатОтправки.Код = Причина; РезультатОтправки.Блокировать = Истина;
        ИначеЕсли РезультатОтправки.КодHTTP = 400 И Причина = "BadDeviceToken" Тогда
            РезультатОтправки.Состояние = "rejected"; РезультатОтправки.Код = Причина; РезультатОтправки.Блокировать = Истина;
        ИначеЕсли РезультатОтправки.КодHTTP = 403 И Причина = "ExpiredProviderToken" Тогда
            РезультатОтправки.Состояние = "retry"; РезультатОтправки.Код = Причина;
        ИначеЕсли РезультатОтправки.КодHTTP = 429 И (Причина = "TooManyRequests" Или Причина = "TooManyProviderTokenUpdates") Тогда
            РезультатОтправки.Состояние = "retry"; РезультатОтправки.Код = Причина;
            Если Причина = "TooManyProviderTokenUpdates" Тогда РезультатОтправки.ПовторПосле = Макс(1200, РезультатОтправки.ПовторПосле); КонецЕсли;
        ИначеЕсли (РезультатОтправки.КодHTTP = 500 И Причина = "InternalServerError") Или (РезультатОтправки.КодHTTP = 503 И (Причина = "ServiceUnavailable" Или Причина = "Shutdown")) Тогда
            РезультатОтправки.Состояние = "retry"; РезультатОтправки.Код = Причина;
        ИначеЕсли РезультатОтправки.КодHTTP = 400 Или РезультатОтправки.КодHTTP = 403 Или РезультатОтправки.КодHTTP = 404 Или РезультатОтправки.КодHTTP = 405 Или РезультатОтправки.КодHTTP = 413 Тогда
            РезультатОтправки.Состояние = "rejected"; РезультатОтправки.Код = "apns_rejected";
            Разрешенные = СтрРазделить("BadCollapseId,BadExpirationDate,BadMessageId,BadPriority,BadTopic,DeviceTokenNotForTopic,DuplicateHeaders,IdleTimeout,InvalidPushType,MissingDeviceToken,MissingTopic,PayloadEmpty,TopicDisallowed,BadCertificate,BadCertificateEnvironment,Forbidden,InvalidProviderToken,MissingProviderToken,BadPath,MethodNotAllowed,PayloadTooLarge", ",");
            Если Разрешенные.Найти(Причина) <> Неопределено Тогда РезультатОтправки.Код = Причина; КонецЕсли;
        КонецЕсли;
    Исключение
        // В том числе ошибки JSON/UUID: никаких сырых данных в журнал.
        РезультатОтправки.Состояние = "unknown"; РезультатОтправки.Код = "invalid_provider_response"; РезультатОтправки.Блокировать = Ложь;
    КонецПопытки;
    Возврат РезультатОтправки;
КонецФункции

// Проверяет формат Team ID или Key ID Apple без изменения регистра символов.
//
// Параметры:
//  Значение - Строка - Проверяемый идентификатор.
//
// Возвращаемое значение:
//  Булево - Истина для ровно 10 символов A-Z и 0-9.
Функция ИдентификаторApple(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 10 Тогда Возврат Ложь; КонецЕсли;
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

// Выбирает фиксированный сервер APNs по подтверждённой среде устройства.
//
// Параметры:
//  Окружение - ПеречислениеСсылка.ОкруженияAPNsПКМП - Sandbox или Production.
//
// Возвращаемое значение:
//  Строка - Имя официального сервера Apple без протокола и пути.
//
// Неизвестная среда вызывает исключение. Переход в другую среду по ошибке не выполняется.
Функция СерверAPNs(Окружение)
    Если Окружение = Перечисления.ОкруженияAPNsПКМП.Sandbox Тогда
        Возврат "api.sandbox.push.apple.com";
    ИначеЕсли Окружение = Перечисления.ОкруженияAPNsПКМП.Production Тогда
        Возврат "api.push.apple.com";
    КонецЕсли;
    ВызватьИсключение "Push: окружение APNs не определено";
КонецФункции

#КонецОбласти
