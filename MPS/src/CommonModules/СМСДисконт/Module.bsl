// Протокол провайдера СМСДисконт (IQSMS).

// Сопоставляет известный статус IQSMS с внутренним состоянием обработки.
//
// Параметры:
//  Статус - Строка - точное значение статуса IQSMS.
//
// Возвращаемое значение:
//  Строка - Принято, Доставлено, Ожидание, Недоставлено, Повтор, Отказ или Неизвестно.
//
// Особенности:
//  not enough credits допускает повтор; delivery error и smsc reject означают окончательную недоставку. Незнакомый
//   статус остаётся неопределённым исходом.
Функция КатегорияСтатуса(Статус) Экспорт
    Если Статус = "accepted" Тогда
        Возврат "Принято";
    ИначеЕсли Статус = "delivered" Тогда
        Возврат "Доставлено";
    ИначеЕсли Статус = "queued" Или Статус = "smsc submit" Тогда
        Возврат "Ожидание";
    ИначеЕсли Статус = "delivery error" Или Статус = "smsc reject" Тогда
        Возврат "Недоставлено";
    ИначеЕсли Статус = "not enough credits" Тогда
        Возврат "Повтор";
    ИначеЕсли Статус = "invalid mobile phone" Или Статус = "text is empty"
        Или Статус = "sender address invalid" Или Статус = "wapurl invalid"
        Или Статус = "invalid schedule time format" Или Статус = "invalid status queue name" Тогда
        Возврат "Отказ";
    КонецЕсли;
    Возврат "Неизвестно";
КонецФункции

// Разбирает текстовый ответ REST-отправки IQSMS и выделяет подтверждённый результат.
//
// Параметры:
//  Текст - Строка - тело HTTP-ответа, обычно status;providerId.
//
// Возвращаемое значение:
//  Структура - результат в формате ОтправкаСМС.РезультатСМС().
//
// Особенности:
//  accepted требует допустимого идентификатора. Неподтверждённый исход возвращает unknown, чтобы не разрешать
//   опасную переотправку.
Функция РазобратьREST(Текст) Экспорт
    Части = СтрРазделить(СокрЛП(Текст), ";", Истина);
    Если Части.Количество() = 0 Тогда
        Возврат ОтправкаСМС.РезультатСМС();
    КонецЕсли;
    Статус = СокрЛП(Части[0]);
    Категория = КатегорияСтатуса(Статус);
    Если Категория = "Неизвестно" Тогда
        Возврат ОтправкаСМС.РезультатСМС();
    КонецЕсли;
    ИД = ?(Части.Количество() = 2, СокрЛП(Части[1]), "");
    Если Категория = "Принято" И Не ДопустимыйИД(ИД) Тогда
        Возврат ОтправкаСМС.РезультатСМС();
    КонецЕсли;
    Возврат ОтправкаСМС.РезультатСМС(Статус, ИД, Категория);
КонецФункции

// Проверяет идентификатор провайдера перед использованием в REST-запросе или разборе ответа.
//
// Параметры:
//  ИД - Произвольный - проверяемое значение; допустима строка из 1–100 латинских букв, цифр, дефиса и
//   подчёркивания.
//
// Возвращаемое значение:
//  Булево - Истина, если тип, длина и символы идентификатора допустимы.
Функция ДопустимыйИД(ИД) Экспорт
    Если ТипЗнч(ИД) <> Тип("Строка") Или СтрДлина(ИД) = 0 Или СтрДлина(ИД) > 100 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(ИД) Цикл
        Если СтрНайти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_", Сред(ИД, Позиция, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

// Преобразует телефон из 11 цифр к формату IQSMS с ведущим плюсом.
//
// Параметры:
//  Телефон - Строка - номер с необязательным плюсом и внешними пробелами; параметр нормализуется, его локальное
//   значение становится строкой без плюса.
//
// Возвращаемое значение:
//  Строка - плюс и 11 исходных цифр.
//
// Особенности:
//  При другой длине или недопустимых символах вызывает исключение. Код страны и первая цифра автоматически не
//   заменяются.
Функция ТелефонДляAPI(Телефон) Экспорт
    Телефон = СокрЛП(Телефон);
    Если Лев(Телефон, 1) = "+" Тогда
        Телефон = Сред(Телефон, 2);
    КонецЕсли;
    Если СтрДлина(Телефон) <> 11 Тогда
        ВызватьИсключение "SMS: ожидается телефон из 11 цифр";
    КонецЕсли;
    Для Позиция = 1 По 11 Цикл
        Если СтрНайти("0123456789", Сред(Телефон, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "SMS: недопустимый телефон";
        КонецЕсли;
    КонецЦикла;
    Возврат "+" + Телефон;
КонецФункции

// Проверяет выбор провайдера СМСДисконт и наличие логина/пароля для IQSMS.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - заполненная настройка с провайдером СМСДисконт.
//
// Возвращаемое значение:
//  Структура - настройки безопасного хранилища, включая Логин и Пароль.
//
// Особенности:
//  При неверном провайдере или пустых реквизитах вызывает исключение до HTTP. Структура содержит секреты.
Функция ДоступIQSMS(Настройка) Экспорт
    Если Не ЗначениеЗаполнено(Настройка) Или Настройка.Провайдер <> Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт Тогда
        ВызватьИсключение "SMS: не выбрана настройка провайдера СМСДисконт";
    КонецЕсли;
    Доступ = ОтправкаСМС.ПолучитьНастройкиПровайдера(Настройка);
    Если ПустаяСтрока(Доступ.Логин) Или ПустаяСтрока(Доступ.Пароль) Тогда
        ВызватьИсключение "SMS: не заполнены логин и пароль провайдера";
    КонецЕсли;
    Возврат Доступ;
КонецФункции

// Выполняет один HTTPS-запрос к api.iqsms.ru с логином/паролем и заданным таймаутом.
//
// Параметры:
//  Путь - Строка - путь REST/JSON-метода, включая query при REST.
//  Доступ - Структура - Логин и Пароль из ДоступIQSMS().
//  Параметры - Структура - параметр ТаймаутСекунд подключения.
//  Тело - Структура, Неопределено - без тела используется GET; с телом выполняется POST с JSON UTF-8 без BOM.
//
// Возвращаемое значение:
//  HTTPОтвет - HTTP-код и тело ответа IQSMS.
//
// Особенности:
//  Сетевой вызов не повторяется внутри функции. Исключение/таймаут не доказывают, что провайдер не принял
//   сообщение.
Функция ЗапросIQSMS(Путь, Доступ, Параметры, Тело = Неопределено)
    Соединение = Новый HTTPСоединение("api.iqsms.ru", 443, Доступ.Логин, Доступ.Пароль,
        , Параметры.ТаймаутСекунд, Новый ЗащищенноеСоединениеOpenSSL);
    ЗапросHTTP = Новый HTTPЗапрос(Путь);
    Если Тело = Неопределено Тогда
        Возврат Соединение.Получить(ЗапросHTTP);
    КонецЕсли;
    ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ЗапросHTTP.УстановитьТелоИзСтроки(ОтправкаСМС.СтрокаJSON(Тело), КодировкаТекста.UTF8,
        ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Соединение.ОтправитьДляОбработки(ЗапросHTTP);
КонецФункции

// Только документированные статусы попадают в журнал. Сырое тело и URL не логируются.
// Сопоставляет ответы JSON-пакета ожидаемым УИД сообщений по clientId.
//
// Параметры:
//  Текст - Строка - JSON-ответ send.json либо status.json.
//  ОжидаемыеУИД - Массив - УИД сообщений, переданных в исходном запросе.
//  ПроверкаСтатусов - Булево - Истина для опроса; Ложь для результатов принятия пакета.
//
// Возвращаемое значение:
//  Соответствие - ключ: строка УИД; значение: структура ОтправкаСМС.РезультатСМС().
//
// Особенности:
//  Неподтверждённые и повторяющиеся clientId остаются unknown. Сырые ответы в результат для логирования не
//   копируются.
Функция РазобратьПакет(Текст, ОжидаемыеУИД, ПроверкаСтатусов = Ложь) Экспорт
    Результаты = Новый Соответствие;
    Для Каждого УИД Из ОжидаемыеУИД Цикл
        Результаты.Вставить(Строка(УИД), ОтправкаСМС.РезультатСМС());
    КонецЦикла;
    Попытка
        Ответ = ОтправкаСМС.РазобратьJSONТекст(Текст);
        Если Ответ.status <> "ok" Или ТипЗнч(Ответ.messages) <> Тип("Массив") Тогда
            Возврат Результаты;
        КонецЕсли;
        Встреченные = Новый Соответствие;
        Для Каждого Сообщение Из Ответ.messages Цикл
            Ключ = Сообщение.clientId;
            Если ТипЗнч(Ключ) <> Тип("Строка") Или Результаты.Получить(Ключ) = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Если Встреченные.Получить(Ключ) <> Неопределено Тогда
                Результаты.Вставить(Ключ, ОтправкаСМС.РезультатСМС());
                Продолжить;
            КонецЕсли;
            Встреченные.Вставить(Ключ, Истина);
            Статус = Сообщение.status;
            Категория = КатегорияСтатуса(Статус);
            ИД = Сообщение.smscId;
            Если Не ДопустимыйИД(ИД) Или Категория = "Неизвестно" Тогда
                Продолжить;
            КонецЕсли;
            Если Не ПроверкаСтатусов И Категория <> "Принято" И Категория <> "Отказ" И Категория <> "Повтор" Тогда
                Продолжить;
            КонецЕсли;
            Результаты.Вставить(Ключ, ОтправкаСМС.РезультатСМС(Статус, ИД, Категория));
        КонецЦикла;
    Исключение
        // Неполный или некорректный ответ не является подтверждённым отказом.
    КонецПопытки;
    Возврат Результаты;
КонецФункции

// Отправляет одну SMS через выбранного провайдера.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - учётная запись.
//  Доступ - Структура - проверенные реквизиты подключения.
//  П - Структура - параметры провайдера.
//  Номер - Строка - нормализованный телефон.
//  Текст - Строка - сообщение.
//
// Возвращаемое значение:
//  Структура - результат в формате ОтправкаСМС.РезультатСМС().
Функция ОтправитьСообщение(Настройка, Доступ, П, Номер, Текст) Экспорт
    Путь = "/messages/v2/send/?phone=" + КодироватьСтроку(Номер, СпособКодированияСтроки.КодировкаURL)
        + "&text=" + КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
    Если Не ПустаяСтрока(П.ПодписьОтправителя) Тогда
        Путь = Путь + "&sender=" + КодироватьСтроку(П.ПодписьОтправителя, СпособКодированияСтроки.КодировкаURL);
    КонецЕсли;
    Ответ = ЗапросIQSMS(Путь, Доступ, П);
    Возврат ?(Ответ.КодСостояния = 200, РазобратьREST(Ответ.ПолучитьТелоКакСтроку()), ОтправкаСМС.РезультатСМС());

КонецФункции

// Запрашивает статус одной SMS через выбранного провайдера.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - учётная запись.
//  П - Структура - параметры провайдера.
//  ИД - Строка - идентификатор сообщения у провайдера.
//
// Возвращаемое значение:
//  Структура - результат в формате ОтправкаСМС.РезультатСМС().
Функция ПолучитьСтатус(Настройка, П, ИД) Экспорт
    Доступ = ДоступIQSMS(Настройка);
    Ответ = ЗапросIQSMS("/messages/v2/status/?id=" + ИД, Доступ, П);
    Если Ответ.КодСостояния = 200 Тогда
        Части = СтрРазделить(СокрЛП(Ответ.ПолучитьТелоКакСтроку()), ";", Истина);
        Если Части.Количество() = 2 И Части[0] = ИД Тогда
            Категория = КатегорияСтатуса(Части[1]);
            Если Категория <> "Неизвестно" Тогда
                Возврат ОтправкаСМС.РезультатСМС(Части[1], ИД, Категория);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Возврат ОтправкаСМС.РезультатСМС();

КонецФункции

// Направляет пакет в транспорт выбранного провайдера.
//
// Параметры:
//  Пакет - Массив - непустой пакет записей с одной учётной записью.
//  П - Структура - параметры провайдера.
//  ПроверкаСтатусов - Булево - опрашивать статусы вместо отправки.
//
// Возвращаемое значение:
//  Соответствие - нормализованные результаты по строковым УИД.
Функция ВыполнитьПакет(Пакет, П, ПроверкаСтатусов) Экспорт
    Настройка = Пакет[0].НастройкаОтправки;
    Сообщения = Новый Массив;
    УИДы = Новый Массив;
    Для Каждого Запись Из Пакет Цикл
        УИДы.Добавить(Запись.УИД);
        Если ПроверкаСтатусов Тогда
            Сообщение = Новый Структура("smscId,clientId", Запись.ИДПровайдера, Строка(Запись.УИД));
        Иначе
            Сообщение = Новый Структура("phone,text,clientId", ТелефонДляAPI(Запись.Телефон),
                Запись.ТекстОтправки, Строка(Запись.УИД));
            Если Не ПустаяСтрока(П.ПодписьОтправителя) Тогда
                Сообщение.Вставить("sender", П.ПодписьОтправителя);
            КонецЕсли;
        КонецЕсли;
        Сообщения.Добавить(Сообщение);
    КонецЦикла;
    Доступ = ДоступIQSMS(Настройка);
    Тело = Новый Структура("login,password,messages", Доступ.Логин, Доступ.Пароль, Сообщения);
    Путь = ?(ПроверкаСтатусов, "/messages/v2/status.json", "/messages/v2/send.json");
    Ответ = ЗапросIQSMS(Путь, Доступ, П, Тело);
    Если Ответ.КодСостояния = 200 Тогда
        Возврат РазобратьПакет(Ответ.ПолучитьТелоКакСтроку(), УИДы, ПроверкаСтатусов);
    КонецЕсли;
    Возврат Новый Соответствие;

КонецФункции

