// Внутренние результаты проверки не являются статусами Mindbox и не отправляются клиенту.
// Лимит задаёт вызывающий код после согласования нагрузки. Ограничение байт — на веб-сервере.
Функция РазобратьJSON(Тело, ЛимитСимволов) Экспорт
    Если ТипЗнч(Тело) <> Тип("Строка") Или ТипЗнч(ЛимитСимволов) <> Тип("Число") Тогда
        Возврат Новый Структура("Допустим,Причина,Данные", Ложь, "InvalidInput", Неопределено);
    КонецЕсли;
    Если ЛимитСимволов <= 0 Или СтрДлина(Тело) > ЛимитСимволов Тогда
        Возврат Новый Структура("Допустим,Причина,Данные", Ложь, "BodyLimit", Неопределено);
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.УстановитьСтроку(Тело);
        Данные = ПрочитатьJSON(Чтение, Истина);
        // ПрочитатьJSON само по себе допускает второй документ после первого объекта.
        Если Чтение.Прочитать() Тогда
            Чтение.Закрыть();
            Возврат Новый Структура("Допустим,Причина,Данные", Ложь, "InvalidJSON", Неопределено);
        КонецЕсли;
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        Возврат Новый Структура("Допустим,Причина,Данные", Ложь, "InvalidJSON", Неопределено);
    КонецПопытки;
    Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
        Возврат Новый Структура("Допустим,Причина,Данные", Ложь, "ObjectRequired", Неопределено);
    КонецЕсли;
    Возврат Новый Структура("Допустим,Причина,Данные", Истина, "", Данные);
КонецФункции

Функция ЗаписатьJSONОтвета(Данные) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

// CSV остаётся строкой UTF-8 без JSON-обёртки и без изменения разделителей/переводов строк.
// Проверка колонок и полноценный CSV-парсер принадлежат конкретным контрактам импорта.
Функция ПроверитьПараметрыCSV(Параметры) Экспорт
    Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Параметры.Получить("csvCodePage") = "65001"
        И Параметры.Получить("csvColumnDelimiter") = ";"
        И ТипЗнч(Параметры.Получить("transactionId")) = Тип("Строка")
        И Не ПустаяСтрока(Параметры.Получить("transactionId"));
КонецФункции
