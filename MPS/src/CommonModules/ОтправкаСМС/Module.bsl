// Читает реквизиты доступа SMS-провайдера из безопасного хранилища БСП.
//
// Параметры:
//  НастройкаСМС - СправочникСсылка.НастройкиСМС - ключ записи безопасного хранилища; пустая ссылка даёт
//   незаполненную структуру.
//  УИДФормыНастроек - УникальныйИдентификатор, Неопределено - при передаче заменяет пароль и токен маркером формы
//   для редактирования без раскрытия секретов.
//
// Возвращаемое значение:
//  Структура - Логин, Пароль, Токен и РежимТокена; без маркера формы может содержать действующие секреты.
//
// Особенности:
//  Для чтения временно включает привилегированный режим. Ошибки безопасного хранилища передаются вызывающему коду.
Функция ПолучитьНастройкиПровайдера(НастройкаСМС, УИДФормыНастроек = Неопределено) Экспорт
	
	Настройки = СтруктураНастроекПровайдера();
	Если ЗначениеЗаполнено(НастройкаСМС) Тогда
		УстановитьПривилегированныйРежим(Истина);
		НастройкиИзХранилища = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(НастройкаСМС, "Логин,Пароль,Токен,РежимТокена");
		УстановитьПривилегированныйРежим(Ложь);
		Если ТипЗнч(НастройкиИзХранилища)  = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Настройки, НастройкиИзХранилища);
			Если УИДФормыНастроек <> Неопределено Тогда
					Настройки.Пароль =  Строка(УИДФормыНастроек);
					Настройки.Токен =  Строка(УИДФормыНастроек);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	Возврат Настройки;
	
КонецФункции

// Сохраняет настройки провайдера, отличая новые секреты от маркера неизменённого значения.
//
// Параметры:
//  НастройкаСМС - СправочникСсылка.НастройкиСМС - ключ сохраняемых реквизитов доступа.
//  УИДФормыНастроек - УникальныйИдентификатор - маркер, с которым сравниваются пароль и токен.
//  Настройки - Структура - Логин, Пароль, Токен и РежимТокена; параметр изменяется: Пароль и Токен удаляются после
//   обработки.
//
// Возвращаемое значение:
//  Неопределено - функция выполняет запись без явного возвращаемого значения.
//
// Особенности:
//  Изменяет безопасное хранилище БСП в привилегированном режиме. Секрет, равный маркеру формы, сохраняет прежнее
//   значение.
Функция ЗаписатьНастройкиПровайдера(НастройкаСМС, УИДФормыНастроек, Настройки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Если Строка(УИДФормыНастроек) <> Настройки.Пароль Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(НастройкаСМС, Настройки.Пароль, "Пароль" );
	КонецЕсли;	
	Настройки.Удалить("Пароль");
	Если Строка(УИДФормыНастроек) <> Настройки.Токен Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(НастройкаСМС, Настройки.Токен, "Токен" );
	КонецЕсли;	
	Настройки.Удалить("Токен");
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(НастройкаСМС, Настройки, Неопределено);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

// Создаёт структуру реквизитов доступа, принятую существующей формой настройки SMS.
//
// Параметры: отсутствуют.
//
// Возвращаемое значение:
//  Структура - Логин, Пароль и Токен: пустые строки; РежимТокена: Ложь.
//
// Особенности:
//  СМСДисконт использует логин и пароль из общей структуры доступа.
Функция СтруктураНастроекПровайдера() Экспорт
	Возврат Новый Структура("Логин,Пароль,Токен,РежимТокена", "", "", "", Ложь);
КонецФункции	
// Общая обработка SMS, настройки провайдеров, очередь и маршрутизация запросов.
#Область Параметры
// Создаёт начальные параметры отправки, опроса статусов и обслуживания SMS-очереди.
//
// Параметры: отсутствуют.
//
// Возвращаемое значение:
//  Структура - размеры пакета и запуска, таймаут, интервалы повторов/опроса, лимит повторов и
//   подпись отправителя.
//
// Особенности:
//  Расписания и включение заданий задаются в мониторе ПКМП. Место логирования определяет модуль Логирование.
Функция ПараметрыПоУмолчанию() Экспорт
    П = Новый Структура;
    П.Вставить("РазмерПакета", 100);
    П.Вставить("ЛимитЗаЗапуск", 1000);
    П.Вставить("ТаймаутСекунд", 30);
    П.Вставить("ИнтервалПовтораСекунд", 60);
    П.Вставить("ИнтервалСтатусовСекунд", 60);
    П.Вставить("ПовторовПакетнойОтправки", 3);
    П.Вставить("ПодписьОтправителя", "");
    Возврат П;
КонецФункции

// Возвращает параметры провайдера, дополняя их начальными значениями.
//
// Параметры:
//  Провайдер - ПеречислениеСсылка.ПровайдерыСМС_ПКМП, Неопределено - ключ регистра.
//   По умолчанию используется реализованный провайдер СМСДисконт.
//
// Возвращаемое значение:
//  Структура - параметры в формате ПараметрыПоУмолчанию().
Функция ПолучитьПараметры(Провайдер = Неопределено) Экспорт
    Если Провайдер = Неопределено Тогда
        Провайдер = Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт;
    КонецЕсли;
    П = ПараметрыПоУмолчанию();
    Если ЗначениеЗаполнено(Провайдер) Тогда
        Запись = РегистрыСведений.ПараметрыПровайдеровСМС.СоздатьМенеджерЗаписи();
        Запись.Провайдер = Провайдер;
        Запись.Прочитать();
        Если Запись.Выбран() Тогда
            ЗаполнитьЗначенияСвойств(П, Запись);
        КонецЕсли;
    КонецЕсли;
    Возврат П;
КонецФункции

// Проверяет и записывает параметры для одного провайдера.
//
// Параметры:
//  Провайдер - ПеречислениеСсылка.ПровайдерыСМС_ПКМП - непустой ключ регистра.
//  Параметры - Структура - поля ПараметрыПоУмолчанию().
Процедура ЗаписатьПараметры(Провайдер, Параметры) Экспорт
    Если Не ЗначениеЗаполнено(Провайдер) Тогда
        ВызватьИсключение "SMS: укажите провайдера";
    КонецЕсли;
    ПроверитьПараметры(Параметры);
    Запись = РегистрыСведений.ПараметрыПровайдеровСМС.СоздатьМенеджерЗаписи();
    Запись.Провайдер = Провайдер;
    Запись.Прочитать();
    ЗаполнитьЗначенияСвойств(Запись, Параметры);
    Запись.Провайдер = Провайдер;
    Запись.Записать();
КонецПроцедуры

// Проверяет допустимые размеры пакета/запуска, таймаут и интервалы обработки SMS.
//
// Параметры:
//  П - Структура - параметры, полученные из ПолучитьПараметры() или формы SMS-заданий.
//
// Особенности:
//  При нарушении проверяемых ограничений вызывает исключение до запуска обработки или сохранения формы.
Процедура ПроверитьПараметры(П) Экспорт
    Если П.РазмерПакета < 1 Или П.РазмерПакета > 200
        Или П.ЛимитЗаЗапуск < 1 Или П.ЛимитЗаЗапуск > 10000
        Или П.ТаймаутСекунд < 1 Или П.ТаймаутСекунд > 120
        Или П.ИнтервалПовтораСекунд < 1 Или П.ИнтервалСтатусовСекунд < 1
        Или П.ПовторовПакетнойОтправки > 10 Тогда
        ВызватьИсключение "Недопустимые параметры обработки SMS";
    КонецЕсли;
КонецПроцедуры

// Заполняет параметры выбранного провайдера в общей форме SMS.
// Параметры:
//  Форма - УправляемаяФорма - изменяемые реквизиты Провайдер и параметры отправки.
Процедура ПрочитатьПараметрыФормы(Форма) Экспорт
    Для Каждого Свойство Из ПолучитьПараметры(Форма.Провайдер) Цикл
        Форма[Свойство.Ключ] = Свойство.Значение;
    КонецЦикла;
КонецПроцедуры

// Сохраняет параметры провайдера из общей формы SMS.
// Параметры:
//  Форма - УправляемаяФорма - провайдер и проверяемые параметры отправки.
// Особенности:
//  Расписания и включение заданий настраиваются в мониторе ПКМП.
Процедура СохранитьПараметрыФормы(Форма) Экспорт
    П = ПараметрыПоУмолчанию();
    Для Каждого Свойство Из П Цикл
        П[Свойство.Ключ] = Форма[Свойство.Ключ];
    КонецЦикла;
    ЗаписатьПараметры(Форма.Провайдер, П);
КонецПроцедуры

#КонецОбласти

#Область Протокол
// Создаёт внутреннее представление результата SMS-операции.
//
// Параметры:
//  Статус - Строка - статус провайдера или внутреннее обозначение; по умолчанию unknown.
//  ИД - Строка - идентификатор провайдера, по умолчанию пустой.
//  Категория - Строка - внутреннее решение обработчика; по умолчанию Неизвестно.
//
// Возвращаемое значение:
//  Структура - Статус, ИДПровайдера и Категория.
//
// Особенности:
//  Внутренние категории и unknown не являются статусами API Mindbox.
Функция РезультатСМС(Статус = "unknown", ИД = "", Категория = "Неизвестно") Экспорт
    Возврат Новый Структура("Статус,ИДПровайдера,Категория", Статус, ИД, Категория);
КонецФункции
// Читает строку JSON встроенными средствами платформы.
//
// Параметры:
//  Текст - Строка - JSON-ответ внешнего API.
//
// Возвращаемое значение:
//  Произвольный - значение JSON в типах платформы: структура, массив или скаляр.
//
// Особенности:
//  Синтаксические ошибки JSON передаются вызывающему обработчику; сетевой запрос не выполняется.
Функция РазобратьJSONТекст(Текст) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

// Сериализует значение платформы в JSON для IQSMS либо технологических данных действия клиента.
//
// Параметры:
//  Данные - Произвольный - структура, массив или другое значение, поддерживаемое ЗаписатьJSON.
//
// Возвращаемое значение:
//  Строка - сериализованный JSON.
//
// Особенности:
//  Вызывает исключение при неподдерживаемом значении. Полученный текст может содержать данные запроса и не
//   предназначен для сырого логирования.
Функция СтрокаJSON(Данные) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции
#КонецОбласти

#Область СинхронныйREST
// УИД используется только для корреляции логов. В очередь и действия клиента записи не добавляются.
// Синхронно отправляет SMS через выбранного провайдера с ограниченным числом подтверждённых повторов.
//
// Параметры:
//  НастройкаСМС - СправочникСсылка.НастройкиСМС - учётная запись выбранного провайдера.
//  Телефон - Строка - номер из 11 цифр с необязательным ведущим плюсом.
//  Текст - Строка - непустое сообщение в UTF-8.
//  УИД - УникальныйИдентификатор, Неопределено - корреляция логов; при отсутствии создаётся новый.
//  АктуальноЧасов - Число - срок от начала вызова; 0 допускает одну попытку, положительное значение — первую и до
//   трёх повторов в пределах срока.
//
// Возвращаемое значение:
//  Структура - Статус, ИДПровайдера и Категория в формате РезультатСМС().
//
// Особенности:
//  Пишет через Логирование, без записей в очередь и ДействияКлиентов. unknown не повторяется; отдельные вызовы с
//   тем же УИД не дедуплицируются. Сбой лога вызывает исключение, в том числе после HTTP.
Функция ОтправитьREST(НастройкаСМС, Телефон, Текст, УИД = Неопределено, АктуальноЧасов = 1) Экспорт
    Если УИД = Неопределено Тогда
        УИД = Новый УникальныйИдентификатор;
    КонецЕсли;
    П = ПолучитьПараметры(ПровайдерНастройкиСМС(НастройкаСМС));
    ПроверитьПараметры(П);
    Журнал = Логирование.ОткрытьСеанс(Перечисления.РазделыЛогирования.СМСОтправка, "rest");
    Логирование.ЗаписатьСобытие(Журнал, УИД, "rest", "start");
    Попытка
        Доступ = ПроверитьДоступСМС(НастройкаСМС);
        Номер = ТелефонПровайдера(НастройкаСМС, Телефон);
        Если ПустаяСтрока(Текст) Тогда
            ВызватьИсключение "SMS: пустой текст";
        КонецЕсли;
    Исключение
        Логирование.ЗаписатьСобытие(Журнал, УИД, "rest", "validation_failed");
        Возврат РезультатСМС("validation_failed", "", "Отказ");
    КонецПопытки;
    До = ТекущаяДатаСеанса() + АктуальноЧасов * 3600;
    Для ПопыткаОтправки = 1 По ?(АктуальноЧасов = 0, 1, 4) Цикл
        Если ПопыткаОтправки > 1 И ТекущаяДатаСеанса() >= До Тогда
            Прервать;
        КонецЕсли;
        Логирование.ЗаписатьСобытие(Журнал, УИД, "rest", "attempt", "", ПопыткаОтправки);
        Попытка
            Результат = ОтправитьЧерезПровайдера(НастройкаСМС, Доступ, П, Номер, Текст);
        Исключение
            Результат = РезультатСМС();
        КонецПопытки;
        Логирование.ЗаписатьСобытие(Журнал, УИД, "rest", Результат.Статус, Результат.ИДПровайдера, ПопыткаОтправки);
        Если Результат.Категория <> "Повтор" Тогда
            Возврат Результат;
        КонецЕсли;
    КонецЦикла;
    Если Результат.Категория = "Повтор" Тогда
        Результат.Категория = "Отказ";
        Логирование.ЗаписатьСобытие(Журнал, УИД, "rest", "retry_limit");
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Однократно запрашивает статус синхронной SMS по идентификатору провайдера.
//
// Параметры:
//  НастройкаСМС - СправочникСсылка.НастройкиСМС - доступ, использованный при отправке.
//  ИДПровайдера - Строка - идентификатор, возвращённый выбранным провайдером.
//  УИД - УникальныйИдентификатор, Неопределено - корреляция с исходным вызовом в логах.
//
// Возвращаемое значение:
//  Структура - результат в формате РезультатСМС(); неподтверждённый ответ означает unknown.
//
// Особенности:
//  Выполняет GET статуса и пишет лог. Очередь и история клиента не изменяются; сбой логирования передаётся
//   исключением.
Функция ПроверитьСтатусREST(НастройкаСМС, ИДПровайдера, УИД = Неопределено) Экспорт
    Если Не ДопустимыйИДПровайдера(НастройкаСМС, ИДПровайдера) Тогда
        ВызватьИсключение "SMS: недопустимый идентификатор провайдера";
    КонецЕсли;
    П = ПолучитьПараметры(ПровайдерНастройкиСМС(НастройкаСМС));
    ПроверитьПараметры(П);
    Журнал = Логирование.ОткрытьСеанс(Перечисления.РазделыЛогирования.СМСОтправка, "rest-status");
    Попытка
        Результат = ПолучитьСтатусУПровайдера(НастройкаСМС, П, ИДПровайдера);
    Исключение
        Результат = РезультатСМС();
    КонецПопытки;
    Логирование.ЗаписатьСобытие(Журнал, УИД, "rest-status", Результат.Статус, ИДПровайдера);
    Возврат Результат;
КонецФункции
#КонецОбласти

#Область МаршрутизацияПровайдеров
// Определяет провайдера по учётной записи SMS.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС, Неопределено - учётная запись.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ПровайдерыСМС_ПКМП - провайдер или пустая ссылка.
Функция ПровайдерНастройкиСМС(Настройка)
    Если ЗначениеЗаполнено(Настройка) Тогда
        Возврат Настройка.Провайдер;
    КонецЕсли;
    Возврат Перечисления.ПровайдерыСМС_ПКМП.ПустаяСсылка();
КонецФункции

// Проверяет реквизиты доступа по правилам выбранного провайдера.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - учётная запись.
//
// Возвращаемое значение:
//  Структура - проверенные реквизиты для запроса. Для неподдерживаемого провайдера вызывает исключение.
Функция ПроверитьДоступСМС(Настройка)
    Если ПровайдерНастройкиСМС(Настройка) = Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт Тогда
        Возврат СМСДисконт.ДоступIQSMS(Настройка);
    КонецЕсли;
    ВызватьИсключение "SMS: провайдер не поддерживается";
КонецФункции

// Отправляет одну SMS через выбранного провайдера.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - учётная запись.
//  Доступ - Структура - проверенные реквизиты подключения.
//  П - Структура - параметры провайдера.
//  Номер - Строка - нормализованный телефон.
//  Текст - Строка - сообщение.
//
// Возвращаемое значение:
//  Структура - результат в формате РезультатСМС().
Функция ОтправитьЧерезПровайдера(Настройка, Доступ, П, Номер, Текст)
    Если ПровайдерНастройкиСМС(Настройка) = Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт Тогда
        Возврат СМСДисконт.ОтправитьСообщение(Настройка, Доступ, П, Номер, Текст);
    КонецЕсли;
    ВызватьИсключение "SMS: провайдер не поддерживается";
КонецФункции

// Запрашивает статус одной SMS через выбранного провайдера.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - учётная запись.
//  П - Структура - параметры провайдера.
//  ИД - Строка - идентификатор сообщения у провайдера.
//
// Возвращаемое значение:
//  Структура - результат в формате РезультатСМС().
Функция ПолучитьСтатусУПровайдера(Настройка, П, ИД)
    Если ПровайдерНастройкиСМС(Настройка) = Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт Тогда
        Возврат СМСДисконт.ПолучитьСтатус(Настройка, П, ИД);
    КонецЕсли;
    ВызватьИсключение "SMS: провайдер не поддерживается";
КонецФункции

// Направляет пакет в транспорт выбранного провайдера.
//
// Параметры:
//  Пакет - Массив - непустой пакет записей с одной учётной записью.
//  П - Структура - параметры провайдера.
//  ПроверкаСтатусов - Булево - опрашивать статусы вместо отправки.
//
// Возвращаемое значение:
//  Соответствие - нормализованные результаты по строковым УИД.
Функция ВыполнитьЗапросПакета(Пакет, П, ПроверкаСтатусов)
    Настройка = Пакет[0].НастройкаОтправки;
    Если ПровайдерНастройкиСМС(Настройка) = Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт Тогда
        Возврат СМСДисконт.ВыполнитьПакет(Пакет, П, ПроверкаСтатусов);
    КонецЕсли;
    ВызватьИсключение "SMS: провайдер не поддерживается";
КонецФункции
#КонецОбласти

#Область Очередь
// Устанавливает исключительную управляемую блокировку и читает запись SMS-очереди по УИД.
//
// Параметры:
//  УИД - УникальныйИдентификатор - ключ записи ОчередьСМС.
//
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.ОчередьСМС - прочитанный менеджер; наличие проверяется Выбран().
//
// Особенности:
//  Вызывается внутри активной транзакции. Блокировка действует до её завершения; функция сама транзакцию не
//   начинает.
Функция ЗаблокироватьЗапись(УИД)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.ОчередьСМС");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.УстановитьЗначение("УИД", УИД);
    Блокировка.Заблокировать();
    Запись = РегистрыСведений.ОчередьСМС.СоздатьМенеджерЗаписи();
    Запись.УИД = УИД;
    Запись.Прочитать();
    Возврат Запись;
КонецФункции

// Проверяет включительную границу актуальности SMS с положительным сроком.
//
// Параметры:
//  ДатаСоздания - Дата - начало отсчёта актуальности записи.
//  Часы - Число - значение АктуальноЧасов из рассылки.
//  Сейчас - Дата - проверяемый момент в той же временной шкале.
//
// Возвращаемое значение:
//  Булево - Истина при Часы > 0 и Сейчас >= ДатаСоздания + Часы * 3600.
//
// Особенности:
//  При нуле возвращает Ложь; ограничение одной попыткой применяется отправителем отдельно.
Функция ИстекСрок(ДатаСоздания, Часы, Сейчас) Экспорт
    Возврат Часы > 0 И Сейчас >= ДатаСоздания + Часы * 3600;
КонецФункции

// Определяет терминальное внутреннее состояние записи SMS-очереди.
//
// Параметры:
//  Состояние - Строка - значение СостояниеОбработки.
//
// Возвращаемое значение:
//  Булево - Истина для Доставлено, Недоставлено, Отказ и Неактуально.
//
// Особенности:
//  Неизвестно не относится к терминальным состояниям доставки, но отдельно исключается из автоматической отправки.
Функция Завершено(Состояние)
    Возврат Состояние = "Доставлено" Или Состояние = "Недоставлено" Или Состояние = "Отказ" Или Состояние = "Неактуально";
КонецФункции

// Проверяет запись очереди и закрепляет за текущим обработчиком одну попытку отправки.
//
// Параметры:
//  УИД - УникальныйИдентификатор - ключ кандидата в ОчередьСМС.
//  П - Структура - параметры лимита повторов и таймаута.
//  Журнал - Структура - контекст Логирование.ОткрытьСеанс() для текущего запуска.
//
// Возвращаемое значение:
//  Структура, Неопределено - снимок УИД, токена захвата, настройки, телефона, текста, срока, Однократно и
//   ЧислоПопыток; либо отсутствие допуска к отправке.
//
// Особенности:
//  В короткой транзакции фиксирует текст/срок/доступ, увеличивает счётчик и устанавливает захват. Может записать
//   отказ/истечение срока и действие клиента. Прерванный захват переводит в Неизвестно; HTTP не выполняет.
Функция ЗахватитьКОтправке(УИД, П, Журнал)
    НачатьТранзакцию();
    Попытка
        З = ЗаблокироватьЗапись(УИД);
        Сейчас = ТекущаяДатаСеанса();
        Если Не З.Выбран() Или З.Неактуально Или ЗначениеЗаполнено(З.ИДПровайдера)
            Или Завершено(З.СостояниеОбработки) Или З.СостояниеОбработки = "Неизвестно"
            Или З.СледующаяПопытка > Сейчас Тогда
            ЗафиксироватьТранзакцию();
            Возврат Неопределено;
        КонецЕсли;
        Если З.СостояниеОбработки = "Отправляется" Тогда
            Прервано = Ложь;
            Если З.ЗахватДо <= Сейчас Тогда
                З.СостояниеОбработки = "Неизвестно";
                З.ПоследняяОшибка = "worker_interrupted";
                З.Записать();
                Прервано = Истина;
            КонецЕсли;
            ЗафиксироватьТранзакцию();
            Если Прервано Тогда
                Логирование.ЗаписатьСобытие(Журнал, УИД, "queue", "unknown_after_restart");
            КонецЕсли;
            Возврат Неопределено;
        КонецЕсли;
        Если З.ЧислоПопыток = 0 Тогда
            Если Не ЗначениеЗаполнено(З.Рассылка) Или Не ЗначениеЗаполнено(З.ДатаСоздания) Тогда
                З.СостояниеОбработки = "Отказ";
                З.ПоследняяОшибка = "invalid_queue_record";
                ЗаписатьДействие(З, "РассылкаНеОтправлялась");
                З.Записать();
                ЗафиксироватьТранзакцию();
                Логирование.ЗаписатьСобытие(Журнал, УИД, "queue", "invalid_queue_record");
                Возврат Неопределено;
            КонецЕсли;
            З.ТекстОтправки = З.Рассылка.Сообщение;
            З.Однократно = З.Рассылка.АктуальноЧасов = 0;
            Если Не З.Однократно Тогда
                З.АктуальноДо = З.ДатаСоздания + З.Рассылка.АктуальноЧасов * 3600;
            КонецЕсли;
            З.НастройкаОтправки = З.Рассылка.НастройкаСМС;
        КонецЕсли;
        Если Не З.Однократно И Сейчас >= З.АктуальноДо Тогда
            ПометитьНеактуальной(З);
            З.Записать();
            ЗафиксироватьТранзакцию();
            Логирование.ЗаписатьСобытие(Журнал, УИД, "queue", "expired");
            Возврат Неопределено;
        КонецЕсли;
        Если З.ЧислоПопыток >= ?(З.Однократно, 1, 1 + П.ПовторовПакетнойОтправки) Тогда
            З.СостояниеОбработки = "Отказ";
            ЗаписатьДействие(З, "РассылкаНеОтправлялась");
            З.Записать();
            ЗафиксироватьТранзакцию();
            Логирование.ЗаписатьСобытие(Журнал, УИД, "queue", "retry_limit");
            Возврат Неопределено;
        КонецЕсли;
        Попытка
            ПроверитьДоступСМС(З.НастройкаОтправки);
            ТелефонПровайдера(З.НастройкаОтправки, З.Телефон);
            Если ПустаяСтрока(З.ТекстОтправки) Тогда
                ВызватьИсключение "empty";
            КонецЕсли;
        Исключение
            З.СостояниеОбработки = "Отказ";
            З.ПоследняяОшибка = "validation_failed";
            ЗаписатьДействие(З, "РассылкаНеОтправлялась");
            З.Записать();
            ЗафиксироватьТранзакцию();
            Логирование.ЗаписатьСобытие(Журнал, УИД, "queue", "validation_failed");
            Возврат Неопределено;
        КонецПопытки;
        З.СостояниеОбработки = "Отправляется";
        З.ТокенЗахвата = Новый УникальныйИдентификатор;
        З.ЗахватДо = Сейчас + П.ТаймаутСекунд + 300;
        З.ЧислоПопыток = З.ЧислоПопыток + 1;
        З.Записать();
        Снимок = Новый Структура("УИД,ТокенЗахвата,НастройкаОтправки,Телефон,ТекстОтправки,АктуальноДо,Однократно,ЧислоПопыток");
        ЗаполнитьЗначенияСвойств(Снимок, З);
        ЗафиксироватьТранзакцию();
        Возврат Снимок;
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

// Обработчик задания №1: проверяет статусы и отправляет ограниченную выборку SMS-очереди.
//
// Параметры: отсутствуют.
//
// Особенности:
//  Учитывает блокировку внешних ресурсов. Группирует пакеты по настройке доступа, соблюдает лимиты.
//   Выполняет HTTP, изменяет очередь/историю и пишет логи; неизвестный исход не переотправляется.
Процедура ВыполнитьОтправкуОчереди() Экспорт
    Если РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
        ВызватьИсключение "Отправка приостановлена штатной блокировкой внешних ресурсов";
    КонецЕсли;
    П = ПолучитьПараметры();
    ПроверитьПараметры(П);
    Журнал = Логирование.ОткрытьСеанс(Перечисления.РазделыЛогирования.СМСОтправка, "queue");
    ОбновитьСтатусыОчереди(П, Журнал);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(П.ЛимитЗаЗапуск, "ЧГ=0") + " УИД
        |ИЗ РегистрСведений.ОчередьСМС
        |ГДЕ НЕ Неактуально И ИДПровайдера = """"
        |И СостояниеОбработки В ("""", ""Повтор"", ""Отправляется"")
        |И СледующаяПопытка <= &Сейчас
        |И ДатаСоздания >= &ГраницаХранения
        |УПОРЯДОЧИТЬ ПО ДатаСоздания");
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
    Запрос.УстановитьПараметр("ГраницаХранения", ТекущаяДатаСеанса() - 30*86400);
    Кандидаты = Запрос.Выполнить().Выгрузить();
    // Захватывать непосредственно перед пакетом, а не весь объём запуска заранее.
    Пакет = Новый Массив;
    Для Каждого Кандидат Из Кандидаты Цикл
        Снимок = ЗахватитьКОтправке(Кандидат.УИД, П, Журнал);
        Если Снимок = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если Пакет.Количество() > 0 Тогда
            Если Пакет[0].НастройкаОтправки <> Снимок.НастройкаОтправки Тогда
                ОтправитьПакетОчереди(Пакет, П, Журнал);
                Пакет.Очистить();
            КонецЕсли;
        КонецЕсли;
        Пакет.Добавить(Снимок);
        Если Пакет.Количество() >= П.РазмерПакета Тогда
            ОтправитьПакетОчереди(Пакет, П, Журнал);
            Пакет.Очистить();
        КонецЕсли;
    КонецЦикла;
    Если Пакет.Количество() > 0 Тогда
        ОтправитьПакетОчереди(Пакет, П, Журнал);
    КонецЕсли;
КонецПроцедуры

// Передаёт захваченные записи одному провайдеру и сохраняет результат каждой SMS.
//
// Параметры:
//  Пакет - Массив - снимки ЗахватитьКОтправке() с одной НастройкаОтправки; размер ограничен вызывающим кодом.
//  П - Структура - параметры HTTP и подпись отправителя.
//  Журнал - Структура - контекст общего логирования.
//
// Особенности:
//  Повторно проверяет срок перед отправкой. УИД передаётся как clientId. Неполный ответ и сетевой сбой сохраняются
//   как неизвестный исход, без повторной отправки всего пакета.
Процедура ОтправитьПакетОчереди(Пакет, П, Журнал)
    КОтправке = Новый Массив;
    Для Каждого Снимок Из Пакет Цикл
        Если Не Снимок.Однократно И ТекущаяДатаСеанса() >= Снимок.АктуальноДо Тогда
            СохранитьРезультатОчереди(Снимок, РезультатСМС("expired", "", "Неактуально"), П, Журнал);
            Продолжить;
        КонецЕсли;
        Логирование.ЗаписатьСобытие(Журнал, Снимок.УИД, "json-send", "attempt", "", Снимок.ЧислоПопыток);
        КОтправке.Добавить(Снимок);
    КонецЦикла;
    Если КОтправке.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    Результаты = Новый Соответствие;
    Попытка
        Результаты = ВыполнитьЗапросПакета(КОтправке, П, Ложь);
    Исключение
        // Таймаут после приёма пакета не даёт основания отправлять его повторно.
    КонецПопытки;
    Для Каждого Снимок Из КОтправке Цикл
        Результат = Результаты.Получить(Строка(Снимок.УИД));
        Если Результат = Неопределено Тогда
            Результат = РезультатСМС();
        КонецЕсли;
        СохранитьРезультатОчереди(Снимок, Результат, П, Журнал);
    КонецЦикла;
КонецПроцедуры

// Применяет ответ отправки только к записи с совпадающим токеном и состоянием Отправляется.
//
// Параметры:
//  Снимок - Структура - УИД и ТокенЗахвата исходной попытки.
//  Результат - Структура - Статус, ИДПровайдера и Категория из разбора ответа.
//  П - Структура - лимит и интервал повторов.
//  Журнал - Структура - контекст общего логирования.
//
// Особенности:
//  В одной транзакции сохраняет состояние/действие клиента, затем пишет лог. Принято фиксирует providerId; Повтор
//   допускается в пределах лимита и только не для Однократно. unknown сохраняется как Неизвестно.
Процедура СохранитьРезультатОчереди(Снимок, Результат, П, Журнал)
    НачатьТранзакцию();
    Попытка
        З = ЗаблокироватьЗапись(Снимок.УИД);
        Если З.Выбран() И З.ТокенЗахвата = Снимок.ТокенЗахвата И З.СостояниеОбработки = "Отправляется" Тогда
            З.Статус = Результат.Статус;
            З.ДатаПоследнегоСтатуса = ТекущаяДатаСеанса();
            З.ЗахватДо = Дата(1,1,1);
            З.ПоследняяОшибка = "";
            Если Результат.Категория = "Принято" Тогда
                З.ИДПровайдера = Результат.ИДПровайдера;
                З.СостояниеОбработки = "Принято";
                ЗаписатьДействие(З, "ОтправкаРассылки");
            ИначеЕсли Результат.Категория = "Повтор" И Не З.Однократно И З.ЧислоПопыток < 1 + П.ПовторовПакетнойОтправки Тогда
                З.СостояниеОбработки = "Повтор";
                З.СледующаяПопытка = ТекущаяДатаСеанса() + П.ИнтервалПовтораСекунд;
                З.ПоследняяОшибка = Результат.Статус;
            ИначеЕсли Результат.Категория = "Неактуально" Тогда
                ПометитьНеактуальной(З);
            ИначеЕсли Результат.Категория = "Неизвестно" Тогда
                З.СостояниеОбработки = "Неизвестно";
                З.ПоследняяОшибка = "unknown_send_result";
            Иначе
                З.СостояниеОбработки = "Отказ";
                З.ПоследняяОшибка = Результат.Статус;
                ЗаписатьДействие(З, "РассылкаНеОтправлялась");
            КонецЕсли;
            З.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Логирование.ЗаписатьСобытие(Журнал, Снимок.УИД, "json-send", Результат.Статус, Результат.ИДПровайдера);
КонецПроцедуры

// Выбирает принятые сообщения, для которых наступил срок следующей проверки статуса.
//
// Параметры:
//  П - Структура - лимит записей, размер пакета и ИнтервалСтатусовСекунд.
//  Журнал - Структура - контекст общего логирования.
//
// Особенности:
//  Группирует записи по настройке отправки и вызывает пакетный опрос. Записи в терминальных состояниях в выборку
//   не включаются.
Процедура ОбновитьСтатусыОчереди(П, Журнал)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(П.ЛимитЗаЗапуск, "ЧГ=0") + " УИД, ИДПровайдера, НастройкаОтправки
        |ИЗ РегистрСведений.ОчередьСМС
        |ГДЕ ИДПровайдера <> """" И СостояниеОбработки В (""Принято"", ""Ожидание"")
        |И ДатаПоследнегоСтатуса <= &Граница
        |УПОРЯДОЧИТЬ ПО ДатаПоследнегоСтатуса");
    Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - П.ИнтервалСтатусовСекунд);
    Строки = Запрос.Выполнить().Выгрузить();
    Пакет = Новый Массив;
    Для Каждого СтрокаОчереди Из Строки Цикл
        Если Пакет.Количество() > 0 Тогда
            Если Пакет[0].НастройкаОтправки <> СтрокаОчереди.НастройкаОтправки Тогда
                ПроверитьПакетСтатусов(Пакет, П, Журнал);
                Пакет.Очистить();
            КонецЕсли;
        КонецЕсли;
        Пакет.Добавить(СтрокаОчереди);
        Если Пакет.Количество() >= П.РазмерПакета Тогда
            ПроверитьПакетСтатусов(Пакет, П, Журнал);
            Пакет.Очистить();
        КонецЕсли;
    КонецЦикла;
    Если Пакет.Количество() > 0 Тогда
        ПроверитьПакетСтатусов(Пакет, П, Журнал);
    КонецЕсли;
КонецПроцедуры

// Запрашивает статусы пакета у провайдера и сохраняет результаты по идентификаторам сообщений.
//
// Параметры:
//  Пакет - Массив - строки выборки с УИД, ИДПровайдера и общей НастройкаОтправки.
//  П - Структура - параметры HTTP.
//  Журнал - Структура - контекст общего логирования.
//
// Особенности:
//  Обновляет время опроса и допустимые состояния, пишет логи. Отсутствие статуса не означает окончательную
//   недоставку и не запускает переотправку.
Процедура ПроверитьПакетСтатусов(Пакет, П, Журнал)
    Результаты = Новый Соответствие;
    Попытка
        Результаты = ВыполнитьЗапросПакета(Пакет, П, Истина);
    Исключение
    КонецПопытки;
    Для Каждого СтрокаОчереди Из Пакет Цикл
        Результат = Результаты.Получить(Строка(СтрокаОчереди.УИД));
        СохранитьСтатусОчереди(СтрокаОчереди.УИД, СтрокаОчереди.ИДПровайдера, Результат);
        Если Результат = Неопределено Тогда
            Результат = РезультатСМС();
        КонецЕсли;
        Логирование.ЗаписатьСобытие(Журнал, СтрокаОчереди.УИД, "json-status", Результат.Статус, СтрокаОчереди.ИДПровайдера);
    КонецЦикла;
КонецПроцедуры

// Сохраняет подтверждённый статус доставки при совпадении идентификатора провайдера.
//
// Параметры:
//  УИД - УникальныйИдентификатор - ключ сообщения в очереди.
//  ИДПровайдера - Строка - идентификатор из исходной выборки статусов.
//  Результат - Структура, Неопределено - разобранный статус либо отсутствие подтверждённого ответа.
//
// Особенности:
//  Блокирует запись в транзакции, не возвращает терминальное состояние в ожидание. При окончательной недоставке
//   добавляет действие РассылкаОкончательноНеДоставлена однократно.
Процедура СохранитьСтатусОчереди(УИД, ИДПровайдера, Результат)
    НачатьТранзакцию();
    Попытка
        З = ЗаблокироватьЗапись(УИД);
        Если З.Выбран() И Не Завершено(З.СостояниеОбработки) И З.ИДПровайдера = ИДПровайдера Тогда
            З.ДатаПоследнегоСтатуса = ТекущаяДатаСеанса();
            Если Результат <> Неопределено Тогда
                Если Результат.ИДПровайдера = З.ИДПровайдера И (Результат.Категория = "Доставлено"
                    Или Результат.Категория = "Недоставлено" Или Результат.Категория = "Ожидание") Тогда
                    З.Статус = Результат.Статус;
                    З.СостояниеОбработки = Результат.Категория;
                    Если Результат.Категория = "Недоставлено" Тогда
                        ЗаписатьДействие(З, "РассылкаОкончательноНеДоставлена");
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
            З.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
#КонецОбласти

#Область ИсторияИОчистка
// Добавляет действие клиента с устойчивым идентификатором события SMS.
//
// Параметры:
//  З - РегистрСведенийМенеджерЗаписи.ОчередьСМС - запись с клиентом, УИД, рассылкой и текущим статусом.
//  ИмяДействия - Строка - имя предопределённого элемента ВидыДействийКлиента.
//
// Особенности:
//  Вызывается под блокировкой очереди в транзакции. UUID строится из УИД и вида действия; существующее действие не
//   дублируется. При пустом клиенте запись не создаётся.
Процедура ЗаписатьДействие(З, ИмяДействия)
    Если Не ЗначениеЗаполнено(З.Клиент) Тогда
        Возврат;
    КонецЕсли;
    // Детерминированный UUID события + блокировка записи очереди обеспечивают
    // однократность даже при повторном получении статуса после перезапуска.
    Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
    Хеш.Добавить(Строка(З.УИД) + ":" + ИмяДействия);
    С = НРег(СтрЗаменить(Строка(Хеш.ХешСумма), " ", ""));
    ИД = Новый УникальныйИдентификатор(Лев(С,8)+"-"+Сред(С,9,4)+"-"+Сред(С,13,4)+"-"+Сред(С,17,4)+"-"+Сред(С,21,12));
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 УИДДействия ИЗ РегистрСведений.ДействияКлиентов ГДЕ УИДДействия = &ИД И Клиент = &Клиент");
    Запрос.УстановитьПараметр("ИД", ИД);
    Запрос.УстановитьПараметр("Клиент", З.Клиент);
    Если Не Запрос.Выполнить().Пустой() Тогда
        Возврат;
    КонецЕсли;
    Действие = РегистрыСведений.ДействияКлиентов.СоздатьМенеджерЗаписи();
    Действие.Клиент = З.Клиент;
    Действие.ДатаДействия = ТекущаяДатаСеанса();
    Действие.УИДДействия = ИД;
    Действие.ВидДействия = ПредопределенноеЗначение("Справочник.ВидыДействийКлиента." + ИмяДействия);
    Действие.Кампания = З.Рассылка;
    Действие.ОписаниеДействия = ИмяДействия;
    Действие.ТехнологическиеДанные = СтрокаJSON(Новый Структура("messageId,providerId,status", Строка(З.УИД), З.ИДПровайдера, З.Статус));
    Действие.Записать();
КонецПроцедуры

// Подготавливает отмену неотправленной SMS по истечении срока и записывает действие клиента.
//
// Параметры:
//  З - РегистрСведенийМенеджерЗаписи.ОчередьСМС - изменяемая запись под блокировкой.
//
// Особенности:
//  Устанавливает Неактуально, внутреннее состояние и expired; добавляет РассылкаНеОтправлялась. Записать()
//   менеджера вызывает внешний обработчик в той же транзакции.
Процедура ПометитьНеактуальной(З)
    З.Неактуально = Истина;
    З.СостояниеОбработки = "Неактуально";
    З.ПоследняяОшибка = "expired";
    ЗаписатьДействие(З, "РассылкаНеОтправлялась");
КонецПроцедуры

// Обработчик задания №2: помечает просроченные SMS и удаляет записи старше 30 суток.
//
// Параметры: отсутствуют.
//
// Особенности:
//  Работает порциями по лимиту запуска, блокирует записи и пропускает действующий захват отправки. Возраст
//   считается по ДатаСоздания; нулевая актуальность сама по себе не отменяет первую попытку. После очереди очищает
//   файлы SMS-логов.
Процедура ОбслужитьОчередь() Экспорт
    П = ПолучитьПараметры();
    ПроверитьПараметры(П);
    Журнал = Логирование.ОткрытьСеанс(Перечисления.РазделыЛогирования.СМСОтправка, "cleanup");
    Сейчас = ТекущаяДатаСеанса();
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(П.ЛимитЗаЗапуск, "ЧГ=0") + " УИД
        |ИЗ РегистрСведений.ОчередьСМС
        |ГДЕ (ДатаСоздания < &Граница И ДатаСоздания <> ДАТАВРЕМЯ(1,1,1))
        |ИЛИ (НЕ Неактуально И ИДПровайдера = """" И СостояниеОбработки В ("""", ""Повтор"")
        | И ((ЧислоПопыток > 0 И НЕ Однократно И АктуальноДо <= &Сейчас)
        | ИЛИ (ЧислоПопыток = 0 И Рассылка.АктуальноЧасов > 0
        | И ДОБАВИТЬКДАТЕ(ДатаСоздания, ЧАС, Рассылка.АктуальноЧасов) <= &Сейчас)))
        |УПОРЯДОЧИТЬ ПО ДатаСоздания");
    Запрос.УстановитьПараметр("Граница", Сейчас - 30*86400);
    Запрос.УстановитьПараметр("Сейчас", Сейчас);
    Кандидаты = Запрос.Выполнить().Выгрузить();
    Для Каждого Кандидат Из Кандидаты Цикл
        Событие = "";
        НачатьТранзакцию();
        Попытка
            З = ЗаблокироватьЗапись(Кандидат.УИД);
            Если З.Выбран() Тогда
                Если З.СостояниеОбработки = "Отправляется" И З.ЗахватДо > Сейчас Тогда
                    ЗафиксироватьТранзакцию();
                    Продолжить;
                КонецЕсли;
                Если ЗначениеЗаполнено(З.ДатаСоздания) И З.ДатаСоздания < Сейчас - 30*86400 Тогда
                    З.Удалить();
                    Событие = "deleted_after_30_days";
                ИначеЕсли Не З.Неактуально И Не ЗначениеЗаполнено(З.ИДПровайдера)
                    И (З.СостояниеОбработки = "" Или З.СостояниеОбработки = "Повтор") Тогда
                    Просрочено = Ложь;
                    Если З.ЧислоПопыток > 0 Тогда
                        Просрочено = Не З.Однократно И Сейчас >= З.АктуальноДо;
                    ИначеЕсли ЗначениеЗаполнено(З.Рассылка) И ЗначениеЗаполнено(З.ДатаСоздания) Тогда
                        Просрочено = ИстекСрок(З.ДатаСоздания, З.Рассылка.АктуальноЧасов, Сейчас);
                    КонецЕсли;
                    Если Просрочено Тогда
                        ПометитьНеактуальной(З);
                        З.Записать();
                        Событие = "expired";
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение
            Если ТранзакцияАктивна() Тогда
                ОтменитьТранзакцию();
            КонецЕсли;
            ВызватьИсключение;
        КонецПопытки;
        Если Не ПустаяСтрока(Событие) Тогда
            Логирование.ЗаписатьСобытие(Журнал, Кандидат.УИД, "cleanup", Событие);
        КонецЕсли;
    КонецЦикла;
    Логирование.ОчиститьФайлы(Перечисления.РазделыЛогирования.СМСОтправка);
КонецПроцедуры
#КонецОбласти


// Проверяет идентификатор сообщения по правилам выбранного провайдера.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - учётная запись.
//  ИД - Строка - идентификатор сообщения.
//
// Возвращаемое значение:
//  Булево - соответствует ли идентификатор правилам провайдера.
Функция ДопустимыйИДПровайдера(Настройка, ИД)
    Если ПровайдерНастройкиСМС(Настройка) = Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт Тогда
        Возврат СМСДисконт.ДопустимыйИД(ИД);
    КонецЕсли;
    ВызватьИсключение "SMS: провайдер не поддерживается";
КонецФункции

// Подготавливает телефон в формате выбранного провайдера.
//
// Параметры:
//  Настройка - СправочникСсылка.НастройкиСМС - учётная запись.
//  Телефон - Строка - номер клиента.
//
// Возвращаемое значение:
//  Строка - номер для запроса. При ошибке проверки вызывает исключение.
Функция ТелефонПровайдера(Настройка, Телефон)
    Если ПровайдерНастройкиСМС(Настройка) = Перечисления.ПровайдерыСМС_ПКМП.СМСДисконт Тогда
        Возврат СМСДисконт.ТелефонДляAPI(Телефон);
    КонецЕсли;
    ВызватьИсключение "SMS: провайдер не поддерживается";
КонецФункции

