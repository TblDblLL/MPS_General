// Все серверные функции маршрутизации, записи и настройки логирования.
#Область НастройкиРазделов
// Возвращает разрешённое сопоставление раздела с таблицей SQL и префиксом файлов.
//
// Параметры:
//  Раздел - ПеречислениеСсылка.РазделыЛогирования - СМСОтправка либо PushОтправка.
//
// Возвращаемое значение:
//  Структура - Таблица: имя метаданных внешней таблицы; Префикс: начало имени файлов раздела.
//
// Особенности:
//  Для неподдерживаемого раздела вызывает исключение; произвольное имя SQL-таблицы от вызывающего кода не
//   принимается.
Функция ОписаниеРаздела(Раздел) Экспорт
    Если Раздел = Перечисления.РазделыЛогирования.СМСОтправка Тогда
        Возврат Новый Структура("Таблица,Префикс", "СМСОтправка", "log-sms-");
    ИначеЕсли Раздел = Перечисления.РазделыЛогирования.PushОтправка Тогда
        Возврат Новый Структура("Таблица,Префикс", "PushОтправка", "log-push-");
    ИначеЕсли Раздел = Перечисления.РазделыЛогирования.РегламентныеЗаданияПКМП Тогда
        Возврат Новый Структура("Таблица,Префикс", "РегламентныеЗаданияПКМП", "log-jobs-");
    КонецЕсли;
    ВызватьИсключение "Неизвестный раздел логирования";
КонецФункции

// Читает настройки раздела из регистра настроек логирования.
//
// Параметры:
//  Раздел - ПеречислениеСсылка.РазделыЛогирования - раздел, для которого читаются параметры.
//
// Возвращаемое значение:
//  Структура - Раздел, Место, Каталог и ХранитьДней.
//
// Особенности:
//  При отсутствии записи возвращает файловые настройки по умолчанию.
Функция ПолучитьНастройку(Раздел) Экспорт
    ОписаниеРаздела(Раздел);
    Настройка = Новый Структура("Раздел,Место,Каталог,ХранитьДней", Раздел,
        Перечисления.МестаЛогирования.ТекстовыеФайлы, "", 30);
    Запись = РегистрыСведений.НастройкиЛогирования.СоздатьМенеджерЗаписи();
    Запись.Раздел = Раздел;
    Запись.Прочитать();
    Если Запись.Выбран() Тогда
        ЗаполнитьЗначенияСвойств(Настройка, Запись);
    КонецЕсли;
    Возврат Настройка;
КонецФункции

// Проверяет раздел, приёмник, срок хранения и абсолютный путь файлового каталога.
//
// Параметры:
//  Настройка - Структура - Раздел, Место, Каталог и ХранитьДней.
//  РазрешитьПустойКаталог - Булево - Истина допускает сохранение ещё не настроенного файлового раздела; при
//   открытии лога используется Ложь.
//
// Особенности:
//  При ошибке вызывает исключение. Для SQL каталог не требуется; права на каталог и SQL-соединение здесь не
//   проверяются.
Процедура ПроверитьНастройку(Настройка, РазрешитьПустойКаталог = Ложь) Экспорт
    ОписаниеРаздела(Настройка.Раздел);
    Если Настройка.Место <> Перечисления.МестаЛогирования.ТекстовыеФайлы
        И Настройка.Место <> Перечисления.МестаЛогирования.ВнешнийИсточник Тогда
        ВызватьИсключение "Выберите место логирования раздела";
    КонецЕсли;
    Если Настройка.Место = Перечисления.МестаЛогирования.ТекстовыеФайлы Тогда
	    Если Настройка.ХранитьДней < 1 Или Настройка.ХранитьДней > 36500 Тогда
	        ВызватьИсключение "Срок хранения текстовых файлов должен быть от 1 до 36500 дней";
	    КонецЕсли;
        Каталог = СокрЛП(Настройка.Каталог);
        Если РазрешитьПустойКаталог И ПустаяСтрока(Каталог) Тогда
            Возврат;
        КонецЕсли;
        Если ПустаяСтрока(Каталог) Или Не (Лев(Каталог,1) = "/" Или Лев(Каталог,2) = "\\"
            Или (СтрДлина(Каталог) >= 3 И Сред(Каталог,2,1) = ":" И (Сред(Каталог,3,1) = "\" Или Сред(Каталог,3,1) = "/"))) Тогда
            ВызватьИсключение "Укажите абсолютный каталог логов на сервере 1С";
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

// Сохраняет переданный набор настроек разделов в одной транзакции 1С.
//
// Параметры:
//  Настройки - Массив - структуры Раздел, Место, Каталог, ХранитьДней; допустим поднабор разделов.
//
// Особенности:
//  Сначала проверяет настройки и отсутствие повторяющихся разделов, затем блокирует и записывает соответствующие
//   строки регистра. Остальные разделы сохраняются; параметры SQL-соединения не меняются.
Процедура СохранитьНастройкиРазделов(Настройки) Экспорт
    Проверенные = Новый Соответствие;
    Для Каждого Настройка Из Настройки Цикл
        ПроверитьНастройку(Настройка, Истина);
        Если Проверенные.Получить(Настройка.Раздел) <> Неопределено Тогда
            ВызватьИсключение "Раздел логирования указан несколько раз";
        КонецЕсли;
        Проверенные.Вставить(Настройка.Раздел, Истина);
    КонецЦикла;
    НачатьТранзакцию();
    Попытка
        Для Каждого Настройка Из Настройки Цикл
            Блокировка = Новый БлокировкаДанных;
            Элемент = Блокировка.Добавить("РегистрСведений.НастройкиЛогирования");
            Элемент.УстановитьЗначение("Раздел", Настройка.Раздел);
            Блокировка.Заблокировать();
            Запись = РегистрыСведений.НастройкиЛогирования.СоздатьМенеджерЗаписи();
            ЗаполнитьЗначенияСвойств(Запись, Настройка);
            Запись.Каталог = СокрЛП(Запись.Каталог);
            Запись.Записать();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
#КонецОбласти

#Область ЗаписьСобытий
// Создаёт контекст запуска логирования с фиксированным приёмником и новым RunId.
//
// Параметры:
//  Раздел - ПеречислениеСсылка.РазделыЛогирования - раздел события.
//  Способ - Строка - обозначение операции до 32 символов, например rest или json-send.
//
// Возвращаемое значение:
//  Структура - Раздел, Место, Каталог, ХранитьДней, ИДЗапуска и Файл; для SQL Файл не используется.
//
// Особенности:
//  Проверяет настройку, создаёт файловый каталог при необходимости и записывает log_opened. При недоступном
//   приёмнике вызывает исключение до возврата контекста.
Функция ОткрытьСеанс(Раздел, Способ = "") Экспорт
    Настройка = ПолучитьНастройку(Раздел);
    ПроверитьНастройку(Настройка);
    Контекст = Новый Структура("Раздел,Место,Каталог,ХранитьДней,ИДЗапуска,Файл");
    ЗаполнитьЗначенияСвойств(Контекст, Настройка);
    Контекст.ИДЗапуска = Строка(Новый УникальныйИдентификатор);
    Если Настройка.Место = Перечисления.МестаЛогирования.ТекстовыеФайлы Тогда
        Описание = ОписаниеРаздела(Раздел);
        Контекст.Файл = Настройка.Каталог + "/" + Описание.Префикс
            + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMdd-HHmmss") + "-" + Контекст.ИДЗапуска + ".log";
        Попытка
            СоздатьКаталог(Настройка.Каталог);
        Исключение
            ОшибкаЗаписиЛога();
        КонецПопытки;
    КонецЕсли;
    ЗаписатьСобытие(Контекст, "", Способ, "log_opened");
    Возврат Контекст;
КонецФункции

// Проверяет поля события и формирует запись с новым EventId и временем UTC.
//
// Параметры:
//  Контекст - Структура - контекст ОткрытьСеанс() с разделом и ИДЗапуска.
//  УИД - УникальныйИдентификатор, Строка, Неопределено - корреляция сообщения до 36 символов; пусто для событий
//   запуска.
//  Способ - Строка - обозначение метода, до 32 символов.
//  Состояние - Строка - статус либо обезличенное событие, до 100 символов.
//  ИДПровайдера - Строка - идентификатор провайдера, до 100 символов; по умолчанию пустой.
//  НомерПопытки - Число - целое от 0 до 2147483647; 0 означает неприменимость.
//  Описание - Строка - дополнительное обезличенное описание до 2000 символов.
//
// Возвращаемое значение:
//  Структура - ИДСобытия, ВремяUTC, ИДЗапуска, ИДСообщения, Способ, Состояние, ИДПровайдера, НомерПопытки и
//   Описание.
//
// Особенности:
//  Только создаёт данные в памяти; при нарушении размеров/номера попытки вызывает исключение. Запись в приёмник
//   выполняется отдельно.
Функция НовоеСобытие(Контекст, УИД, Способ, Состояние, ИДПровайдера = "", НомерПопытки = 0, Описание = "") Экспорт
    ОписаниеРаздела(Контекст.Раздел);
    Если СтрДлина(Строка(УИД)) > 36 Или СтрДлина(Способ) > 32 Или СтрДлина(Состояние) > 100
        Или СтрДлина(ИДПровайдера) > 100 Или СтрДлина(Описание) > 2000
        Или НомерПопытки < 0 Или НомерПопытки > 2147483647 Или НомерПопытки <> Цел(НомерПопытки) Тогда
        ВызватьИсключение "Поля события логирования не соответствуют контракту";
    КонецЕсли;
    Возврат Новый Структура("ИДСобытия,ВремяUTC,ИДЗапуска,ИДСообщения,Способ,Состояние,ИДПровайдера,НомерПопытки,Описание",
        Строка(Новый УникальныйИдентификатор), ТекущаяУниверсальнаяДата(), Контекст.ИДЗапуска,
        Строка(УИД), Способ, Состояние, ИДПровайдера, НомерПопытки, Описание);
КонецФункции

// Добавляет одно событие в файловый либо SQL-приёмник выбранного контекста.
//
// Параметры:
//  Контекст - Структура - результат ОткрытьСеанс(), фиксирующий приёмник данного запуска.
//  УИД - УникальныйИдентификатор, Строка, Неопределено - идентификатор сообщения до 36 символов.
//  Способ - Строка - метод/операция до 32 символов.
//  Состояние - Строка - статус или обезличенное событие до 100 символов.
//  ИДПровайдера - Строка - идентификатор провайдера до 100 символов.
//  НомерПопытки - Число - целый номер попытки, 0 для неприменимых событий.
//  Описание - Строка - обезличенное описание до 2000 символов; секреты и текст SMS передавать нельзя.
//
// Особенности:
//  Файлы дополняет одной строкой JSON UTF-8; SQL — новым набором с Записать(Ложь), без чтения/поиска ключей. Дубли
//   допускаются. При сбое выдаёт обезличенное исключение; автоматического повтора и резервного приёмника нет.
Процедура ЗаписатьСобытие(Контекст, УИД, Способ, Состояние, ИДПровайдера = "", НомерПопытки = 0, Описание = "") Экспорт
    Событие = НовоеСобытие(Контекст, УИД, Способ, Состояние, ИДПровайдера, НомерПопытки, Описание);
    Попытка
        Если Контекст.Место = Перечисления.МестаЛогирования.ТекстовыеФайлы Тогда
            Данные = Новый Структура("eventId,timeUtc,runId,messageId,method,state,providerId,attempt,details",
                Событие.ИДСобытия, Формат(Событие.ВремяUTC,"ДФ=yyyy-MM-ddTHH:mm:ss") + "Z", Событие.ИДЗапуска,
                Событие.ИДСообщения, Способ, Состояние, ИДПровайдера, НомерПопытки, Описание);
            ЗаписьJSON = Новый ЗаписьJSON;
            ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
            ЗаписатьJSON(ЗаписьJSON, Данные);
            Текст = ЗаписьJSON.Закрыть();
            Файл = Новый ЗаписьТекста(Контекст.Файл, КодировкаТекста.UTF8, Символы.ПС, Истина);
            Файл.ЗаписатьСтроку(Текст);
            Файл.Закрыть();
        ИначеЕсли Контекст.Место = Перечисления.МестаЛогирования.ВнешнийИсточник Тогда
            Набор = НаборДляСобытия(Контекст.Раздел, Событие);
            // Только INSERT. Нет чтения, поиска ключей, отбора или замещения.
            // Не повторять при таймауте: SQL мог уже сохранить строку.
            Набор.Записать(Ложь);
        Иначе
            ВызватьИсключение "Неизвестный приёмник логирования";
        КонецЕсли;
    Исключение
        ОшибкаЗаписиЛога();
    КонецПопытки;
КонецПроцедуры

// Создаёт в памяти набор из одной записи внешней SQL-таблицы соответствующего раздела.
//
// Параметры:
//  Раздел - ПеречислениеСсылка.РазделыЛогирования - определяет таблицу в едином источнике ВнешниеЛоги.
//  Событие - Структура - результат НовоеСобытие() с полями, соответствующими метаданным таблицы.
//
// Возвращаемое значение:
//  ВнешнийИсточникДанныхТаблицаНаборЗаписей - новый заполненный набор из одной строки.
//
// Особенности:
//  Метод не читает и не записывает строки SQL. НомерЗаписи остаётся read-only и должен генерироваться IDENTITY
//   физической таблицы при вставке.
Функция НаборДляСобытия(Раздел, Событие)
    Описание = ОписаниеРаздела(Раздел);
    Набор = ВнешниеИсточникиДанных.ВнешниеЛоги.Таблицы[Описание.Таблица].СоздатьНаборЗаписей();
    Строка = Набор.Добавить();
    ЗаполнитьЗначенияСвойств(Строка, Событие);
    // НомерЗаписи: read-only IDENTITY SQL Server, приложение не присваивает его.
    Возврат Набор;
КонецФункции

// Регистрирует обезличенный сбой приёмника и прерывает вызывающую обработку исключением.
//
// Параметры: отсутствуют.
//
// Особенности:
//  Пишет событие Логирование.ОшибкаЗаписи в журнал регистрации, затем всегда вызывает исключение. Сырой
//   SQL/ODBC-ответ и строка соединения в сообщение не включаются.
Процедура ОшибкаЗаписиЛога()
    ЗаписьЖурналаРегистрации("Логирование.ОшибкаЗаписи", УровеньЖурналаРегистрации.Ошибка, , ,
        "Не удалось записать событие в выбранное место логирования");
    // Сырые SQL/ODBC-ошибки могут содержать строку соединения и секреты.
    ВызватьИсключение "Не удалось записать лог. Проверьте настройки раздела и доступность приёмника";
КонецПроцедуры

// Удаляет устаревшие файлы только выбранного файлового раздела.
//
// Параметры:
//  Раздел - ПеречислениеСсылка.РазделыЛогирования - раздел, чьи настройки и префикс используются.
//
// Особенности:
//  Без рекурсии удаляет файлы старше ХранитьДней по UTC; для SMS также учитывает iqsms-*.log. Для SQL завершается
//   без подключения и DELETE. Ошибки доступа к файлам передаются вызывающему коду.
Процедура ОчиститьФайлы(Раздел) Экспорт
    Настройка = ПолучитьНастройку(Раздел);
    Если Настройка.Место <> Перечисления.МестаЛогирования.ТекстовыеФайлы Тогда
        Возврат;
    КонецЕсли;
    ПроверитьНастройку(Настройка);
    Маски = Новый Массив;
    Маски.Добавить(ОписаниеРаздела(Раздел).Префикс + "*.log");
    Если Раздел = Перечисления.РазделыЛогирования.СМСОтправка Тогда
        Маски.Добавить("iqsms-*.log");
    КонецЕсли;
    Для Каждого Маска Из Маски Цикл
        Для Каждого Файл Из НайтиФайлы(Настройка.Каталог, Маска, Ложь) Цикл
            Если Файл.ЭтоФайл() И Файл.ПолучитьУниверсальноеВремяИзменения() < ТекущаяУниверсальнаяДата() - Настройка.ХранитьДней*86400 Тогда
                УдалитьФайлы(Файл.ПолноеИмя);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    // SQL-логи этим механизмом никогда не обновляются и не удаляются.
КонецПроцедуры
#КонецОбласти

#Область ФормаИСоединение
// Заполняет фиксированный перечень разделов и безопасно отображаемые общие параметры SQL-соединения.
//
// Параметры:
//  Форма - УправляемаяФорма - таблица Разделы и поля подключения; изменяется процедурой.
//
// Особенности:
//  Читает регистр и штатные общие параметры ВнешниеЛоги. Пароль не возвращает на клиент; строку со встроенными
//   реквизитами доступа скрывает целиком. Флаги изменения соединения сбрасывает.
Процедура ПрочитатьФорму(Форма) Экспорт
    Форма.Разделы.Очистить();
    Для Каждого Раздел Из Перечисления.РазделыЛогирования Цикл
        Строка = Форма.Разделы.Добавить();
        ЗаполнитьЗначенияСвойств(Строка, ПолучитьНастройку(Раздел));
    КонецЦикла;
    П = ВнешниеИсточникиДанных.ВнешниеЛоги.ПолучитьОбщиеПараметрыСоединения();
    Если П.СтрокаСоединения <> Неопределено Тогда
        // Встроенные секреты не возвращаются на клиент. Пароль имеет отдельное поле.
        Если Не СодержитУчетныеДанные(П.СтрокаСоединения) Тогда
            Форма.СтрокаСоединения = П.СтрокаСоединения;
        КонецЕсли;
    КонецЕсли;
    Если П.ИмяПользователя <> Неопределено Тогда
        Форма.Пользователь = П.ИмяПользователя;
    КонецЕсли;
    Форма.АутентификацияОС = П.АутентификацияОС = Истина;
    Форма.Пароль = "";
    Форма.ИзменитьПароль = Ложь;
    Форма.ИзменитьСоединение = Ложь;
КонецПроцедуры

// Определяет наличие UID/PWD или параметров аутентификации в ODBC-строке.
//
// Параметры:
//  СтрокаСоединения - Строка - проверяемая ODBC-строка.
//
// Возвращаемое значение:
//  Булево - Истина, если вне значений в фигурных скобках найден запрещённый ключ.
//
// Особенности:
//  Учитывает точки с запятой внутри фигурных скобок и экранированное }}. Соединение не устанавливает; полную
//   проверку корректности ODBC-строки не выполняет.
Функция СодержитУчетныеДанные(СтрокаСоединения) Экспорт
    // Разбираем разделители ODBC вне {...}, в том числе экранированное }}.
    ВнутриСкобок = Ложь;
    Токен = "";
    Позиция = 1;
    Пока Позиция <= СтрДлина(СтрокаСоединения) + 1 Цикл
        Символ = Сред(СтрокаСоединения, Позиция, 1);
        Если Символ = "{" Тогда
            ВнутриСкобок = Истина;
        ИначеЕсли Символ = "}" Тогда
            Если ВнутриСкобок И Сред(СтрокаСоединения, Позиция+1, 1) = "}" Тогда
                Токен = Токен + "}}";
                Позиция = Позиция + 2;
                Продолжить;
            КонецЕсли;
            ВнутриСкобок = Ложь;
        КонецЕсли;
        Если (Символ = ";" И Не ВнутриСкобок) Или Позиция > СтрДлина(СтрокаСоединения) Тогда
            Равно = СтрНайти(Токен, "=");
            Если Равно > 0 Тогда
                Ключ = НРег(СокрЛП(Лев(Токен, Равно-1)));
                Если Ключ = "pwd" Или Ключ = "password" Или Ключ = "uid" Или Ключ = "user id"
                    Или Ключ = "userid" Или Ключ = "username" Или Ключ = "user name"
                    Или Ключ = "authentication" Или Ключ = "trusted_connection" Или Ключ = "integrated security" Тогда
                    Возврат Истина;
                КонецЕсли;
            КонецЕсли;
            Токен = "";
        Иначе
            Токен = Токен + Символ;
        КонецЕсли;
        Позиция = Позиция + 1;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Сохраняет настройки всех разделов и, по явному флагу, общие параметры внешнего источника.
//
// Параметры:
//  Форма - УправляемаяФорма, Структура - Разделы, параметры соединения и флаги его изменения; после успеха пароль
//   и флаги очищаются.
//
// Особенности:
//  Проверяет перечень разделов. Общие параметры соединения сохраняются перед транзакцией регистра; эти две
//   операции не атомарны. При снятом флаге соединение не меняется.
Процедура СохранитьФорму(Форма) Экспорт
    Настройки = Новый Массив;
    Для Каждого Строка Из Форма.Разделы Цикл
        Настройка = Новый Структура("Раздел,Место,Каталог,ХранитьДней");
        ЗаполнитьЗначенияСвойств(Настройка, Строка);
        ПроверитьНастройку(Настройка, Истина);
        Настройки.Добавить(Настройка);
    КонецЦикла;
    ЧислоРазделов = 0;
    Для Каждого Раздел Из Перечисления.РазделыЛогирования Цикл
        ЧислоРазделов = ЧислоРазделов + 1;
    КонецЦикла;
    Если Настройки.Количество() <> ЧислоРазделов Тогда
        ВызватьИсключение "Форма должна содержать все разделы логирования";
    КонецЕсли;
    Если Форма.ИзменитьСоединение Тогда
        СохранитьСоединение(Форма);
    КонецЕсли;
    СохранитьНастройкиРазделов(Настройки);
    Форма.Пароль = "";
    Форма.ИзменитьПароль = Ложь;
    Форма.ИзменитьСоединение = Ложь;
КонецПроцедуры

// Сохраняет общие параметры MS SQL в штатных настройках источника ВнешниеЛоги.
//
// Параметры:
//  Форма - УправляемаяФорма, Структура - СтрокаСоединения, Пользователь, АутентификацияОС, ИзменитьПароль и
//   Пароль.
//
// Особенности:
//  Запрещает UID/PWD в ODBC-строке; применяет ОС- либо стандартную аутентификацию. Пароль меняет только по флагу.
//   Требует административных прав; разрывает соединение текущего сеанса. Ошибки возвращает без секретов.
Процедура СохранитьСоединение(Форма)
    Если ПустаяСтрока(Форма.СтрокаСоединения) Или СодержитУчетныеДанные(Форма.СтрокаСоединения) Тогда
        ВызватьИсключение "Укажите ODBC-строку без UID/PWD и параметров аутентификации; используйте отдельные поля формы";
    КонецЕсли;
    Если Не Форма.АутентификацияОС И ПустаяСтрока(Форма.Пользователь) Тогда
        ВызватьИсключение "Заполните пользователя MS SQL";
    КонецЕсли;
    Попытка
        Источник = ВнешниеИсточникиДанных.ВнешниеЛоги;
        П = Источник.ПолучитьОбщиеПараметрыСоединения();
        П.СУБД = "MSSQLServer";
        П.СтрокаСоединения = Форма.СтрокаСоединения;
        П.АутентификацияОС = Форма.АутентификацияОС;
        П.АутентификацияСтандартная = Не Форма.АутентификацияОС;
        П.ИмяПользователя = ?(Форма.АутентификацияОС, "", Форма.Пользователь);
        Если Форма.ИзменитьПароль Тогда
            П.Пароль = Форма.Пароль;
        КонецЕсли;
        Источник.УстановитьОбщиеПараметрыСоединения(П);
        Источник.РазорватьСоединение();
    Исключение
        ВызватьИсключение "Не удалось сохранить общие параметры ВнешниеЛоги. Проверьте права администратора источника";
    КонецПопытки;
КонецПроцедуры

// Пробует подключиться к ВнешниеЛоги с уже сохранёнными эффективными параметрами платформы.
//
// Параметры: отсутствуют.
//
// Особенности:
//  Устанавливает соединение; таблицы и возможность INSERT не проверяет. При ошибке выдаёт обезличенное исключение.
//   Настройки формы автоматически не сохраняет.
Процедура ПроверитьСоединение() Экспорт
    Попытка
        ВнешниеИсточникиДанных.ВнешниеЛоги.УстановитьСоединение();
    Исключение
        ВызватьИсключение "Не удалось подключиться к ВнешниеЛоги. Проверьте сохранённые параметры и ODBC-драйвер на сервере 1С";
    КонецПопытки;
КонецПроцедуры

// Проверяет запись в приёмник выбранного раздела по сохранённым настройкам.
//
// Параметры:
//  Раздел - ПеречислениеСсылка.РазделыЛогирования - раздел, выделенный пользователем для проверки.
//
// Особенности:
//  Намеренно добавляет два события: log_opened и test_event, способ settings-test. Для SQL это реальные вставки;
//   сообщения клиентам не отправляет.
Процедура ЗаписатьТестовоеСобытие(Раздел) Экспорт
    Контекст = ОткрытьСеанс(Раздел, "settings-test");
    ЗаписатьСобытие(Контекст, "", "settings-test", "test_event");
КонецПроцедуры
#КонецОбласти
