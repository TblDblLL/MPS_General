// Копирует переданный текст в буфер обмена и выводит пользователю оповещение о результате.
//
// Параметры:
//   ЗначениеДляВставки - Строка - текст, помещаемый в буфер обмена
Асинх Процедура СкопироватьСтрокуВБуферОбмена(ЗначениеДляВставки) Экспорт
	
	РезультатВставкиУспешен = Ложь;
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно() и ЗначениеЗаполнено(ЗначениеДляВставки) Тогда
		ФорматДанных = СтандартныйФорматДанныхБуфераОбмена.Текст;
		Если Ждать СредстваБуфераОбмена.ПоддерживаетсяФорматДанных(ФорматДанных) Тогда
		            ЭлементБуфераОбмена = Новый ЭлементБуфераОбмена(ФорматДанных, ЗначениеДляВставки);
		            РезультатВставкиУспешен = Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ЭлементБуфераОбмена);
		КонецЕсли;
	КонецЕсли;
	
	Если 	РезультатВставкиУспешен Тогда
		ПоказатьОповещениеПользователя("Cкопировано в буфер обмена", , ЗначениеДляВставки);	
	Иначе
		ПоказатьОповещениеПользователя("Не скопировано в буфер обмена", , ЗначениеДляВставки);
	КонецЕсли;	

	

КонецПроцедуры

// Формирует текстовое состояние о введённом тексте (длина, рекомендуемая длина, количество разделов,
// признак превышения максимума) и при наличии подходящего элемента формы выводит его в заголовок.
//
// Параметры:
//   Текст - Строка - анализируемый текст.
//   МаксимальнаяДлина - Число - допустимая длина текста, 0 - не ограничена.
//   РекомендованнаяДлинаДо - Число - рекомендуемая длина текста, 0 - не задана; при 0 и заданной
//                          МаксимальнаяДлина принимается равной ей.
//   ЭлементТекста - ПолеФормы, Неопределено - поле ввода, заголовок которого отображает состояние.
//   РазмерЧасти - Число, Неопределено - размер одной части сообщения для расчёта количества разделов,
//                 Неопределено или 0 - не рассчитывается.
//   НадписьСостояния - ДекорацияФормы, Неопределено - надпись, заголовок которой отображает состояние;
//                      имеет приоритет над ЭлементТекста.
//
// Возвращаемое значение:
//   Строка - сформированное описание состояния текста.
Функция ПриИзмененииТекста(Текст, МаксимальнаяДлина = 0, Знач РекомендованнаяДлинаДо = 0, ЭлементТекста = Неопределено, РазмерЧасти = Неопределено, НадписьСостояния = Неопределено) Экспорт
	
	Если НадписьСостояния <> Неопределено и НадписьСостояния.ПоложениеЗаголовка <> ПоложениеЗаголовкаЭлементаФормы.Нет 	Тогда
		Получатель = НадписьСостояния;
	ИначеЕсли 	ЭлементТекста <> Неопределено и ТипЗнч(ЭлементТекста)=Тип("ПолеФормы") и ЭлементТекста.ПоложениеЗаголовка <> ПоложениеЗаголовкаЭлементаФормы.Нет 	Тогда
		Получатель = ЭлементТекста;
	Иначе
		Получатель = Неопределено;
	КонецЕсли;		
	
	
	Если РекомендованнаяДлинаДо = 0 и МаксимальнаяДлина <> 0 Тогда
		РекомендованнаяДлинаДо = МаксимальнаяДлина;
	КонецЕсли;	
	
	ДлинаВсего = СтрДлина(Текст);
	СостояниеТекста = СтрШаблон("Символов: %1%2",ДлинаВсего,?(МаксимальнаяДлина = 0,""," из "+МаксимальнаяДлина));
	
	Если РекомендованнаяДлинаДо <> 0 Тогда
		СостояниеТекста = СостояниеТекста + СтрШаблон(" (рекомендовано символов - %1)", РекомендованнаяДлинаДо);
	КонецЕсли;	
		
	Если РазмерЧасти <> Неопределено и РазмерЧасти > 0  Тогда
		ЦелыхЧастей = Цел(ДлинаВсего/РазмерЧасти);
		Если ЦелыхЧастей*РазмерЧасти = ДлинаВсего Тогда
			Разделов = ЦелыхЧастей;
		Иначе
			Разделов = ЦелыхЧастей + 1;
		КонецЕсли;	
		СостояниеТекста = СостояниеТекста + СтрШаблон(", разделов сообщения %1", Разделов);	
	КонецЕсли;
		
	Если МаксимальнаяДлина <> 0 и ДлинаВсего>МаксимальнаяДлина Тогда
		Если не Получатель = Неопределено Тогда
			Получатель.ЦветТекстаЗаголовка = WEBЦвета.Красный;
		КонецЕсли;
		СостояниеТекста = СостояниеТекста + " превышение максимального размера строки"; 
	Иначе	
		Если не Получатель = Неопределено Тогда
			Получатель.ЦветТекстаЗаголовка = Новый Цвет;
		КонецЕсли;	
	КонецЕсли;	
	
	Если не Получатель = Неопределено Тогда
		Получатель.Заголовок = СостояниеТекста;
	КонецЕсли;
	
	
	Возврат СостояниеТекста;	
КонецФункции	

