// Копирует переданный текст в буфер обмена и выводит пользователю оповещение о результате.
//
// Параметры:
//   ЗначениеДляВставки - Строка - текст, помещаемый в буфер обмена
Асинх Процедура СкопироватьСтрокуВБуферОбмена(ЗначениеДляВставки) Экспорт
	
	РезультатВставкиУспешен = Ложь;
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно() и ЗначениеЗаполнено(ЗначениеДляВставки) Тогда
		ФорматДанных = СтандартныйФорматДанныхБуфераОбмена.Текст;
		Если Ждать СредстваБуфераОбмена.ПоддерживаетсяФорматДанных(ФорматДанных) Тогда
		            ЭлементБуфераОбмена = Новый ЭлементБуфераОбмена(ФорматДанных, ЗначениеДляВставки);
		            РезультатВставкиУспешен = Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ЭлементБуфераОбмена);
		КонецЕсли;
	КонецЕсли;
	
	Если 	РезультатВставкиУспешен Тогда
		ПоказатьОповещениеПользователя("Cкопировано в буфер обмена", , ЗначениеДляВставки);	
	Иначе
		ПоказатьОповещениеПользователя("Не скопировано в буфер обмена", , ЗначениеДляВставки);
	КонецЕсли;	

	

КонецПроцедуры

// Формирует и отображает состояние текста: количество символов, максимальную и рекомендованную
// длину, число разделов сообщения, а также подсвечивает превышение максимального размера.
//
// Параметры:
//   Текст - Строка - анализируемый текст.
//   МаксимальнаяДлина - Число - предельно допустимое количество символов; 0 - ограничение не задано.
//   РекомендованнаяДлинаДо - Число - рекомендуемое количество символов; 0 - не задано. Если превышает
//                          МаксимальнаяДлина, приравнивается к ней.
//   ЭлементТекста - ПолеФормы, Неопределено - поле ввода, в заголовке которого отображается состояние
//                  текста; используется, если у поля задан заголовок.
//   РазмерЧасти - Число, Неопределено - размер одной части сообщения для расчета количества разделов;
//                Неопределено или 0 - количество разделов не рассчитывается.
//   ЭлементНадписиСостоянияТекста - ДекорацияФормы, Неопределено - надпись для вывода состояния текста;
//                                  имеет приоритет над ЭлементТекста.
//
// Возвращаемое значение:
//   Строка - сформированное состояние текста.
Функция ПриИзмененииТекста(Текст, МаксимальнаяДлина = 0, РекомендованнаяДлинаДо = 0, РазмерЧасти = 0, ЭлементНадпись = Неопределено, НормальныйЦвет = Неопределено) Экспорт
	
	Если МаксимальнаяДлина <> 0 и (РекомендованнаяДлинаДо = 0 или РекомендованнаяДлинаДо>МаксимальнаяДлина)  Тогда
		РекомендованнаяДлинаДо = МаксимальнаяДлина;
	КонецЕсли;	
	
	ДлинаВсего = СтрДлина(Текст);
	СостояниеТекста = СтрШаблон("Символов: %1 %2",ДлинаВсего,?(МаксимальнаяДлина = 0,""," (максимум - "+МаксимальнаяДлина+")"));
	
	Если РекомендованнаяДлинаДо <> 0 Тогда
		СостояниеТекста = СостояниеТекста + СтрШаблон(", (рекомендовано символов - %1)", РекомендованнаяДлинаДо);
	КонецЕсли;	
		
	Если РазмерЧасти > 0  Тогда
		ЦелыхЧастей = Цел(ДлинаВсего/РазмерЧасти);
		Если ЦелыхЧастей*РазмерЧасти = ДлинаВсего Тогда
			Разделов = ЦелыхЧастей;
		Иначе
			Разделов = ЦелыхЧастей + 1;
		КонецЕсли;	
		СостояниеТекста = СостояниеТекста + СтрШаблон(", разделов сообщения  - %1", Разделов);	
	КонецЕсли;
	
	Если не ЭлементНадпись = Неопределено Тогда
		Если не МаксимальнаяДлина = 0 и ДлинаВсего>МаксимальнаяДлина Тогда
			СостояниеТекста = СостояниеТекста + ", превышена максимальная длина";
			ЭлементНадпись.ЦветТекста = WEBЦвета.Красный;
		Иначе		
			ЭлементНадпись.ЦветТекста = ?(НормальныйЦвет = Неопределено,Новый Цвет,НормальныйЦвет);
		КонецЕсли;	
		ЭлементНадпись.Заголовок = СостояниеТекста;
	КонецЕсли;	
		
	Возврат СостояниеТекста;	
	
КонецФункции	

