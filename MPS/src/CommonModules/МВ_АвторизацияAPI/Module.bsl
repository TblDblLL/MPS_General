// Настройки передаются только серверным адаптером защищённого хранилища.
// Структура строки: EndpointId, Секрет, Канал, Активен. Нет доверия к User-Agent.
// Это проверка пары ключ/endpoint; права операций проверяются отдельно диспетчером.
Функция ОпределитьКанал(EndpointId, ЗаголовокАвторизации, Настройки) Экспорт
    Если ТипЗнч(EndpointId) <> Тип("Строка") Или ТипЗнч(ЗаголовокАвторизации) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если ПустаяСтрока(EndpointId) Или ТипЗнч(Настройки) <> Тип("Массив") Тогда
        Возврат Неопределено;
    КонецЕсли;
    НайденнаяНастройка = Неопределено;
    Для Каждого Настройка Из Настройки Цикл
        Если ТипЗнч(Настройка) <> Тип("Структура") Тогда
            Возврат Неопределено;
        КонецЕсли;
        Если Не Настройка.Свойство("EndpointId") Или Не Настройка.Свойство("Секрет")
            Или Не Настройка.Свойство("Канал") Или Не Настройка.Свойство("Активен") Тогда
            Возврат Неопределено;
        КонецЕсли;
        Если ТочноеСовпадение(Настройка.EndpointId, EndpointId) Тогда
            // Дублирующая конфигурация endpoint — ошибка, даже если один ключ подходит.
            Если НайденнаяНастройка <> Неопределено Тогда
                Возврат Неопределено;
            КонецЕсли;
            НайденнаяНастройка = Настройка;
        КонецЕсли;
    КонецЦикла;
    Если НайденнаяНастройка = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Настройка = НайденнаяНастройка;
    Если ТипЗнч(Настройка.Активен) <> Тип("Булево") Или Настройка.Активен <> Истина
        Или ТипЗнч(Настройка.Секрет) <> Тип("Строка") Или ПустаяСтрока(Настройка.Секрет) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Настройка.Канал <> "Web" И Настройка.Канал <> "Android" И Настройка.Канал <> "iOS" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Не ТочноеСовпадение(ЗаголовокАвторизации, "Mindbox secretKey=""" + Настройка.Секрет + """") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Настройка.Канал;
КонецФункции

Функция ТочноеСовпадение(Левая, Правая)
    Если ТипЗнч(Левая) <> Тип("Строка") Или ТипЗнч(Правая) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрДлина(Левая) <> СтрДлина(Правая) Тогда
        Возврат Ложь;
    КонецЕсли;
    Различия = 0;
    Для Позиция = 1 По СтрДлина(Левая) Цикл
        Если КодСимвола(Левая, Позиция) <> КодСимвола(Правая, Позиция) Тогда
            Различия = Различия + 1;
        КонецЕсли;
    КонецЦикла;
    Возврат Различия = 0;
КонецФункции
