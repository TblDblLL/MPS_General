// Сопоставляет вид задания с его метаданными. Пустые и посторонние значения запрещены.
Функция МетаданныеЗадания(ВидЗадания)
    Виды = Перечисления.ВидыРегламентныхЗаданийПКМП;
    Если ВидЗадания = Виды.ОтправкаСМС Тогда
        Возврат Метаданные.РегламентныеЗадания.ОтправкаСМС;
    ИначеЕсли ВидЗадания = Виды.ОчисткаОчередиСМС Тогда
        Возврат Метаданные.РегламентныеЗадания.ОчисткаОчередиСМС;
    ИначеЕсли ВидЗадания = Виды.ОтправкаPushПКМП Тогда
        Возврат Метаданные.РегламентныеЗадания.ОтправкаPushПКМП;
    КонецЕсли;
    ВызватьИсключение "Выберите вид регламентного задания ПКМП";
КонецФункции

Функция ЭкземплярЗадания(ВидЗадания)
    МетаданныеВида = МетаданныеЗадания(ВидЗадания);
    Найденные = РегламентныеЗаданияСервер.НайтиЗадания(
        Новый Структура("Метаданные", МетаданныеВида));
    Если Найденные.Количество() > 1 Тогда
        ВызватьИсключение "Обнаружено несколько экземпляров задания " + Строка(ВидЗадания);
    КонецЕсли;
    Если Найденные.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Найденные[0];
КонецФункции

Функция СостояниеЗадания(ВидЗадания)

	Запись = РегистрыСведений.СостоянияЗаданийПКМП.СоздатьМенеджерЗаписи();
    Запись.Задание = ВидЗадания;
    Запись.Прочитать();
    Если Не Запись.Выбран() Тогда
        Запись.Задание = ВидЗадания;
        Запись.Порог = 3;
        Запись.Допуск = 45;
    КонецЕсли;
    Возврат Запись;  
	
КонецФункции

Функция Приостановлено(ВидЗадания)
    Возврат ВидЗадания <> Перечисления.ВидыРегламентныхЗаданийПКМП.ОчисткаОчередиСМС
        И РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована();
КонецФункции

Процедура ЗаполнитьФорму(Форма) Экспорт
    РегламентныеЗаданияСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
    Форма.Задания.Очистить();
    Для Каждого ВидЗадания Из Перечисления.ВидыРегламентныхЗаданийПКМП Цикл
        Запись = СостояниеЗадания(ВидЗадания);
        Задание = ЭкземплярЗадания(ВидЗадания);
        Строка = Форма.Задания.Добавить();
        ЗаполнитьЗначенияСвойств(Строка, Запись);
        Строка.Включено = Задание <> Неопределено И Задание.Использование;
        Если Задание <> Неопределено Тогда
            Строка.Расписание = Строка(РегламентныеЗаданияСервер.РасписаниеРегламентногоЗадания(
                Задание.УникальныйИдентификатор));
        КонецЕсли;
        Если Не Строка.Включено Тогда
            Строка.Статус = "Выключено";
        ИначеЕсли Приостановлено(ВидЗадания) Тогда
            Строка.Статус = "Приостановлено";
        ИначеЕсли Запись.Проверено < ТекущаяДатаСеанса() - 180 Тогда
            Строка.Статус = "Данные монитора устарели";
        ИначеЕсли Запись.Тревога Тогда
            Строка.Статус = "Пропущены плановые запуски";
        ИначеЕсли Запись.ИсторияНеполна Тогда
            Строка.Статус = "История неполна после простоя";
        Иначе
            Строка.Статус = "Под контролем";
        КонецЕсли;
        Строка.Тревога = Строка.Включено И Не Приостановлено(ВидЗадания) И Запись.Тревога;
    КонецЦикла;
КонецПроцедуры

Функция ПрочитатьРасписание(ВидЗадания) Экспорт
    РегламентныеЗаданияСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
    Задание = ЭкземплярЗадания(ВидЗадания);
    Если Задание <> Неопределено Тогда
        Возврат РегламентныеЗаданияСервер.РасписаниеРегламентногоЗадания(Задание.УникальныйИдентификатор);
    КонецЕсли;
    Расписание = Новый РасписаниеРегламентногоЗадания;
    Расписание.ПериодПовтораДней = 1;
    Расписание.ПериодПовтораВТечениеДня = ?(
        ВидЗадания = Перечисления.ВидыРегламентныхЗаданийПКМП.ОчисткаОчередиСМС, 3600, 60);
    Возврат Расписание;
КонецФункции

Процедура Сохранить(ВидЗадания, Включено, Порог, Допуск, Расписание = Неопределено) Экспорт
    РегламентныеЗаданияСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
    Если Порог < 1 Или Допуск < 1 Или Допуск > 3600 Тогда
        ВызватьИсключение "Укажите порог от 1 и допуск от 1 до 3600 секунд";
    КонецЕсли;
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьСостояние(ВидЗадания);
        Задание = ЭкземплярЗадания(ВидЗадания);
        НовоеРасписание = Расписание <> Неопределено;
        Если Не НовоеРасписание Тогда
            Расписание = ПрочитатьРасписание(ВидЗадания);
        КонецЕсли;
        Если Расписание.ПаузаПовтора > 0 Тогда
            ВызватьИсключение "Для контроля плановых окон задайте период повтора без паузы после завершения";
        КонецЕсли;
        Если Расписание.ПериодПовтораВТечениеДня > 0 И Допуск >= Расписание.ПериодПовтораВТечениеДня Тогда
            ВызватьИсключение "Допуск должен быть меньше периода повтора в течение дня";
        КонецЕсли;
        СброситьОтсчет = (Задание = Неопределено) Или НовоеРасписание;
        Если Задание = Неопределено Тогда
            Параметры = Новый Структура("Метаданные,Использование,Расписание,Ключ",
                МетаданныеЗадания(ВидЗадания), Включено, Расписание, МетаданныеЗадания(ВидЗадания).Имя);
            РегламентныеЗаданияСервер.ДобавитьЗадание(Параметры);
        Иначе
            СброситьОтсчет = СброситьОтсчет Или Задание.Использование <> Включено;
            Параметры = Новый Структура("Использование", Включено);
            Если НовоеРасписание Тогда
                Параметры.Вставить("Расписание", Расписание);
            КонецЕсли;
            РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, Параметры);
        КонецЕсли;
        Запись = СостояниеЗадания(ВидЗадания);
        Если СброситьОтсчет Или Запись.Допуск <> Допуск Тогда
            СброситьСостояние(Запись, ТекущаяДатаСеанса());
        КонецЕсли;
        Запись.Порог = Порог;
        Запись.Допуск = Допуск;
        Запись.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ЗаблокироватьСостояние(ВидЗадания)
    МетаданныеЗадания(ВидЗадания);
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.СостоянияЗаданийПКМП");
    Элемент.УстановитьЗначение("Задание", ВидЗадания);
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура СброситьСостояние(Запись, Сейчас)
    Запись.Проверено = Сейчас;
    Запись.ПровереноДо = Сейчас;
    Запись.ПлановоеОкно = Дата(1, 1, 1);
    Запись.Пропуски = 0;
    Запись.Тревога = Ложь;
    Запись.ИсторияНеполна = Ложь;
КонецПроцедуры

// The scheduler supplies the original scheduled job on automatic background runs.
// Manual runs via BSP have a key but lack this association.
Процедура ПроверитьЗадания() Экспорт
    ОшибкаПроверки = Ложь;
    Для Каждого ВидЗадания Из Перечисления.ВидыРегламентныхЗаданийПКМП Цикл
        Попытка
            ПроверитьЗадание(ВидЗадания);
        Исключение
            ОшибкаПроверки = Истина;
            ЗаписьЖурналаРегистрации("МониторПКМП.ОшибкаПроверки",
                УровеньЖурналаРегистрации.Ошибка, , , МетаданныеЗадания(ВидЗадания).Имя);
        КонецПопытки;
    КонецЦикла;
    Если ОшибкаПроверки Тогда
        ВызватьИсключение "МониторПКМП: ошибка проверки заданий";
    КонецЕсли;
    Логирование.ОчиститьФайлы(Перечисления.РазделыЛогирования.РегламентныеЗаданияПКМП);
КонецПроцедуры

Процедура ПроверитьЗадание(ВидЗадания)
    Сейчас = ТекущаяДатаСеанса();
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьСостояние(ВидЗадания);
        Задание = ЭкземплярЗадания(ВидЗадания);
        Если Задание <> Неопределено Тогда
            Запись = СостояниеЗадания(ВидЗадания);
            Если Не Задание.Использование Или Приостановлено(ВидЗадания)
                Или Не ЗначениеЗаполнено(Запись.ПровереноДо) Тогда
                СброситьСостояние(Запись, Сейчас);
            Иначе
                ПроверитьОкна(Запись, Задание.УникальныйИдентификатор, Сейчас);
            КонецЕсли;
            Запись.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Если Задание <> Неопределено Тогда
        ВыгрузитьСобытие(ВидЗадания);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОкна(Запись, Идентификатор, Сейчас)
    Если Не ПустаяСтрока(Запись.Событие) Тогда
        Возврат;
    КонецЕсли;
    Расписание = РегламентныеЗаданияСервер.РасписаниеРегламентногоЗадания(Идентификатор);
    Регламентное = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(Идентификатор);
    История = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("РегламентноеЗадание", Регламентное));
    ОбработатьОкна(Запись, Расписание, История, Сейчас);
КонецПроцедуры

Процедура ОбработатьОкна(Запись, Расписание, История, Сейчас)
    // A background history is short-lived. Never assert missed runs after a blind period.
    Если Запись.ПровереноДо < Сейчас - 1800 Тогда
        Запись.ИсторияНеполна = Истина;
        Запись.ПровереноДо = Сейчас - Запись.Допуск;
        Запись.ПлановоеОкно = Дата(1, 1, 1);
        Запись.Пропуски = 0;
    КонецЕсли;
    Момент = Запись.ПровереноДо + 1;
    Граница = Сейчас - Запись.Допуск;
    Пока Момент <= Граница Цикл
        Если Расписание.ТребуетсяВыполнение(Момент, Запись.ПлановоеОкно, Запись.ПлановоеОкно) Тогда
            Если Не ЗначениеЗаполнено(Запись.ПлановоеОкно)
                И Расписание.ПериодПовтораВТечениеДня > 0 Тогда
                // Establish the phase of a repeating schedule at its first native dispatch.
                ГраницаФазы = Момент + Расписание.ПериодПовтораВТечениеДня;
                ПервыйСтарт = ПервыйПлановыйСтарт(История, Момент, ГраницаФазы);
                Если Не ЗначениеЗаполнено(ПервыйСтарт) И Сейчас < ГраницаФазы
                    Или ПервыйСтарт > Граница Тогда
                    Момент = Момент - 1;
                    Прервать;
                КонецЕсли;
                Если ЗначениеЗаполнено(ПервыйСтарт) Тогда
                    Момент = ПервыйСтарт;
                КонецЕсли;
            КонецЕсли;
            Запись.ПлановоеОкно = Момент;
            Успех = УспешноеОкончание(История, Момент, Момент + Запись.Допуск);
            Если Успех > Запись.ПоследнийУспех Тогда
                Запись.ПоследнийУспех = Успех;
                Запись.Пропуски = 0;
                Запись.ИсторияНеполна = Ложь;
            Иначе
                Запись.Пропуски = Запись.Пропуски + 1;
            КонецЕсли;
            Тревога = Запись.Пропуски >= Запись.Порог;
            Если Тревога <> Запись.Тревога Тогда
                Запись.Тревога = Тревога;
                Запись.Событие = ?(Тревога, "schedule_missed", "schedule_recovered");
                Запись.ОкноСобытия = Момент;
                Запись.ПропускиСобытия = Запись.Пропуски;
                Прервать;
            КонецЕсли;
        КонецЕсли;
        Момент = Момент + 1;
    КонецЦикла;
    Запись.ПровереноДо = Макс(Запись.ПровереноДо, Мин(Граница, Момент));
    Запись.Проверено = Сейчас;
КонецПроцедуры

Функция ПервыйПлановыйСтарт(История, Начало, Конец)
    ПервыйСтарт = Дата(1, 1, 1);
    Для Каждого Фон Из История Цикл
        Если Фон.Начало >= Начало И Фон.Начало < Конец
            И (Не ЗначениеЗаполнено(ПервыйСтарт) Или Фон.Начало < ПервыйСтарт) Тогда
            ПервыйСтарт = Фон.Начало;
        КонецЕсли;
    КонецЦикла;
    Возврат ПервыйСтарт;
КонецФункции

Функция УспешноеОкончание(История, НачалоОкна, КонецОкна)
    Успех = Дата(1, 1, 1);
    Для Каждого Фон Из История Цикл
        Если Фон.Состояние = СостояниеФоновогоЗадания.Завершено
            И Фон.Начало >= НачалоОкна И Фон.Начало <= Фон.Конец И Фон.Конец <= КонецОкна Тогда
            Успех = Макс(Успех, Фон.Конец);
        КонецЕсли;
    КонецЦикла;
    Возврат Успех;
КонецФункции

Процедура ВыгрузитьСобытие(ВидЗадания)
    Запись = СостояниеЗадания(ВидЗадания);
    Если ПустаяСтрока(Запись.Событие) Тогда
        Возврат;
    КонецЕсли;
    Контекст = Логирование.ОткрытьСеанс(Перечисления.РазделыЛогирования.РегламентныеЗаданияПКМП, "monitor");
    Описание = МетаданныеЗадания(ВидЗадания).Имя + " | " + Формат(Запись.ОкноСобытия, "ДФ=yyyy-MM-dd HH:mm:ss")
        + " | " + Строка(Запись.ПропускиСобытия);
    Логирование.ЗаписатьСобытие(Контекст, "", "monitor", Запись.Событие, "", 0, Описание);
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьСостояние(ВидЗадания);
        Текущее = СостояниеЗадания(ВидЗадания);
        Если Текущее.Событие = Запись.Событие И Текущее.ОкноСобытия = Запись.ОкноСобытия Тогда
            Текущее.Событие = "";
            Текущее.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
