//
Функция НоваяДекорацияКартинка(Форма, НаименованиеЭлемента, Картинка = Неопределено, Родитель = Неопределено, ЭлементПеред = Неопределено) Экспорт 
							
	Элементы = Форма.Элементы;						
	
	Если Элементы.Найти(НаименованиеЭлемента) <> Неопределено Тогда
		Возврат Неопределено
	КонецЕсли;	
	
	ИницилизоватьРодительЭлементПеред(Форма, НаименованиеЭлемента, Родитель, ЭлементПеред); 
	
	// Создадим элемент
	Элемент = Элементы.Вставить(НаименованиеЭлемента, Тип("ДекорацияФормы"), Родитель, ЭлементПеред);	
