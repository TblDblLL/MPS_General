#Область СозданиеЭлементов

// Функци добавления поля ввода.
// 
// Параметры - 
// Имя.
// Путь к данным.
// Родитель.
// Элемент, перед которым создавать.
Функция НовоеПолеВвода(Форма, Знач НаименованиеЭлемента, Знач ПутьКДанным, Знач Родитель = Неопределено, Знач ЭлементПеред = Неопределено, Знач КнопкаОчистки = Ложь) Экспорт 
							
	Элементы = Форма.Элементы;						
	
	Если Элементы.Найти(НаименованиеЭлемента) <> Неопределено Тогда
		
		// Повторное создание элемента.
		Возврат Неопределено;		
	КонецЕсли;	
	
	ИницилизоватьРодительЭлементПеред(Форма, НаименованиеЭлемента, Родитель, ЭлементПеред);
	
	// Создадим элемент
	Элемент = Элементы.Вставить(НаименованиеЭлемента, Тип("ПолеФормы"), Родитель, ЭлементПеред);
	Элемент.Вид 			= ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным 	= ПутьКДанным;
	Элемент.КнопкаОчистки 	= КнопкаОчистки;
	
	Возврат Элемент;             

КонецФункции

