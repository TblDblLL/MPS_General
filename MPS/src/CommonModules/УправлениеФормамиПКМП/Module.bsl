// Процедура добавления группы формы.
// 
// Параметры - 
// Имя.
// Заголовок.
// ВидГруппы.  
// Родитель.
// Элемент, перед которым создавать.
Функция НоваяГруппа(Форма, Знач НаименованиеЭлемента, Знач Заголовок, Знач ВидГруппы = Неопределено, Знач  Родитель = Неопределено, Знач ЭлементПеред = Неопределено) Экспорт
							
	Элементы = Форма.Элементы;						
	
	Если Элементы.Найти(НаименованиеЭлемента) <> Неопределено Тогда
		
		// Повторное создание элемента.
		Возврат Неопределено;		
	КонецЕсли;
	
	ИницилизоватьРодительЭлементПеред(Форма, НаименованиеЭлемента, Родитель, ЭлементПеред);
	
	// Создадим элемент
	Элемент = Элементы.Вставить(НаименованиеЭлемента, Тип("ГруппаФормы"), Родитель, ЭлементПеред);
	
	Если ВидГруппы = Неопределено Тогда
		Элемент.Вид 	  = ВидГруппыФормы.ОбычнаяГруппа;
	Иначе			
		Элемент.Вид 	  = ВидГруппы;
	КонецЕсли;	
	
	Если ПустаяСтрока(Заголовок) и Элемент.Вид = ВидГруппыФормы.ОбычнаяГруппа Тогда
		Элемент.ОтображатьЗаголовок = Ложь;
	Иначе
		Элемент.Заголовок = Заголовок;
	КонецЕсли;		
	
	Возврат Элемент;

КонецФункции

// Процедура добавления группы формы.
// 
// Параметры - 
// Имя.
// Заголовок.
// НаименованиеСтраниц - Структура с названиями страниц, где ключ - это имя, а значение - заголовок. 
Функция НоваяГруппаСтраницы(Форма, Знач НаименованиеЭлемента, Знач Заголовок, Знач НаименованиеСтраниц, Знач Родитель = Неопределено, Знач ЭлементПеред = Неопределено) Экспорт
	
	Элементы = Форма.Элементы;						
	
	Если Элементы.Найти(НаименованиеЭлемента) <> Неопределено Тогда
		
		// Повторное создание элемента.
		Возврат Неопределено;		
	КонецЕсли;
	
	ИницилизоватьРодительЭлементПеред(Форма, НаименованиеЭлемента, Родитель, ЭлементПеред);
	
	// Создадим элемент
	Элемент = Элементы.Вставить(НаименованиеЭлемента, Тип("ГруппаФормы"), Родитель, ЭлементПеред);
	Элемент.Вид = ВидГруппыФормы.Страницы;	
	
	Элемент.Заголовок = Заголовок;
			
	Для Каждого ЭлементСтруктуры Из НаименованиеСтраниц Цикл
		Заголовок = ?(ЭлементСтруктуры.Значение.Свойство("Заголовок"), ЭлементСтруктуры.Значение.Заголовок, ""); 
		Группа = НоваяГруппа(Форма, ЭлементСтруктуры.Ключ, Заголовок , ВидГруппыФормы.Страница, НаименованиеЭлемента);
		Для Каждого ЗначениеСвойства Из ЭлементСтруктуры.Значение Цикл
			Группа[ЗначениеСвойства.Ключ] = ЗначениеСвойства.Значение;
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат Элемент;

КонецФункции	

// Процедура добавления команды формы.
//
Функция НоваяКомандаФормы(Форма, Знач НаименованиеЭлемента, Знач Заголовок, Знач Отображение, Знач Действие, Знач ИзменяетСохраняемыеДанные = Истина) Экспорт
	
	Команды = Форма.Команды;
	
	НоваяКомандаФормы = Команды.Добавить(НаименованиеЭлемента);
	НоваяКомандаФормы.Заголовок 				= Заголовок;
	НоваяКомандаФормы.ИзменяетСохраняемыеДанные = ИзменяетСохраняемыеДанные;
	НоваяКомандаФормы.Отображение 				= Отображение;	
	НоваяКомандаФормы.Действие 					= Действие;	
	
	Возврат НоваяКомандаФормы
	
КонецФункции	

// Процедура добавления новой кпопки формы.
//
Функция НоваяКнопкаФормы(Форма, НаименованиеЭлемента, Знач ВидКнопки, Знач ИмяКоманды, Знач Родитель = Неопределено, Знач ЭлементПеред = Неопределено, Знач ИспользоватьКоманднуюПанель = Ложь) Экспорт
	
	Элементы = Форма.Элементы;
	
	ИницилизоватьРодительЭлементПеред(Форма, НаименованиеЭлемента, Родитель, ЭлементПеред, ИспользоватьКоманднуюПанель);
		
	НоваяКнопкаФормы = Элементы.Вставить(НаименованиеЭлемента, Тип("КнопкаФормы"), Родитель, ЭлементПеред);
	НоваяКнопкаФормы.Вид = ВидКнопки;
	НоваяКнопкаФормы.ИмяКоманды = ИмяКоманды;
	
	Возврат НоваяКнопкаФормы
	
КонецФункции	

// Процедура добавления новой колонки Табличной части.
//
Функция НоваяКолонкаТаблицыФормы(Форма, Элемент, Имя, Заголовок, ПутьКДанным) Экспорт
	
	Элементы = Форма.Элементы;
	
	КолонкаСтоимость = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элемент);
	КолонкаСтоимость.ПутьКДанным		 				= ПутьКДанным;
	КолонкаСтоимость.Заголовок							= Заголовок;
	КолонкаСтоимость.Вид				 				= ВидПоляФормы.ПолеВвода;
	
	Возврат КолонкаСтоимость;
КонецФункции

