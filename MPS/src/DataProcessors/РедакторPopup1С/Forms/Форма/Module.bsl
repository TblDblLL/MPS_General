Функция Шаблон_simple_html(ПараметрыШаблона)
    Результат = "";
    Результат = Результат + "<div id=""popmechanic-form"">" + Символы.ПС +
    "    ";
    Если ПараметрыШаблона.showurl <> 0 Тогда
        Результат = Результат + "" + Символы.ПС +
        "    <a class=""popmechanic-link"" href=""";
        Результат = Результат + ЗначениеШаблона(ПараметрыШаблона, "url", Ложь);
        Результат = Результат + """ target=""_blank"" data-popmechanic-submit>" + Символы.ПС +
        "    ";
    КонецЕсли;
    Результат = Результат + "" + Символы.ПС +
    "        <img src=""";
    Результат = Результат + ЗначениеШаблона(ПараметрыШаблона, "image", Ложь);
    Результат = Результат + """/>" + Символы.ПС +
    "    ";
    Если ПараметрыШаблона.showurl <> 0 Тогда
        Результат = Результат + " </a> ";
    КонецЕсли;
    Результат = Результат + "" + Символы.ПС +
    "    " + Символы.ПС +
    "    <div class=""popmechanic-close"" data-popmechanic-close>&times;</div>" + Символы.ПС +
    "</div>";
    Возврат Результат;
КонецФункции

