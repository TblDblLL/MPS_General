#Область СозданиеФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Popup — настройки средствами 1С";
    НачальныеЗначения();
    Режим = "simple";
    Устройство = Перечисления.ТипыУстройствОтображения.Компьютер;
    ШиринаОкна = 900;
    //CATALOG_INIT
    Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
        ЗагрузитьНаСервере();
    Иначе
        НаименованиеPopup = "Новый popup";
        ИсходныйJSON = "";
        СинхронизироватьПоля();
        ОбновитьРезультат();
    КонецЕсли;
    ЕстьИзменения = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ПреобразованиеЦветов

&НаКлиентеНаСервереБезКонтекста
Функция ИзHEX(Текст)
    Алфавит = "0123456789abcdef";
    Значения = Новый Массив;
    Для Позиция = 2 По 6 Цикл
        Если Позиция % 2 <> 0 Тогда
            Продолжить;
        КонецЕсли;
        СтаршийПолубайт = СтрНайти(Алфавит, НРег(Сред(Текст, Позиция, 1))) - 1;
        МладшийПолубайт = СтрНайти(Алфавит, НРег(Сред(Текст, Позиция + 1, 1))) - 1;
        Если СтаршийПолубайт < 0 Или МладшийПолубайт < 0 Тогда
            ВызватьИсключение "Неверный цвет HEX.";
        КонецЕсли;
        Значения.Добавить(СтаршийПолубайт * 16 + МладшийПолубайт);
    КонецЦикла;
    Возврат Новый Цвет(Значения[0], Значения[1], Значения[2]);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВHEX(ЦветЗначение)
    Алфавит = "0123456789abcdef";
    Результат = "#";
    Компоненты = Новый Массив;
    Компоненты.Добавить(ЦветЗначение.Красный);
    Компоненты.Добавить(ЦветЗначение.Зеленый);
    Компоненты.Добавить(ЦветЗначение.Синий);
    Для Каждого КомпонентаЦвета Из Компоненты Цикл
        Результат = Результат + Сред(Алфавит, Цел(КомпонентаЦвета / 16) + 1, 1) + Сред(Алфавит, КомпонентаЦвета % 16 + 1, 1);
    КонецЦикла;
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область ИнтерактивныеНастройки

&НаСервере
Процедура СинхронизироватьПоля()
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ЗначениеПоля = ЭтотОбъект[ОписаниеПараметра.Имя];
        Если ОписаниеПараметра.Вид = "number" Тогда
            ЭтотОбъект[ОписаниеПараметра.Имя + "_Scale"] = Окр((ЗначениеПоля - ОписаниеПараметра.Минимум) / ОписаниеПараметра.Шаг, 0);
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "color" Тогда
            Элементы["Input_" + ОписаниеПараметра.Имя].ЦветФона = ЗначениеПоля;
        КонецЕсли;
    КонецЦикла;
    УстройстваОтображенияПКМП.ПрименитьВидимость(ЭтотОбъект, Устройство, ПривязкиНастроекУстройств(), ГруппыНастроекУстройств(), Поиск, Режим);
КонецПроцедуры

&НаКлиенте
Процедура ПолзунокИзменен(Элемент) Экспорт
    Имя = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 8);
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        Если ОписаниеПараметра.Имя = Имя Тогда
            ЭтотОбъект[Имя] = Окр(ОписаниеПараметра.Минимум + ЭтотОбъект[Имя + "_Scale"] * ОписаниеПараметра.Шаг, 4);
            Прервать;
        КонецЕсли;
    КонецЦикла;
    ПараметрИзменен(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПараметрИзменен(Элемент) Экспорт
    ЕстьИзменения = Истина;
    Попытка
        ОбновитьРезультат();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура РежимИзменен(Элемент)
    ПараметрИзменен(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПоискИзменен(Элемент)
    СинхронизироватьПоля();
КонецПроцедуры

&НаКлиенте
Процедура УстройствоИзменено(Элемент) Экспорт
    УстройствоИзмененоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЦветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    Диалог = Новый ДиалогВыбораЦвета;
    Имя = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 7);
    Диалог.Цвет = ЭтотОбъект[Имя];
    Диалог.Показать(Новый ОписаниеОповещения("ЦветВыбран", ЭтотОбъект, Имя));
КонецПроцедуры

&НаКлиенте
Процедура ЦветВыбран(ВыбранныйЦвет, Имя) Экспорт
    Если ВыбранныйЦвет = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ЭтотОбъект[Имя] = ВыбранныйЦвет;
    ПараметрИзменен(Элементы["Input_" + Имя]);
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Изображения PNG, JPEG, GIF, WebP|*.png;*.jpg;*.jpeg;*.gif;*.webp";
    Диалог.Показать(Новый ОписаниеОповещения("ИзображениеВыбрано", ЭтотОбъект, Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 7)));
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеВыбрано(Файлы, Имя) Экспорт
    Если Файлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Файл = Новый Файл(Файлы[0]);
    Если Файл.Размер() > 4 * 1024 * 1024 Тогда
        Сообщить("Максимальный размер изображения — 4 МБ.");
        Возврат;
    КонецЕсли;
    Расширение = НРег(Файл.Расширение);
    Если Расширение = ".jpg" Или Расширение = ".jpeg" Тогда
        MIME = "image/jpeg";
    ИначеЕсли Расширение = ".png" Тогда
        MIME = "image/png";
    ИначеЕсли Расширение = ".gif" Тогда
        MIME = "image/gif";
    ИначеЕсли Расширение = ".webp" Тогда
        MIME = "image/webp";
    Иначе
        Сообщить("Выберите PNG, JPEG, GIF или WebP.");
        Возврат;
    КонецЕсли;
    Данные = Новый ДвоичныеДанные(Файлы[0]);
    ЭтотОбъект[Имя] = "data:" + MIME + ";base64," + СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ПС, ""), Символы.ВК, "");
    ПараметрИзменен(Элементы["Input_" + Имя]);
КонецПроцедуры

#КонецОбласти

#Область ФормированиеРезультата

&НаСервере
Функция СобратьСостояние()
    Простые = Новый Структура;
    Полные = Новый Структура;
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ЗначениеПараметра = ЭтотОбъект[ОписаниеПараметра.Имя];
        Если ОписаниеПараметра.Вид = "bool" Тогда
            ЗначениеПараметра = ?(ЗначениеПараметра, 1, 0);
        ИначеЕсли ОписаниеПараметра.Вид = "color" Тогда
            ЗначениеПараметра = ВHEX(ЗначениеПараметра);
        КонецЕсли;
        ПроверитьЗначение(ОписаниеПараметра, ЗначениеПараметра);
        ПараметрыРежима = ?(ОписаниеПараметра.Режим = "simple", Простые, Полные);
        ПараметрыРежима.Вставить(ОписаниеПараметра.Ключ, ЗначениеПараметра);
    КонецЦикла;
    Возврат Новый Структура("version,mode,profiles", 1, Режим, Новый Структура("simple,full", Простые, Полные));
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьЗначение(ОписаниеПараметра, ЗначениеПараметра)
    Если ОписаниеПараметра.Вид = "number" Тогда
        Если ТипЗнч(ЗначениеПараметра) <> Тип("Число") Тогда
            ВызватьИсключение "Ожидается число: " + ОписаниеПараметра.Ключ;
        КонецЕсли;
        Если ЗначениеПараметра < ОписаниеПараметра.Минимум Или ЗначениеПараметра > ОписаниеПараметра.Максимум Тогда
            ВызватьИсключение "Недопустимое значение " + ОписаниеПараметра.Ключ + ": от " + Строка(ОписаниеПараметра.Минимум) + " до " + Строка(ОписаниеПараметра.Максимум);
        КонецЕсли;
    ИначеЕсли ОписаниеПараметра.Вид = "bool" Тогда
        Если ЗначениеПараметра <> 0 И ЗначениеПараметра <> 1 Тогда
            ВызватьИсключение "Флаг должен быть 0 или 1: " + ОписаниеПараметра.Ключ;
        КонецЕсли;
    Иначе
        Если ТипЗнч(ЗначениеПараметра) <> Тип("Строка") Тогда
            ВызватьИсключение "Ожидается строка: " + ОписаниеПараметра.Ключ;
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "color" Тогда
            Если СтрДлина(ЗначениеПараметра) <> 7 Или Лев(ЗначениеПараметра, 1) <> "#" Тогда
                ВызватьИсключение "Неверный цвет: " + ОписаниеПараметра.Ключ;
            КонецЕсли;
            ИзHEX(ЗначениеПараметра);
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "image" Или ОписаниеПараметра.Ключ = "url" Или ОписаниеПараметра.Ключ = "link_url" Тогда
            Если Не ПустаяСтрока(ЗначениеПараметра) И Лев(НРег(ЗначениеПараметра), 7) <> "http://" И Лев(НРег(ЗначениеПараметра), 8) <> "https://" И Не (ОписаниеПараметра.Вид = "image" И Лев(ЗначениеПараметра, 11) = "data:image/") Тогда
                ВызватьИсключение "Нужен HTTP(S) адрес или встроенное изображение: " + ОписаниеПараметра.Ключ;
            КонецЕсли;
        КонецЕсли;
        Если ОписаниеПараметра.Ключ = "form_font" Или ОписаниеПараметра.Ключ = "custom_font" Тогда
            Для Каждого Символ Из СтрРазделить(";|{|}|<|>|\", "|") Цикл
                Если СтрНайти(ЗначениеПараметра, Символ) > 0 Тогда
                    ВызватьИсключение "Недопустимый символ в имени шрифта.";
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "select" И ЗначениеПараметра <> "link" И ЗначениеПараметра <> "close" И ЗначениеПараметра <> "form" Тогда
            ВызватьИсключение "Неверное действие кнопки.";
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭкранироватьHTML(ЭкранируемыйТекст)
    ЭкранируемыйТекст = СтрЗаменить(ЭкранируемыйТекст, "&", "&amp;");
    ЭкранируемыйТекст = СтрЗаменить(ЭкранируемыйТекст, "<", "&lt;");
    ЭкранируемыйТекст = СтрЗаменить(ЭкранируемыйТекст, ">", "&gt;");
    ЭкранируемыйТекст = СтрЗаменить(ЭкранируемыйТекст, """", "&quot;");
    Возврат СтрЗаменить(ЭкранируемыйТекст, "'", "&#39;");
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеШаблона(ПараметрыШаблона, Ключ, ЭтоCSS)
    ЗначениеПараметра = ПараметрыШаблона[Ключ];
    Если ТипЗнч(ЗначениеПараметра) = Тип("Число") Тогда
        Возврат Формат(ЗначениеПараметра, "ЧГ=0;ЧРД=.;ЧН=0");
    КонецЕсли;
    Если Не ЭтоCSS Тогда
        Возврат ЭкранироватьHTML(ЗначениеПараметра);
    КонецЕсли;
    Если Ключ = "form_bg_img" Или Ключ = "bg_img_top_mobile" Тогда
        ЗначениеПараметра = СтрЗаменить(СтрЗаменить(ЗначениеПараметра, "\", "\\"), """", "\""");
        ЗначениеПараметра = СтрЗаменить(СтрЗаменить(ЗначениеПараметра, Символы.ПС, ""), Символы.ВК, "");
        Возврат """" + СтрЗаменить(ЗначениеПараметра, "<", "\3c ") + """";
    КонецЕсли;
    Если Ключ = "timer_days" Или Ключ = "timer_hours" Или Ключ = "timer_minutes" Или Ключ = "timer_seconds" Тогда
        ЗначениеПараметра = СтрЗаменить(СтрЗаменить(ЗначениеПараметра, "\", "\\"), """", "\""");
        ЗначениеПараметра = СтрЗаменить(СтрЗаменить(ЗначениеПараметра, Символы.ПС, "\a "), Символы.ВК, "");
    КонецЕсли;
    Возврат СтрЗаменить(ЗначениеПараметра, "<", "\3c ");
КонецФункции

&НаСервере
Процедура ОбновитьРезультат() Экспорт
    СинхронизироватьПоля();
    СостояниеНастроек = СобратьСостояние();
    Если СостояниеНастроек.mode <> "simple" И СостояниеНастроек.mode <> "full" Тогда
        ВызватьИсключение "Выберите режим шаблона.";
    КонецЕсли;
    Если ШиринаОкна < 240 Или ШиринаОкна > 1600 Тогда
        ВызватьИсключение "Ширина окна: от 240 до 1600 px.";
    КонецЕсли;
    КодУстройстваCSS = УстройстваОтображенияПКМП.КодCSS(Устройство);
    Если Режим = "simple" Тогда
        ГотовыйHTML = Шаблон_simple_html(СостояниеНастроек.profiles.simple);
        ГотовыйCSS = Шаблон_simple_css(СостояниеНастроек.profiles.simple) + Символы.ПС + "#popmechanic-form { position: relative; }";
    Иначе
        ГотовыйHTML = Шаблон_full_html(СостояниеНастроек.profiles.full);
        ГотовыйCSS = Шаблон_full_css(СостояниеНастроек.profiles.full) + Символы.ПС + "#popmechanic-form .popmechanic-image { background-size:contain; background-repeat:no-repeat; }";
    КонецЕсли;
    ТекстПросмотра = ГотовыйHTML;
    Для Каждого Единица Из СтрРазделить("days,hours,minutes,seconds", ",") Цикл
        Цифры = ?(Единица = "days", "02", ?(Единица = "hours", "12", ?(Единица = "minutes", "34", "56")));
        ТекстПросмотра = СтрЗаменить(ТекстПросмотра, "data-popmechanic-timer=""timer:" + Единица + """></div>", "data-popmechanic-timer=""timer:" + Единица + """><span class=""popmechanic-timer-digit"">" + Цифры + "</span></div>");
    КонецЦикла;
    HTMLРезультат = "<!doctype html><html lang=""ru""><head><meta charset=""utf-8""><style>" + ГотовыйCSS + "html,body{margin:0;font-family:Arial;background:#e8edf4}body{padding:20px}.preview{width:" + Формат(ШиринаОкна, "ЧГ=0;ЧРД=.;ЧН=0") + "px;position:relative}</style></head><body><div class=""preview popmechanic-" + КодУстройстваCSS + """>" + ТекстПросмотра + "</div><p style=""color:#64748b;font-size:12px"">Предпросмотр. Таймер демонстрационный; действия подключаются скриптами сайта.</p></body></html>";
КонецПроцедуры

&НаКлиенте
Процедура ПредпросмотрПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ХранениеНастроек

&НаСервере
Процедура ПрименитьJSON(ТекстJSON)
    ЗначениеПараметра = Неопределено;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    СостояниеНастроек = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Если СостояниеНастроек.version <> 1 Или (СостояниеНастроек.mode <> "simple" И СостояниеНастроек.mode <> "full") Тогда
        ВызватьИсключение "Неподдерживаемый формат настроек.";
    КонецЕсли;
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ПараметрыРежима = СостояниеНастроек.profiles[ОписаниеПараметра.Режим];
        Если ПараметрыРежима.Свойство(ОписаниеПараметра.Ключ, ЗначениеПараметра) Тогда
            ПроверитьЗначение(ОписаниеПараметра, ЗначениеПараметра);
        КонецЕсли;
    КонецЦикла;
    НачальныеЗначения();
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ПараметрыРежима = СостояниеНастроек.profiles[ОписаниеПараметра.Режим];
        Если ПараметрыРежима.Свойство(ОписаниеПараметра.Ключ, ЗначениеПараметра) Тогда
            Если ОписаниеПараметра.Вид = "color" Тогда
                ЗначениеПараметра = ИзHEX(ЗначениеПараметра);
            ИначеЕсли ОписаниеПараметра.Вид = "bool" Тогда
                ЗначениеПараметра = ЗначениеПараметра = 1;
            КонецЕсли;
            ЭтотОбъект[ОписаниеПараметра.Имя] = ЗначениеПараметра;
        КонецЕсли;
    КонецЦикла;
    Режим = СостояниеНастроек.mode;
    СинхронизироватьПоля();
    ОбновитьРезультат();
КонецПроцедуры

&НаСервере
Функция JSONСостояния()
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, СобратьСостояние());
    Возврат Запись.Закрыть();
КонецФункции

&НаКлиенте
Процедура Сохранить(Команда) Экспорт
    Попытка
        СохранитьНаСервере();
        Сообщить("Popup сохранен: " + НаименованиеPopup);
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере() Экспорт
    Если ПустаяСтрока(НаименованиеPopup) Или СтрДлина(НаименованиеPopup) > 25 Тогда
        ВызватьИсключение "Введите наименование длиной от 1 до 25 символов.";
    КонецЕсли;
    ОбновитьРезультат();
    НовыйJSON = JSONСостояния();
    НачатьТранзакцию();
    Попытка
        Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
            Блокировка = Новый БлокировкаДанных;
            ЭлементБлокировки = Блокировка.Добавить("Справочник.СообщенияНаСайт");
            ЭлементБлокировки.УстановитьЗначение("Ссылка", СообщениеСсылка);
            Блокировка.Заблокировать();
            ЗаписываемыйОбъект = СообщениеСсылка.ПолучитьОбъект();
            Если ЗаписываемыйОбъект.PopupПараметрыJSON <> ИсходныйJSON Тогда
                ВызватьИсключение "Карточка уже изменена в другом окне. Загрузите актуальные настройки.";
            КонецЕсли;
        Иначе
            ЗаписываемыйОбъект = Справочники.СообщенияНаСайт.СоздатьЭлемент();
        КонецЕсли;
        ЗаписываемыйОбъект.Наименование = НаименованиеPopup;
        ЗаписываемыйОбъект.PopupПараметрыJSON = НовыйJSON;
        ЗаписываемыйОбъект.PopupHTML = ГотовыйHTML;
        ЗаписываемыйОбъект.PopupCSS = ГотовыйCSS;
        ЗаписываемыйОбъект.PopupРежим = Режим;
        ЗаписываемыйОбъект.Записать();
        ЗафиксироватьТранзакцию();
        СообщениеСсылка = ЗаписываемыйОбъект.Ссылка;
        ИсходныйJSON = НовыйJSON;
        ЕстьИзменения = Ложь;
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
    Если ЕстьИзменения Тогда
        ПоказатьВопрос(Новый ОписаниеОповещения("РазрешенаЗагрузка", ЭтотОбъект), "Заменить несохраненные настройки выбранным сообщением?", РежимДиалогаВопрос.ДаНет);
    Иначе
        ЗагрузитьНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РазрешенаЗагрузка(Ответ, Дополнительно) Экспорт
    Если Ответ = КодВозвратаДиалога.Да Тогда
        ЗагрузитьНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере() Экспорт
    Если Не ЗначениеЗаполнено(СообщениеСсылка) Тогда
        ВызватьИсключение "Выберите сообщение.";
    КонецЕсли;
    ОбъектСообщения = СообщениеСсылка.ПолучитьОбъект();
    Если Не ПустаяСтрока(ОбъектСообщения.PopupПараметрыJSON) Тогда
        ПрименитьJSON(ОбъектСообщения.PopupПараметрыJSON);
    Иначе
        НачальныеЗначения();
        Режим = "simple";
        СинхронизироватьПоля();
        ОбновитьРезультат();
    КонецЕсли;
    НаименованиеPopup = ОбъектСообщения.Наименование;
    ИсходныйJSON = ОбъектСообщения.PopupПараметрыJSON;
    ЕстьИзменения = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура НовыйPopup(Команда)
    Если ЕстьИзменения Тогда
        ПоказатьВопрос(Новый ОписаниеОповещения("РазрешенНовый", ЭтотОбъект), "Создать новый popup без сохранения текущих изменений?", РежимДиалогаВопрос.ДаНет);
    Иначе
        НовыйНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РазрешенНовый(Ответ, Дополнительно) Экспорт
    Если Ответ = КодВозвратаДиалога.Да Тогда
        НовыйНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НовыйНаСервере()
    НачальныеЗначения();
    Режим = "simple";
    НаименованиеPopup = "Новый popup";
    ИсходныйJSON = "";
    СообщениеСсылка = Справочники.СообщенияНаСайт.ПустаяСсылка();
    СинхронизироватьПоля();
    ОбновитьРезультат();
    ЕстьИзменения = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбменФайлами

&НаКлиенте
Процедура Выгрузить(Команда)
    Попытка
        ОбновитьРезультат();
    Исключение
        Сообщить(ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Показать(Новый ОписаниеОповещения("КаталогВыбран", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыбран(Файлы, Дополнительно) Экспорт
    Если Файлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ВыгрузитьВКаталог(Файлы[0]);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВКаталог(Корень) Экспорт
    ОбновитьРезультат();
    Папка = Корень + "\popup-native-" + Строка(Новый УникальныйИдентификатор);
    СоздатьКаталог(Папка);
    ЗаписатьТекст(Папка + "\popup.html", ГотовыйHTML);
    ЗаписатьТекст(Папка + "\popup.css", ГотовыйCSS);
    ЗаписатьТекст(Папка + "\preview.html", HTMLРезультат);
    ЗаписатьТекст(Папка + "\settings.json", JSONСостояния());
    Сообщить("Файлы выгружены: " + Папка);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьТекст(Путь, Текст)
    Док = Новый ТекстовыйДокумент;
    Док.УстановитьТекст(Текст);
    Док.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

&НаКлиенте
Процедура ИмпортJSON(Команда)
    Если ЕстьИзменения Тогда
        ПоказатьВопрос(Новый ОписаниеОповещения("РазрешенИмпорт", ЭтотОбъект), "Заменить текущие несохраненные настройки файлом JSON?", РежимДиалогаВопрос.ДаНет);
    Иначе
        ВыбратьJSON();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РазрешенИмпорт(Ответ, Дополнительно) Экспорт
    Если Ответ = КодВозвратаДиалога.Да Тогда
        ВыбратьJSON();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьJSON()
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Настройки popup|*.json";
    Диалог.Показать(Новый ОписаниеОповещения("JSONВыбран", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура JSONВыбран(Файлы, Дополнительно) Экспорт
    Если Файлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Док = Новый ТекстовыйДокумент;
        Док.Прочитать(Файлы[0], КодировкаТекста.UTF8);
        ПрименитьJSON(Док.ПолучитьТекст());
        ЕстьИзменения = Истина;
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ЗавершениеРаботы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
    Если ЕстьИзменения Тогда
