#Область ВыборГарнитурыШрифта

&НаКлиенте
Процедура ШрифтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
    СтандартнаяОбработка = Ложь;
    ИмяРеквизитаШрифта = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 7);
    ТекущаяГарнитура = ЭтотОбъект[ИмяРеквизитаШрифта];
    ДиалогШрифта = СоздатьДиалогГарнитуры(ТекущаяГарнитура);
    ДиалогШрифта.Показать(Новый ОписаниеОповещения("ШрифтВыбран", ЭтотОбъект, ИмяРеквизитаШрифта));
КонецПроцедуры

&НаКлиенте
Функция СоздатьДиалогГарнитуры(ТекущаяГарнитура) Экспорт
    Если ПустаяСтрока(ТекущаяГарнитура) Тогда
        ТекущаяГарнитура = "Arial, sans-serif";
    КонецЕсли;
    ЧастиГарнитуры = СтрРазделить(ТекущаяГарнитура, ",");
    ИмяТекущегоШрифта = СокрЛП(СтрЗаменить(СтрЗаменить(ЧастиГарнитуры[0], "'", ""), """", ""));
    ДиалогШрифта = Новый ДиалогВыбораШрифта;
    ДиалогШрифта.Шрифт = Новый Шрифт(ИмяТекущегоШрифта, 12);
    Возврат ДиалогШрифта;
КонецФункции

&НаКлиенте
Процедура ШрифтВыбран(ВыбранныйШрифт, ИмяРеквизитаШрифта) Экспорт
    Если ВыбранныйШрифт = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ИмяВыбранногоШрифта = СокрЛП(ВыбранныйШрифт.Имя);
    Если ПустаяСтрока(ИмяВыбранногоШрифта) Или Лев(ИмяВыбранногоШрифта, 1) = "<" Тогда
        Сообщить("Выберите шрифт с названием гарнитуры, например Arial. Стилевые шрифты 1С не задают гарнитуру для сайта.");
        Возврат;
    КонецЕсли;
    Для Каждого НедопустимыйСимвол Из СтрРазделить(";|{|}|<|>|\|'|""" + "|" + Символы.ПС + "|" + Символы.ВК, "|") Цикл
        Если СтрНайти(ИмяВыбранногоШрифта, НедопустимыйСимвол) > 0 Тогда
            Сообщить("Имя выбранного шрифта содержит недопустимый для CSS символ.");
            Возврат;
        КонецЕсли;
    КонецЦикла;
    ЭтотОбъект[ИмяРеквизитаШрифта] = "'" + ИмяВыбранногоШрифта + "', sans-serif";
    ПараметрИзменен(Элементы["Input_" + ИмяРеквизитаШрифта]);
КонецПроцедуры

#КонецОбласти
