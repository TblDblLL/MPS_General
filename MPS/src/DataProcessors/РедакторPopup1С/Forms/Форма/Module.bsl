    Результат = Результат + ";" + Символы.ПС +
    "    border-radius: ";
    Результат = Результат + ЗначениеШаблона(ПараметрыШаблона, "form_border_radius", Истина);
    Результат = Результат + "px;" + Символы.ПС +
    "    box-sizing: border-box;" + Символы.ПС +
    "}" + Символы.ПС +
    "" + Символы.ПС +
    "" + Символы.ПС +
