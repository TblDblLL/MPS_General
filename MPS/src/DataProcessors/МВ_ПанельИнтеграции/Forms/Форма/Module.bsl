&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Сводка = "Подготовлены реестр 36 операций, авторизация каналов и обработка JSON. Бизнес-операции ещё не подключены. Магазин не переключён; HTTP API не опубликован.";
    Фильтр = "";
    ИмяОперации = "Website.CheckCustomer";
    Маршрут = "sync";
    ПримерJSON = "{""customer"":{""ids"":{""mindboxId"":""demo-id""}}}";
    ОбновитьРеестр();
    ОписаниеОперации = ПояснениеОперации(ИмяОперации);
    РезультатПроверки = "Нажмите «Проверить компоненты», чтобы выполнить локальную диагностику на синтетических данных. Прикладные данные не записываются.";
    ОбъектыБазы = СоставОбъектовБазы();
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеестр()
    Операции.Очистить();
    Для Каждого Запись Из МВ_ДиспетчерОпераций.РеестрОпераций() Цикл
        Если Не ПустаяСтрока(Фильтр) И СтрНайти(НРег(Запись.Ключ + " " + ГруппаОперации(Запись.Ключ)), НРег(Фильтр)) = 0 Тогда
            Продолжить;
        КонецЕсли;
        СтрокаОперации = Операции.Добавить();
        СтрокаОперации.Операция = Запись.Ключ;
        СтрокаОперации.Транспорт = Запись.Значение.Маршрут;
        СтрокаОперации.Группа = ГруппаОперации(Запись.Ключ);
        СтрокаОперации.Статус = "Не подключена";
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда) Экспорт
    ОбновитьРеестр();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрИзменен(Элемент)
    ОбновитьРеестр();
КонецПроцедуры

&НаКлиенте
Процедура ОперацииПриАктивизацииСтроки(Элемент)
    ТекущаяСтрока = Элемент.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ИмяОперации = ТекущаяСтрока.Операция;
    Маршрут = ТекущаяСтрока.Транспорт;
    ОписаниеОперации = ПояснениеОперации(ИмяОперации);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ГруппаОперации(Имя)
    Если СтрНайти(Имя, "Import") > 0 Тогда
        Возврат "CSV-импорт";
    ИначеЕсли СтрНайти(Имя, "Cart") > 0 Тогда
        Возврат "Корзина";
    ИначеЕсли СтрНайти(Имя, "Order") > 0 Или СтрНайти(Имя, "ChangeStatus") > 0 Тогда
        Возврат "Заказы и транзакции";
    ИначеЕсли СтрНайти(Имя, "Card") > 0 Тогда
        Возврат "Карты лояльности";
    ИначеЕсли СтрНайти(Имя, "Promo") > 0 Или СтрНайти(Имя, "Recommendations") > 0 Тогда
        Возврат "Промо и рекомендации";
    КонецЕсли;
    Возврат "Клиенты и авторизация";
КонецФункции

&НаСервереБезКонтекста
Функция ПояснениеОперации(Имя)
    Текст = Имя + Символы.ПС + "Состояние: не подключена. Успех не имитируется." + Символы.ПС + Символы.ПС;
    Если Имя = "Website.CheckCustomer" Тогда
        Возврат Текст + "Первая сквозная операция. PHP ожидает customer.processingStatus = Found/NotFound, ids.mindboxId, сведения профиля, карты и балансы. Нужны реальные HTTP-ответы Mindbox и соответствие прежних ID клиентам 1С.";
    ИначеЕсли СтрНайти(Имя, "Calculate") > 0 Тогда
        Возврат Текст + "Требуются реальные ответы по строкам корзины, split lines, промокодам и бонусам; правила акций и округления. Денежные значения магазина хранятся в сотых долях. Возвращать только итог корзины нельзя.";
    ИначеЕсли СтрНайти(Имя, "Transaction") > 0 Или СтрНайти(Имя, "Order") > 0 Или СтрНайти(Имя, "ChangeStatus") > 0 Тогда
        Возврат Текст + "Нужны проверенные переходы состояний, сохранение ID, блокировки и защита повторов. transactionId встречается и в query, и в JSON. Таймаут после фиксации не должен приводить ко второму списанию.";
    ИначеЕсли СтрНайти(Имя, "Import") > 0 Тогда
        Возврат Текст + "Вход — сырой CSV UTF-8 с разделителем ;. Нужны реальные заголовки/колонки, ответы импорта и правила повторов. Разбор CSV-колонок и запись импорта ещё не реализованы.";
    ИначеЕсли СтрНайти(Имя, "Phone") > 0 Или Имя = "Website.Login" Тогда
        Возврат Текст + "Нужны SMS-провайдер, срок кода, лимиты отправки/попыток и безопасное хранение проверки. PHP ожидает ProtocolError и определённые сообщения ошибок. В AuthService.confirmCode найдено условие, всегда отклоняющее успешный статус; изменение PHP не выполнялось.";
    КонецЕсли;
    Возврат Текст + "Нужны реальные ответы, согласованные правила обработки и адаптер к существующим данным 1С. Идентификаторы Mindbox сохраняются при миграции. Реестр не подтверждает выполнение бизнес-операции.";
КонецФункции

&НаКлиенте
Процедура ПроверитьКомпоненты(Команда) Экспорт
    РезультатПроверки = ВыполнитьДиагностику();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьДиагностику() Экспорт
    Текст = "Локальная диагностика на синтетических данных" + Символы.ПС;
    Реестр = МВ_ДиспетчерОпераций.РеестрОпераций();
    Если Реестр.Количество() <> 36 Тогда
        Возврат Текст + "ОШИБКА: число операций отличается от 36.";
    КонецЕсли;
    Для Каждого Операция Из Реестр Цикл
        Если Операция.Значение.Реализована Или МВ_ДиспетчерОпераций.ПроверитьОперацию(Операция.Ключ, Операция.Значение.Маршрут, "Web") <> "NotImplemented" Тогда
            Возврат Текст + "ОШИБКА: нарушена блокировка неподключённой операции.";
        КонецЕсли;
    КонецЦикла;
    Текст = Текст + "✓ Реестр: 36 операций; все неподключённые операции заблокированы." + Символы.ПС;
    Настройки = Новый Массив;
    Настройки.Добавить(Новый Структура("EndpointId,Секрет,Канал,Активен", "test-Web", "TestOnly-Web", "Web", Истина));
    Если МВ_АвторизацияAPI.ОпределитьКанал("test-Web", "Mindbox secretKey=""TestOnly-Web""", Настройки) <> "Web"
        Или МВ_АвторизацияAPI.ОпределитьКанал("test-Web", "Mindbox secretKey=""incorrect""", Настройки) <> Неопределено Тогда
        Возврат Текст + "ОШИБКА: проверка авторизации.";
    КонецЕсли;
    Текст = Текст + "✓ Тестовая авторизация: верная пара принята, ошибочный ключ отклонён." + Символы.ПС;
    Данные = МВ_ПротоколAPI.РазобратьJSON("{""id"":""000123"",""text"":""Кириллица""}", 1024);
    Если Не Данные.Допустим Или Данные.Данные.Получить("id") <> "000123"
        Или МВ_ПротоколAPI.РазобратьJSON("{}{}", 1024).Допустим Тогда
        Возврат Текст + "ОШИБКА: разбор JSON.";
    КонецЕсли;
    Повтор = МВ_ПротоколAPI.РазобратьJSON(МВ_ПротоколAPI.ЗаписатьJSONОтвета(Данные.Данные), 1024);
    Если Не Повтор.Допустим Или Повтор.Данные.Получить("text") <> "Кириллица" Тогда
        Возврат Текст + "ОШИБКА: сериализация JSON.";
    КонецЕсли;
    Текст = Текст + "✓ JSON: вложенные типы/строковый ID, кириллица и отклонение лишнего документа." + Символы.ПС;
    Возврат Текст + Символы.ПС + "Диагностика завершена. Это проверка компонентов, а не готовности лояльности или заказов. SMS и сетевые запросы не отправлялись; документы и движения не создавались.";
КонецФункции

&НаКлиенте
Процедура ПроверитьЗапрос(Команда) Экспорт
    РезультатПроверки = ПроверитьПример(ПримерJSON, ИмяОперации, Маршрут);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьПример(ТекстJSON, Имя, Путь)
    Разбор = МВ_ПротоколAPI.РазобратьJSON(ТекстJSON, 65536);
    Если Не Разбор.Допустим Тогда
        Возврат "JSON отклонён. Причина проверки: " + Разбор.Причина + ". Бизнес-операция не выполнялась.";
    КонецЕсли;
    Результат = МВ_ДиспетчерОпераций.ПроверитьОперацию(Имя, Путь, "Web");
    Возврат "JSON корректен. Проверка маршрута: " + Результат + "." + Символы.ПС
        + "Это локальная проверка формата, а не ответ Mindbox API. Данные клиента не искались; заказ, SMS и бонусные движения не создавались.";
КонецФункции

&НаСервереБезКонтекста
Функция СоставОбъектовБазы()
    Текст = "Существующие объекты конфигурации (наличие не означает совместимость их алгоритмов с Mindbox):" + Символы.ПС;
    Для Каждого Имя Из СтрРазделить("Клиенты,Номенклатура,ПрограммыАкций,НаборыПромокодов,Виджеты,СообщенияНаСайт", ",") Цикл
        Текст = Текст + "• " + Имя + ": " + ?(Метаданные.Справочники.Найти(Имя) = Неопределено, "нет", "найден") + Символы.ПС;
    КонецЦикла;
    Текст = Текст + "• БалльныеСчета: " + ?(Метаданные.РегистрыНакопления.Найти("БалльныеСчета") = Неопределено, "нет", "найден") + Символы.ПС;
    Возврат Текст + "• ЗаказКлиента: " + ?(Метаданные.Документы.Найти("ЗаказКлиента") = Неопределено, "нет", "найден");
КонецФункции

&НаКлиенте
Процедура ОткрытьКлиентов(Команда)
    ОткрытьФорму("Справочник.Клиенты.ФормаСписка");
КонецПроцедуры

