#Область СозданиеФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "In-app — настройки средствами 1С";
    НачальныеЗначения();
    Режим = "simple";
    Устройство = Перечисления.ТипыУстройствОтображения.Компьютер;
    ШиринаОкна = 900;
    СообщениеСсылка = Объект.Ссылка;
    НаименованиеPopup = Объект.Наименование;
    Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
        ЗагрузитьНаСервере();
    Иначе
        НаименованиеPopup = "Новый in-app";
        ИсходныйJSON = "";
        СинхронизироватьПоля();
        ОбновитьРезультат();
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СообщениеСсылка) Тогда
        НачальныеУсловияПоказа();
    КонецЕсли;
    ЕстьИзменения = Ложь;
    УстановитьУсловноеОформление();
    ОформитьКартуПоложенияОкна();
КонецПроцедуры

Процедура УстановитьУсловноеОформление()
	
	Для ш = 1 По 3 Цикл

		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
		ПолеУО.Использование = Истина;
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных("КартаПоложенияОкнаК"+ш);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "");
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
		ПолеУО.Использование = Истина;
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных("КартаПоложенияОкнаК"+ш);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Аквамарин);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "+");
		ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КартаПоложенияОкна.К"+ш);
		ЭлементОтбора.ПравоеЗначение = Истина;

	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ПреобразованиеЦветов

&НаКлиентеНаСервереБезКонтекста
Функция ИзHEX(Текст)
    Алфавит = "0123456789abcdef";
    Значения = Новый Массив;
    Для Позиция = 2 По 6 Цикл
        Если Позиция % 2 <> 0 Тогда
            Продолжить;
        КонецЕсли;
        СтаршийПолубайт = СтрНайти(Алфавит, НРег(Сред(Текст, Позиция, 1))) - 1;
        МладшийПолубайт = СтрНайти(Алфавит, НРег(Сред(Текст, Позиция + 1, 1))) - 1;
        Если СтаршийПолубайт < 0 Или МладшийПолубайт < 0 Тогда
            ВызватьИсключение "Неверный цвет HEX.";
        КонецЕсли;
        Значения.Добавить(СтаршийПолубайт * 16 + МладшийПолубайт);
    КонецЦикла;
    Возврат Новый Цвет(Значения[0], Значения[1], Значения[2]);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВHEX(ЦветЗначение)
    Алфавит = "0123456789abcdef";
    Результат = "#";
    Компоненты = Новый Массив;
    Компоненты.Добавить(ЦветЗначение.Красный);
    Компоненты.Добавить(ЦветЗначение.Зеленый);
    Компоненты.Добавить(ЦветЗначение.Синий);
    Для Каждого КомпонентаЦвета Из Компоненты Цикл
        Результат = Результат + Сред(Алфавит, Цел(КомпонентаЦвета / 16) + 1, 1) + Сред(Алфавит, КомпонентаЦвета % 16 + 1, 1);
    КонецЦикла;
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область ИнтерактивныеНастройки

&НаСервере
Процедура СинхронизироватьПоля()
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ЗначениеПоля = ЭтотОбъект[ОписаниеПараметра.Имя];
        Если ОписаниеПараметра.Вид = "number" Тогда
            ЭтотОбъект[ОписаниеПараметра.Имя + "_Scale"] = Окр((ЗначениеПоля - ОписаниеПараметра.Минимум) / ОписаниеПараметра.Шаг, 0);
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "color" Тогда
            Элементы["Input_" + ОписаниеПараметра.Имя].ЦветФона = ЗначениеПоля;
        КонецЕсли;
    КонецЦикла;
    ОбновитьПоляИсточниковИзображений();
    УстройстваОтображенияПКМП.ПрименитьВидимость(ЭтотОбъект, Устройство, ПривязкиНастроекУстройств(), ГруппыНастроекУстройств(), Поиск, Режим);
КонецПроцедуры

&НаКлиенте
Процедура ПолзунокИзменен(Элемент) Экспорт
    Имя = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 8);
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        Если ОписаниеПараметра.Имя = Имя Тогда
            ЭтотОбъект[Имя] = Окр(ОписаниеПараметра.Минимум + ЭтотОбъект[Имя + "_Scale"] * ОписаниеПараметра.Шаг, 4);
            Прервать;
        КонецЕсли;
    КонецЦикла;
    ПараметрИзменен(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПараметрИзменен(Элемент) Экспорт
    ПринятьИзмененияИзПредпросмотра(ИмяИзмененногоПараметра(Элемент));
    ЕстьИзменения = Истина;
    Попытка
        ОбновитьРезультат();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура РежимИзменен(Элемент)
    ПараметрИзменен(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПоискИзменен(Элемент)
    СинхронизироватьПоля();
КонецПроцедуры

&НаКлиенте
Процедура УстройствоИзменено(Элемент) Экспорт
    ПринятьИзмененияИзПредпросмотра();
    УстройствоИзмененоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЦветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ИмяРеквизита = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 7);
    Оповещение = Новый ОписаниеОповещения("ЦветПалитрыВыбран", ЭтотОбъект, ИмяРеквизита);
    ОткрытьФорму("ОбщаяФорма.ФормаВыбораЦвета", , ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ЦветПалитрыВыбран(РезультатВыбора, ИмяРеквизита) Экспорт
    Если РезультатВыбора = "ДругиеЦвета" Тогда
        ДиалогЦвета = Новый ДиалогВыбораЦвета;
        ДиалогЦвета.Цвет = ЭтотОбъект[ИмяРеквизита];
        ДиалогЦвета.Показать(Новый ОписаниеОповещения("ЦветВыбран", ЭтотОбъект, ИмяРеквизита));
    ИначеЕсли ТипЗнч(РезультатВыбора) = Тип("Цвет") Тогда
        ЦветВыбран(РезультатВыбора, ИмяРеквизита);
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НормализоватьВебЦвет(ЦветЗначение)
    Возврат СообщенияИнтерфейсаПКМП.НормализоватьВебЦвет(ЦветЗначение);
КонецФункции

&НаКлиенте
Процедура ЦветВыбран(Знач ВыбранныйЦвет, Имя) Экспорт
    Если ВыбранныйЦвет = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если ВыбранныйЦвет.Вид <> ВидЦвета.Абсолютный Тогда
        ВыбранныйЦвет = НормализоватьВебЦвет(ВыбранныйЦвет);
        Если ВыбранныйЦвет = Неопределено Тогда
            Сообщить("Выберите цвет из палитры или задайте цвет RGB.");
            Возврат;
        КонецЕсли;
    КонецЕсли;
    ЭтотОбъект[Имя] = ВыбранныйЦвет;
    ПараметрИзменен(Элементы["Input_" + Имя]);
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ИмяИзображения = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 6);
    ДиалогФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    ДиалогФайла.Фильтр = "Изображения PNG, JPEG, GIF, WebP|*.png;*.jpg;*.jpeg;*.gif;*.webp";
    ДиалогФайла.Показать(Новый ОписаниеОповещения("ИзображениеВыбрано", ЭтотОбъект, ИмяИзображения));
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеВыбрано(Файлы, ИмяИзображения) Экспорт
    Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    ФайлИзображения = Новый Файл(Файлы[0]);
    ТипыИзображений = Новый Соответствие;
    ТипыИзображений.Вставить(".jpg", "image/jpeg");
    ТипыИзображений.Вставить(".jpeg", "image/jpeg");
    ТипыИзображений.Вставить(".png", "image/png");
    ТипыИзображений.Вставить(".gif", "image/gif");
    ТипыИзображений.Вставить(".webp", "image/webp");
    ТипИзображения = ТипыИзображений.Получить(НРег(ФайлИзображения.Расширение));
    Если ТипИзображения = Неопределено Тогда
        Сообщить("Выберите PNG, JPEG, GIF или WebP.");
        Возврат;
    КонецЕсли;
    ПределРазмера = 4 * 1024 * 1024;
    Попытка
        Если ФайлИзображения.Размер() > ПределРазмера Тогда
            Сообщить("Максимальный размер изображения — 4 МБ.");
            Возврат;
        КонецЕсли;
        ДанныеИзображения = Новый ДвоичныеДанные(ФайлИзображения.ПолноеИмя);
        Если ДанныеИзображения.Размер() = 0 Или ДанныеИзображения.Размер() > ПределРазмера Тогда
            Сообщить("Выберите непустой файл изображения размером до 4 МБ.");
            Возврат;
        КонецЕсли;
    Исключение
        Сообщить("Не удалось прочитать файл изображения.");
        Возврат;
    КонецПопытки;
    КодИзображения = СтрЗаменить(СтрЗаменить(Base64Строка(ДанныеИзображения), Символы.ПС, ""), Символы.ВК, "");
    ЭтотОбъект[ИмяИзображения + "_FileData"] = "data:" + ТипИзображения + ";base64," + КодИзображения;
    ЭтотОбъект[ИмяИзображения + "_FileLabel"] = ФайлИзображения.Имя;
    ПрименитьИсточникИзображения(ИмяИзображения);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникИзображенияИзменен(Элемент)
    ПрименитьИсточникИзображения(Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 8));
КонецПроцедуры

&НаКлиенте
Процедура СсылкаИзображенияИзменена(Элемент)
    ПрименитьИсточникИзображения(Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 5));
КонецПроцедуры

&НаКлиенте
Процедура ФайлИзображенияИзменен(Элемент)
    ИмяИзображения = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 6);
    Если ПустаяСтрока(ЭтотОбъект[ИмяИзображения + "_FileLabel"]) Тогда
        ЭтотОбъект[ИмяИзображения + "_FileData"] = "";
        ПрименитьИсточникИзображения(ИмяИзображения);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИсточникИзображения(ИмяИзображения) Экспорт
    ИзФайла = ЭтотОбъект[ИмяИзображения + "_Source"] = "file";
    АдресИзображения = СокрЛП(ЭтотОбъект[ИмяИзображения + "_URL"]);
    Если Не ИзФайла И Не ПустаяСтрока(АдресИзображения)
        И Лев(НРег(АдресИзображения), 7) <> "http://" И Лев(НРег(АдресИзображения), 8) <> "https://" Тогда
        ЭтотОбъект[ИмяИзображения + "_URL"] = "";
        Сообщить("Введите адрес изображения, начинающийся с http:// или https://.");
        Возврат;
    КонецЕсли;
    ЭтотОбъект[ИмяИзображения] = ?(ИзФайла, ЭтотОбъект[ИмяИзображения + "_FileData"], АдресИзображения);
    ПараметрИзменен(Неопределено);
КонецПроцедуры

&НаСервере
Процедура ВосстановитьПоляИзображений()
    Для Каждого ИмяИзображения Из СтрРазделить("S_image,F_img_top,F_form_bg_img,F_bg_img_top_mobile", ",") Цикл
        ЗначениеИзображения = ЭтотОбъект[ИмяИзображения];
        ИзФайла = Лев(ЗначениеИзображения, 11) = "data:image/";
        ЭтотОбъект[ИмяИзображения + "_Source"] = ?(ИзФайла, "file", "url");
        ЭтотОбъект[ИмяИзображения + "_URL"] = ?(ИзФайла, "", ЗначениеИзображения);
        ЭтотОбъект[ИмяИзображения + "_FileData"] = ?(ИзФайла, ЗначениеИзображения, "");
        ЭтотОбъект[ИмяИзображения + "_FileLabel"] = ?(ИзФайла, "Встроенное изображение", "");
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоляИсточниковИзображений()
    Для Каждого ИмяИзображения Из СтрРазделить("S_image,F_img_top,F_form_bg_img,F_bg_img_top_mobile,F_bg_img_top_mobile__Планшет", ",") Цикл
        Если Элементы.Найти("URL_" + ИмяИзображения) = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ИмяРеквизита = УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(ИмяИзображения);
        ИзФайла = ЭтотОбъект[ИмяРеквизита + "_Source"] = "file";
        Элементы["URL_" + ИмяИзображения].Видимость = Не ИзФайла;
        Элементы["File_" + ИмяИзображения].Видимость = ИзФайла;
    КонецЦикла;
КонецПроцедуры


#КонецОбласти

#Область ФормированиеРезультата

&НаСервере
Функция СобратьСостояние()
    Простые = Новый Структура;
    Полные = Новый Структура;
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ЗначениеПараметра = ЭтотОбъект[ОписаниеПараметра.Имя];
        Если ОписаниеПараметра.Вид = "bool" Тогда
            ЗначениеПараметра = ?(ЗначениеПараметра, 1, 0);
        ИначеЕсли ОписаниеПараметра.Вид = "color" Тогда
            ЗначениеПараметра = ВHEX(ЗначениеПараметра);
        КонецЕсли;
        ПроверитьЗначение(ОписаниеПараметра, ЗначениеПараметра);
        ПараметрыРежима = ?(ОписаниеПараметра.Режим = "simple", Простые, Полные);
        ПараметрыРежима.Вставить(ОписаниеПараметра.Ключ, ЗначениеПараметра);
    КонецЦикла;
    Возврат Новый Структура("version,mode,profiles", 1, Режим, Новый Структура("simple,full", Простые, Полные));
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьЗначение(ОписаниеПараметра, ЗначениеПараметра)
    Если ОписаниеПараметра.Вид = "number" Тогда
        Если ТипЗнч(ЗначениеПараметра) <> Тип("Число") Тогда
            ВызватьИсключение "Ожидается число: " + ОписаниеПараметра.Ключ;
        КонецЕсли;
        Если ЗначениеПараметра < ОписаниеПараметра.Минимум Или ЗначениеПараметра > ОписаниеПараметра.Максимум Тогда
            ВызватьИсключение "Недопустимое значение " + ОписаниеПараметра.Ключ + ": от " + Строка(ОписаниеПараметра.Минимум) + " до " + Строка(ОписаниеПараметра.Максимум);
        КонецЕсли;
    ИначеЕсли ОписаниеПараметра.Вид = "bool" Тогда
        Если ЗначениеПараметра <> 0 И ЗначениеПараметра <> 1 Тогда
            ВызватьИсключение "Флаг должен быть 0 или 1: " + ОписаниеПараметра.Ключ;
        КонецЕсли;
    Иначе
        Если ТипЗнч(ЗначениеПараметра) <> Тип("Строка") Тогда
            ВызватьИсключение "Ожидается строка: " + ОписаниеПараметра.Ключ;
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "color" Тогда
            Если СтрДлина(ЗначениеПараметра) <> 7 Или Лев(ЗначениеПараметра, 1) <> "#" Тогда
                ВызватьИсключение "Неверный цвет: " + ОписаниеПараметра.Ключ;
            КонецЕсли;
            ИзHEX(ЗначениеПараметра);
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "image" Или ОписаниеПараметра.Ключ = "url" Или ОписаниеПараметра.Ключ = "link_url" Тогда
            Если Не ПустаяСтрока(ЗначениеПараметра) И Лев(НРег(ЗначениеПараметра), 7) <> "http://" И Лев(НРег(ЗначениеПараметра), 8) <> "https://" И Не (ОписаниеПараметра.Вид = "image" И Лев(ЗначениеПараметра, 11) = "data:image/") Тогда
                ВызватьИсключение "Нужен HTTP(S) адрес или встроенное изображение: " + ОписаниеПараметра.Ключ;
            КонецЕсли;
        КонецЕсли;
        Если ОписаниеПараметра.Ключ = "form_font" Тогда
            Для Каждого Символ Из СтрРазделить(";|{|}|<|>|\", "|") Цикл
                Если СтрНайти(ЗначениеПараметра, Символ) > 0 Тогда
                    ВызватьИсключение "Недопустимый символ в имени шрифта.";
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если ОписаниеПараметра.Вид = "select" И ЗначениеПараметра <> "link" И ЗначениеПараметра <> "close" И ЗначениеПараметра <> "form" Тогда
            ВызватьИсключение "Неверное действие кнопки.";
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭкранироватьHTML(ЭкранируемыйТекст)
    Возврат СообщенияИнтерфейсаПКМП.ЭкранироватьHTML(ЭкранируемыйТекст);
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеШаблона(ПараметрыШаблона, Ключ, ЭтоCSS)
    Возврат СообщенияИнтерфейсаПКМП.ЗначениеШаблона(ПараметрыШаблона, Ключ, ЭтоCSS);
КонецФункции

&НаСервере
Процедура ОбновитьРезультат() Экспорт
    СинхронизироватьПоля();
    СостояниеНастроек = СобратьСостояние();
    Если СостояниеНастроек.mode <> "simple" И СостояниеНастроек.mode <> "full" Тогда
        ВызватьИсключение "Выберите режим шаблона.";
    КонецЕсли;
    Если ШиринаОкна < 240 Или ШиринаОкна > 1600 Тогда
        ВызватьИсключение "Ширина окна: от 240 до 1600 px.";
    КонецЕсли;
    КодУстройстваCSS = УстройстваОтображенияПКМП.КодCSS(Устройство);
    Если Режим = "simple" Тогда
        ГотовыйHTML = Шаблон_simple_html(СостояниеНастроек.profiles.simple);
        ГотовыйCSS = Шаблон_simple_css(СостояниеНастроек.profiles.simple) + Символы.ПС + "#popmechanic-form { position: relative; }";
    Иначе
        ГотовыйHTML = Шаблон_full_html(СостояниеНастроек.profiles.full);
        ГотовыйCSS = Шаблон_full_css(СостояниеНастроек.profiles.full) + Символы.ПС + "#popmechanic-form .popmechanic-image { background-size:contain; background-repeat:no-repeat; }";
    КонецЕсли;
    ТекстПросмотра = ГотовыйHTML;
    Для Каждого Единица Из СтрРазделить("days,hours,minutes,seconds", ",") Цикл
        Цифры = ?(Единица = "days", "02", ?(Единица = "hours", "12", ?(Единица = "minutes", "34", "56")));
        ТекстПросмотра = СтрЗаменить(ТекстПросмотра, "data-popmechanic-timer=""timer:" + Единица + """></div>", "data-popmechanic-timer=""timer:" + Единица + """><span class=""popmechanic-timer-digit"">" + Цифры + "</span></div>");
    КонецЦикла;
    HTMLРезультат = "<!doctype html><html lang=""ru""><head><meta charset=""utf-8""><style>" + ГотовыйCSS + "html,body{margin:0;font-family:Arial;background:#e8edf4}body{padding:20px}.preview{width:" + Формат(ШиринаОкна, "ЧГ=0;ЧРД=.;ЧН=0") + "px;position:relative}</style></head><body><div class=""preview popmechanic-" + КодУстройстваCSS + """>" + ТекстПросмотра + "</div><p style=""color:#64748b;font-size:12px"">Предпросмотр. Таймер демонстрационный; действия подключаются скриптами сайта.</p></body></html>";
    HTMLПредпросмотраДляВыгрузки = HTMLРезультат;
    ВерсияВизуальногоПредпросмотра = Строка(Новый УникальныйИдентификатор);
    РежимВизуальногоПредпросмотра = Режим;
    УстройствоВизуальногоПредпросмотра = КодУстройстваCSS;
    Если ВизуальноеРедактирование Тогда
        ПараметрыРедактора = Новый Структура("token,mode,device,selected,items", ВерсияВизуальногоПредпросмотра,
            Режим, КодУстройстваCSS, ВыделенныйВизуальныйЭлемент, ОписаниеВизуальныхЭлементов(Режим, КодУстройстваCSS));
        HTMLРезультат = СообщенияИнтерфейсаПКМП.ДокументВизуальногоРедактора(HTMLРезультат, ПараметрыРедактора);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредпросмотрПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
    СтандартнаяОбработка = ВизуальноеРедактирование;
КонецПроцедуры

#КонецОбласти

#Область ХранениеНастроек

&НаСервере
Процедура ПрименитьJSON(ТекстJSON)
    ЗначениеПараметра = Неопределено;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    СостояниеНастроек = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Если СостояниеНастроек.version <> 1 Или (СостояниеНастроек.mode <> "simple" И СостояниеНастроек.mode <> "full") Тогда
        ВызватьИсключение "Неподдерживаемый формат настроек.";
    КонецЕсли;
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ПараметрыРежима = СостояниеНастроек.profiles[ОписаниеПараметра.Режим];
        Если ПараметрыРежима.Свойство(ОписаниеПараметра.Ключ, ЗначениеПараметра) Тогда
            ПроверитьЗначение(ОписаниеПараметра, ЗначениеПараметра);
        КонецЕсли;
    КонецЦикла;
    НачальныеЗначения();
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        ПараметрыРежима = СостояниеНастроек.profiles[ОписаниеПараметра.Режим];
        Если ПараметрыРежима.Свойство(ОписаниеПараметра.Ключ, ЗначениеПараметра) Тогда
            Если ОписаниеПараметра.Вид = "color" Тогда
                ЗначениеПараметра = ИзHEX(ЗначениеПараметра);
            ИначеЕсли ОписаниеПараметра.Вид = "bool" Тогда
                ЗначениеПараметра = ЗначениеПараметра = 1;
            КонецЕсли;
            ЭтотОбъект[ОписаниеПараметра.Имя] = ЗначениеПараметра;
        КонецЕсли;
    КонецЦикла;
    ВосстановитьПоляИзображений();
    Режим = СостояниеНастроек.mode;
    СинхронизироватьПоля();
    ОбновитьРезультат();
КонецПроцедуры

&НаСервере
Функция JSONСостояния()
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, СобратьСостояние());
    Возврат Запись.Закрыть();
КонецФункции

&НаКлиенте
Процедура Сохранить(Команда) Экспорт
    ПринятьИзмененияИзПредпросмотра();
    Попытка
        СохранитьНаСервере();
        Сообщить("In-app сохранён: " + НаименованиеPopup);
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере() Экспорт
    Если ПустаяСтрока(НаименованиеPopup) Или СтрДлина(НаименованиеPopup) > 25 Тогда
        ВызватьИсключение "Введите наименование длиной от 1 до 25 символов.";
    КонецЕсли;
    ОбновитьРезультат();
    НовыйJSON = JSONСостояния();
    НачатьТранзакцию();
    Попытка
        Если ЗначениеЗаполнено(СообщениеСсылка) Тогда
            Блокировка = Новый БлокировкаДанных;
            ЭлементБлокировки = Блокировка.Добавить("Справочник.СообщенияВПриложение");
            ЭлементБлокировки.УстановитьЗначение("Ссылка", СообщениеСсылка);
            Блокировка.Заблокировать();
            ЗаписываемыйОбъект = СообщениеСсылка.ПолучитьОбъект();
            Если ЗаписываемыйОбъект.PopupПараметрыJSON <> ИсходныйJSON Тогда
                ВызватьИсключение "Карточка уже изменена в другом окне. Загрузите актуальные настройки.";
            КонецЕсли;
        Иначе
            ЗаписываемыйОбъект = Справочники.СообщенияВПриложение.СоздатьЭлемент();
        КонецЕсли;
        ЗаписываемыйОбъект.Наименование = НаименованиеPopup;
        ЗаписываемыйОбъект.PopupПараметрыJSON = НовыйJSON;
        ЗаписываемыйОбъект.PopupHTML = ГотовыйHTML;
        ЗаписываемыйОбъект.PopupCSS = ГотовыйCSS;
        ЗаписываемыйОбъект.PopupРежим = Режим;
        Если ЗначениеЗаполнено(СообщениеСсылка) И СообщенияИнтерфейсаПКМП.JSONУсловий(ЗаписываемыйОбъект) <> ИсходныеУсловияJSON Тогда
            ВызватьИсключение "Условия изменены в другом окне. Загрузите карточку заново.";
        КонецЕсли;
        ЗаписываемыйОбъект.ПутьПоказа = Правило_ПутьПоказа;
        ЗаписываемыйОбъект.СобытиеЗапуска = Правило_СобытиеЗапуска;
        ЗаписываемыйОбъект.ЗадержкаПоказа = Правило_ЗадержкаПоказа;
        ЗаписываемыйОбъект.ПриоритетПоказа = Правило_ПриоритетПоказа;
        ЗаписываемыйОбъект.ИнтервалПоказа = Правило_ИнтервалПоказа;
        ЗаписываемыйОбъект.ЛимитПоказов = Правило_ЛимитПоказов;
        ЗаписываемыйОбъект.ПоложениеОкна = Правило_ПоложениеОкна;
        ЗаписываемыйОбъект.ПоказыватьAndroid = Правило_ПоказыватьAndroid;
        ЗаписываемыйОбъект.ПоказыватьIOS = Правило_ПоказыватьIOS;
        СообщенияИнтерфейсаПКМП.ПроверитьУсловия(ЗаписываемыйОбъект);
        ЗаписываемыйОбъект.Записать();
        ЗафиксироватьТранзакцию();
        СообщениеСсылка = ЗаписываемыйОбъект.Ссылка;
        ИсходныйJSON = НовыйJSON;
        ИсходныеУсловияJSON = СообщенияИнтерфейсаПКМП.JSONУсловий(ЗаписываемыйОбъект);
        ЕстьИзменения = Ложь;
        ЗначениеВРеквизитФормы(ЗаписываемыйОбъект, "Объект");
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
    Если ЕстьИзменения Тогда
        ПоказатьВопрос(Новый ОписаниеОповещения("РазрешенаЗагрузка", ЭтотОбъект), "Заменить несохраненные настройки выбранным сообщением?", РежимДиалогаВопрос.ДаНет);
    Иначе
        ЗагрузитьНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РазрешенаЗагрузка(Ответ, Дополнительно) Экспорт
    Если Ответ = КодВозвратаДиалога.Да Тогда
        ЗагрузитьНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере() Экспорт
    Если Не ЗначениеЗаполнено(СообщениеСсылка) Тогда
        ВызватьИсключение "Выберите сообщение.";
    КонецЕсли;
    ОбъектСообщения = СообщениеСсылка.ПолучитьОбъект();
    Если Не ПустаяСтрока(ОбъектСообщения.PopupПараметрыJSON) Тогда
        ПрименитьJSON(ОбъектСообщения.PopupПараметрыJSON);
    Иначе
        НачальныеЗначения();
        Режим = "simple";
        СинхронизироватьПоля();
        ОбновитьРезультат();
    КонецЕсли;
    НаименованиеPopup = ОбъектСообщения.Наименование;
    ИсходныйJSON = ОбъектСообщения.PopupПараметрыJSON;
    ЗагрузитьУсловияПоказа(ОбъектСообщения);
    ЕстьИзменения = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбменФайлами

&НаКлиенте
Процедура Выгрузить(Команда)
    ПринятьИзмененияИзПредпросмотра();
    Попытка
        ОбновитьРезультат();
    Исключение
        Сообщить(ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Показать(Новый ОписаниеОповещения("КаталогВыбран", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыбран(Файлы, Дополнительно) Экспорт
    Если Файлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ВыгрузитьВКаталог(Файлы[0]);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВКаталог(Корень) Экспорт
    ПринятьИзмененияИзПредпросмотра();
    ОбновитьРезультат();
    Папка = Корень + "\popup-native-" + Строка(Новый УникальныйИдентификатор);
    СоздатьКаталог(Папка);
    ЗаписатьТекст(Папка + "\popup.html", ГотовыйHTML);
    ЗаписатьТекст(Папка + "\popup.css", ГотовыйCSS);
    ЗаписатьТекст(Папка + "\preview.html", HTMLПредпросмотраДляВыгрузки);
    ЗаписатьТекст(Папка + "\settings.json", JSONСостояния());
    Сообщить("Файлы выгружены: " + Папка);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьТекст(Путь, Текст)
    Док = Новый ТекстовыйДокумент;
    Док.УстановитьТекст(Текст);
    Док.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

&НаКлиенте
Процедура ИмпортJSON(Команда)
    Если ЕстьИзменения Тогда
        ПоказатьВопрос(Новый ОписаниеОповещения("РазрешенИмпорт", ЭтотОбъект), "Заменить текущие несохраненные настройки файлом JSON?", РежимДиалогаВопрос.ДаНет);
    Иначе
        ВыбратьJSON();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РазрешенИмпорт(Ответ, Дополнительно) Экспорт
    Если Ответ = КодВозвратаДиалога.Да Тогда
        ВыбратьJSON();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьJSON()
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Настройки popup|*.json";
    Диалог.Показать(Новый ОписаниеОповещения("JSONВыбран", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура JSONВыбран(Файлы, Дополнительно) Экспорт
    Если Файлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Док = Новый ТекстовыйДокумент;
        Док.Прочитать(Файлы[0], КодировкаТекста.UTF8);
        ПрименитьJSON(Док.ПолучитьТекст());
        ЕстьИзменения = Истина;
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ЗавершениеРаботы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
    ПринятьИзмененияИзПредпросмотра();
    Если ЕстьИзменения Тогда
        ТекстПредупреждения = "Настройки popup не сохранены. Закрыть?";
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОписаниеПараметровИШаблоны

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеПараметров()
    ОписанияПараметров = Новый Массив;
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_url", "url", "simple", "text", 2, 0, 0, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_image", "image", "simple", "image", 0, 0, 0, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_width", "width", "simple", "number", 4, 100, 1400, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_form_border_width", "form_border_width", "simple", "number", 4, 0, 100, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_form_border_color", "form_border_color", "simple", "color", 9, 0, 0, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_form_border_radius", "form_border_radius", "simple", "number", 4, 0, 100, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_cl_size", "cl_size", "simple", "number", 8, -50, 150, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_otstup1", "otstup1", "simple", "number", 8, -50, 150, 1));
    ОписанияПараметров.Добавить(Новый Структура("Имя,Ключ,Режим,Вид,Группа,Минимум,Максимум,Шаг", "S_otstup2", "otstup2", "simple", "number", 8, -50, 150, 1));
