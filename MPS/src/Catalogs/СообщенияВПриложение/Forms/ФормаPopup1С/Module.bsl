&НаКлиенте
Функция ИмяИзмененногоПараметра(Элемент)
    Если Элемент = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    ИмяЭлемента = УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя);
    Если Лев(ИмяЭлемента, 6) = "Input_" Тогда
        Возврат Сред(ИмяЭлемента, 7);
    ИначеЕсли Лев(ИмяЭлемента, 7) = "Slider_" Тогда
        Возврат Сред(ИмяЭлемента, 8);
    КонецЕсли;
    Возврат "";
КонецФункции

&НаКлиенте
Процедура ПринятьИзмененияИзПредпросмотра(ПриоритетныйПараметр = "") Экспорт
    Попытка
        ДокументРедактора = Элементы.ПредпросмотрHTML.Документ;
        ПризнакПеретаскивания = ДокументРедактора.getElementById("mps-editor-busy").value;
        ПолеИзменений = ДокументРедактора.getElementById("mps-editor-change");
        JSONИзменений = ПолеИзменений.value;
        ВыделенныйВизуальныйЭлемент = ДокументРедактора.getElementById("mps-editor-selection").value;
    Исключение
        // Обычный предпросмотр или документ ещё загружается.
        Возврат;
    КонецПопытки;
    Если ПризнакПеретаскивания = "1" Или ПустаяСтрока(JSONИзменений) Тогда
        Возврат;
    КонецЕсли;
    ПолеИзменений.value = "";
    Попытка
        ПрименитьВизуальныеИзмененияНаСервере(JSONИзменений, ПриоритетныйПараметр);
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПрименитьВизуальныеИзмененияНаСервере(JSONИзменений, ПриоритетныйПараметр = "") Экспорт
    Если СтрДлина(JSONИзменений) > 4096 Тогда
        ВызватьИсключение "Превышен размер изменения макета.";
    КонецЕсли;
    Изменения = СообщенияИнтерфейсаПКМП.ИзJSON(JSONИзменений);
    Если ТипЗнч(Изменения) <> Тип("Структура") Или Не Изменения.Свойство("token")
        Или Не Изменения.Свойство("selected") Или Не Изменения.Свойство("updates") Тогда
        ВызватьИсключение "Неверный формат изменения макета.";
    КонецЕсли;
    Если Изменения.token <> ВерсияВизуальногоПредпросмотра Тогда
        Возврат Ложь;
    КонецЕсли;
    Если ТипЗнч(Изменения.updates) <> Тип("Структура") Тогда
        ВызватьИсключение "Ожидается набор изменённых параметров.";
    КонецЕсли;
    РазрешенныеПоля = Новый Соответствие;
    НайденЭлемент = Ложь;
    Для Каждого ЭлементРедактора Из ОписаниеВизуальныхЭлементов(РежимВизуальногоПредпросмотра, УстройствоВизуальногоПредпросмотра) Цикл
        НайденЭлемент = НайденЭлемент Или ЭлементРедактора.id = Изменения.selected;
        Для Каждого ИмяКоординаты Из СтрРазделить("x,y,w,h", ",") Цикл
            ПолеГеометрии = ЭлементРедактора[ИмяКоординаты];
            Если ПолеГеометрии <> Неопределено Тогда
                РазрешенныеПоля.Вставить(ПолеГеометрии.name, ПолеГеометрии);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Если Не НайденЭлемент Тогда
        ВызватьИсключение "Не найден выбранный элемент макета.";
    КонецЕсли;
    ПрежниеЗначения = Новый Структура;
    Для Каждого Изменение Из Изменения.updates Цикл
        ПолеГеометрии = РазрешенныеПоля.Получить(Изменение.Ключ);
        Если ПолеГеометрии = Неопределено Или ТипЗнч(Изменение.Значение) <> Тип("Число") Тогда
            ВызватьИсключение "Недопустимый параметр геометрии.";
        КонецЕсли;
        Если Изменение.Значение <> Окр(Изменение.Значение, 0) Или Изменение.Значение < ПолеГеометрии.min
            Или Изменение.Значение > ПолеГеометрии.max Тогда
            ВызватьИсключение "Размер или координата вне допустимого диапазона: " + Изменение.Ключ;
        КонецЕсли;
        Если Изменение.Ключ <> ПриоритетныйПараметр Тогда
            ПрежниеЗначения.Вставить(Изменение.Ключ, ЭтотОбъект[Изменение.Ключ]);
        КонецЕсли;
    КонецЦикла;
    Попытка
        Для Каждого ПрежнееЗначение Из ПрежниеЗначения Цикл
            ЭтотОбъект[ПрежнееЗначение.Ключ] = Изменения.updates[ПрежнееЗначение.Ключ];
        КонецЦикла;
        ВыделенныйВизуальныйЭлемент = Изменения.selected;
        ОбновитьРезультат();
        ЕстьИзменения = Истина;
    Исключение
        Для Каждого ПрежнееЗначение Из ПрежниеЗначения Цикл
            ЭтотОбъект[ПрежнееЗначение.Ключ] = ПрежнееЗначение.Значение;
        КонецЦикла;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Истина;
КонецФункции

#КонецОбласти


&НаСервере
Функция ОписаниеВизуальныхЭлементов(РежимШаблона, КодУстройства)
    ЭлементыРедактора = Новый Массив;
    Если РежимШаблона = "simple" Тогда
        Суффикс = ?(КодУстройства = "mobile", "_mob", "");
        ШиринаИзображения = ?(КодУстройства = "mobile", "S_width_mobile", "S_width");
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "window", "Окно сообщения", "#popmechanic-form",
            "S_form_offset_x" + Суффикс, "S_form_offset_y" + Суффикс, ШиринаИзображения, "S_height" + Суффикс);
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "image", "Изображение", "#popmechanic-form img",
            "S_image_offset_x" + Суффикс, "S_image_offset_y" + Суффикс, ШиринаИзображения, "S_height" + Суффикс);
        ЭлементКрестика = ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "close", "Крестик", "#popmechanic-form .popmechanic-close",
            "S_otstup2", "S_otstup1", "S_cl_size", "S_cl_size");
        ЭлементКрестика.x.factor = -1;
        ЭлементКрестика.square = Истина;
    Иначе
        Суффикс = ?(КодУстройства = "desktop", "", "_mob");
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "window", "Окно сообщения", "#popmechanic-form",
            "F_form_offset_x" + Суффикс, "F_form_offset_y" + Суффикс, "F_form_width" + Суффикс, "F_form_height" + Суффикс);
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "image", "Изображение", "#popmechanic-form .popmechanic-image",
            "F_img_top_left" + Суффикс, "F_img_top_top" + Суффикс, "F_img_top_width" + Суффикс, "F_img_top_height" + Суффикс);
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "subtitle", "Подзаголовок", "#popmechanic-form .popmechanic-sub-title",
            "F_sub_title_offset_x" + Суффикс, "F_sub_title_offset_y" + Суффикс, "F_sub_title_box_width" + Суффикс, "F_sub_title_box_height" + Суффикс);
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "title", "Заголовок", "#popmechanic-form .popmechanic-title",
            "F_title_offset_x" + Суффикс, "F_title_offset_y" + Суффикс, "F_title_box_width" + Суффикс, "F_title_box_height" + Суффикс);
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "timer", "Таймер целиком", "#popmechanic-form .popmechanic-timer",
            "F_timer_offset_x" + Суффикс, "F_timer_offset_y" + Суффикс, "F_timer_width" + Суффикс, "F_timer_height" + Суффикс);
        ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "button", "Кнопка действия", "#popmechanic-form .popmechanic-button",
            "F_btn_offset_x" + Суффикс, "F_btn_offset_y" + Суффикс, "F_btn_width" + Суффикс, "F_btn_height" + Суффикс);
        ЭлементКрестика = ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "close", "Крестик", "#popmechanic-form .popmechanic-close",
            "F_close_offset_x" + Суффикс, "F_close_offset_y" + Суффикс, "F_close_size" + Суффикс, "F_close_size" + Суффикс);
        ЭлементКрестика.square = Истина;
        ФоновыйЭлемент = ДобавитьВизуальныйЭлемент(ЭлементыРедактора, "background", "Фоновое изображение · положение", "#popmechanic-form",
            "F_form_bg_offset_x" + Суффикс, "F_form_bg_offset_y" + Суффикс, "", "");
        ФоновыйЭлемент.ghost = Истина;
    КонецЕсли;
    Возврат ЭлементыРедактора;
КонецФункции

&НаСервере
Функция ДобавитьВизуальныйЭлемент(Коллекция, Идентификатор, ЗаголовокЭлемента, Селектор, ИмяX, ИмяY, ИмяШирины, ИмяВысоты)
    ЭлементРедактора = Новый Структура("id,label,selector,x,y,w,h,square,ghost", Идентификатор, ЗаголовокЭлемента, Селектор,
        ОписаниеВизуальногоПоля(ИмяX), ОписаниеВизуальногоПоля(ИмяY), ОписаниеВизуальногоПоля(ИмяШирины),
        ОписаниеВизуальногоПоля(ИмяВысоты), Ложь, Ложь);
    Коллекция.Добавить(ЭлементРедактора);
    Возврат ЭлементРедактора;
КонецФункции

&НаСервере
Функция ОписаниеВизуальногоПоля(ИмяПараметра)
    Если ПустаяСтрока(ИмяПараметра) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Каждого ОписаниеПараметра Из ОписаниеПараметров() Цикл
        Если ОписаниеПараметра.Имя = ИмяПараметра И ОписаниеПараметра.Вид = "number" Тогда
            Возврат Новый Структура("name,value,min,max,factor", ИмяПараметра, ЭтотОбъект[ИмяПараметра],
                ОписаниеПараметра.Минимум, ОписаниеПараметра.Максимум, 1);
        КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "Не найден параметр визуального элемента: " + ИмяПараметра;
КонецФункции


#Область ПоложениеОкнаПриПубликации

&НаСервере
Процедура ОформитьКартуПоложенияОкна()

	КартаПоложенияОкна.Добавить();
	КартаПоложенияОкна.Добавить();
	КартаПоложенияОкна.Добавить();

	НомерСтрокиПоложения = Макс(1, Мин(Цел((Правило_ПоложениеОкна - 1) / 3) + 1, 3));
	НомерКолонкиПоложения = Макс(1, Мин(Правило_ПоложениеОкна - (НомерСтрокиПоложения - 1) * 3, 3));
	КартаПоложенияОкна.Получить(НомерСтрокиПоложения - 1)["К" + НомерКолонкиПоложения] = Истина;
	Элементы.КартаПоложенияОкна.ТекущийЭлемент = Элементы["КартаПоложенияОкнаК" + НомерКолонкиПоложения];
	Сч = 0; 
	Для Каждого СтрокаКарты Из КартаПоложенияОкна Цикл
		Сч = Сч + 1;
		Если Сч = НомерСтрокиПоложения Тогда
			Элементы.КартаПоложенияОкна.ТекущаяСтрока = СтрокаКарты.ПолучитьИдентификатор();
			Элементы.КартаПоложенияОкна.ВыделенныеСтроки.Очистить();
			Прервать;
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

&НаКлиенте
Процедура КартаПоложенияОкнаПриАктивизацииЯчейки(Элемент)
	ИмяАктивнойКолонки = Элементы.КартаПоложенияОкна.ТекущийЭлемент.Имя;
	НомерАктивнойКолонки = Число(Прав(ИмяАктивнойКолонки,1));
	ТС = Элементы.КартаПоложенияОкна.ТекущаяСтрока;
	Сч = 0;
	Для Каждого СтрокаКарты Из КартаПоложенияОкна Цикл
		Для ш = 1 По 3 Цикл
			Сч = Сч + 1;
			Если СтрокаКарты.ПолучитьИдентификатор() = ТС и НомерАктивнойКолонки = ш Тогда
				СтрокаКарты["К"+ш] = Истина;
				Правило_ПоложениеОкна = Сч;
			Иначе
				СтрокаКарты["К"+ш] = Ложь;
			КонецЕсли;		
		КонецЦикла;
	КонецЦикла;
	Элементы.КартаПоложенияОкна.ВыделенныеСтроки.Очистить();
КонецПроцедуры

#КонецОбласти
