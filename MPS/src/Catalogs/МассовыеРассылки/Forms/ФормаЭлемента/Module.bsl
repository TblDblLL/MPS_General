#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СлужебныйПКМП.ДеньНеделиВремяПриСозданииФормы(ЭтотОбъект);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Для ПозДеньНедели = 1 по СтрДлина(Объект.ДниНедели) Цикл
			КнопкаДня = Элементы["ДеньНедели"+Сред(Объект.ДниНедели,ПозДеньНедели,1)];
			КнопкаДня.Пометка = Истина;
			КнопкаДня.ЦветФона = Новый Цвет(72,215,44);
		КонецЦИкла;	
	КонецЕсли;	
	
	ИнициализацияДанныхФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//проверка компоновщика на заполнение
	КомпоновкаИРасписание_ПКМП.ПередЗаписьюОтбораКомпоновкиНаСервере(ЭтотОбъект, ТекущийОбъект,
		"НастройкиПолучателей", "Компоновщик_ПоПолучателям", Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВидКаналаПриИзменении(Неопределено);
	УправлениеФормой();
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ВидКаналаПриИзменении(Неопределено);
КонецПроцедуры
#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УправлениеФормой()
	Элементы.ГруппаДеньНеделиВремя.Видимость = Объект.ОграничитьПоВремени;
	Подключаемая_НеОграничиватьВремяСрабатыванияПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОграничитьПоВремениПриИзменении(Элемент)
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииТекста(Элемент)
	
	НормальныйЦвет = Новый Цвет(128,122,89); 
	Если Элементы.ПараметрыПоТипамКаналов.ТекущаяСтраница = Элементы.Канал_Email Тогда
		Если Элемент = Неопределено Тогда
			Элементы.ЗаголовокПочта.ОбновитьТекстРедактирования();
			Элементы.Прехедер.ОбновитьТекстРедактирования();
		КонецЕсли;	
		Если Элемент = Неопределено или Элемент = Элементы.ЗаголовокПочта Тогда
			ОбщегоНазначенияПКМПКлиент.ПриИзмененииТекста(Элементы.ЗаголовокПочта.ТекстРедактирования, , 120, ,Элементы.СостояниеЗаголовокПочта,НормальныйЦвет);
		КонецЕсли;	
		Если Элемент = Неопределено или Элемент = Элементы.Прехедер Тогда
			ОбщегоНазначенияПКМПКлиент.ПриИзмененииТекста(Элементы.Прехедер.ТекстРедактирования, , 150, , Элементы.СостояниеПрехедер, НормальныйЦвет);
		КонецЕсли;	
	ИначеЕсли Элементы.ПараметрыПоТипамКаналов.ТекущаяСтраница = Элементы.Канал_SMS Тогда
		Если Элемент = Неопределено Тогда
			Элементы.СообщениеСМС.ОбновитьТекстРедактирования();
		КонецЕсли;	
		Если Элемент = Неопределено или Элемент = Элементы.СообщениеСМС Тогда
			ОбщегоНазначенияПКМПКлиент.ПриИзмененииТекста(Элементы.СообщениеСМС.ТекстРедактирования, 420, 120, 60, Элементы.СостояниеСообщениеСМС, НормальныйЦвет);
		КонецЕсли;	
	ИначеЕсли Элементы.ПараметрыПоТипамКаналов.ТекущаяСтраница = Элементы.Канал_Mobile Тогда
		Если Элемент = Неопределено Тогда
			Элементы.ЗаголовокМобайл.ОбновитьТекстРедактирования();
			Элементы.СообщениеМобайл.ОбновитьТекстРедактирования();
			Элементы.СсылкаПерехода.ОбновитьТекстРедактирования();
		КонецЕсли;	
		Если Элемент = Неопределено или Элемент = Элементы.ЗаголовокМобайл Тогда
			ОбщегоНазначенияПКМПКлиент.ПриИзмененииТекста(Элементы.ЗаголовокМобайл.ТекстРедактирования, 0, 0, 0, Элементы.СостояниеЗаголовокМобайл, НормальныйЦвет);
		КонецЕсли;	
		Если Элемент = Неопределено или Элемент = Элементы.СообщениеМобайл Тогда
    		ОбщегоНазначенияПКМПКлиент.ПриИзмененииТекста(Элементы.СообщениеМобайл.ТекстРедактирования, 0, 0, 0, Элементы.СостояниеСообщениеМобайл, НормальныйЦвет);
		КонецЕсли;	
		Если Элемент = Неопределено или Элемент = Элементы.СсылкаПерехода Тогда
			ОбщегоНазначенияПКМПКлиент.ПриИзмененииТекста(Элементы.СсылкаПерехода.ТекстРедактирования, 2000, 0, 0, Элементы.СостояниеСсылкаПерехода, НормальныйЦвет);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ПриИзмененииТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВидКаналаПриИзменении(Элемент)
	Если Объект.ВидКанала.Пустая() Тогда
		ИмяКанала = "Пустая";
	Иначе	
		ИмяКанала = ИмяЗначенияПеречисления(ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.ВидКанала, "ТипКанала"));
	КонецЕсли;	
	Элементы.ПараметрыПоТипамКаналов.ТекущаяСтраница = Элементы["Канал_"+ИмяКанала];
	ПриИзмененииТекста(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокПочтаПриИзменении(Элемент)
	Элементы.ЗаголовокМобайл.ОбновитьТекстРедактирования();
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокМобайлПриИзменении(Элемент)
	Элементы.ЗаголовокПочта.ОбновитьТекстРедактирования();
КонецПроцедуры

&НаКлиенте
Процедура СообщениеСМСПриИзменении(Элемент)
	Элементы.СообщениеСМС.ОбновитьТекстРедактирования();
КонецПроцедуры

&НаКлиенте
Процедура СообщениеМобайлПриИзменении(Элемент)
	Элементы.СообщениеСМС.ОбновитьТекстРедактирования(); 
КонецПроцедуры
#КонецОбласти


#Область Инициализация
&НаСервере
Процедура ИнициализацияДанныхФормы()
	
	КомпоновкаИРасписание_ПКМП.ИнициализацияКомпоновки(ЭтотОбъект, "ФильтрПоПартнерам", "НастройкиПолучателей",
		Компоновщик_ПоПолучателям);
КонецПроцедуры
#КонецОбласти

#Область ПодключаемыеОбработкаДиалогаДняНеделиВремени
&НаКлиенте 
Процедура Подключаемая_НеОграничиватьВремяСрабатыванияПриИзменении(Элемент)
	
	Элементы.ГруппаВремя.Видимость = не Объект.НеОграничиватьВремяСрабатывания;
	
КонецПроцедуры	
	
&НаКлиенте 
Процедура Подключаемая_ВыбратьДеньНедели(Команда)
	
	АктивнаяКнопка = ТекущийЭлемент;
	Если не ТипЗнч(АктивнаяКнопка) = Тип("КнопкаФормы") Тогда
		Возврат;
	КонецЕсли;
	
	АктивнаяКнопка.Пометка = не 	АктивнаяКнопка.Пометка;
	
	АктивнаяКнопка.ЦветФона = ?(АктивнаяКнопка.Пометка,Новый Цвет(72,215,44),Новый Цвет);
	
	Объект.ДниНедели = "";
	Для ДеньНедели = 1 по 7 Цикл
		Если Элементы["ДеньНедели"+ДеньНедели].Пометка Тогда
			Объект.ДниНедели = Объект.ДниНедели + ДеньНедели;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры
#КонецОбласти	


#Область СлужебныеПроцедурыИФункции
&НаСервереБезКонтекста
Функция ИмяЗначенияПеречисления(ЗначениеПеречисления)
	Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(ЗначениеПеречисления);
КонецФункции
#КонецОбласти

