&НаКлиенте
Процедура ВыдатьСкидкуНаПродуктыЗаПродуктыПоЗаказам_Параметры(Элемент)
	ТД_ДействияПоЗаказам = Элементы.ДействияАкцииПоЗаказам.ТекущиеДанные;
	Если ТД_ДействияПоЗаказам = Неопределено Тогда Возврат; КонецЕсли;

	ОбработатьСклонениеСпискаКлиент("ВариантОграниченияПоПродуктам_ВСППЗ", ТД_ДействияПоЗаказам.ЗаКаждый, "Винительный", Истина);
	Элементы.ЗаКаждый_ВСППЗ.Заголовок = ?(ТД_ДействияПоЗаказам.ЗаКаждый <= 1 , "за каждый", "за каждые"); 
	Элементы.Уникальность_ВСППЗ.Видимость = (ТД_ДействияПоЗаказам.ЗаКаждый > 1);
	ОбработатьСклонениеСпискаКлиент("ИзменениеКоличестваВ_ВСППЗ", ТД_ДействияПоЗаказам.Количество, "Винительный", Истина);
	ОбработатьСклонениеСпискаКлиент("ВариантОграниченияПоПродуктамЦелиСкидки_ВСППЗ", ТД_ДействияПоЗаказам.НачинаяС, "Винительный", Истина);
	
	Если ТД_ДействияПоЗаказам.ВидСпискаЦелиСкидки = ПредопределенноеЗначение("Перечисление.ВидыСпискаЦелиСкидки.Следующие") Тогда
		Элементы.ВариантОграниченияПоПродуктамЦелиСкидки_ВСППЗ.Доступность = Истина;
	Иначе
		ТД_ДействияПоЗаказам.ВариантОграниченияПоПродуктамЦелиСкидки = Неопределено;
		Элементы.ВариантОграниченияПоПродуктамЦелиСкидки_ВСППЗ.Доступность = Ложь;
	КонецЕсли;	

	ОбработатьВариантОграниченияПоПродуктам(ТД_ДействияПоЗаказам, "ВСППЗ");
	ОбработатьВариантОграниченияПоПродуктам(ТД_ДействияПоЗаказам, "ВСППЗ", "ЦелиСкидки");
	СпискиСтрокиИзФормы();
	
	НеВесьНабор = не ТД_ДействияПоЗаказам.ВидСпискаЦелиСкидки = ПредопределенноеЗначение("Перечисление.ВидыСпискаЦелиСкидки.ВесьНабор") и
				не ТД_ДействияПоЗаказам.ВидСпискаЦелиСкидки.Пустая();
	Элементы.ВСППЗ_3.Видимость = НеВесьНабор;
	Элементы.ВСППЗ_4.Видимость = НеВесьНабор;
	//Элементы.
	
	УправлениеГруппами("СверткаЗаказы");
КонецПроцедуры

