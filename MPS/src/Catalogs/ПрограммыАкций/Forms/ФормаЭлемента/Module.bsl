&НаКлиенте
Перем ЭлементыСтиляКонфигурации;

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.ТипАкции.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не задан тип акции.", , , , Отказ);
		Возврат;
	КонецЕсли;

	СлужебныйПКМП.ДеньНеделиВремяПриСозданииФормы(ЭтотОбъект, , , Ложь);

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Для ПозДеньНедели = 1 По СтрДлина(Объект.ДниНедели) Цикл
			КнопкаДня = Элементы["ДеньНедели" + Сред(Объект.ДниНедели, ПозДеньНедели, 1)];
			КнопкаДня.Пометка = Истина;
			КнопкаДня.ЦветФона = Новый Цвет(72, 215, 44);
		КонецЦикла;
	КонецЕсли;

	ИнициализацияДанныхФормы();

	ВидимостьПериодаВыполнения();
	Элементы.ЧасовойПояс.ПодсказкаВвода = Константы.ЧасовойПоясПоУмолчанию.Получить();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// СоставНабораСегмент виден, когда состав набора задаётся сегментом (СоставВСписке = Ложь).
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНабора.СоставВСписке");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоставНабораСегмент.Имя);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// СоставНабораСписокОтбораТоваров виден, когда состав набора задаётся списком (СоставВСписке = Истина).
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНабора.СоставВСписке");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СоставНабораСписокОтбораТоваров.Имя);
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Для каждого ДействиеАкцииПоЗаказам из Объект.ДействияАкцииПоЗаказам Цикл
		ДействиеАкцииПоЗаказам.СписокОтбораТоваровПоЗаказам.ЗагрузитьЗначения(Объект.ТоварыОтбор.Выгрузить(Новый Структура("КлючСостава",ДействиеАкцииПоЗаказам.КлючСостава)).ВыгрузитьКолонку("Номенклатура"));
		ДействиеАкцииПоЗаказам.СписокОтбораТоваровПоЗаказамЦелиСкидки.ЗагрузитьЗначения(Объект.ТоварыОтбор.Выгрузить(Новый Структура("КлючСостава",ДействиеАкцииПоЗаказам.КлючСоставаЦелиСкидки)).ВыгрузитьКолонку("Номенклатура"));
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//проверка компоновщика на заполнение
	КомпоновкаИРасписание_ПКМП.ПередЗаписьюОтбораКомпоновкиНаСервере(ЭтотОбъект, ТекущийОбъект,
		"НастройкиЗаказовПоПродуктам", "Компоновщик_ЗаказыПоПродуктам", Отказ);
	//проверка компоновщика на заполнение
	КомпоновкаИРасписание_ПКМП.ПередЗаписьюОтбораКомпоновкиНаСервере(ЭтотОбъект, ТекущийОбъект, "НастройкиЗаказов",
		"Компоновщик_ПоЗаказам", Отказ);
КонецПроцедуры

&НаСервере
Процедура ПолучитьСтатус()
	тмпСтатус = ОбработкаДанныхПКМП.ПолучитьСтатус(Объект.Ссылка);
	Статус = ?(Не ЗначениеЗаполнено(тмпСтатус), Перечисления.СтатусыСценариев.Черновик, тмпСтатус);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Объект.ТоварыОтбор.Очистить();
	Для Каждого ЭлементСписка Из СписокОтбораТоваровПоПродуктам Цикл
		НоваяСтрока = Объект.ТоварыОтбор.Добавить();
		НоваяСтрока.Номенклатура = ЭлементСписка.Значение;
		НоваяСтрока.КлючСостава = "ПоПродуктам";
	КонецЦикла;
	Для каждого ДействиеАкцииПоЗаказам из Объект.ДействияАкцииПоЗаказам Цикл
		Если не ДействиеАкцииПоЗаказам.СписокОтбораТоваровПоЗаказам.Количество() = 0 Тогда
			Для каждого ЭлементСписка из ДействиеАкцииПоЗаказам.СписокОтбораТоваровПоЗаказам Цикл
				НоваяСтрока = Объект.ТоварыОтбор.Добавить();
				НоваяСтрока.Номенклатура = ЭлементСписка.Значение;
				НоваяСтрока.КлючСостава = ДействиеАкцииПоЗаказам.КлючСостава;
			КонецЦикла;	
		КонецЕсли;	
		Если не ДействиеАкцииПоЗаказам.СписокОтбораТоваровПоЗаказамЦелиСкидки.Количество() = 0 Тогда
			Для каждого ЭлементСписка из ДействиеАкцииПоЗаказам.СписокОтбораТоваровПоЗаказамЦелиСкидки Цикл
				НоваяСтрока = Объект.ТоварыОтбор.Добавить();
				НоваяСтрока.Номенклатура = ЭлементСписка.Значение;
				НоваяСтрока.КлючСостава = ДействиеАкцииПоЗаказам.КлючСоставаЦелиСкидки;
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

