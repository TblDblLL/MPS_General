&НаКлиенте
Процедура Подключаемая_ВыбратьДеньНедели(Команда)

	АктивнаяКнопка = ТекущийЭлемент;
	Если Не ТипЗнч(АктивнаяКнопка) = Тип("КнопкаФормы") Тогда
		Возврат;
	КонецЕсли;

	АктивнаяКнопка.Пометка = Не АктивнаяКнопка.Пометка;

	АктивнаяКнопка.ЦветФона = ?(АктивнаяКнопка.Пометка, Новый Цвет(72, 215, 44), Новый Цвет);

	Объект.ДниНедели = "";
	Для ДеньНедели = 1 По 7 Цикл
		Если Элементы["ДеньНедели" + ДеньНедели].Пометка Тогда
			Объект.ДниНедели = Объект.ДниНедели + ДеньНедели;
		КонецЕсли;
	КонецЦикла;

	УправлениеГруппами("СверткаДоступность");

КонецПроцедуры

&НаКлиенте
Процедура Подключаемая_Время(Элемент)

	УправлениеГруппами("СверткаДоступность");

КонецПроцедуры
#КонецОбласти

#Область Прочие
&НаСервереБезКонтекста
Функция Склонение(ЗначениеИсходное, ЧисловоеЗначение, Падеж)
	СтрокаСклонения = ПолучитьСклоненияСтрокиПоЧислу(ЗначениеИсходное, ЧисловоеЗначение, , , "ПД=" + Падеж)[0];
	мс = СтрРазделить(СтрокаСклонения, " ");
	мс.Удалить(0);
	Возврат СтрСоединить(мс, " ");
КонецФункции

&НаКлиенте
Процедура ОбработатьСклонениеСпискаКлиент(ИмяЭлемента, ЧисловоеЗначение, Падеж = "Винительный", УчитыватьИсходноеПредставление = Ложь)
	ОбозначениеПустого = "";
	Если БазаСписковВыбора.Свойство(ИмяЭлемента) Тогда
		тмпСписок = БазаСписковВыбора[ИмяЭлемента].Скопировать();
		Для Каждого ЭлементБазы Из тмпСписок Цикл
			Если ЭлементБазы.Значение.Пустая() Тогда
				ОбозначениеПустого = ЭлементБазы.Представление;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		тмпСписок = Элементы[ИмяЭлемента].СписокВыбора.Скопировать();
	КонецЕсли;
	ОбработатьСклонениеСписка(тмпСписок, ЧисловоеЗначение, Падеж, УчитыватьИсходноеПредставление);
	Для Каждого ЭлементСклонения Из тмпСписок Цикл
		ЭлементСписка = Элементы[ИмяЭлемента].СписокВыбора.НайтиПоЗначению(ЭлементСклонения.Значение);
		Если ЭлементСписка = Неопределено Тогда Продолжить; КонецЕсли;
		мс = СтрРазделить(ЭлементСклонения.Представление, " ");
		мс.Удалить(0);
		ЭлементСписка.Представление = СтрСоединить(мс, " ");
		ЭлементСписка.Картинка = ЭлементСклонения.Картинка;
	КонецЦикла;

	Если Не ПустаяСтрока(ОбозначениеПустого) И ТипЗнч(Элементы[ИмяЭлемента]) = Тип("ПолеФормы")
		И Элементы[ИмяЭлемента].Вид = ВидПоляФормы.ПолеВвода Тогда

		Элементы[ИмяЭлемента].ПодсказкаВвода = Склонение(ОбозначениеПустого, ЧисловоеЗначение, Падеж);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьСклонениеСписка(Список, ЧисловоеЗначение, Падеж, УчитыватьИсходноеПредставление = Ложь)
	СлужебныйПКМП.СклонениеПредставленийПеречисленийВСпискеПоЧисловомуЗначению(Список, ЧисловоеЗначение, Падеж, УчитыватьИсходноеПредставление);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяЗначенияПеречисления(ЗначениеПеречисления)
	Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(ЗначениеПеречисления);
КонецФункции
#КонецОбласти

#Область ВизуализацияФормы
&НаКлиенте
Процедура СверткаНажатие(Элемент)
	УправлениеГруппами(Элемент.Имя, Истина);
КонецПроцедуры

&НаКлиенте
Процедура УправлениеГруппами(ИмяЭлементаЗаголовкаГруппы, ИзменятьСвернутость = Ложь)
	ИДГруппы = СтрЗаменить(ИмяЭлементаЗаголовкаГруппы, "Свертка", "");
	Группа = Элементы[СтрЗаменить(ИмяЭлементаЗаголовкаГруппы, "Свертка", "Группа")];
	ЭлементОписание = Элементы["Описание" + ИмяЭлементаЗаголовкаГруппы];
	Элемент = Элементы[ИмяЭлементаЗаголовкаГРуппы];
	ЗаголовокБезЗнака = Сред(Элемент.Заголовок, 2);

	Свернута = Группа.Видимость;
	Если ИзменятьСвернутость Тогда
		Свернута = Не Свернута;
		Группа.Видимость = Свернута;
	КонецЕсли;

	ЕстьОшибки = Ложь;
	ЭлементОписание.Заголовок = ПолучитьОписаниеГруппы(ИДГруппы, ЕстьОшибки);

	Если Свернута Тогда
		Знак = "▼";
	Иначе
		Знак = "►";
	КонецЕсли;

	Элемент.Заголовок = Знак + ЗаголовокБезЗнака;
	Если ЕстьОшибки Тогда
		Элемент.ЦветТекста = WEBЦвета.Красный;
		ЭлементОписание.ЦветТекста = WEBЦвета.Красный;
	Иначе
		ЦветНормы = Новый Цвет(51, 153, 102);
		Элемент.ЦветТекста = ЦветНормы;
		ЭлементОписание.ЦветТекста = ЦветНормы;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьОписаниеГруппы(ИДГруппы, ЕстьОшибки)

	ЕстьОшибки = Ложь;
	ОписаниеГруппы = Новый Массив;
	Если ИДГруппы = "Контрагенты" Тогда
		Если Объект.ВидОтбораПоКлиентам = ПредопределенноеЗначение("Перечисление.ЕстьНетНеВажно.НеВажно") Тогда
			ОписаниеГруппы.Добавить("Для всех клиентов.");
		ИначеЕсли Не Объект.ВидОтбораПоКлиентам.Пустая() Тогда
			Если Объект.СегментКлиентов.Пустая() Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан сегмент клиентов. ");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("Для клиентов %1 из сегмента <b>""%2""</b>. ", ?(
					Объект.ВидОтбораПоКлиентам = ПредопределенноеЗначение("Перечисление.ЕстьНетНеВажно.Нет"), "не", ""),
					Объект.СегментКлиентов));
			КонецЕсли;
		Иначе
			ЕстьОшибки = Истина;
			ОписаниеГруппы.Добавить("Не указан вид отбора по клиентам.");
		КонецЕсли;
	ИначеЕсли ИДГруппы = "Доступность" Тогда
		Если Не Объект.ОграничитьПоПромокодам И Не Объект.ОграничитьПоВремени Тогда
			ОписаниеГруппы.Добавить("Доступно всегда.");
		КонецЕсли;
		Если Объект.ОграничитьПоПромокодам Тогда
			Если Объект.НаборПромокодов.Пустая() Тогда
				ОписаниеГруппы.Добавить("Не указан набор промокодов.");
				ЕстьОшибки = Истина;
			Иначе
				ДополнениеПромокодовПоКоличеству = "";
				Если Объект.РазрешитьНесколькоПромокодовВЗаказе Тогда
					ДополнениеПромокодовПоКоличеству = СтрШаблон("(не более <b>%1 %2</b> из набора в одном заказе)",
						Объект.КоличествоПромокодовВЗаказе, Элементы.ДекорацияПромокоды2.Заголовок);
				КонецЕсли;
				ОписаниеГруппы.Добавить(СтрШаблон("При доступности промокода из набора <b>""%1""</b> %2. ",
					Объект.НаборПромокодов, ДополнениеПромокодовПоКоличеству));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ОграничитьПоВремени Тогда
			Если ПустаяСтрока(Объект.ДниНедели) Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указаны дни недели доступности.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("Доступна в дни недели <b>%1</b> ",
					ОбщегоНазначенияПКМПКлиентСервер.НаименованияДнейНедели(Объект.ДниНедели)));
			КонецЕсли;
			Если Не Объект.НеОграничиватьВремяСрабатывания Тогда
				ИнтервалНекорректен = "";
				Если Объект.ВремяС >= Объект.ВремяПо Тогда
					ЕстьОшибки = Истина;
					ИнтервалНекорректен = " - некорректно указан интервал времени";
				КонецЕсли;
				ОписаниеГруппы.Добавить(СтрШаблон("(с <b>%1</b> по <b>%2</b> %3) ", Формат(Объект.ВремяС,
					"ДФ=ЧЧ:мм; ДП=00:00;"), Формат(Объект.ВремяПо, "ДФ=ЧЧ:мм; ДП=00:00;"), ИнтервалНекорректен));
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ИДГруппы = "Места" Тогда
		ФильтрКаналов  = "во всех каналах";
		ФильтрЗон  = "во всех зонах";
		Если Объект.ОграничитьПоКаналам Тогда
			Если Не ДеревоКаналов.ПолучитьЭлементы().Количество() = 0 Тогда
				МассивОтмеченных =  ОтчетыКлиентСервер.НайтиСтрокиТаблицы(ДеревоКаналов, Новый Структура("Отметка",
					Истина));
				Если МассивОтмеченных.Количество() = 0 Тогда
					ЕстьОшибки = Истина;
					ФильтрКаналов = "<не указаны каналы>";
				Иначе
					ФильтрКаналов =  "в каналах " + ОбщегоНазначенияПКМПКлиентСервер.СократитьСтроку(МассивОтмеченных,
						20, , "ЗначениеОтбора");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Объект.ОграничитьПоЗонам Тогда
			Если Не ДеревоЗон.ПолучитьЭлементы().Количество() = 0 Тогда
				МассивОтмеченных =  ОтчетыКлиентСервер.НайтиСтрокиТаблицы(ДеревоЗон, Новый Структура("Отметка", Истина));
				Если МассивОтмеченных.Количество() = 0 Тогда
					ЕстьОшибки = Истина;
					ФильтрКаналов = "<не указаны зоны>";
				Иначе
					ФильтрКаналов =  "в зонах " + ОбщегоНазначенияПКМПКлиентСервер.СократитьСтроку(МассивОтмеченных,
						20, , "ЗначениеОтбора");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ОписаниеГруппы.Добавить(СтрШаблон("Промоакция действует <b>%1</b> и <b>%2</b>", ФильтрКаналов, ФильтрЗон));
	ИначеЕсли ИДГруппы = "Продукты" Тогда
		Если не Объект.ОграничитьПоПродуктам и не Объект.ОграничитьЗаказыПоПродуктам Тогда
			ОписаниеГруппы.Добавить("Для всех продуктов.");
		Иначе
			Если Объект.ДействиеАкцииПоПродуктам.Пустая() Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указано действие акции при установленных отборах.");
//			Иначе
//				ОписаниеГруппы.Добавить(СтрШаблон("Выполнить действие: <b>%1</b>", Объект.ДействиеАкцииПоПродуктам));
			КонецЕсли;
		КонецЕсли;
		Если Объект.ОграничитьПоПродуктам Тогда
			Если Объект.ВариантОграниченияПоПродуктам.Пустая() Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан вариант ограничения по продуктам.");
			ИначеЕсли Объект.ВариантОграниченияПоПродуктам = ПредопределенноеЗначение(
				"Перечисление.ВариантыОграниченияПоПродуктам.ВСписке") Тогда
				Если СписокОтбораТоваровПоПродуктам.Количество() = 0 Тогда
					ЕстьОшибки = Истина;
					ОписаниеГруппы.Добавить("Список продуктов не заполнен.");
				Иначе
					ОписаниеГруппы.Добавить("Промоакция действует на товары: <b>"
						+ ОбщегоНазначенияПКМПКлиентСервер.СократитьСтроку(СписокОтбораТоваровПоПродуктам, 100) + "<b>");
				КонецЕсли;
			Иначе
				Если Объект.СегментНоменклатурыПоПродуктам.Пустая() Тогда
					ЕстьОшибки = Истина;
					ОписаниеГруппы.Добавить("Сегмент продуктов не указан.");
				Иначе
					ОписаниеГруппы.Добавить("Промоакция действует на товары сегмента: <b>"
						+ Объект.СегментНоменклатурыПоПродуктам + "</b>");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Объект.ОграничитьЗаказыПоПродуктам Тогда
			Если Компоновщик_ЗаказыПоПродуктам.Настройки.Отбор.Элементы.Количество() = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан отбор по заказам.");
			Иначе
				ОписаниеГруппы.Добавить("Отбор по заказам: "
					+ КомпоновкаИРасписание_ПКМПКлиентСервер.ТекстовоеПредставлениеОтбораКомпоновки(
					Компоновщик_ЗаказыПоПродуктам.Настройки));
			КонецЕсли;
		КонецЕсли;
		ОписаниеГруппы.Добавить(ПолучитьОписаниеДействийПоПродуктам(ЕстьОшибки));
	ИначеЕсли ИДГруппы = "Заказы" Тогда
		Если Объект.ОграничитьПоЗаказам Тогда
			Если Компоновщик_ПоЗаказам.Настройки.Отбор.Элементы.Количество() = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан отбор по заказам.");
			Иначе
				ОписаниеГруппы.Добавить("Отбор по заказам: "
					+ КомпоновкаИРасписание_ПКМПКлиентСервер.ТекстовоеПредставлениеОтбораКомпоновки(
					Компоновщик_ПоЗаказам.Настройки));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ДействияАкцииПоЗаказам.Количество() = 0 Тогда
			ЕстьОшибки = Истина;
			ОписаниеГруппы.Добавить("Не указаны действия акции по заказу.");
		Иначе
//			ОписаниеГруппы.Добавить(СтрШаблон("Выполнить действия: <b>%1</b>",
//				ОбщегоНазначенияПКМПКлиентСервер.СократитьСтроку(Объект.ДействияАкцииПоЗаказам, 100, ,
//				"ДействиеАкции")));
		КонецЕсли;	
		ЛегендаКаскаднойСкидки();	
		ОписаниеГруппы.Добавить(ПолучитьОписаниеДействийПоЗаказам(ЕстьОшибки));
	ИначеЕсли ИДГруппы = "Лимиты" Тогда
		Если Объект.ЕстьЛимитОбщийКоличество Тогда
			Если Объект.ЛимитОбщийКоличество = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан лимит общего количества.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>", Элементы.ЕстьЛимитОбщийКоличество.Заголовок,
					Объект.ЛимитОбщийКоличество, Элементы.ТекстРазЛОК.Заголовок, ?(
					Объект.ПериодЛимитаОбщийКоличество.Пустая(), "", Объект.КоличествоПериодовЛимитаОбщийКоличество), ?(
					Объект.ПериодЛимитаОбщийКоличество.Пустая(), "всё время акции", НРег(
					Элементы.ПериодЛимитаОбщийКоличество.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ЕстьЛимитОбщийСумма Тогда
			Если Объект.ЛимитОбщийСумма = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан лимит общей суммы.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>", Элементы.ЕстьЛимитОбщийСумма.Заголовок,
					Объект.ЛимитОбщийСумма, Элементы.ТекстРубЛОС.Заголовок, ?(Объект.ПериодЛимитаОбщийСумма.Пустая(),
					"", Объект.КоличествоПериодовЛимитаОбщийСумма), ?(Объект.ПериодЛимитаОбщийСумма.Пустая(),
					"всё время акции", НРег(Элементы.ПериодЛимитаОбщийСумма.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ЕстьЛимитПерсональныйКоличество Тогда
			Если Объект.ЛимитПерсональныйКоличество = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан персональный лимит количества.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>",
					Элементы.ЕстьЛимитПерсональныйКоличество.Заголовок, Объект.ЛимитПерсональныйКоличество,
					Элементы.ТекстРазЛПК.Заголовок, ?(Объект.ПериодЛимитаПерсональныйКоличество.Пустая(), "",
					Объект.КоличествоПериодовЛимитаПерсональныйКоличество), ?(
					Объект.ПериодЛимитаПерсональныйКоличество.Пустая(), "всё время акции", НРег(
					Элементы.ПериодЛимитаПерсональныйКоличество.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ЕстьЛимитПерсональныйСумма Тогда
			Если Объект.ЛимитПерсональныйСумма = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан персональный лимит суммы.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>", Элементы.ЕстьЛимитПерсональныйСумма.Заголовок,
					Объект.ЛимитПерсональныйСумма, Элементы.ТекстРубЛПС.Заголовок, ?(
					Объект.ПериодЛимитаПерсональныйСумма.Пустая(), "", Объект.КоличествоПериодовЛимитаПерсональныйСумма),
					?(Объект.ПериодЛимитаПерсональныйСумма.Пустая(), "всё время акции", НРег(
					Элементы.ПериодЛимитаПерсональныйСумма.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ЭлементыСтиляКонфигурации = Неопределено Тогда
		ЭлементыСтиляКонфигурации = СтандартныеПодсистемыКлиент.ЭлементыСтиля();
	КонецЕсли;

	кс = ОписаниеГруппы.Количество();
	Для ш = 1 По кс Цикл
		ОписаниеГруппы[ш - 1] = СтроковыеФункцииКлиентСервер.СформироватьФорматированнуюСтроку(ОписаниеГруппы[ш - 1]
			+ ?(ш = кс, "", Символы.ПС), ЭлементыСтиляКонфигурации, Неопределено, Неопределено, Неопределено,
			Неопределено, Неопределено);
	КонецЦикла;
	Возврат Новый ФорматированнаяСтрока(ОписаниеГруппы);
КонецФункции

&НаКлиенте
Функция ОписаниеВариантОграниченияПоПродуктам(Источник, ИДСтраницы, Вариант = "")
	ВариантОграничения = Источник[СтрШаблон("ВариантОграниченияПоПродуктам%1",Вариант)];
	ПоСписку =  (ВариантОграничения = ПредопределенноеЗначение("Перечисление.ВариантыОграниченияПоПродуктам.ВСписке"));
	ПоСегменту = (ВариантОграничения = ПредопределенноеЗначение("Перечисление.ВариантыОграниченияПоПродуктам.ВСегменте") 
				или 
	  			ВариантОграничения = ПредопределенноеЗначение("Перечисление.ВариантыОграниченияПоПродуктам.НеВСегменте"));
	  			
	ТекстОписания =  Элементы[СтрШаблон("ВариантОграниченияПоПродуктам%1_%2",Вариант,ИДСтраницы)].ТекстРедактирования; 			
	Если ПоСегменту Тогда
		ТекстУсловия = Элементы[СтрШаблон("СегментНоменклатуры%1_%2",Вариант,ИДСтраницы)].ТекстРедактирования;
		Описание = СтрШаблон(" %1 ""%2""",ТекстОписания,ТекстУсловия);
	ИначеЕсли	ПоСписку Тогда
		ТекстУсловия =  ОбщегоНазначенияПКМПКлиентСервер.СократитьСтроку(ЭтотОбъект[СтрШаблон("СписокОтбораТоваровПоЗаказам%1",Вариант)], 100);     			
		Описание = СтрШаблон(" %1 ""%2""",ТекстОписания,ТекстУсловия);
	Иначе
		Описание = Элементы[СтрШаблон("ВариантОграниченияПоПродуктам%1_%2",Вариант,ИДСтраницы)].ПодсказкаВвода;
	КонецЕсли;		 			
	  			
	Возврат Описание;
КонецФункции

&НаКлиенте
Процедура ЛегендаКаскаднойСкидки()
	
	ТД_ДействияПоЗаказам = Элементы.ДействияАкцииПоЗаказам.ТекущиеДанные;
	Если ТД_ДействияПоЗаказам = Неопределено или не ТД_ДействияПоЗаказам.ДействиеАкции = ПредопределенноеЗначение("Перечисление.ДействияВАкциях.КаскаднаяСкидка") Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЭлементыСтиляКонфигурации = Неопределено Тогда
		ЭлементыСтиляКонфигурации = СтандартныеПодсистемыКлиент.ЭлементыСтиля();
	КонецЕсли;
	
	ЛегендаКаскаднойСкидки.Удалить();
	
	
//	ПозицияНачалаПрименения = Макс(ТД_ДействияПоЗаказам.ЗаКаждый, ТД_ДействияПоЗаказам.НачинаяС);
//	ПозицияКонцаПрименения = Макс(ТД_ДействияПоЗаказам.ЗаКаждый, ТД_ДействияПоЗаказам.ОканчиваяС);
	ПозицияНачалаПрименения = ТД_ДействияПоЗаказам.НачинаяС;
	ПозицияКонцаПрименения = ТД_ДействияПоЗаказам.ОканчиваяС;
	
	СтрокиЛегенды = Новый Массив;
	СтрокиЛегенды.Добавить(СтрШаблон("%1 <b>%2</b> %3",
			Элементы.ЗаКаждый_КСЗ.Заголовок,
			ТД_ДействияПоЗаказам.ЗаКаждый,
			ОписаниеВариантОграниченияПоПродуктам(ТД_ДействияПоЗаказам,"КСЗ")));
	СтрокиЛегенды.Добавить(СтрШаблон("выдать дополнительную скидку на продукты из того же сегмента <b>%1</b> %2, начиная с <b>%3</b>-го продукта.",
			ТД_ДействияПоЗаказам.Количество,
			Элементы.ИзменениеКоличестваВ_КСЗ.ТекстРедактирования,
			ТД_ДействияПоЗаказам.НачинаяС));
	СтрокиЛегенды.Добавить("");
	СтрокиЛегенды.Добавить("При применении скидки продукты сортируются по убыванию цены, т.е. на продукт с наибольшей ценой применится минимальная скидка.");
	СтрокиЛегенды.Добавить("");
	СтрокиЛегенды.Добавить("Пример результата:");
	СтрокиЛегенды.Добавить("");
	Если ПозицияКонцаПрименения < ПозицияНачалаПрименения или ПозицияНачалаПрименения = 0 или ТД_ДействияПоЗаказам.ЗаКаждый = 0 Тогда
		СтрокиЛегенды.Добавить("<b>Не указаны или некорректно указаны границы применения</b>");
	Иначе
		РазмерСкидки = 0;
		Позиция = 1;
		Пока Позиция <= ТД_ДействияПоЗаказам.ОканчиваяС + 2 Цикл
			НачПозицияСлота = Позиция;
			КонПозицияСлота = Позиция + (ТД_ДействияПоЗаказам.ЗаКаждый - 1);
			ПервыйПроходСлота = Истина;
			Для ПозицияВСлоте = НачПозицияСлота По КонПозицияСлота Цикл
				Если ПозицияВСлоте >= ПозицияНачалаПрименения И ПозицияВСлоте <= ПозицияКонцаПрименения
					И ПервыйПроходСлота Тогда
					РазмерСкидки = РазмерСкидки + ТД_ДействияПоЗаказам.Количество;
					ПервыйПроходСлота = Ложь;
				КонецЕсли;

				СтрокиЛегенды.Добавить(СтрШаблон("%1-й продукт - скидка <b>%2</b> %3", Позиция, РазмерСкидки,
					Элементы.ИзменениеКоличестваВ_КСЗ.ТекстРедактирования));
				Позиция = Позиция + 1;
			КонецЦикла;

		КонецЦикла;
		СтрокиЛегенды.Добавить("и т.д.");

		СтрокиЛегенды.Вставить(2, СтрШаблон(
			"Начиная с <b>%1</b>-го продукта, выдавать максимальную скидку (<b>%2</b> %3)",
			ТД_ДействияПоЗаказам.ОканчиваяС, РазмерСкидки, Элементы.ИзменениеКоличестваВ_КСЗ.ТекстРедактирования));
	КонецЕсли;
	Элементы.МаксимальноеКоличество_КСЗ.Заголовок = РазмерСкидки;
	
	кс = СтрокиЛегенды.Количество();
	Для ш = 1 По кс Цикл
		СтрокиЛегенды[ш - 1] = СтроковыеФункцииКлиентСервер.СформироватьФорматированнуюСтроку(СтрокиЛегенды[ш - 1]
			+ ?(ш = кс, "", Символы.ПС), ЭлементыСтиляКонфигурации, Неопределено, Неопределено, Неопределено,
			Неопределено, Неопределено);
	КонецЦикла;
	
	ЛегендаКаскаднойСкидки.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(СтрокиЛегенды));
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьОписаниеДействийПоЗаказам(ЕстьОшибки)
	
	Описания = Новый Массив;
	Для каждого СтрокаДействияАкции из Объект.ДействияАкцииПоЗаказам Цикл
		Если СтрокаДействияАкции.ДействиеАкции.Пустая() Тогда Продолжить; КонецЕсли;
		Если СтрокаДействияАкции.ПолучитьИдентификатор() = Элементы.ДействияАкцииПоЗаказам.ТекущаяСтрока Тогда
			ПроверяемаяГруппа = Элементы[ИмяЗначенияПеречисления(СтрокаДействияАкции.ДействиеАкции)+"ПоЗаказам"];
			ОписанияСтроки = Новый Массив;
			ОписанияСтроки.Добавить("<b>" + Строка(СтрокаДействияАкции.ДействиеАкции)+"</b>:");
			ОписанияСтроки.Добавить(СтрСоединить(ОписанияПодчиненныхЭлементов(ПроверяемаяГруппа, СтрокаДействияАкции, ЕстьОшибки),Символы.ПС));
			СтрокаДействияАкции.Описание = СтрСоединить(ОписанияСтроки,Символы.ПС);
		КонецЕсли;	
		Описания.Добавить(СтрокаДействияАкции.Описание);
	КонецЦикла;
	Возврат СтрСоединить(Описания,Символы.ПС);
КонецФункции	

&НаКлиенте
Функция ПолучитьОписаниеДействийПоПродуктам(ЕстьОшибки)
	
	Если Объект.ДействиеАкцииПоПродуктам.Пустая() Тогда Возврат ""; КонецЕсли;
	
	ПроверяемаяГруппа = Элементы[ИмяЗначенияПеречисления(Объект.ДействиеАкцииПоПродуктам)+"ПоПродуктам"];
	
	Описание = "<b>" + Строка(Объект.ДействиеАкцииПоПродуктам) + "</b>:
				|" +
				СтрСоединить(ОписанияПодчиненныхЭлементов(ПроверяемаяГруппа, Объект, ЕстьОшибки),Символы.ПС);
	
	Возврат Описание;
КонецФункции	

&НаКлиенте
Функция ОписанияПодчиненныхЭлементов(Родитель, Источник, ЕстьОшибки)
	
	Описания = Новый Массив;
	
	// Обход в порядке расположения: слева направо, сверху вниз.
	Для Каждого Элемент Из Родитель.ПодчиненныеЭлементы Цикл
		
		Если Не Элемент.Видимость Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = ОписаниеЭлементаФормы(Элемент, Источник, ЕстьОшибки);
		Если Не ПустаяСтрока(Описание) Тогда
			Описания.Добавить(Описание);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Описания;
	
КонецФункции

&НаКлиенте
Функция ОписаниеЭлементаФормы(Элемент, Источник, ЕстьОшибки)
	
	ТипЭлемента = ТипЗнч(Элемент);
	
	Если ТипЭлемента = Тип("ГруппаФормы") Тогда
		Возврат ОписаниеГруппыФормы(Элемент, Источник, ЕстьОшибки);
	ИначеЕсли ТипЭлемента = Тип("ТаблицаФормы") Тогда
		Возврат ОписаниеТаблицыФормы(Элемент, ЕстьОшибки);
	ИначеЕсли ТипЭлемента = Тип("ДекорацияФормы") Тогда
		Возврат ОписаниеДекорацииФормы(Элемент);
	ИначеЕсли ТипЭлемента = Тип("ПолеФормы") Тогда
		Возврат ОписаниеПоляФормы(Элемент, Источник, ЕстьОшибки);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОписаниеГруппыФормы(Группа, Источник, ЕстьОшибки)
	
	ВидГруппы = Группа.Вид;
	ЭтоГруппаУправления = ВидГруппы = ВидГруппыФормы.КоманднаяПанель
		Или ВидГруппы = ВидГруппыФормы.ГруппаКнопок
		Или ВидГруппы = ВидГруппыФормы.Подменю
		Или ВидГруппы = ВидГруппыФормы.КонтекстноеМеню;
	
	Если ЭтоГруппаУправления Тогда
		// Командные панели и меню не описывают состояние данных.
		Возврат "";
	КонецЕсли;
	
	Перечень = СтрСоединить(ОписанияПодчиненныхЭлементов(Группа, Источник, ЕстьОшибки), " ");
	
	Если ПустаяСтрока(Группа.Заголовок) или не Группа.ОтображатьЗаголовок  Тогда
		Возврат Перечень;
	КонецЕсли;
	
	Возврат СокрЛП(Группа.Заголовок + ": " + Перечень);
	
КонецФункции

&НаКлиенте
Функция ОписаниеПоляФормы(Поле, Источник, ЕстьОшибки)
	
	ВидПоля = Поле.Вид;
	
	Если ВидПоля = ВидПоляФормы.ПолеНадписи Тогда
		Возврат Поле.Заголовок;
	Иначе
		Если ВидПоля = ВидПоляФормы.ПолеВвода 
		Или ВидПоля = ВидПоляФормы.ПолеПереключателя 
		Или ВидПоля = ВидПоляФормы.ПолеФлажка 
		Тогда
			Позиция_ = СтрНайти(Поле.Имя, "_");
			Если Позиция_ >= 2 Тогда
				ИмяРеквизита = Лев(Поле.Имя, Позиция_ - 1);
			Иначе
				ИмяРеквизита = Поле.Имя;
			КонецЕсли;
			
			ЗначениеРеквизита = Неопределено;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник,  ИмяРеквизита) Тогда
				ЗначениеРеквизита = Источник[ИмяРеквизита];
			ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект,  ИмяРеквизита) Тогда
				ЗначениеРеквизита = ЭтотОбъект[ИмяРеквизита];
			КонецЕсли;
			
			ДополнениеОшибки = "";
			Если не ЗначениеЗаполнено(ЗначениеРеквизита) и не(ВидПоля = ВидПоляФормы.ПолеВвода и не Поле.ОтметкаНезаполненного) Тогда
				ЕстьОшибки = Истина;
				ДополнениеОшибки = " <b>➔не заполнено</b> ";
			КонецЕсли;	
			МаксимальнаяДлинаСписка = 120;
			
			КВозврату = "";
			Если ТипЗнч(ЗначениеРеквизита) = Тип("СписокЗначений") Тогда
				Значение = ОбщегоНазначенияПКМПКлиентСервер.СократитьСтроку(ЗначениеРеквизита, МаксимальнаяДлинаСписка);
				КВозврату =  ЗначениеСЗаголовком(Поле, Значение);
			ИначеЕсли Поле.Вид = ВидПоляФормы.ПолеВвода Тогда
				Если не Поле.ОтметкаНезаполненного и не ПустаяСтрока(Поле.ПодсказкаВвода) и не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
					КВозврату =  ЗначениеСЗаголовком(Поле, Поле.ПодсказкаВвода);
				Иначе	
					КВозврату =  ЗначениеСЗаголовком(Поле, Поле.ТекстРедактирования, ЗначениеРеквизита);
				КонецЕсли;
			ИначеЕсли Поле.Вид = ВидПоляФормы.ПолеФлажка Тогда
				Если ЗначениеРеквизита = Неопределено Тогда
					КВозврату =  ЗаголовокЭлементаФормы(Поле);
				Иначе
					Если Не ПустаяСтрока(Поле.ФорматРедактирования) Тогда
						КВозврату =  ЗначениеСЗаголовком(Поле, Формат(ЗначениеРеквизита, Поле.ФорматРедактирования), ЗначениеРеквизита, Истина);
					Иначе
						КВозврату =  ЗначениеСЗаголовком(Поле, ЗначениеРеквизита, , Истина);
					КонецЕсли;	
				КонецЕсли;		
			Иначе
				Если ЗначениеРеквизита = Неопределено Тогда
					КВозврату =  ЗаголовокЭлементаФормы(Поле);
				Иначе
					КВозврату =  ЗначениеСЗаголовком(Поле, ЗначениеРеквизита, , Истина);
				КонецЕсли;		
			КонецЕсли;
			Возврат КВозврату + ДополнениеОшибки;
		Иначе
			Возврат ЗаголовокЭлементаФормы(Поле);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОписаниеДекорацииФормы(Декорация)
	
	Если Декорация.Вид = ВидДекорацииФормы.Надпись Тогда
		Возврат Декорация.Заголовок;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция ОписаниеТаблицыФормы(Таблица, ЕстьОшибки)
	
	ИмяТаблицы = Таблица.Имя;
	Если ИмяТаблицы = "СоставНабора" Тогда
		Описание = "Набор (%1 стр.)";
		Если Объект.СоставНабора.Количество() = 0 Тогда
			Описание = Описание + ", набор пустой";
			ЕстьОшибки = Истина;
		Иначе
			СтрокиСОшибками = Новый Массив;
			Для Каждого СтрокаНабора Из Объект.СоставНабора Цикл
				Если СтрокаНабора.Количество = 0 Или (СтрокаНабора.СоставВСписке
					И СтрокаНабора.СписокОтбораТоваров.Количество() = 0 Или Не СтрокаНабора.СоставВСписке
					И СтрокаНабора.Сегмент.Пустая()) Тогда
					СтрокиСОшибками.Добавить(СтрокаНабора.НомерСтроки);
					ЕстьОшибки = Истина;
				КонецЕсли;
			КонецЦикла;
			Если Не СтрокиСОшибками.Количество() = 0 Тогда
				Описание = Описание + ", ошибки в строке: " + СтрСоединить(СтрокиСОшибками, ",");
			КонецЕсли;
		КонецЕсли;
		Возврат СтрШаблон(Описание, Объект.СоставНабора.Количество());
	Иначе
		Возврат "таблица " + ИмяТаблицы;
	КонецЕсли;
КонецФункции


&НаКлиенте
Функция ЗначениеСЗаголовком(Элемент, Представление, Значение = Неопределено, ЭтоБулево = Ложь)
	
	КВыводу  = ?(не ЗначениеЗаполнено(Представление) и не Значение = Неопределено, Значение,Представление);
	Заголовок = ЗаголовокЭлементаФормы(Элемент);
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат "<b>"+СокрЛП(КВыводу)+"</b>";
	ИначеЕсли Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право и
			не ЭтоБулево Тогда
		Возврат СокрЛП("<b>"+КВыводу + "</b> " + Заголовок);
	Иначе
		Возврат СокрЛП(Заголовок + " <b>" + КВыводу+ ",</b>");
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ЗаголовокЭлементаФормы(Элемент)
	
	Если Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Элемент.Заголовок;
	
КонецФункции
#КонецОбласти


