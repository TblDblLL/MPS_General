&НаКлиенте
Перем ЭлементыСтиляКонфигурации, СокращенияФормы;

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.ТипАкции.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю("Не задан тип акции.", , , , Отказ);
		Возврат;
	КонецЕсли;

	СлужебныйПКМП.ДеньНеделиВремяПриСозданииФормы(ЭтотОбъект, , , Ложь);

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Для ПозДеньНедели = 1 По СтрДлина(Объект.ДниНедели) Цикл
			КнопкаДня = Элементы["ДеньНедели" + Сред(Объект.ДниНедели, ПозДеньНедели, 1)];
			КнопкаДня.Пометка = Истина;
			КнопкаДня.ЦветФона = Новый Цвет(72, 215, 44);
		КонецЦикла;
	КонецЕсли;

	ИнициализацияДанныхФормы();

	ВидимостьПериодаВыполнения();
	Элементы.ЧасовойПояс.ПодсказкаВвода = Константы.ЧасовойПоясПоУмолчанию.Получить();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//проверка компоновщика на заполнение
	КомпоновкаИРасписание_ПКМП.ПередЗаписьюОтбораКомпоновкиНаСервере(ЭтотОбъект, ТекущийОбъект,
		"НастройкиЗаказовПоПродуктам", "Компоновщик_ЗаказыПоПродуктам", Отказ);
	//проверка компоновщика на заполнение
	КомпоновкаИРасписание_ПКМП.ПередЗаписьюОтбораКомпоновкиНаСервере(ЭтотОбъект, ТекущийОбъект, "НастройкиЗаказов",
		"Компоновщик_ПоЗаказам", Отказ);
КонецПроцедуры

&НаСервере
Процедура ПолучитьСтатус()
	тмпСтатус = ОбработкаДанныхПКМП.ПолучитьСтатус(Объект.Ссылка);
	Статус = ?(Не ЗначениеЗаполнено(тмпСтатус), Перечисления.СтатусыСценариев.Черновик, тмпСтатус);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Объект.ТоварыОтбор.Очистить();
	Для Каждого ЭлементСписка Из СписокОтбораТоваровПоПродуктам Цикл
		НоваяСтрока = Объект.ТоварыОтбор.Добавить();
		НоваяСтрока.Номенклатура = ЭлементСписка.Значение;
		НоваяСтрока.КлючСостава = Истина;
	КонецЦикла;
	Для Каждого ЭлементСписка Из СписокОтбораТоваровПоЗаказам Цикл
		НоваяСтрока = Объект.ТоварыОтбор.Добавить();
		НоваяСтрока.Номенклатура = ЭлементСписка.Значение;
		НоваяСтрока.КлючСостава = Ложь;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти

#Область Инициализация
&НаСервере
Процедура ИнициализацияДанныхФормы()
	
	ЗаполнениеЗависимыхДанныхНаСервере();

	КомпоновкаИРасписание_ПКМП.ИнициализацияКомпоновки(ЭтотОбъект, "ФильтрПоЗаказам", "НастройкиЗаказовПоПродуктам",
		Компоновщик_ЗаказыПоПродуктам);
	КомпоновкаИРасписание_ПКМП.ИнициализацияКомпоновки(ЭтотОбъект, "ФильтрПоЗаказам", "НастройкиЗаказов",
		Компоновщик_ПоЗаказам);

	ПолучитьСтатус();

	СписокОтбораТоваровПоПродуктам.ЗагрузитьЗначения(Объект.ТоварыОтбор.Выгрузить(Новый Структура("КлючСостава",
		Истина)).ВыгрузитьКолонку("Номенклатура"));
	СписокОтбораТоваровПоЗаказам.ЗагрузитьЗначения(Объект.ТоварыОтбор.Выгрузить(Новый Структура("КлючСостава",
		Ложь)).ВыгрузитьКолонку("Номенклатура"));

	ЗаполнитьБазуСписковВыбора();
КонецПроцедуры

