			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>", Элементы.ЕстьЛимитОбщийКоличество.Заголовок,
					Объект.ЛимитОбщийКоличество, Элементы.ТекстРазЛОК.Заголовок, ?(
					Объект.ПериодЛимитаОбщийКоличество.Пустая(), "", Объект.КоличествоПериодовЛимитаОбщийКоличество), ?(
					Объект.ПериодЛимитаОбщийКоличество.Пустая(), "всё время акции", НРег(
					Элементы.ПериодЛимитаОбщийКоличество.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ЕстьЛимитОбщийСумма Тогда
			Если Объект.ЛимитОбщийСумма = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан лимит общей суммы.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>", Элементы.ЕстьЛимитОбщийСумма.Заголовок,
					Объект.ЛимитОбщийСумма, Элементы.ТекстРубЛОС.Заголовок, ?(Объект.ПериодЛимитаОбщийСумма.Пустая(),
					"", Объект.КоличествоПериодовЛимитаОбщийСумма), ?(Объект.ПериодЛимитаОбщийСумма.Пустая(),
					"всё время акции", НРег(Элементы.ПериодЛимитаОбщийСумма.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ЕстьЛимитПерсональныйКоличество Тогда
			Если Объект.ЛимитПерсональныйКоличество = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан персональный лимит количества.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>",
					Элементы.ЕстьЛимитПерсональныйКоличество.Заголовок, Объект.ЛимитПерсональныйКоличество,
					Элементы.ТекстРазЛПК.Заголовок, ?(Объект.ПериодЛимитаПерсональныйКоличество.Пустая(), "",
					Объект.КоличествоПериодовЛимитаПерсональныйКоличество), ?(
					Объект.ПериодЛимитаПерсональныйКоличество.Пустая(), "всё время акции", НРег(
					Элементы.ПериодЛимитаПерсональныйКоличество.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;

		Если Объект.ЕстьЛимитПерсональныйСумма Тогда
			Если Объект.ЛимитПерсональныйСумма = 0 Тогда
				ЕстьОшибки = Истина;
				ОписаниеГруппы.Добавить("Не указан персональный лимит суммы.");
			Иначе
				ОписаниеГруппы.Добавить(СтрШаблон("%1 <b>%2 %3 %4 %5</b>", Элементы.ЕстьЛимитПерсональныйСумма.Заголовок,
					Объект.ЛимитПерсональныйСумма, Элементы.ТекстРубЛПС.Заголовок, ?(
					Объект.ПериодЛимитаПерсональныйСумма.Пустая(), "", Объект.КоличествоПериодовЛимитаПерсональныйСумма),
					?(Объект.ПериодЛимитаПерсональныйСумма.Пустая(), "всё время акции", НРег(
					Элементы.ПериодЛимитаПерсональныйСумма.ТекстРедактирования))));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ЭлементыСтиляКонфигурации = Неопределено Тогда
		ЭлементыСтиляКонфигурации = СтандартныеПодсистемыКлиент.ЭлементыСтиля();
	КонецЕсли;

	кс = ОписаниеГруппы.Количество();
	Для ш = 1 По кс Цикл
		ОписаниеГруппы[ш - 1] = СтроковыеФункцииКлиентСервер.СформироватьФорматированнуюСтроку(ОписаниеГруппы[ш - 1]
			+ ?(ш = кс, "", Символы.ПС), ЭлементыСтиляКонфигурации, Неопределено, Неопределено, Неопределено,
			Неопределено, Неопределено);
	КонецЦикла;
	Возврат Новый ФорматированнаяСтрока(ОписаниеГруппы);
КонецФункции

&НаСервере
Процедура ЗаполнениеЗависимыхДанныхНаСервере()

	Элементы.ДействиеАкцииПоПродуктам.СписокВыбора.Очистить();
	Элементы.ДействиеАкцииПоЗаказам.СписокВыбора.Очистить();

	Если Не Объект.ДействиеАкцииПоПродуктам.Пустая() Тогда
		МассивТекущихДействий = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.ДействиеАкцииПоПродуктам);
	Иначе
		МассивТекущихДействий = Объект.ДействияАкцииПоЗаказам.Выгрузить().ВыгрузитьКолонку("ДействиеАкции");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(МассивТекущихДействий,
		Перечисления.ДействияВАкциях.ПустаяСсылка());
	НеприемлемыеДействия = ПолучитьИсключаемыеДействия(МассивТекущихДействий);

	Если Объект.ТипАкции = Перечисления.ТипыАкций.Баллы Тогда
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоПродуктам, Перечисления.ДействияВАкциях.НачислитьБаллы,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоПродуктам,
			Перечисления.ДействияВАкциях.РазрешитьСкидкуБаллами, НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам, Перечисления.ДействияВАкциях.НачислитьБаллы,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам,
			Перечисления.ДействияВАкциях.РазрешитьСкидкуБаллами, НеприемлемыеДействия);
	ИначеЕсли Объект.ТипАкции = Перечисления.ТипыАкций.Скидки Тогда
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоПродуктам, Перечисления.ДействияВАкциях.ВыдатьСкидку,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоПродуктам, Перечисления.ДействияВАкциях.ОкруглениеЦены,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам, Перечисления.ДействияВАкциях.ВыдатьСкидку,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам, Перечисления.ДействияВАкциях.КаскаднаяСкидка,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам, Перечисления.ДействияВАкциях.ОкруглениеЦены,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам,
			Перечисления.ДействияВАкциях.ВыдатьСкидкуЗаНабор, НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам,
			Перечисления.ДействияВАкциях.ВыдатьСкидкуНаПродуктЗаСуммуПокупокВСегменте, НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам,
			Перечисления.ДействияВАкциях.ВыдатьСкидкуНаПродуктыЗаПродукты, НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам, Перечисления.ДействияВАкциях.ВыдатьПромокод,
			НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам,
			Перечисления.ДействияВАкциях.ВыдатьПромокодЗаКаждыйПродукт, НеприемлемыеДействия);
		ДобавитьВСписокВыбораДействие(Элементы.ДействиеАкцииПоЗаказам, Перечисления.ДействияВАкциях.СкидкаНаДоставку,
			НеприемлемыеДействия);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьВСписокВыбораДействие(ЭлементВладелецСписка, ДобавляемоеДействие, НеприемлемыеДействия)
	Если НеприемлемыеДействия.Найти(ДобавляемоеДействие) = Неопределено Тогда
		ЭлементВладелецСписка.СписокВыбора.Добавить(ДобавляемоеДействие);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьИсключаемыеДействия(МассивТекущихДействий)

	Результат = Новый Массив;

	Если Не МассивТекущихДействий.Количество() = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВзаимоисключающиеДействияАкций.ИсключитьДействие КАК ИсключитьДействие
		|ИЗ
		|	РегистрСведений.ВзаимоисключающиеДействияАкций КАК ВзаимоисключающиеДействияАкций
		|ГДЕ
		|	ВзаимоисключающиеДействияАкций.ТипАкции = &ТипАкции
		|	И ВзаимоисключающиеДействияАкций.Действие В (&Действие)";

		Запрос.УстановитьПараметр("Действие", МассивТекущихДействий);
		Запрос.УстановитьПараметр("ТипАкции", Объект.ТипАкции);

		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИсключитьДействие");

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ВидимостьПериодаВыполненияНаКлиенте(Элемент)
	ВидимостьПериодаВыполнения();
КонецПроцедуры

&НаСервере
Процедура ВидимостьПериодаВыполнения()
	Элементы.ДатаНачалаВыполнения.Видимость = Не Объект.НачалоПослеЗапуска;
	Элементы.ДатаОстановки.Видимость = Не Объект.ОстановкаВручную;
	//Элементы.ЧасовойПояс.Видимость = не Объект.НачалоПослеЗапуска или не Объект.ОстановкаВручную;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НоваяПрограмма = Объект.Ссылка.Пустая();

	УправлениеФормойКонтрагенты(Неопределено);
	УправлениеФормойДоступность(Неопределено);
	УправлениеФормойМеста(Неопределено);
	УстановитьСтраницуПараметров("ПоПродуктам", НоваяПрограмма);
	УправлениеФормойПродукты(Неопределено);
	УстановитьСтраницуПараметров("ПоЗаказам", НоваяПрограмма);
	УправлениеФормойЗаказы(Неопределено);
	УправлениеФормойЛимиты(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормойКонтрагенты(Элемент)
	//контрагенты
	Элементы.СегментКлиентов.Видимость = Не (Объект.ВидОтбораПоКлиентам = ПредопределенноеЗначение(
		"Перечисление.ЕстьНетНеВажно.НеВажно") Или Объект.ВидОтбораПоКлиентам.Пустая());
	УправлениеГруппами("СверткаКонтрагенты");
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормойДоступность(Элемент)
	//промокоды доступности
	Элементы.ГруппаОграничитьПоПромокодам.Видимость = Объект.ОграничитьПоПромокодам;

	Если Объект.ОграничитьПоПромокодам Тогда
		Если Объект.РазрешитьНесколькоПромокодовВЗаказе Тогда
			Элементы.ДекорацияПромокоды1.Заголовок = "Разрешить использовать до";
			Элементы.ДекорацияПромокоды2.Заголовок = "промо" + Склонение("код", Объект.КоличествоПромокодовВЗаказе,
				"Родительный");
			Элементы.ДекорацияПромокоды2.Видимость = Истина;
			Элементы.КоличествоПромокодовВЗаказе.Видимость = Истина;
		Иначе
			Элементы.ДекорацияПромокоды1.Заголовок = "Разрешить использовать несколько промокодов";
			Элементы.ДекорацияПромокоды2.Видимость = Ложь;
			Элементы.КоличествоПромокодовВЗаказе.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;		
	//время доступности
	Элементы.ГруппаДеньНеделиВремя.Видимость = Объект.ОграничитьПоВремени;
	Подключаемая_НеОграничиватьВремяСрабатыванияПриИзменении(Неопределено);

	УправлениеГруппами("СверткаДоступность");

КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормойМеста(Элемент)
	Элементы.ГруппаКаналыОтбор.Видимость = Объект.ОграничитьПоКаналам;
	Элементы.ГруппаЗоныОтбор.Видимость = Объект.ОграничитьПоЗонам;
	УправлениеГруппами("СверткаМеста");
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормойПродукты(Элемент)
	Элементы.ГруппаПродуктыПродуктыОтбор.Видимость = Объект.ОграничитьПоПродуктам;
	Элементы.СписокОтбораТоваровПоПродуктам.Видимость = (Объект.ВариантОграниченияПоПродуктам
		= ПредопределенноеЗначение("Перечисление.ВариантыОграниченияПоПродуктам.ВСписке"));
	Элементы.СегментНоменклатурыПоПродуктам.Видимость = (Объект.ВариантОграниченияПоПродуктам
		= ПредопределенноеЗначение("Перечисление.ВариантыОграниченияПоПродуктам.ВСегменте")
		Или Объект.ВариантОграниченияПоПродуктам = ПредопределенноеЗначение(
		"Перечисление.ВариантыОграниченияПоПродуктам.НеВСегменте"));
	Элементы.ГруппаПродуктыЗаказыОтбор.Видимость = Объект.ОграничитьЗаказыПоПродуктам;
	УправлениеГруппами("СверткаПродукты");
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормойЗаказы(Элемент)
	Элементы.ГруппаЗаказыОтбор.Видимость = Объект.ОграничитьПоЗаказам;
	УправлениеГруппами("СверткаЗаказы");
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормойЛимиты(Элемент)

	Элементы.ГруппаЛимитОбщийКоличествоПараметры.Видимость = Объект.ЕстьЛимитОбщийКоличество;
	Элементы.ГруппаЛимитОбщийСуммаПараметры.Видимость = Объект.ЕстьЛимитОбщийСумма;
	Элементы.ГруппаЛимитПерсональныйКоличествоПараметры.Видимость = Объект.ЕстьЛимитПерсональныйКоличество;
	Элементы.ГруппаЛимитПерсональныйСуммаПараметры.Видимость = Объект.ЕстьЛимитПерсональныйСумма;

	Элементы.ТекстРазЛОК.Заголовок = Склонение("раз", Объект.ЛимитОбщийКоличество, "Винительный") + " за";
	Элементы.ТекстРубЛОС.Заголовок = Склонение("рубль", Объект.ЛимитОбщийСумма, "Винительный") + " за";
	Элементы.ТекстРазЛПК.Заголовок = Склонение("раз", Объект.ЛимитПерсональныйКоличество, "Винительный") + " за";
	Элементы.ТекстРубЛПС.Заголовок = Склонение("рубль", Объект.ЛимитПерсональныйСумма, "Винительный") + " за";

	Элементы.КоличествоПериодовЛимитаОбщийКоличество.Видимость = Не Объект.ПериодЛимитаОбщийКоличество.Пустая();
	Элементы.КоличествоПериодовЛимитаОбщийСумма.Видимость = Не Объект.ПериодЛимитаОбщийСумма.Пустая();
	Элементы.КоличествоПериодовЛимитаПерсональныйКоличество.Видимость = Не Объект.ПериодЛимитаПерсональныйКоличество.Пустая();
	Элементы.КоличествоПериодовЛимитаПерсональныйСумма.Видимость = Не Объект.ПериодЛимитаПерсональныйСумма.Пустая();

	ОбработатьСклонениеСпискаКлиент("ПериодЛимитаОбщийКоличество", Объект.КоличествоПериодовЛимитаОбщийКоличество);
	ОбработатьСклонениеСпискаКлиент("ПериодЛимитаОбщийСумма", Объект.КоличествоПериодовЛимитаОбщийСумма);
	ОбработатьСклонениеСпискаКлиент("ПериодЛимитаПерсональныйКоличество",
		Объект.КоличествоПериодовЛимитаПерсональныйКоличество);
	ОбработатьСклонениеСпискаКлиент("ПериодЛимитаПерсональныйСумма", Объект.КоличествоПериодовЛимитаПерсональныйСумма);

	УправлениеГруппами("СверткаЛимиты");

КонецПроцедуры

&НаКлиенте
Процедура ДействиеАкцииПоПродуктамПриИзменении(Элемент)

	ЗаполнениеЗависимыхДанныхНаСервере();

	УстановитьСтраницуПараметров("ПоПродуктам", Истина);

	УправлениеГруппами("СверткаПродукты");
КонецПроцедуры

&НаКлиенте
Процедура ДействиеАкцииПоЗаказамПриИзменении(Элемент)

	ЗаполнениеЗависимыхДанныхНаСервере();

	УстановитьСтраницуПараметров("ПоЗаказам", Истина);

	УправлениеГруппами("СверткаЗаказы");
КонецПроцедуры

&НаКлиенте
Процедура ДействияАкцииПоЗаказамПриАктивизацииСтроки(Элемент)
	УстановитьСтраницуПараметров("ПоЗаказам", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуПараметров(СуффиксСтраницы, Инициализировать)
	ТекущееДействие = Неопределено;
	Если СуффиксСтраницы = "ПоПродуктам" Тогда
		ТекущееДействие = Объект.ДействиеАкцииПоПродуктам;
	ИначеЕсли СуффиксСтраницы = "ПоЗаказам" Тогда
		ТД_ДействияПоЗаказам = Элементы.ДействияАкцииПоЗаказам.ТекущиеДанные;
		Если Не ТД_ДействияПоЗаказам = Неопределено Тогда
			ТекущееДействие = ТД_ДействияПоЗаказам.ДействиеАкции;
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущееДействие) Тогда
		Элементы["ПараметрыДействия" + СуффиксСтраницы].ТекущаяСтраница = Элементы["Пустая" + СуффиксСтраницы];
		Элементы["ПараметрыДействия" + СуффиксСтраницы].Видимость = Ложь;
	Иначе
		ИмяСтраницы = ИмяЗначенияПеречисления(ТекущееДействие) + СуффиксСтраницы;
		Элементы["ПараметрыДействия" + СуффиксСтраницы].ТекущаяСтраница = Элементы[ИмяСтраницы];
		Элементы["ПараметрыДействия" + СуффиксСтраницы].Видимость = Истина;
		Если Инициализировать Тогда
			Если ИмяСтраницы = "НачислитьБаллыПоПродуктам" Тогда
				Объект.ИзменениеКоличестваВ = ПредопределенноеЗначение("Перечисление.ВидИзмененияКоличества.Процент");
			ИначеЕсли ИмяСтраницы = "РазрешитьСкидкуБалламиПоПродуктам" Тогда
				Объект.ИзменениеКоличестваВ = ПредопределенноеЗначение("Перечисление.ВидИзмененияКоличества.Процент");
			ИначеЕсли ИмяСтраницы = "ВыдатьСкидкуПоПродуктам" Тогда
				Объект.ИзменениеКоличестваВ = ПредопределенноеЗначение("Перечисление.ВидИзмененияКоличества.Процент");
			КонецЕсли;
			Выполнить (ИмяСтраницы + "_Параметры(Неопределено)");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиПараметровДействий
&НаКлиенте
Процедура ОбработатьВидПериодаДоступности(Преффикс)
	Сразу = Объект.ВидПериодаДоступности = ПредопределенноеЗначение("Перечисление.ПередСразуПослеДатой.Сразу");
	Через = Объект.ВидПериодаДоступности = ПредопределенноеЗначение("Перечисление.ПередСразуПослеДатой.После");
	Датой = Объект.ВидПериодаДоступности = ПредопределенноеЗначение("Перечисление.ПередСразуПослеДатой.Датой");
	
	Элементы["КоличествоПериодовДоступности_"+Преффикс].Видимость = Через;
	Элементы["ПериодДоступности_"+Преффикс].Видимость = Через;
	Элементы["ДатаДоступности_"+Преффикс].Видимость = Датой;
	Элементы["ДоступноПоСтатусу_"+Преффикс].Видимость = Сразу или Через;
	Элементы["СтатусДоступности_"+Преффикс].Видимость = Объект.ДоступноПоСтатусу и (Сразу или Через);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСрокДействия(Преффикс)
	НаПериод = Объект.ВидСрокаДействия = ПредопределенноеЗначение("Перечисление.ВидыСроковНачисленияБаллов.ВТечение");
	ДоДаты = Объект.ВидСрокаДействия = ПредопределенноеЗначение("Перечисление.ВидыСроковНачисленияБаллов.ДоДаты");
	Элементы["КоличествоПериодовСрокаДействия_"+Преффикс].Видимость = НаПериод;
	Элементы["ПериодСрокаДействия_"+Преффикс].Видимость = НаПериод;
	Элементы["ДатаОкончанияСрокаДействия_"+Преффикс].Видимость = ДоДаты;
КонецПроцедуры


