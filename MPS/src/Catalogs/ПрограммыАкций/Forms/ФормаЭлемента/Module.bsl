#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СвернутьРазвернутьВсе(Команда)
	Свертка = (Команда.Имя = "СвернутьВсе");
	Для Каждого ГруппаСвертка Из ПодчиненныеЭлементы Цикл
		Если Не (ТипЗнч(ГруппаСвертка) = Тип("ГруппаФормы") И СтрНачинаетсяС(ГруппаСвертка.Имя, "ГруппаСвертка")) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ДекорацияСвертки Из ГруппаСвертка.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ДекорацияСвертки) = Тип("ДекорацияФормы") И СтрНачинаетсяС(ДекорацияСвертки.Имя, "Свертка") Тогда
				СвернутьРазвернутьЕслиОтличается(ДекорацияСвертки.Имя, Свертка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура СвернутьРазвернутьЕслиОтличается(ИмяЭлементаЗаголовкаГруппы, Свертка)
	Группа = Элементы[СтрЗаменить(ИмяЭлементаЗаголовкаГруппы, "Свертка", "Группа")];
	Элемент = Элементы[ИмяЭлементаЗаголовкаГРуппы];
	ЗаголовокБезЗнака = Сред(Элемент.Заголовок, 2);

	ИзменятьСвернутость = (Группа.Видимость = Свертка);
	Если ИзменятьСвернутость Тогда
		Группа.Видимость = Не Группа.Видимость;
		Если Группа.Видимость Тогда
			Знак = "▼";
		Иначе
			Знак = "►";
		КонецЕсли;
		Элемент.Заголовок = Знак + ЗаголовокБезЗнака;
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

