&НаКлиенте
Процедура НачислитьБаллыПоПродуктам_Параметры(Элемент)
	ОбработатьСклонениеСпискаКлиент("ИзменениеКоличестваВ_НБП", Объект.Количество, "Винительный", Истина);
	ОбработатьСклонениеСпискаКлиент("ПериодДоступности_НБП", Объект.КоличествоПериодовДоступности, "Винительный", Истина);
	ОбработатьСклонениеСпискаКлиент("ПериодСрокаДействия_НБП", Объект.КоличествоПериодовСрокаДействия, "Винительный", Истина);
	Элементы.НБП_СрокДействия.Видимость = Объект.ЕстьСрокДействия;
	Элементы.НБП_ОграничениеНаКоличество.Видимость = Объект.ЕстьОграничениеНаКоличество;
	
	ОбработатьВидПериодаДоступности("НБП");
	ОбработатьСрокДействия("НБП");
	
	УправлениеГруппами("СверткаПродукты");
КонецПроцедуры

