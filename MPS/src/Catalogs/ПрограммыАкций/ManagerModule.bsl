#Область ПрограммныйИнтерфейс

// Проверяет заполнение реквизитов действий акции справочника.
//
// Проверяются реквизиты, соответствующие видимым элементам формы ФормаЭлемента
// (с учётом действия акции и значений флагов), для которых в форме установлено
// свойство АвтоотметкаНезаполненого:
//  * строки табличной части ДействияАкцииПоЗаказам - по страницам группы
//    ПараметрыДействияПоЗаказам;
//  * реквизиты объекта по действию Объект.ДействиеАкцииПоПродуктам - по страницам
//    группы ПараметрыДействияПоПродуктам.
// Логика видимости повторяет процедуры формы УстановитьСтраницуПараметров,
// ОбработатьВидПериодаДоступности, ОбработатьСрокДействия,
// ОбработатьВариантОграниченияПоПродуктам и процедуры <ИмяСтраницы>_Параметры.
// Для ограничения "в списке" проверяется наличие строк в табличной части
// ТоварыОтбор, связанных по полю КлючСостава (КлючСоставаЦелиСкидки).
//
// Параметры:
//  Объект - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  Отказ  - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьЗаполнениеДействийАкций(Объект, Отказ) Экспорт
	
	ПроверитьДействияАкцииПоЗаказам(Объект, Отказ);
	ПроверитьДействияАкцииПоПродуктам(Объект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДействияПоЗаказам

// Проверяет заполнение реквизитов всех строк табличной части ДействияАкцииПоЗаказам.
//
// Параметры:
//  Объект - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  Отказ  - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействияАкцииПоЗаказам(Объект, Отказ) Экспорт
	
	Для Каждого СтрокаДействия Из Объект.ДействияАкцииПоЗаказам Цикл
		ПроверитьСтрокуДействияАкции(Объект, СтрокаДействия, Отказ);
	КонецЦикла;
	
КонецПроцедуры

// Проверяет заполнение реквизитов одной строки табличной части ДействияАкцииПоЗаказам
// в зависимости от действия акции, выбранного в строке.
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьСтрокуДействияАкции(Объект, СтрокаДействия, Отказ)
	
	Если Не ЗначениеЗаполнено(СтрокаДействия.ДействиеАкции) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.НачислитьБаллы Тогда
		ПроверитьДействиеНачислитьБаллы(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.РазрешитьСкидкуБаллами Тогда
		ПроверитьДействиеРазрешитьСкидкуБаллами(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.ВыдатьСкидку Тогда
		ПроверитьДействиеВыдатьСкидку(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.КаскаднаяСкидка Тогда
		ПроверитьДействиеКаскаднаяСкидка(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.ОкруглениеЦены Тогда
		ПроверитьДействиеОкруглениеЦены(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.ВыдатьСкидкуЗаНабор Тогда
		ПроверитьДействиеВыдатьСкидкуЗаНабор(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции =
			Перечисления.ДействияВАкциях.ВыдатьСкидкуНаПродуктЗаСуммуПокупокВСегменте Тогда
		ПроверитьДействиеСкидкаЗаСуммуПокупокВСегменте(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.ВыдатьСкидкуНаПродуктыЗаПродукты Тогда
		ПроверитьДействиеВыдатьСкидкуНаПродуктыЗаПродукты(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.ВыдатьПромокод Тогда
		ПроверитьДействиеВыдатьПромокод(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.ВыдатьПромокодЗаКаждыйПродукт Тогда
		ПроверитьДействиеВыдатьПромокодЗаКаждыйПродукт(Объект, СтрокаДействия, Отказ);
		
	ИначеЕсли СтрокаДействия.ДействиеАкции = Перечисления.ДействияВАкциях.СкидкаНаДоставку Тогда
		ПроверитьДействиеСкидкаНаДоставку(Объект, СтрокаДействия, Отказ);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Начислить баллы"
// (страница формы НачислитьБаллыПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеНачислитьБаллы(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "ВидПериодаДоступности",
		СтрокаДействия.ВидПериодаДоступности, Отказ);
	Если ПериодДоступностиЧерез(СтрокаДействия) Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "КоличествоПериодовДоступности",
			СтрокаДействия.КоличествоПериодовДоступности, Отказ);
		ПроверитьРеквизит(Объект, СтрокаДействия, "ПериодДоступности",
			СтрокаДействия.ПериодДоступности, Отказ);
	КонецЕсли;
	Если ПериодДоступностиДатой(СтрокаДействия) Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "ДатаДоступности",
			СтрокаДействия.ДатаДоступности, Отказ);
	КонецЕсли;
	Если СтрокаДействия.ДоступноПоСтатусу И ПериодДоступностиСразуИлиЧерез(СтрокаДействия) Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "СтатусДоступности",
			СтрокаДействия.СтатусДоступности, Отказ);
	КонецЕсли;
	
	Если СтрокаДействия.ЕстьСрокДействия Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "ВидСрокаДействия",
			СтрокаДействия.ВидСрокаДействия, Отказ);
		Если СрокДействияНаПериод(СтрокаДействия) Тогда
			ПроверитьРеквизит(Объект, СтрокаДействия, "КоличествоПериодовСрокаДействия",
				СтрокаДействия.КоличествоПериодовСрокаДействия, Отказ);
			ПроверитьРеквизит(Объект, СтрокаДействия, "ПериодСрокаДействия",
				СтрокаДействия.ПериодСрокаДействия, Отказ);
		КонецЕсли;
		Если СрокДействияДоДаты(СтрокаДействия) Тогда
			ПроверитьРеквизит(Объект, СтрокаДействия, "ДатаОкончанияСрокаДействия",
				СтрокаДействия.ДатаОкончанияСрокаДействия, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаДействия.ЕстьОграничениеНаКоличество Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "КоличествоОграничения",
			СтрокаДействия.КоличествоОграничения, Отказ);
	КонецЕсли;
	
	Если СтрокаДействия.ЕстьДиапазон Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "ДиапазонС",
			СтрокаДействия.ДиапазонС, Отказ);
		ПроверитьРеквизит(Объект, СтрокаДействия, "ДиапазонПо",
			СтрокаДействия.ДиапазонПо, Отказ);
		Если не Отказ Тогда
			Если СтрокаДействия.ДиапазонС>СтрокаДействия.ДиапазонПо Тогда
				ТекстСообщения = НСтр("ru = 'Неверно задан диапазон цен. Нижняя граница больше верхней.'");
				ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ);
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Разрешить скидку баллами"
// (страница формы РазрешитьСкидкуБалламиПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеРазрешитьСкидкуБаллами(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "БалльныйСчет",
		СтрокаДействия.БалльныйСчет, Отказ);
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
	Если СтрокаДействия.ЕстьМинимальнаяСтоимость Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "МинимальнаяСтоимость",
			СтрокаДействия.МинимальнаяСтоимость, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Выдать скидку"
// (страница формы ВыдатьСкидкуПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеВыдатьСкидку(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
	Если СтрокаДействия.ЕстьОграничениеНаКоличество Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "КоличествоОграничения",
			СтрокаДействия.КоличествоОграничения, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Каскадная скидка"
// (страница формы КаскаднаяСкидкаПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеКаскаднаяСкидка(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "ЗаКаждый",
		СтрокаДействия.ЗаКаждый, Отказ);
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "НачинаяС",
		СтрокаДействия.НачинаяС, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ОканчиваяС",
		СтрокаДействия.ОканчиваяС, Отказ);
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Округление цены"
// (страница формы ОкруглениеЦеныПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеОкруглениеЦены(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "ДискретностьОкругленияВЗаказе",
		СтрокаДействия.ДискретностьОкругленияВЗаказе, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ВариантОкругления",
		СтрокаДействия.ВариантОкругления, Отказ);
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Выдать скидку за набор"
// (страница формы ВыдатьСкидкуЗаНаборПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеВыдатьСкидкуЗаНабор(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	
	ПроверитьСоставНабора(Объект, СтрокаДействия, Отказ);
	
КонецПроцедуры

// Проверяет заполнение табличной части СоставНабора: состав должен содержать
// хотя бы одну строку, в каждой строке должно быть указано количество и заполнен
// сегмент либо список отбора товаров (в зависимости от признака СоставВСписке).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные данные.
//
Процедура ПроверитьСоставНабора(Объект, СтрокаДействия, Отказ)
	
	Если Объект.СоставНабора.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не заполнен состав набора в строке %1 (действие акции ""%2"").'"),
			СтрокаДействия.НомерСтроки, СтрокаДействия.ДействиеАкции);
		ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ);
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаСостава Из Объект.СоставНабора Цикл
		ПроверитьСтрокуСоставаНабора(Объект, СтрокаДействия, СтрокаСостава, Отказ);
	КонецЦикла;
	
КонецПроцедуры

// Проверяет заполнение одной строки табличной части СоставНабора.
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  СтрокаСостава  - СтрокаТабличнойЧасти - строка табличной части СоставНабора.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные данные.
//
Процедура ПроверитьСтрокуСоставаНабора(Объект, СтрокаДействия, СтрокаСостава, Отказ)
	
	Если СтрокаСостава.Количество = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не заполнено количество в строке %1 состава набора (действие акции ""%2"").'"),
			СтрокаСостава.НомерСтроки, СтрокаДействия.ДействиеАкции);
		ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ);
	КонецЕсли;
	
	Если СтрокаСостава.СоставВСписке Тогда
		Если Не СписокОтбораЗаполнен(Объект, СтрокаСостава.КлючСостава) Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Не заполнен список отбора в строке %1 состава набора (действие акции ""%2"").'"),
				СтрокаСостава.НомерСтроки, СтрокаДействия.ДействиеАкции);
			ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ);
		КонецЕсли;
	Иначе
		Если Не ЗначениеЗаполнено(СтрокаСостава.Сегмент) Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Не заполнен сегмент в строке %1 состава набора (действие акции ""%2"").'"),
				СтрокаСостава.НомерСтроки, СтрокаДействия.ДействиеАкции);
			ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Выдать скидку на продукт за сумму покупок
// в сегменте" (страница формы ВыдатьСкидкуНаПродуктЗаСуммуПокупокВСегментеПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеСкидкаЗаСуммуПокупокВСегменте(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "ЗаКаждый",
		СтрокаДействия.ЗаКаждый, Отказ);
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктамЦелиСкидки", "СегментНоменклатурыЦелиСкидки",
		СтрокаДействия.КлючСоставаЦелиСкидки, Отказ);
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Выдать скидку на продукты за продукты"
// (страница формы ВыдатьСкидкуНаПродуктыЗаПродуктыПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеВыдатьСкидкуНаПродуктыЗаПродукты(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "ЗаКаждый",
		СтрокаДействия.ЗаКаждый, Отказ);
	Если СтрокаДействия.ЗаКаждый > 1 Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "Уникальность",
			СтрокаДействия.Уникальность, Отказ);
	КонецЕсли;
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ВидСпискаЦелиСкидки",
		СтрокаДействия.ВидСпискаЦелиСкидки, Отказ);
	
	Если СписокЦелиСкидкиНеВесьНабор(СтрокаДействия) Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, "НачинаяС",
			СтрокаДействия.НачинаяС, Отказ);
		Если СтрокаДействия.ВидСпискаЦелиСкидки = Перечисления.ВидыСпискаЦелиСкидки.Следующие Тогда
			ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
				"ВариантОграниченияПоПродуктамЦелиСкидки", "СегментНоменклатурыЦелиСкидки",
				СтрокаДействия.КлючСоставаЦелиСкидки, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Выдать промокод"
// (страница формы ВыдатьПромокодПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеВыдатьПромокод(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "НаборПромокодов",
		СтрокаДействия.НаборПромокодов, Отказ);
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Выдать промокод за каждый продукт"
// (страница формы ВыдатьПромокодЗаКаждыйПродуктПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеВыдатьПромокодЗаКаждыйПродукт(Объект, СтрокаДействия, Отказ)
	
	ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия,
		"ВариантОграниченияПоПродуктам", "СегментНоменклатуры",
		СтрокаДействия.КлючСостава, Отказ);
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "НаборПромокодов",
		СтрокаДействия.НаборПромокодов, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	
КонецПроцедуры

// Проверяет заполнение реквизитов действия "Скидка на доставку"
// (страница формы СкидкаНаДоставкуПоЗаказам).
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  Отказ          - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействиеСкидкаНаДоставку(Объект, СтрокаДействия, Отказ)
	
	ПроверитьРеквизит(Объект, СтрокаДействия, "Количество",
		СтрокаДействия.Количество, Отказ);
	ПроверитьРеквизит(Объект, СтрокаДействия, "ИзменениеКоличестваВ",
		СтрокаДействия.ИзменениеКоличестваВ, Отказ);
	
КонецПроцедуры

// Проверяет заполнение ограничения по продуктам: видимый реквизит сегмента номенклатуры
// и (или) наличие состава списка отбора товаров.
//
// Параметры:
//  Объект               - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия       - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  ИмяРеквизитаВарианта - Строка - имя реквизита варианта ограничения по продуктам.
//  ИмяРеквизитаСегмента - Строка - имя реквизита сегмента номенклатуры.
//  КлючСостава          - Строка - ключ связи со строками табличной части ТоварыОтбор.
//  Отказ                - Булево - устанавливается в Истина, если найдены незаполненные данные.
//
Процедура ПроверитьОграничениеПоПродуктам(Объект, СтрокаДействия, ИмяРеквизитаВарианта,
	ИмяРеквизитаСегмента, КлючСостава, Отказ)
	
	ВариантОграничения = СтрокаДействия[ИмяРеквизитаВарианта];
	
	Если ОграничениеЗадаетсяСегментом(ВариантОграничения) Тогда
		ПроверитьРеквизит(Объект, СтрокаДействия, ИмяРеквизитаСегмента,
			СтрокаДействия[ИмяРеквизитаСегмента], Отказ);
	КонецЕсли;
	
	Если ОграничениеЗадаетсяСписком(ВариантОграничения) Тогда
		ПроверитьСписокОтбора(Объект, СтрокаДействия, КлючСостава, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение одного реквизита строки табличной части.
//
// Параметры:
//  Объект            - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия    - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  ИмяРеквизита      - Строка - имя проверяемого реквизита.
//  ЗначениеРеквизита - Произвольный - значение проверяемого реквизита.
//  Отказ             - Булево - устанавливается в Истина, если реквизит не заполнен.
//
Процедура ПроверитьРеквизит(Объект, СтрокаДействия, ИмяРеквизита, ЗначениеРеквизита, Отказ)
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеРеквизита = "";
	РеквизитМД = Метаданные.Справочники.ПрограммыАкций.ТабличныеЧасти.ДействияАкцииПоЗаказам.Реквизиты.Найти(ИмяРеквизита);
	Если не РеквизитМД = Неопределено Тогда
		ПредставлениеРеквизита = РеквизитМД.Синоним;
	КонецЕсли;	
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Не заполнено значение ""%1"" в строке %2 (действие акции ""%3"").'"),
		?(ПустаяСтрока(ПредставлениеРеквизита),ИмяРеквизита,ПредставлениеРеквизита), СтрокаДействия.НомерСтроки, СтрокаДействия.ДействиеАкции);
	ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ);
	
КонецПроцедуры

// Проверяет, что для ограничения "в списке" в табличной части ТоварыОтбор есть строки,
// связанные с проверяемой строкой по полю КлючСостава.
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//  КлючСостава    - Строка - ключ связи со строками табличной части ТоварыОтбор.
//  Отказ          - Булево - устанавливается в Истина, если список отбора пуст.
//
Процедура ПроверитьСписокОтбора(Объект, СтрокаДействия, КлючСостава, Отказ)
	
	Если СписокОтбораЗаполнен(Объект, КлючСостава) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Не заполнен список отбора товаров в строке %1 (действие акции ""%2"").'"),
		СтрокаДействия.НомерСтроки, СтрокаДействия.ДействиеАкции);
	ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ);
	
КонецПроцедуры

// Определяет, что в табличной части ТоварыОтбор есть строки, связанные с составом
// по указанному ключу.
//
// Параметры:
//  Объект      - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  КлючСостава - Строка - ключ связи со строками табличной части ТоварыОтбор.
//
// Возвращаемое значение:
//  Булево - Истина, если по ключу найдены строки в табличной части ТоварыОтбор.
//
Функция СписокОтбораЗаполнен(Объект, КлючСостава) Экспорт	
	Если ПустаяСтрока(КлючСостава) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Отбор = Новый Структура("КлючСостава", КлючСостава);
	
	Возврат Объект.ТоварыОтбор.НайтиСтроки(Отбор).Количество() > 0;
	
КонецФункции

#КонецОбласти

#Область ДействияПоПродуктам

// Проверяет заполнение реквизитов объекта по действию Объект.ДействиеАкцииПоПродуктам.
//
// Параметры:
//  Объект - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  Отказ  - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьДействияАкцииПоПродуктам(Объект, Отказ) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.ДействиеАкцииПоПродуктам) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДействиеАкцииПоПродуктам = Перечисления.ДействияВАкциях.НачислитьБаллы Тогда
		ПроверитьПродуктыНачислитьБаллы(Объект, Отказ);
		
	ИначеЕсли Объект.ДействиеАкцииПоПродуктам = Перечисления.ДействияВАкциях.РазрешитьСкидкуБаллами Тогда
		ПроверитьПродуктыРазрешитьСкидкуБаллами(Объект, Отказ);
		
	ИначеЕсли Объект.ДействиеАкцииПоПродуктам = Перечисления.ДействияВАкциях.ВыдатьСкидку Тогда
		ПроверитьПродуктыВыдатьСкидку(Объект, Отказ);
		
	ИначеЕсли Объект.ДействиеАкцииПоПродуктам = Перечисления.ДействияВАкциях.ОкруглениеЦены Тогда
		ПроверитьПродуктыОкруглениеЦены(Объект, Отказ);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов объекта для действия "Начислить баллы"
// (страница формы НачислитьБаллыПоПродуктам).
//
// Параметры:
//  Объект - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  Отказ  - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьПродуктыНачислитьБаллы(Объект, Отказ)
	
	ПроверитьРеквизитОбъекта(Объект, "Количество", Объект.Количество, Отказ);
	ПроверитьРеквизитОбъекта(Объект, "ИзменениеКоличестваВ",
		Объект.ИзменениеКоличестваВ, Отказ);
	ПроверитьРеквизитОбъекта(Объект, "БалльныйСчет", Объект.БалльныйСчет, Отказ);
	
	ПроверитьРеквизитОбъекта(Объект, "ВидПериодаДоступности",
		Объект.ВидПериодаДоступности, Отказ);
	Если ПериодДоступностиЧерез(Объект) Тогда
		ПроверитьРеквизитОбъекта(Объект, "КоличествоПериодовДоступности",
			Объект.КоличествоПериодовДоступности, Отказ);
		ПроверитьРеквизитОбъекта(Объект, "ПериодДоступности",
			Объект.ПериодДоступности, Отказ);
	КонецЕсли;
	Если ПериодДоступностиДатой(Объект) Тогда
		ПроверитьРеквизитОбъекта(Объект, "ДатаДоступности", Объект.ДатаДоступности, Отказ);
	КонецЕсли;
	Если Объект.ДоступноПоСтатусу И ПериодДоступностиСразуИлиЧерез(Объект) Тогда
		ПроверитьРеквизитОбъекта(Объект, "СтатусДоступности",
			Объект.СтатусДоступности, Отказ);
	КонецЕсли;
	
	Если Объект.ЕстьСрокДействия Тогда
		ПроверитьРеквизитОбъекта(Объект, "ВидСрокаДействия", Объект.ВидСрокаДействия, Отказ);
		Если СрокДействияНаПериод(Объект) Тогда
			ПроверитьРеквизитОбъекта(Объект, "КоличествоПериодовСрокаДействия",
				Объект.КоличествоПериодовСрокаДействия, Отказ);
			ПроверитьРеквизитОбъекта(Объект, "ПериодСрокаДействия",
				Объект.ПериодСрокаДействия, Отказ);
		КонецЕсли;
		Если СрокДействияДоДаты(Объект) Тогда
			ПроверитьРеквизитОбъекта(Объект, "ДатаОкончанияСрокаДействия",
				Объект.ДатаОкончанияСрокаДействия, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ЕстьОграничениеНаКоличество Тогда
		ПроверитьРеквизитОбъекта(Объект, "КоличествоОграничения",
			Объект.КоличествоОграничения, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов объекта для действия "Разрешить скидку баллами"
// (страница формы РазрешитьСкидкуБалламиПоПродуктам).
//
// Параметры:
//  Объект - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  Отказ  - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьПродуктыРазрешитьСкидкуБаллами(Объект, Отказ)
	
	ПроверитьРеквизитОбъекта(Объект, "Количество", Объект.Количество, Отказ);
	ПроверитьРеквизитОбъекта(Объект, "ИзменениеКоличестваВ",
		Объект.ИзменениеКоличестваВ, Отказ);
	ПроверитьРеквизитОбъекта(Объект, "БалльныйСчет", Объект.БалльныйСчет, Отказ);
	
	Если Объект.ЕстьМинимальнаяСтоимость Тогда
		ПроверитьРеквизитОбъекта(Объект, "МинимальнаяСтоимость",
			Объект.МинимальнаяСтоимость, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов объекта для действия "Выдать скидку"
// (страница формы ВыдатьСкидкуПоПродуктам).
//
// Параметры:
//  Объект - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  Отказ  - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьПродуктыВыдатьСкидку(Объект, Отказ)
	
	ПроверитьРеквизитОбъекта(Объект, "Количество", Объект.Количество, Отказ);
	ПроверитьРеквизитОбъекта(Объект, "ИзменениеКоличестваВ",
		Объект.ИзменениеКоличестваВ, Отказ);
	
	Если Объект.ЕстьОграничениеНаКоличество Тогда
		ПроверитьРеквизитОбъекта(Объект, "КоличествоОграничения",
			Объект.КоличествоОграничения, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение реквизитов объекта для действия "Округление цены"
// (страница формы ОкруглениеЦеныПоПродуктам).
//
// Параметры:
//  Объект - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  Отказ  - Булево - устанавливается в Истина, если найдены незаполненные реквизиты.
//
Процедура ПроверитьПродуктыОкруглениеЦены(Объект, Отказ)
	
	ПроверитьРеквизитОбъекта(Объект, "ВариантОкругления", Объект.ВариантОкругления, Отказ);
	
КонецПроцедуры

// Проверяет заполнение одного реквизита объекта.
//
// Параметры:
//  Объект            - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  ИмяРеквизита      - Строка - имя проверяемого реквизита.
//  ЗначениеРеквизита - Произвольный - значение проверяемого реквизита.
//  Отказ             - Булево - устанавливается в Истина, если реквизит не заполнен.
//
Процедура ПроверитьРеквизитОбъекта(Объект, ИмяРеквизита, ЗначениеРеквизита, Отказ)
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат;
	КонецЕсли;

	ПредставлениеРеквизита = "";
	РеквизитМД = Метаданные.Справочники.ПрограммыАкций.Реквизиты.Найти(ИмяРеквизита);
	Если не РеквизитМД = Неопределено Тогда
		ПредставлениеРеквизита = РеквизитМД.Синоним;
	КонецЕсли;	
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Не заполнено значение ""%1"" (действие акции по продуктам ""%2"").'"),
		?(ПустаяСтрока(ПредставлениеРеквизита),ИмяРеквизита,ПредставлениеРеквизита), Объект.ДействиеАкцииПоПродуктам);
	ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, Неопределено, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбщиеПроцедурыИФункции

// Выводит пользователю сообщение о незаполненном реквизите и устанавливает отказ.
//
// Параметры:
//  Объект          - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  ТекстСообщения  - Строка - текст выводимого сообщения.
//  СтрокаДействия  - СтрокаТабличнойЧасти, Неопределено - строка табличной части
//                    ДействияАкцииПоЗаказам, к которой относится сообщение.
//                    Неопределено - сообщение относится к реквизитам объекта
//                    (действие акции по продуктам).
//  Отказ           - Булево - устанавливается в Истина.
//
Процедура ВывестиСообщениеОНезаполнении(Объект, ТекстСообщения, СтрокаДействия, Отказ)
	
	Отказ = Истина;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Поле = ПолеСообщения(Объект, СтрокаДействия);
	Сообщение.Сообщить();
	
КонецПроцедуры

// Определяет путь к данным, с которым связывается сообщение пользователю:
// поле ввода действия акции по продуктам либо поле действия акции в конкретной
// строке табличной части ДействияАкцииПоЗаказам.
//
// Параметры:
//  Объект         - СправочникОбъект.ПрограммыАкций - проверяемый объект.
//  СтрокаДействия - СтрокаТабличнойЧасти, Неопределено - строка табличной части
//                   ДействияАкцииПоЗаказам, к которой относится сообщение.
//                   Неопределено - сообщение относится к реквизитам объекта.
//
// Возвращаемое значение:
//  Строка - путь к данным для свойства СообщениеПользователю.Поле.
//
Функция ПолеСообщения(Объект, СтрокаДействия)
	
	Если СтрокаДействия = Неопределено Тогда
		Возврат "Объект.ДействиеАкцииПоПродуктам";
	КонецЕсли;
	
	ИндексСтроки = Объект.ДействияАкцииПоЗаказам.Индекс(СтрокаДействия);
	Если ИндексСтроки < 0 Тогда
		Возврат "Объект.ДействияАкцииПоЗаказам.ДействиеАкции";
	КонецЕсли;
	
	Возврат СтрШаблон("Объект.ДействияАкцииПоЗаказам[%1].ДействиеАкции", ИндексСтроки);
	
КонецФункции

// Определяет, что ограничение по продуктам задаётся сегментом номенклатуры
// (в этом случае на форме виден реквизит сегмента номенклатуры).
//
// Параметры:
//  ВариантОграничения - ПеречислениеСсылка.ВариантыОграниченияПоПродуктам - вариант ограничения.
//
// Возвращаемое значение:
//  Булево - Истина, если ограничение задаётся сегментом (в сегменте или не в сегменте).
//
Функция ОграничениеЗадаетсяСегментом(ВариантОграничения)
	
	Возврат ВариантОграничения = Перечисления.ВариантыОграниченияПоПродуктам.ВСегменте
		Или ВариантОграничения = Перечисления.ВариантыОграниченияПоПродуктам.НеВСегменте;
	
КонецФункции

// Определяет, что ограничение по продуктам задаётся списком отбора товаров
// (в этом случае список должен быть заполнен).
//
// Параметры:
//  ВариантОграничения - ПеречислениеСсылка.ВариантыОграниченияПоПродуктам - вариант ограничения.
//
// Возвращаемое значение:
//  Булево - Истина, если ограничение задаётся списком.
//
Функция ОграничениеЗадаетсяСписком(ВариантОграничения)
	
	Возврат ВариантОграничения = Перечисления.ВариантыОграниченияПоПродуктам.ВСписке;
	
КонецФункции

// Определяет, что период доступности задан "через"
// (виден реквизит КоличествоПериодовДоступности).
//
// Параметры:
//  Источник - СтрокаТабличнойЧасти, СправочникОбъект.ПрограммыАкций - источник значений реквизитов.
//
// Возвращаемое значение:
//  Булево - Истина, если вид периода доступности равен "через".
//
Функция ПериодДоступностиЧерез(Источник)
	
	Возврат Источник.ВидПериодаДоступности = Перечисления.ПередСразуПослеДатой.После;
	
КонецФункции

// Определяет, что период доступности задан конкретной датой
// (виден реквизит ДатаДоступности).
//
// Параметры:
//  Источник - СтрокаТабличнойЧасти, СправочникОбъект.ПрограммыАкций - источник значений реквизитов.
//
// Возвращаемое значение:
//  Булево - Истина, если вид периода доступности равен "датой".
//
Функция ПериодДоступностиДатой(Источник)
	
	Возврат Источник.ВидПериодаДоступности = Перечисления.ПередСразуПослеДатой.Датой;
	
КонецФункции

// Определяет, что период доступности задан "сразу" или "через"
// (в этом случае виден реквизит ДоступноПоСтатусу).
//
// Параметры:
//  Источник - СтрокаТабличнойЧасти, СправочникОбъект.ПрограммыАкций - источник значений реквизитов.
//
// Возвращаемое значение:
//  Булево - Истина, если вид периода доступности равен "сразу" или "через".
//
Функция ПериодДоступностиСразуИлиЧерез(Источник)
	
	Возврат Источник.ВидПериодаДоступности = Перечисления.ПередСразуПослеДатой.Сразу
		Или Источник.ВидПериодаДоступности = Перечисления.ПередСразуПослеДатой.После;
	
КонецФункции

// Определяет, что срок действия баллов задан на период
// (виден реквизит КоличествоПериодовСрокаДействия).
//
// Параметры:
//  Источник - СтрокаТабличнойЧасти, СправочникОбъект.ПрограммыАкций - источник значений реквизитов.
//
// Возвращаемое значение:
//  Булево - Истина, если вид срока действия равен "в течение".
//
Функция СрокДействияНаПериод(Источник)
	
	Возврат Источник.ВидСрокаДействия = Перечисления.ВидыОграниченияПериодовДействий.ВТечение;
	
КонецФункции

// Определяет, что срок действия баллов задан до даты
// (виден реквизит ДатаОкончанияСрокаДействия).
//
// Параметры:
//  Источник - СтрокаТабличнойЧасти, СправочникОбъект.ПрограммыАкций - источник значений реквизитов.
//
// Возвращаемое значение:
//  Булево - Истина, если вид срока действия равен "до даты".
//
Функция СрокДействияДоДаты(Источник)
	
	Возврат Источник.ВидСрокаДействия = Перечисления.ВидыОграниченияПериодовДействий.ДоДаты;
	
КонецФункции

// Определяет, что список цели скидки задан и не является "весь набор"
// (в этом случае на форме видны поля цели скидки).
//
// Параметры:
//  СтрокаДействия - СтрокаТабличнойЧасти - строка табличной части ДействияАкцииПоЗаказам.
//
// Возвращаемое значение:
//  Булево - Истина, если список цели скидки заполнен и не равен "весь набор".
//
Функция СписокЦелиСкидкиНеВесьНабор(СтрокаДействия)
	
	Возврат ЗначениеЗаполнено(СтрокаДействия.ВидСпискаЦелиСкидки)
		И СтрокаДействия.ВидСпискаЦелиСкидки <> Перечисления.ВидыСпискаЦелиСкидки.ВесьНабор;
	
КонецФункции

#КонецОбласти

#КонецОбласти
