&НаКлиенте
Процедура Изменение_ИзменилсяПродуктВСпискеПриИзменении(Элемент)
	ЗаголовокЦен = "Цена продукта";
	ЗаголовокКоличестваИзменения = " ";
	Если Изменение_ИзменилсяПродуктВСписке  = ПредопределенноеЗначение("Перечисление.ИзмененияСостоянияПродукта.ЦенаНаПродуктСнизилась") Тогда
		ЗаголовокЦен = "Цена до снижения";
		ЗаголовокКоличестваИзменения = "Снижение минимум на";
	ИначеЕсли Изменение_ИзменилсяПродуктВСписке  = ПредопределенноеЗначение("Перечисление.ИзмененияСостоянияПродукта.ЦенаНаПродуктВыросла")  Тогда
		ЗаголовокЦен = "Цена до повышения";
		ЗаголовокКоличестваИзменения = "Повышение минимум на";
	КонецЕсли;	
	Элементы.ЦенаВДиапазоне_ИзменилсяПродуктВСписке.Заголовок = ЗаголовокЦен;
	Элементы.ЦенаИзмениласьНаИБолее_ИзменилсяПродуктВСписке.Заголовок = ЗаголовокКоличестваИзменения;
	Элементы.ГруппаИзменениеЦеныИзменилсяПродуктВСписке.Видимость = не ПустаяСтрока(ЗаголовокКоличестваИзменения);
КонецПроцедуры

&НаКлиенте
Процедура ЦенаВДиапазоне_ИзменилсяПродуктВСпискеПриИзменении(Элемент)
	Элементы.ГруппаДиапазонЦенИзменилсяПродуктВСписке.Видимость = ЦенаВДиапазоне_ИзменилсяПродуктВСписке;
КонецПроцедуры


&НаКлиенте
Процедура Изменение_ИзменилсяПросмотренныйПродуктПриИзменении(Элемент)
	ЗаголовокКоличестваИзменения = " ";
	Если Изменение_ИзменилсяПросмотренныйПродукт  = ПредопределенноеЗначение("Перечисление.ИзмененияСостоянияПродукта.ЦенаНаПродуктСнизилась") Тогда
		ЗаголовокКоличестваИзменения = "Снижение минимум на";
	ИначеЕсли Изменение_ИзменилсяПросмотренныйПродукт  = ПредопределенноеЗначение("Перечисление.ИзмененияСостоянияПродукта.ЦенаНаПродуктВыросла")  Тогда
		ЗаголовокКоличестваИзменения = "Повышение минимум на";
	КонецЕсли;	
	Элементы.ЦенаИзмениласьНаИБолее_ИзменилсяПросмотренныйПродукт.Заголовок = ЗаголовокКоличестваИзменения;
	Элементы.ГруппаИзменениеЦеныИзменилсяПросмотренныйПродукт.Видимость = не ПустаяСтрока(ЗаголовокКоличестваИзменения);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура НастроитьРасписание(Команда)
	
	ДиалогРасписания = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	ДиалогРасписания.Показать(Новый ОписаниеОповещения("НастроитьРасписаниеЗавершение", ЭтотОбъект, Новый Структура("ДиалогРасписания", ДиалогРасписания)));
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеЗавершение(Расписание1, ДополнительныеПараметры) Экспорт
	
	ДиалогРасписания = ДополнительныеПараметры.ДиалогРасписания;
	
	Если Расписание1 <> Неопределено Тогда
		
		Модифицированность = Истина;
		Расписание         = ДиалогРасписания.Расписание;
		РасписаниеСтрокой  = Строка(Расписание);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОтборПриИзменении(Элемент)
	Если КомпоновщикКлиентов.Настройки.Отбор.Элементы.Количество() = 0 Тогда
		ОписаниеФильтраКлиентов = "Отбор клиентов не установлен";
	Иначе
		ОписаниеФильтраКлиентов = "Отбор клиентов установлен";
	КонецЕсли;

	Элементы.ОписаниеФильтраКлиентов.Заголовок = ОписаниеФильтраКлиентов;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаКлиенте
Процедура УправлениеФормойНаКлиенте()
	
	//смена вида запуска 
	Если Объект.ЗапускПоРасписанию Тогда
		Элементы.СтраницыРасписания.ТекущаяСтраница = Элементы.СтраницаПоРасписанию;
	Иначе	
		Элементы.СтраницыРасписания.ТекущаяСтраница = Элементы.СтраницаПоСобытию;
	КонецЕсли;
	
	//смена события
	Если Объект.ДействиеЗапуска.Пустая() Тогда
		Элементы.СтраницыВариантовСобытий.ТекущаяСтраница = Элементы["_Страница"];
	Иначе
		Элементы.СтраницыВариантовСобытий.ТекущаяСтраница = Элементы[ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(
			Объект.ДействиеЗапуска, "ИмяПредопределенныхДанных") + "_Страница"];
	КонецЕсли;
	
	ЗапускРазВПериод = (Объект.ВидЧастотыЗапускаСценарияНаКлиенте = ПредопределенноеЗначение("Перечисление.ЧастотаЗапускаСценарияНаКлиенте.ОдинРазЗаПериод"));
	ОдинРаз = (Объект.ВидЧастотыЗапускаСценарияНаКлиенте = ПредопределенноеЗначение("Перечисление.ЧастотаЗапускаСценарияНаКлиенте.ОдинРаз"));
	
	Элементы.ГруппаПериодЗапуска.Видимость = ЗапускРазВПериод;
	Элементы.ГруппаЛимитСрабатыванияНаКлиенте.Видимость = не ОдинРаз;
	
	Элементы.ЛимитСрабатыванияНаКлиенте.Видимость = Объект.ЕстьЛимитСрабатыванияНаКлиенте;

	Элементы.ЛимитСрабатыванияНаКлиенте.Заголовок = Склонение("раз",Объект.ЛимитСрабатыванияНаКлиенте,"Винительный");
	Элементы.ЧастотаЗапуска.Заголовок = Склонение("раз",Объект.ЧастотаЗапуска,"Винительный");
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция Склонение(ЗначениеИсходное, ЧисловоеЗначение, Падеж)
		СтрокаСклонения = ПолучитьСклоненияСтрокиПоЧислу(ЗначениеИсходное, ЧисловоеЗначение,,, "ПД="+Падеж)[0];
		мс = СтрРазделить(СтрокаСклонения," ");
		Возврат мс[1];
КонецФункции

#КонецОбласти
