Функция СгенерироватьПромокодыНаСервере(Знач НастройкаГенерации) Экспорт
	
	СтрокаРеквизитов = СтрокаРеквизитовНастройки();
	Если ТипЗнч(НастройкаГенерации) = Тип("СправочникСсылка.НастройкиГенерацииПромокодов") Тогда
		//@skip-check undefined-variable
		РеквизитыНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаГенерации, СтрокаРеквизитов);
	Иначе
		РеквизитыНастройки = Новый Структура(СтрокаРеквизитов);
		ЗаполнитьЗначенияСвойств(РеквизитыНастройки, НастройкаГенерации);	
	КонецЕсли;	
	
	ПараметрыФормирования = РассчитатьПараметрыФормирования(РеквизитыНастройки);
	Промокоды = Новый Массив;
	
	
	Если Не ПараметрыФормирования.Корректно Тогда
		Возврат ОписаниеРезультатаГенерации(
			СтрСоединить(ПараметрыФормирования.Ошибки, Символы.ПС), 0, Промокоды, Истина);
	КонецЕсли;
	
	МощностьАлфавита = ПараметрыФормирования.МощностьАлфавита;
	СвободныхПозиций = ПараметрыФормирования.СвободныхПозиций;
	ТребуетсяПромокодов = РеквизитыНастройки.МаксимальноеКоличество;
	
	Если СвободныхПозиций * Log10(МощностьАлфавита) < Log10(ТребуетсяПромокодов) Тогда
		Возврат ОписаниеРезультатаГенерации(
			"Невозможно сгенерировать " + Формат(ТребуетсяПромокодов, "ЧГ=0") +
			" промокодов: количество возможных комбинаций меньше.", 0, Промокоды, Истина);
	КонецЕсли;
	
	Генератор = Новый ГенераторСлучайныхЧисел;
	УникальныеПромокоды = Новый Соответствие;
	МаксимумПопыток = ТребуетсяПромокодов * 50 + 1000;
	Попыток = 0;
	
	Пока УникальныеПромокоды.Количество() < ТребуетсяПромокодов И Попыток < МаксимумПопыток Цикл
		Попыток = Попыток + 1;
		Промокод = НовыйПромокод(РеквизитыНастройки, ПараметрыФормирования, Генератор);
		Если УникальныеПромокоды[Промокод] = Неопределено Тогда
			УникальныеПромокоды.Вставить(Промокод, Истина);
			Промокоды.Добавить(Промокод);
		КонецЕсли;
	КонецЦикла;
	
	Сгенерировано = УникальныеПромокоды.Количество();
	
	Если Сгенерировано < ТребуетсяПромокодов Тогда
		Текст = "Сгенерировано " + Формат(Сгенерировано, "ЧГ=0") + " промокодов из " +
			Формат(ТребуетсяПромокодов, "ЧГ=0") + ": уникальные комбинации закончились.";
	Иначе
		Текст = "Сгенерировано промокодов: " + Формат(Сгенерировано, "ЧГ=0") + ".";
	КонецЕсли;
	
	Возврат ОписаниеРезультатаГенерации(Текст, Сгенерировано, Промокоды, Ложь);
	
КонецФункции

Функция СтрокаРеквизитовНастройки() Экспорт
	Возврат "СМаркером,Маркер,ПозицияМаркера,ДлинаПромокода,МаксимальноеКоличество,Алфавит";
КонецФункции
	
Функция РассчитатьПараметрыФормирования(РеквизитыНастройки) Экспорт
	
	Ошибки = Новый Массив;
	СтрокаАлфавита = СтрЗаменить(СокрЛП(РеквизитыНастройки.Алфавит), " ", "");
	МощностьАлфавита = СтрДлина(СтрокаАлфавита);
	
	Если МощностьАлфавита = 0 Тогда
		Ошибки.Добавить("Не указан алфавит формирования промокода.");
	ИначеЕсли ЕстьПовторяющиесяСимволы(СтрокаАлфавита) Тогда
		Ошибки.Добавить("Алфавит содержит повторяющиеся символы.");
	КонецЕсли;
	
	Если РеквизитыНастройки.ДлинаПромокода <= 0 Тогда
		Ошибки.Добавить("Длина промокода должна быть больше нуля.");
	ИначеЕсли РеквизитыНастройки.ДлинаПромокода > МаксимальнаяДлинаПромокода() Тогда
		Ошибки.Добавить("Длина промокода не должна превышать " +
			Формат(МаксимальнаяДлинаПромокода(), "ЧГ=0") + " символов.");
	КонецЕсли;
	
	Если РеквизитыНастройки.МаксимальноеКоличество <= 0 Тогда
		Ошибки.Добавить("Максимально допустимое количество промокодов должно быть больше нуля.");
	КонецЕсли;
	
	ДлинаМаркера = 0;
	Если РеквизитыНастройки.СМаркером Тогда
		ДлинаМаркера = СтрДлина(РеквизитыНастройки.Маркер);
		Если ДлинаМаркера = 0 Тогда
			Ошибки.Добавить("Не указан маркер промокода.");
		ИначеЕсли Не СостоитИзСимволовАлфавита(РеквизитыНастройки.Маркер, СтрокаАлфавита) Тогда
			Ошибки.Добавить("Маркер содержит символы, отсутствующие в алфавите.");
		КонецЕсли;
		Если РеквизитыНастройки.ПозицияМаркера < 1 Тогда
			Ошибки.Добавить("Позиция маркера должна быть больше нуля.");
		ИначеЕсли РеквизитыНастройки.ДлинаПромокода > 0 И РеквизитыНастройки.ПозицияМаркера + ДлинаМаркера - 1 > РеквизитыНастройки.ДлинаПромокода Тогда
			Ошибки.Добавить("Маркер не помещается в промокод указанной длины.");
		КонецЕсли;
	КонецЕсли;
	
	СвободныхПозиций = РеквизитыНастройки.ДлинаПромокода - ДлинаМаркера;
	ИтоговыйФорматКода = "";
	ВероятностьУгадать = "";
	
	Если Ошибки.Количество() = 0 Тогда
		ИтоговыйФорматКода = МаскаПромокода(РеквизитыНастройки.ДлинаПромокода, РеквизитыНастройки.Маркер, РеквизитыНастройки.ПозицияМаркера, РеквизитыНастройки.СМаркером);
		ВероятностьУгадать = ОписаниеВероятности(МощностьАлфавита, СвободныхПозиций);
		РезультатПроверки = "Формат заполнен корректно";
	Иначе
		РезультатПроверки = СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	
	ПараметрыФормирования = Новый Структура;
	ПараметрыФормирования.Вставить("Корректно", Ошибки.Количество() = 0);
	ПараметрыФормирования.Вставить("Ошибки", Ошибки);
	ПараметрыФормирования.Вставить("РезультатПроверки", РезультатПроверки);
	ПараметрыФормирования.Вставить("ИтоговыйФорматКода", ИтоговыйФорматКода);
	ПараметрыФормирования.Вставить("ВероятностьУгадать", ВероятностьУгадать);
	ПараметрыФормирования.Вставить("Алфавит", СтрокаАлфавита);
	ПараметрыФормирования.Вставить("МощностьАлфавита", МощностьАлфавита);
	ПараметрыФормирования.Вставить("ДлинаМаркера", ДлинаМаркера);
	ПараметрыФормирования.Вставить("СвободныхПозиций", СвободныхПозиций);
	
	Возврат ПараметрыФормирования;
	
КонецФункции


Функция НовыйПромокод(РеквизитыНастройки, ПараметрыФормирования, Генератор)
	
	ЧастиПромокода = Новый Массив;
	СтрокаАлфавита = ПараметрыФормирования.Алфавит;
	МощностьАлфавита = ПараметрыФормирования.МощностьАлфавита;
	НачалоМаркера = РеквизитыНастройки.ПозицияМаркера;
	КонецМаркера = РеквизитыНастройки.ПозицияМаркера + ПараметрыФормирования.ДлинаМаркера - 1;
	
	Для Индекс = 1 По РеквизитыНастройки.ДлинаПромокода Цикл
		Если РеквизитыНастройки.СМаркером И Индекс >= НачалоМаркера И Индекс <= КонецМаркера Тогда
			ЧастиПромокода.Добавить(Сред(РеквизитыНастройки.Маркер, Индекс - НачалоМаркера + 1, 1));
		Иначе
			НомерСимвола = Генератор.СлучайноеЧисло(1, МощностьАлфавита);
			ЧастиПромокода.Добавить(Сред(СтрокаАлфавита, НомерСимвола, 1));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиПромокода, "");
	
КонецФункции

Функция ОписаниеРезультатаГенерации(Текст, Количество, Промокоды, Ошибка)
	
	Результат = Новый Структура;
	Результат.Вставить("Сообщение", Текст);
	Результат.Вставить("Количество", Количество);
	Результат.Вставить("Промокоды", Промокоды);
	Результат.Вставить("Ошибка", Ошибка);
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьПовторяющиесяСимволы(Знач СтрокаСимволов)
	
	ПроверенныеСимволы = Новый Соответствие;
	
	Для Индекс = 1 По СтрДлина(СтрокаСимволов) Цикл
		Символ = Сред(СтрокаСимволов, Индекс, 1);
		Если ПроверенныеСимволы[Символ] = Неопределено Тогда
			ПроверенныеСимволы.Вставить(Символ, Истина);
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция МаксимальнаяДлинаПромокода()
	
	Возврат 99;
	
КонецФункции

Функция СостоитИзСимволовАлфавита(Знач ПроверяемаяСтрока, Знач СтрокаАлфавита)
	
	Для Индекс = 1 По СтрДлина(ПроверяемаяСтрока) Цикл
		Если СтрНайти(СтрокаАлфавита, Сред(ПроверяемаяСтрока, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ОписаниеВероятности(Знач МощностьАлфавита, Знач СвободныхПозиций)
	
	Если МощностьАлфавита <= 1 ИЛИ СвободныхПозиций <= 0 Тогда
		Возврат "1 / 1";
	КонецЕсли;
	
	Если СвободныхПозиций * Log10(МощностьАлфавита) > 15 Тогда
		Возврат "1 / " + Формат(МощностьАлфавита, "ЧГ=0") + "^" +
			Формат(СвободныхПозиций, "ЧГ=0");
	КонецЕсли;
	
	Возврат "1 / " + Формат(Pow(МощностьАлфавита, СвободныхПозиций), "ЧГ=0");
	
КонецФункции

Функция МаскаПромокода(Знач ДлинаПромокода, Знач Маркер, Знач ПозицияМаркера, Знач СМаркером)
	
	ЧастиМаски = Новый Массив;
	ДлинаМаркера = ?(СМаркером, СтрДлина(Маркер), 0);
	КонецМаркера = ПозицияМаркера + ДлинаМаркера - 1;
	
	Для Индекс = 1 По ДлинаПромокода Цикл
		Если СМаркером И Индекс >= ПозицияМаркера И Индекс <= КонецМаркера Тогда
			ЧастиМаски.Добавить(Сред(Маркер, Индекс - ПозицияМаркера + 1, 1));
		Иначе
			ЧастиМаски.Добавить("*");
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиМаски, "");
	
КонецФункции

