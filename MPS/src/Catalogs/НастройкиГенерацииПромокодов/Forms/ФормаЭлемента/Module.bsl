
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.РезультатПроверки.ТолькоПросмотр = Истина;
	Элементы.ИтоговыйФорматКода.ТолькоПросмотр = Истина;
	Элементы.ВероятностьУгадать.ТолькоПросмотр = Истина;
	Элементы.ПересечениеСДругимиФорматами.ТолькоПросмотр = Истина;
	Элементы.ТаблицаПромокодов.ТолькоПросмотр = Истина;
	
	ПолныйАлфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	ВыбратьВсеСимволыНаСервере();
	ОбновитьРезультатНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АлфавитПриИзменении(Элемент)
	
	УстановитьПометкиПоСтроке(Алфавит);
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимФормированияПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура МаркерПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура ПозицияМаркераПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлинаПромокодаПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура МаксимальноеКоличествоПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	УстановитьПометкиПоСтроке(ПолныйАлфавит);
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура СимволАлфавитаОбработать(Команда)
	
	ИмяЭлемента = ТекущийЭлемент.Имя;
	Символ = СтрЗаменить(ИмяЭлемента, "Кнопка_", "");
	
	Если СтрДлина(Символ) <> 1 ИЛИ СтрНайти(ПолныйАлфавит, Символ) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПометкуКнопки(ИмяЭлемента, Не Элементы[ИмяЭлемента].Пометка);
	
	ОбновитьАлфавитИРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура Сгенерировать(Команда)
	
	РезультатГенерации = СгенерироватьПромокодыНаСервере();
	
	Если Не ПустаяСтрока(РезультатГенерации.Сообщение) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = РезультатГенерации.Сообщение;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьАлфавитИРезультат()
	
	Алфавит = ТекущийАлфавит();
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультат()
	
	ОбновитьРезультатНаСервере();
	
КонецПроцедуры


&НаКлиенте
Функция ИмяКнопкиСимвола(Знач Символ)
	
	Возврат "Кнопка_" + Символ;
	
КонецФункции

&НаКлиенте
Функция ЦветПометки()
	
	Возврат Новый Цвет(72, 215, 44);
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкуКнопки(Знач ИмяКнопки, Знач Пометка)
	
	Элементы[ИмяКнопки].Пометка = Пометка;
	Элементы[ИмяКнопки].ЦветФона = ?(Пометка, ЦветПометки(), Новый Цвет());
	
КонецПроцедуры

&НаКлиенте
Функция ТекущийАлфавит()
	
	Результат = "";
	
	Для Индекс = 1 По СтрДлина(ПолныйАлфавит) Цикл
		Символ = Сред(ПолныйАлфавит, Индекс, 1);
		Если Элементы[ИмяКнопкиСимвола(Символ)].Пометка Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиПоСтроке(Знач СтрокаСимволов)
	
	СтрокаСимволов = ВРег(СтрЗаменить(СтрокаСимволов, " ", ""));
	
	Для Индекс = 1 По СтрДлина(ПолныйАлфавит) Цикл
		Символ = Сред(ПолныйАлфавит, Индекс, 1);
		УстановитьПометкуКнопки(ИмяКнопкиСимвола(Символ), СтрНайти(СтрокаСимволов, Символ) > 0);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьВсеСимволыНаСервере()
	
	УстановитьПометкиПоСтрокеНаСервере(ПолныйАлфавит);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПометкиПоСтрокеНаСервере(Знач СтрокаСимволов)
	
	СтрокаСимволов = ВРег(СтрЗаменить(СтрокаСимволов, " ", ""));
	
	Для Индекс = 1 По СтрДлина(ПолныйАлфавит) Цикл
		Символ = Сред(ПолныйАлфавит, Индекс, 1);
		ИмяКнопки = "Кнопка_" + Символ;
		Пометка = СтрНайти(СтрокаСимволов, Символ) > 0;
		Элементы[ИмяКнопки].Пометка = Пометка;
		Элементы[ИмяКнопки].ЦветФона = ?(Пометка, Новый Цвет(72, 215, 44), Новый Цвет());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРезультатНаСервере()
	
	ПараметрыФормирования = РассчитатьПараметрыФормирования();
	
	РезультатПроверки = ПараметрыФормирования.РезультатПроверки;
	ИтоговыйФорматКода = ПараметрыФормирования.ИтоговыйФорматКода;
	ВероятностьУгадать = ПараметрыФормирования.ВероятностьУгадать;
	ПересечениеСДругимиФорматами = "—";
	
	Элементы.Маркер.Доступность = ПараметрыФормирования.СМаркером;
	Элементы.ПозицияМаркера.Доступность = ПараметрыФормирования.СМаркером;
	
КонецПроцедуры

&НаСервере
Функция РассчитатьПараметрыФормирования()
	
	Ошибки = Новый Массив;
	СтрокаАлфавита = СтрЗаменить(СокрЛП(Алфавит), " ", "");
	МощностьАлфавита = СтрДлина(СтрокаАлфавита);
	
	Если МощностьАлфавита = 0 Тогда
		Ошибки.Добавить("Не указан алфавит формирования промокода.");
	ИначеЕсли ЕстьПовторяющиесяСимволы(СтрокаАлфавита) Тогда
		Ошибки.Добавить("Алфавит содержит повторяющиеся символы.");
	КонецЕсли;
	
	Если ДлинаПромокода <= 0 Тогда
		Ошибки.Добавить("Длина промокода должна быть больше нуля.");
	ИначеЕсли ДлинаПромокода > МаксимальнаяДлинаПромокода() Тогда
		Ошибки.Добавить("Длина промокода не должна превышать " +
			Формат(МаксимальнаяДлинаПромокода(), "ЧГ=0") + " символов.");
	КонецЕсли;
	
	Если МаксимальноеКоличество <= 0 Тогда
		Ошибки.Добавить("Максимально допустимое количество промокодов должно быть больше нуля.");
	КонецЕсли;
	
	ДлинаМаркера = 0;
	Если Объект.СМаркером Тогда
		ДлинаМаркера = СтрДлина(Маркер);
		Если ДлинаМаркера = 0 Тогда
			Ошибки.Добавить("Не указан маркер промокода.");
		ИначеЕсли Не СостоитИзСимволовАлфавита(Маркер, СтрокаАлфавита) Тогда
			Ошибки.Добавить("Маркер содержит символы, отсутствующие в алфавите.");
		КонецЕсли;
		Если ПозицияМаркера < 1 Тогда
			Ошибки.Добавить("Позиция маркера должна быть больше нуля.");
		ИначеЕсли ДлинаПромокода > 0 И ПозицияМаркера + ДлинаМаркера - 1 > ДлинаПромокода Тогда
			Ошибки.Добавить("Маркер не помещается в промокод указанной длины.");
		КонецЕсли;
	КонецЕсли;
	
	СвободныхПозиций = ДлинаПромокода - ДлинаМаркера;
	ИтоговыйФорматКода = "";
	ВероятностьУгадать = "";
	
	Если Ошибки.Количество() = 0 Тогда
		ИтоговыйФорматКода = МаскаПромокода(ДлинаПромокода, Маркер, ПозицияМаркера, Объект.СМаркером);
		ВероятностьУгадать = ОписаниеВероятности(МощностьАлфавита, СвободныхПозиций);
		РезультатПроверки = "Формат заполнен корректно";
	Иначе
		РезультатПроверки = СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	
	ПараметрыФормирования = Новый Структура;
	ПараметрыФормирования.Вставить("Корректно", Ошибки.Количество() = 0);
	ПараметрыФормирования.Вставить("Ошибки", Ошибки);
	ПараметрыФормирования.Вставить("СМаркером", Объект.СМаркером);
	ПараметрыФормирования.Вставить("РезультатПроверки", РезультатПроверки);
	ПараметрыФормирования.Вставить("ИтоговыйФорматКода", ИтоговыйФорматКода);
	ПараметрыФормирования.Вставить("ВероятностьУгадать", ВероятностьУгадать);
	ПараметрыФормирования.Вставить("Алфавит", СтрокаАлфавита);
	ПараметрыФормирования.Вставить("МощностьАлфавита", МощностьАлфавита);
	ПараметрыФормирования.Вставить("ДлинаМаркера", ДлинаМаркера);
	ПараметрыФормирования.Вставить("СвободныхПозиций", СвободныхПозиций);
	
	Возврат ПараметрыФормирования;
	
КонецФункции

&НаСервере
Функция МаксимальнаяДлинаПромокода()
	
	Возврат 50;
	
КонецФункции

&НаСервере
Функция ЕстьПовторяющиесяСимволы(Знач СтрокаСимволов)
	
	ПроверенныеСимволы = Новый Соответствие;
	
	Для Индекс = 1 По СтрДлина(СтрокаСимволов) Цикл
		Символ = Сред(СтрокаСимволов, Индекс, 1);
		Если ПроверенныеСимволы[Символ] = Неопределено Тогда
			ПроверенныеСимволы.Вставить(Символ, Истина);
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция СостоитИзСимволовАлфавита(Знач ПроверяемаяСтрока, Знач СтрокаАлфавита)
	
	Для Индекс = 1 По СтрДлина(ПроверяемаяСтрока) Цикл
		Если СтрНайти(СтрокаАлфавита, Сред(ПроверяемаяСтрока, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция МаскаПромокода(Знач ДлинаПромокода, Знач Маркер, Знач ПозицияМаркера, Знач СМаркером)
	
	ЧастиМаски = Новый Массив;
	ДлинаМаркера = ?(СМаркером, СтрДлина(Маркер), 0);
	КонецМаркера = ПозицияМаркера + ДлинаМаркера - 1;
	
	Для Индекс = 1 По ДлинаПромокода Цикл
		Если СМаркером И Индекс >= ПозицияМаркера И Индекс <= КонецМаркера Тогда
			ЧастиМаски.Добавить(Сред(Маркер, Индекс - ПозицияМаркера + 1, 1));
		Иначе
			ЧастиМаски.Добавить("*");
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиМаски, "");
	
КонецФункции

&НаСервере
Функция ОписаниеВероятности(Знач МощностьАлфавита, Знач СвободныхПозиций)
	
	Если МощностьАлфавита <= 1 ИЛИ СвободныхПозиций <= 0 Тогда
		Возврат "1 / 1";
	КонецЕсли;
	
	Если СвободныхПозиций * Log10(МощностьАлфавита) > 15 Тогда
		Возврат "1 / " + Формат(МощностьАлфавита, "ЧГ=0") + "^" +
			Формат(СвободныхПозиций, "ЧГ=0");
	КонецЕсли;
	
	Возврат "1 / " + Формат(Pow(МощностьАлфавита, СвободныхПозиций), "ЧГ=0");
	
КонецФункции

&НаСервере
Функция СгенерироватьПромокодыНаСервере()
	
	ПараметрыФормирования = РассчитатьПараметрыФормирования();
	Промокоды.Очистить();
	
	Если Не ПараметрыФормирования.Корректно Тогда
		Возврат ОписаниеРезультатаГенерации(
			СтрСоединить(ПараметрыФормирования.Ошибки, Символы.ПС), 0);
	КонецЕсли;
	
	МощностьАлфавита = ПараметрыФормирования.МощностьАлфавита;
	СвободныхПозиций = ПараметрыФормирования.СвободныхПозиций;
	ТребуетсяПромокодов = МаксимальноеКоличество;
	
	Если СвободныхПозиций * Log10(МощностьАлфавита) < Log10(ТребуетсяПромокодов) Тогда
		Возврат ОписаниеРезультатаГенерации(
			"Невозможно сгенерировать " + Формат(ТребуетсяПромокодов, "ЧГ=0") +
			" промокодов: количество возможных комбинаций меньше.", 0);
	КонецЕсли;
	
	Генератор = Новый ГенераторСлучайныхЧисел;
	УникальныеПромокоды = Новый Соответствие;
	МаксимумПопыток = ТребуетсяПромокодов * 50 + 1000;
	Попыток = 0;
	
	Пока УникальныеПромокоды.Количество() < ТребуетсяПромокодов И Попыток < МаксимумПопыток Цикл
		Попыток = Попыток + 1;
		Промокод = НовыйПромокод(ПараметрыФормирования, Генератор);
		Если УникальныеПромокоды[Промокод] = Неопределено Тогда
			УникальныеПромокоды.Вставить(Промокод, Истина);
			СтрокаПромокода = Промокоды.Добавить();
			СтрокаПромокода.Промокод = Промокод;
		КонецЕсли;
	КонецЦикла;
	
	Сгенерировано = УникальныеПромокоды.Количество();
	
	Если Сгенерировано < ТребуетсяПромокодов Тогда
		Текст = "Сгенерировано " + Формат(Сгенерировано, "ЧГ=0") + " промокодов из " +
			Формат(ТребуетсяПромокодов, "ЧГ=0") + ": уникальные комбинации закончились.";
	Иначе
		Текст = "Сгенерировано промокодов: " + Формат(Сгенерировано, "ЧГ=0") + ".";
	КонецЕсли;
	
	Возврат ОписаниеРезультатаГенерации(Текст, Сгенерировано);
	
КонецФункции

&НаСервере
Функция НовыйПромокод(ПараметрыФормирования, Генератор)
	
	ЧастиПромокода = Новый Массив;
	СтрокаАлфавита = ПараметрыФормирования.Алфавит;
	МощностьАлфавита = ПараметрыФормирования.МощностьАлфавита;
	НачалоМаркера = ПозицияМаркера;
	КонецМаркера = ПозицияМаркера + ПараметрыФормирования.ДлинаМаркера - 1;
	
	Для Индекс = 1 По ДлинаПромокода Цикл
		Если ПараметрыФормирования.СМаркером И Индекс >= НачалоМаркера И Индекс <= КонецМаркера Тогда
			ЧастиПромокода.Добавить(Сред(Объект.Маркер, Индекс - НачалоМаркера + 1, 1));
		Иначе
			НомерСимвола = Генератор.СлучайноеЧисло(1, МощностьАлфавита);
			ЧастиПромокода.Добавить(Сред(СтрокаАлфавита, НомерСимвола, 1));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиПромокода, "");
	
КонецФункции

&НаСервере
Функция ОписаниеРезультатаГенерации(Знач Текст, Знач Количество)
	
	Результат = Новый Структура;
	Результат.Вставить("Сообщение", Текст);
	Результат.Вставить("Количество", Количество);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
