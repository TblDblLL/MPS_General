
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.РезультатПроверки.ТолькоПросмотр = Истина;
	Элементы.ИтоговыйФорматКода.ТолькоПросмотр = Истина;
	Элементы.ВероятностьУгадать.ТолькоПросмотр = Истина;
	Элементы.ПересечениеСДругимиФорматами.ТолькоПросмотр = Истина;
	Элементы.ТаблицаПромокодов.ТолькоПросмотр = Истина;
	
	ПолныйАлфавит = Справочники.НастройкиГенерацииПромокодов.ПолныйАлфавит();
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Алфавит = ПолныйАлфавит;
	КонецЕсли;
	УстановитьПометкиПоСтрокеНаСервере(Объект.Алфавит);
	ОбновитьРезультатНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МаркерПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура ПозицияМаркераПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлинаПромокодаПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура МаксимальноеКоличествоПриИзменении(Элемент)
	
	ОбновитьРезультат();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	УстановитьПометкиПоСтроке(ПолныйАлфавит);
	ОбновитьАлфавитИРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура СимволАлфавитаОбработать(Команда)
	
	ИмяЭлемента = ТекущийЭлемент.Имя;
	Символ = СтрЗаменить(ИмяЭлемента, "Кнопка_", "");
	
	Если СтрДлина(Символ) <> 1 ИЛИ СтрНайти(ПолныйАлфавит, Символ) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПометкуКнопки(ИмяЭлемента, Не Элементы[ИмяЭлемента].Пометка);
	
	ОбновитьАлфавитИРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура Сгенерировать(Команда)
	
	РезультатГенерации = СгенерироватьПромокодыНаСервере();
	
	Если Не ПустаяСтрока(РезультатГенерации.Сообщение) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = РезультатГенерации.Сообщение;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьАлфавитИРезультат()
	
	Объект.Алфавит = ТекущийАлфавит();
	ОбновитьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРезультат()
	
	ОбновитьРезультатНаСервере();
	
КонецПроцедуры


&НаКлиенте
Функция ИмяКнопкиСимвола(Знач Символ)
	
	Возврат "Кнопка_" + Символ;
	
КонецФункции

&НаКлиенте
Функция ЦветПометки()
	
	Возврат Новый Цвет(72, 215, 44);
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкуКнопки(Знач ИмяКнопки, Знач Пометка)
	
	Элементы[ИмяКнопки].Пометка = Пометка;
	Элементы[ИмяКнопки].ЦветФона = ?(Пометка, ЦветПометки(), Новый Цвет());
	
КонецПроцедуры

&НаКлиенте
Функция ТекущийАлфавит()
	
	Результат = "";
	
	Для Индекс = 1 По СтрДлина(ПолныйАлфавит) Цикл
		Символ = Сред(ПолныйАлфавит, Индекс, 1);
		Если Элементы[ИмяКнопкиСимвола(Символ)].Пометка Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиПоСтроке(Знач СтрокаСимволов)
	
	СтрокаСимволов = ВРег(СтрЗаменить(СтрокаСимволов, " ", ""));
	
	Для Индекс = 1 По СтрДлина(ПолныйАлфавит) Цикл
		Символ = Сред(ПолныйАлфавит, Индекс, 1);
		УстановитьПометкуКнопки(ИмяКнопкиСимвола(Символ), СтрНайти(СтрокаСимволов, Символ) > 0);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьВсеСимволыНаСервере()
	
	УстановитьПометкиПоСтрокеНаСервере(ПолныйАлфавит);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПометкиПоСтрокеНаСервере(Знач СтрокаСимволов)
	
	СтрокаСимволов = ВРег(СтрЗаменить(СтрокаСимволов, " ", ""));
	
	Для Индекс = 1 По СтрДлина(ПолныйАлфавит) Цикл
		Символ = Сред(ПолныйАлфавит, Индекс, 1);
		ИмяКнопки = "Кнопка_" + Символ;
		Пометка = СтрНайти(СтрокаСимволов, Символ) > 0;
		Элементы[ИмяКнопки].Пометка = Пометка;
		Элементы[ИмяКнопки].ЦветФона = ?(Пометка, Новый Цвет(72, 215, 44), Новый Цвет());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НастройкаГенерации()
	СтрокаРеквизитов = Справочники.НастройкиГенерацииПромокодов.СтрокаРеквизитовНастройки();
	НастройкаГенерации = Новый Структура(СтрокаРеквизитов); 
	ЗаполнитьЗначенияСвойств(НастройкаГенерации, Объект);
	Возврат НастройкаГенерации;
КонецФункции	


&НаСервере
Процедура ОбновитьРезультатНаСервере()
	
	ПараметрыФормирования = Справочники.НастройкиГенерацииПромокодов.РассчитатьПараметрыФормирования(НастройкаГенерации());
	
	РезультатПроверки = ПараметрыФормирования.РезультатПроверки;
	ИтоговыйФорматКода = ПараметрыФормирования.ИтоговыйФорматКода;
	ВероятностьУгадать = ПараметрыФормирования.ВероятностьУгадать;
	ПересечениеСДругимиФорматами = "—";
	
	Элементы.Маркер.Доступность = Объект.СМаркером;
	Элементы.ПозицияМаркера.Доступность = Объект.СМаркером;
	
КонецПроцедуры

&НаСервере
Функция СгенерироватьПромокодыНаСервере()
	
	РезультатГенерации = Справочники.НастройкиГенерацииПромокодов.СгенерироватьПромокодыНаСервере(НастройкаГенерации());
	Если не РезультатГенерации.Ошибка Тогда
		Объект.Промокоды.Очистить();
		Для каждого Промокод из РезультатГенерации.Промокоды Цикл
			Объект.Промокоды.Добавить().Промокод = Промокод;
		КонецЦикла;	
	КонецЕсли;	
	Возврат РезультатГенерации; 
	
КонецФункции


#КонецОбласти
