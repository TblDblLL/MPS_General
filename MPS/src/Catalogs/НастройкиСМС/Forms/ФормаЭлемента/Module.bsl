#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИнициализацияПровайдера();
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Попытка
	МодульПровайдера = ОбщегоНазначения.ОбщийМодуль(ИмяЗначенияПеречисления(ТекущийОбъект.Провайдер));
	Исключение
		ОбщегоНазначения.СообщитьПользователю("Не обнаружен модуль обработки настроек SMS провайдера.",,"Объект.Провайдер",,Отказ);
		Возврат;
	КонецПопытки;
	Настройки = МодульПровайдера.СтруктураНастроекПровайдера();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	МодульПровайдера.ЗаписатьНастройкиПровайдера(ТекущийОбъект.Ссылка, УникальныйИдентификатор, Настройки);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ИнициализацияПровайдера();
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура РежимТокенаЧисло2ПриИзменении(Элемент)
	РежимТокена = (РежимТокенаЧисло = 2);
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура РежимТокенаЧисло1ПриИзменении(Элемент)
	РежимТокена = (РежимТокенаЧисло = 2);
	УправлениеФормой();
КонецПроцедуры


&НаКлиенте
Процедура ПровайдерПриИзменении(Элемент)
	ИнициализацияПровайдера();
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура ИнициализацияПровайдера()
	Логин = "";
	Пароль = "";
	Токен = "";
	Элементы.СтраницыНастройкиПровадера.ТекущаяСтраница = Элементы.Пустая;
	Попытка
		МодульПровайдера = ОбщегоНазначения.ОбщийМодуль(ИмяЗначенияПеречисления(Объект.Провайдер));
	Исключение
		ОбщегоНазначения.СообщитьПользователю("Не обнаружен модуль обработки настроек SMS провайдера.", ,
			"Объект.Провайдер");
		Возврат;
	КонецПопытки;

	НастройкиПровайдера = МодульПровайдера.ПолучитьНастройкиПровайдера(Объект.Ссылка,УникальныйИдентификатор);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиПровайдера);
	РежимТокенаЧисло = ?(РежимТокена = Истина, 2, 1);
	Элементы.СтраницыНастройкиПровадера.ТекущаяСтраница = Элементы.Настройки;
	УправлениеФормой();
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	Элементы.Токен.Доступность = (РежимТокенаЧисло = 2);
	Элементы.ПодгруппаПарольЛогин.Доступность = не (РежимТокенаЧисло = 2);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяЗначенияПеречисления(ЗначениеПеречисления)
	Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(ЗначениеПеречисления);
КонецФункции
#КонецОбласти

