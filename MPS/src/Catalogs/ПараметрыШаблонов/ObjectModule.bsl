Процедура ПередЗаписью(Отказ)
    Наименование = СокрЛП(Наименование);
    Если ПустаяСтрока(Наименование) Или СтрНайти(Наименование, "{") > 0
        Или СтрНайти(Наименование, "}") > 0 Или СтрЧислоСтрок(Наименование) > 1
        Или СтрНайти(Наименование, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Укажите непустое наименование параметра без фигурных скобок и переносов строк.";
    КонецЕсли;

    Разделы = Новый Соответствие;
    Для Каждого СтрокаДоступности Из Доступность Цикл
        Если Не ЗначениеЗаполнено(СтрокаДоступности.Раздел) Тогда
            ВызватьИсключение "Укажите раздел в каждой строке доступности.";
        КонецЕсли;
        Если Разделы.Получить(СтрокаДоступности.Раздел) <> Неопределено Тогда
            ВызватьИсключение "Раздел указан повторно: " + Строка(СтрокаДоступности.Раздел);
        КонецЕсли;
        Разделы.Вставить(СтрокаДоступности.Раздел, Истина);
    КонецЦикла;

    // Сравнение и запись должны быть последовательными и для двух новых элементов.
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("Справочник.ПараметрыШаблонов");
    Блокировка.Заблокировать();

    Запрос = Новый Запрос(
        "ВЫБРАТЬ ПЕРВЫЕ 1 Параметры.Ссылка
        |ИЗ Справочник.ПараметрыШаблонов КАК Параметры
        |ГДЕ Параметры.Наименование = &Наименование И Параметры.Ссылка <> &Ссылка");
    Запрос.УстановитьПараметр("Наименование", Наименование);
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "Параметр с таким наименованием уже существует: " + Наименование;
    КонецЕсли;
КонецПроцедуры
