Функция ПараметрыРаздела(ПредметныйРаздел) Экспорт
    Если ТипЗнч(ПредметныйРаздел) <> Тип("ПеречислениеСсылка.ПредметныеРазделыПКМП")
        Или Не ЗначениеЗаполнено(ПредметныйРаздел) Тогда
        ВызватьИсключение "Укажите предметный раздел.";
    КонецЕсли;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |    Доступность.Ссылка КАК Параметр,
        |    Доступность.Ссылка.Наименование КАК Наименование,
        |    Доступность.Динамический КАК Динамический,
        |    Доступность.ЗначениеПараметра КАК ЗначениеПараметра
        |ИЗ Справочник.ПараметрыШаблонов.Доступность КАК Доступность
        |ГДЕ Доступность.Раздел = &Раздел И НЕ Доступность.Ссылка.ПометкаУдаления
        |УПОРЯДОЧИТЬ ПО Наименование");
    Запрос.УстановитьПараметр("Раздел", ПредметныйРаздел);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ЗначениеПараметра(Наименование, ПредметныйРаздел, Рассылка = Неопределено) Экспорт
    Параметр = ПараметрыРаздела(ПредметныйРаздел).Найти(Наименование, "Наименование");
    Если Параметр = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат ЗначениеПараметраРаздела(Параметр, ПредметныйРаздел, Рассылка);
КонецФункции

Функция ЗначениеПараметраРаздела(Параметр, ПредметныйРаздел, Рассылка) Экспорт
    Если Не Параметр.Динамический Тогда
        Возврат Параметр.ЗначениеПараметра;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Рассылка) Или Не Метаданные.ОпределяемыеТипы.Рассылки.Тип.СодержитТип(ТипЗнч(Рассылка)) Тогда
        Возврат Неопределено;
    КонецЕсли;
    МенеджерРассылки = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Рассылка);
    Результат = Неопределено;
    МенеджерРассылки.ПолучитьПараметрОбъекта(Параметр.Наименование, ПредметныйРаздел, Рассылка, Результат);
    Возврат Результат;
КонецФункции
