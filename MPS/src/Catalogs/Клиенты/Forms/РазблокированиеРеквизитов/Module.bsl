
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	РазрешитьРедактированиеКод = Истина;
	РазрешитьРедактированиеДатаРождения                      = Истина;
	РазрешитьРедактированиеПол                        = Истина;
	РазрешитьРедактированиеГруппаДоступа                = Истина;
	РазрешитьРедактированиеЛокации                    = Истина;
	РазрешитьРедактированиеТелефон                    = Истина;
	РазрешитьРедактированиеПочта                    = Истина;
	РазрешитьРедактированиеФИО                    = Истина;
	РазрешитьРедактированиеКодДисконтнойКарты                    = Истина;
	РазрешитьРедактированиеДатаРегистрации                    = Истина;
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазрешитьРедактирование(Команда)
	
	Результат = Новый Массив;
	Если РазрешитьРедактированиеКод Тогда
		Результат.Добавить("Код");
	КонецЕсли;
	
	Если РазрешитьРедактированиеДатаРождения Тогда
		Результат.Добавить("ДатаРождения");
	КонецЕсли;
	
	Если РазрешитьРедактированиеПол Тогда
		Результат.Добавить("Пол");
	КонецЕсли;
	
	Если РазрешитьРедактированиеГруппаДоступа Тогда
		Результат.Добавить("ГруппаДоступа");
	КонецЕсли;
	
	Если РазрешитьРедактированиеЛокации Тогда
		Результат.Добавить("ЧасовойПояс");
		Результат.Добавить("ЗонаДоставки");
	КонецЕсли;
	
	Если РазрешитьРедактированиеТелефон Тогда
		Результат.Добавить("Телефон");
	КонецЕсли;
	
	Если РазрешитьРедактированиеПочта Тогда
		Результат.Добавить("Почта");
	КонецЕсли;
	
	Если РазрешитьРедактированиеФИО Тогда
		Результат.Добавить("Фамилия");
		Результат.Добавить("Имя");
		Результат.Добавить("Отчество");
	КонецЕсли;
	
	Если РазрешитьРедактированиеКодДисконтнойКарты Тогда
		Результат.Добавить("КодДисконтнойКарты");
	КонецЕсли;
	
	Если РазрешитьРедактированиеДатаРегистрации Тогда
		Результат.Добавить("ДатаРегистрации");
	КонецЕсли;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры

#КонецОбласти
