// Возвращает имена блокируемых реквизитов для механизма блокирования реквизитов БСП.
//
// Возвращаемое значение:
//   Массив - имена блокируемых реквизитов.
//
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	
	
	Результат.Добавить("Код;СформироватьИД");
	Результат.Добавить("ДатаРождения");
	Результат.Добавить("Пол");
	Результат.Добавить("ГруппаДоступа");
	Результат.Добавить("ЧасовойПояс");
	Результат.Добавить("ЗонаДоставки");
	Результат.Добавить("Телефон");
	Результат.Добавить("Почта");
	Результат.Добавить("Фамилия");
	Результат.Добавить("Имя");
	Результат.Добавить("Отчество");
	Результат.Добавить("КодДисконтнойКарты");
	Результат.Добавить("ДатаРегистрации");
	
	Возврат Результат;
	
КонецФункции

