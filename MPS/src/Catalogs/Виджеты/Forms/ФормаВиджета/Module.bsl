&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Объект.КолонокКомпьютер = 0 Тогда
        ДанныеОбъекта = РеквизитФормыВЗначение("Объект");
        Справочники.Виджеты.НачальныеНастройки(ДанныеОбъекта);
        ЗначениеВРеквизитФормы(ДанныеОбъекта, "Объект");
    КонецЕсли;
    УстройствоПросмотра = Перечисления.ТипыУстройствОтображения.Компьютер;
    ШиринаПросмотра = 960;
    ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
    Попытка
        ОбновитьНаСервере();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПараметрИзменен(Элемент)
    Модифицированность = Истина;
    Обновить(Неопределено);
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере() Экспорт
    СинхронизироватьНастройки();
    ПрименитьПоиск();
    Результат = Справочники.Виджеты.Сформировать(РеквизитФормыВЗначение("Объект"));
    ГотовыйHTML = Результат.HTML;
    ГотовыйCSS = Результат.CSS;
    ГотовыйJS = Результат.JS;
    СтраницаДляВыгрузки = Результат.Просмотр;
    ГотовыйПросмотр = ОформитьПредпросмотр(Результат.Просмотр);
КонецПроцедуры

&НаКлиенте
Процедура Пример(Команда)
    ПримерНаСервере();
    Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ПримерНаСервере() Экспорт
    Если Объект.Товары.Количество() > 0 Тогда
        ВызватьИсключение "Пример добавляется только в пустую таблицу товаров.";
    КонецЕсли;
    Для Номер = 1 По 6 Цикл
        Товар = Объект.Товары.Добавить();
        Товар.Показывать = Истина;
        Товар.ИдентификаторСайта = "demo-" + Формат(Номер, "ЧГ=0");
        Товар.Название = "Демонстрационный товар " + Формат(Номер, "ЧГ=0");
        Товар.Цена = 1000 + Номер * 250;
        Товар.СтараяЦена = ?(Номер = 1, 2000, 0);
        Товар.Группа = ?(Номер <= 3, "Для дома", "Для отдыха");
        Товар.Производитель = "Пример бренда";
        Товар.Рейтинг = 4.5;
        Товар.Новинка = Номер = 2;
    КонецЦикла;
    ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураИзменена(Элемент)
    Товар = Элементы.ТаблицаТоваров.ТекущиеДанные;
    Если Товар <> Неопределено И ЗначениеЗаполнено(Товар.Номенклатура) Тогда
        ДанныеТовара = ДанныеНоменклатуры(Товар.Номенклатура);
        Если ПустаяСтрока(Товар.Название) Тогда
            Товар.Название = ДанныеТовара.Название;
        КонецЕсли;
        Если ПустаяСтрока(Товар.ИдентификаторСайта) Тогда
            Товар.ИдентификаторСайта = ДанныеТовара.Идентификатор;
        КонецЕсли;
        Товар.Показывать = Истина;
    КонецЕсли;
    ПараметрИзменен(Элемент);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеНоменклатуры(Номенклатура)
    Возврат Новый Структура("Название,Идентификатор", Строка(Номенклатура), Строка(Номенклатура.УникальныйИдентификатор()));
КонецФункции

&НаКлиенте
Процедура Выгрузить(Команда)
    Попытка
        ОбновитьНаСервере();
    Исключение
        Сообщить(ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Показать(Новый ОписаниеОповещения("КаталогВыбран", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыбран(Файлы, Дополнительно) Экспорт
    Если Файлы <> Неопределено Тогда
        ВыгрузитьВКаталог(Файлы[0]);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВКаталог(Корень) Экспорт
    ОбновитьНаСервере();
    Папка = Корень + "\widget-" + Строка(Новый УникальныйИдентификатор);
    СоздатьКаталог(Папка);
    ЗаписатьТекст(Папка + "\widget.html", ГотовыйHTML);
    ЗаписатьТекст(Папка + "\widget.css", ГотовыйCSS);
    ЗаписатьТекст(Папка + "\widget.js", ГотовыйJS);
    ЗаписатьТекст(Папка + "\preview.html", СтраницаДляВыгрузки);
    Сообщить("Виджет выгружен: " + Папка);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьТекст(Путь, Текст)
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(Текст);
    Документ.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
    // Предпросмотр в 1С не открывает страницы товаров.
    СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ЦветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    Диалог = Новый ДиалогВыбораЦвета;
    Диалог.Цвет = ЭтотОбъект["Цвет_" + Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 6)];
    Диалог.Показать(Новый ОписаниеОповещения("ЦветВыбран", ЭтотОбъект, Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 6)));
КонецПроцедуры

&НаКлиенте
Процедура ЦветВыбран(Цвет, ИмяРеквизита) Экспорт
    Если Цвет = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Алфавит = "0123456789abcdef";
    Текст = "#";
    Компоненты = Новый Массив;
    Компоненты.Добавить(Цвет.Красный);
    Компоненты.Добавить(Цвет.Зеленый);
    Компоненты.Добавить(Цвет.Синий);
    Для Каждого Компонента Из Компоненты Цикл
        Текст = Текст + Сред(Алфавит, Цел(Компонента / 16) + 1, 1) + Сред(Алфавит, Компонента % 16 + 1, 1);
    КонецЦикла;
    Объект[ИмяРеквизита] = Текст;
    ЭтотОбъект["Цвет_" + ИмяРеквизита] = Цвет;
    ПараметрИзменен(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ЦветИзменен(Элемент)
    ИмяРеквизита = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 6);
    ЦветВыбран(ЭтотОбъект["Цвет_" + ИмяРеквизита], ИмяРеквизита);
КонецПроцедуры

&НаКлиенте
Процедура ПолзунокИзменен(Элемент) Экспорт
    ИмяРеквизита = Сред(УстройстваОтображенияПКМП.ИмяИсходногоЭлемента(Элемент.Имя), 8);
    Объект[ИмяРеквизита] = ЭтотОбъект["Шкала_" + ИмяРеквизита];
    ПараметрИзменен(Элемент);
КонецПроцедуры

