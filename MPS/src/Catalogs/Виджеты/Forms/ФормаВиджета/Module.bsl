    Шкала_КолонокПланшет = Объект.КолонокПланшет;
    Шкала_КолонокТелефон = Объект.КолонокТелефон;
    Шкала_Расстояние = Объект.Расстояние;
    Шкала_ОтступВиджета = Объект.ОтступВиджета;
    Шкала_ОтступКарточки = Объект.ОтступКарточки;
    Шкала_Скругление = Объект.Скругление;
    Шкала_ВысотаИзображения = Объект.ВысотаИзображения;
    Шкала_ВысотаИзображенияТелефон = Объект.ВысотаИзображенияТелефон;
    Шкала_РазмерШрифта = Объект.РазмерШрифта;
    Шкала_РазмерШрифтаТелефон = Объект.РазмерШрифтаТелефон;
    Шкала_РазмерЗаголовка = Объект.РазмерЗаголовка;
    Шкала_СтрокНазвания = Объект.СтрокНазвания;
    Цвет_ЦветФона = ЦветИзHEX(Объект.ЦветФона);
    Цвет_ЦветКарточки = ЦветИзHEX(Объект.ЦветКарточки);
    Цвет_ЦветТекста = ЦветИзHEX(Объект.ЦветТекста);
    Цвет_ЦветВторостепенный = ЦветИзHEX(Объект.ЦветВторостепенный);
    Цвет_ЦветГраницы = ЦветИзHEX(Объект.ЦветГраницы);
    Цвет_ЦветАкцента = ЦветИзHEX(Объект.ЦветАкцента);
    Цвет_ЦветТекстаКнопки = ЦветИзHEX(Объект.ЦветТекстаКнопки);
    Цвет_ЦветНовинки = ЦветИзHEX(Объект.ЦветНовинки);
КонецПроцедуры

