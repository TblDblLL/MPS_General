&НаСервере
Функция ЦветИзHEX(Текст)
    Алфавит = "0123456789abcdef";
    Компоненты = Новый Массив;
    Для Позиция = 2 По 6 Цикл
        Если Позиция % 2 <> 0 Тогда
            Продолжить;
        КонецЕсли;
        Старшая = СтрНайти(Алфавит, НРег(Сред(Текст, Позиция, 1))) - 1;
        Младшая = СтрНайти(Алфавит, НРег(Сред(Текст, Позиция + 1, 1))) - 1;
        Компоненты.Добавить(Макс(0, Старшая * 16 + Младшая));
    КонецЦикла;
    Возврат Новый Цвет(Компоненты[0], Компоненты[1], Компоненты[2]);
КонецФункции

&НаСервере
Функция ОформитьПредпросмотр(HTML)
    Ширина = Формат(Мин(1920, Макс(280, ШиринаПросмотра)), "ЧГ=0;ЧДЦ=0");
    Колонки = Объект.КолонокКомпьютер;
    Если УстройствоПросмотра = Перечисления.ТипыУстройствОтображения.Планшет Тогда
        Колонки = Объект.КолонокПланшет;
    ИначеЕсли УстройствоПросмотра = Перечисления.ТипыУстройствОтображения.Телефон Тогда
        Колонки = Объект.КолонокТелефон;
    КонецЕсли;
    ЧислоКолонок = Формат(Колонки, "ЧГ=0;ЧДЦ=0");
    Мобильный = УстройствоПросмотра = Перечисления.ТипыУстройствОтображения.Телефон;
    Шрифт = Формат(?(Мобильный, Объект.РазмерШрифтаТелефон, Объект.РазмерШрифта), "ЧГ=0;ЧДЦ=0");
    ВысотаКартинки = Формат(?(Мобильный, Объект.ВысотаИзображенияТелефон, Объект.ВысотаИзображения), "ЧГ=0;ЧДЦ=0");
    Дополнение = "<style>.pw{width:" + Ширина + "px!important;font-size:" + Шрифт + "px!important;padding:var(--pw-padding)!important}"
    + ".pw-card{flex-basis:calc((100% - (" + ЧислоКолонок + " - 1) * var(--pw-gap)) / " + ЧислоКолонок + ")!important;padding:var(--pw-card-padding)!important}"
    + ".pw-picture{height:" + ВысотаКартинки + "px!important}.pw-heading{font-size:var(--pw-heading-size)!important}"
    + ".pw-arrow{display:" + ?(Мобильный, "none", "block") + "!important}</style>";
    Возврат СтрЗаменить(HTML, "</head>", Дополнение + "</head>");
КонецФункции

&НаСервере
Процедура СинхронизироватьНастройки()
