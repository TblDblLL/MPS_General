
&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()
	ПостроительЗапроса = Новый ПостроительЗапроса;	
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Справочники.ВидыДействийКлиента.ПолучитьМакет("ВидыПоУмолчанию").Область());  
	ПостроительЗапроса.Выполнить();   
	ТЗРезультат = ПостроительЗапроса.Результат.Выгрузить(); 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТЗРезультат.КодДействия КАК КодДействия,
	|	ТЗРезультат.КодДействияMindBox КАК КодДействияMindBox,
	|	ТЗРезультат.Наименование КАК Наименование,
	|	ТЗРезультат.ОписаниеВидаОперации КАК ОписаниеВидаОперации,
	|	ТЗРезультат.ДополнительныеКодыMindBox КАК ДополнительныеКодыMindBox
	|ПОМЕСТИТЬ ВТ_ВидыПоУмолчанию
	|ИЗ
	|	&ТЗРезультат КАК ТЗРезультат
	|ГДЕ
	|	НЕ СОКРЛП(ТЗРезультат.КодДействия) = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВидыПоУмолчанию.*
	|ИЗ
	|	ВТ_ВидыПоУмолчанию КАК ВТ_ВидыПоУмолчанию
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыДействийКлиента КАК ВидыДействийКлиента
	|		ПО ВТ_ВидыПоУмолчанию.КодДействия = ВидыДействийКлиента.КодДействия
	|ГДЕ
	|	ВидыДействийКлиента.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ТЗРезультат", ТЗРезультат);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовыйЭлемент = Справочники.ВидыДействийКлиента.СоздатьЭлемент();
		НовыйЭлемент.КодДействия = Выборка.КодДействия;
		НовыйЭлемент.Наименование = Выборка.Наименование;
		НовыйЭлемент.ОписаниеВидаОперации = Выборка.ОписаниеВидаОперации;
		НовыйЭлемент.ДополнительныеКодыMindBox = Выборка.ДополнительныеКодыMindBox;
		НовыйЭлемент.КодДействияMindBox = Выборка.КодДействияMindBox;
		НовыйЭлемент.Записать();
	КонецЦикла;
	
	Элементы.Список.Обновить();


КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	ЗаполнитьПоУмолчаниюНаСервере();
КонецПроцедуры
