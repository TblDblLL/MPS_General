Функция СохранитьШаблон(Знач Наименование, ПредметныйРаздел, JSONНастроек,
    Ссылка = Неопределено, ИсходныйJSON = "", ИсходноеНаименование = "") Экспорт
    Наименование = СокрЛП(Наименование);
    Если ПустаяСтрока(Наименование) Или СтрДлина(Наименование) > 150 Тогда
        ВызватьИсключение "Укажите название шаблона длиной до 150 символов.";
    КонецЕсли;
    HTML = СформироватьHTMLИзJSON(JSONНастроек, ПредметныйРаздел);

    НачатьТранзакцию();
    Попытка
        Если ЗначениеЗаполнено(Ссылка) Тогда
            Блокировка = Новый БлокировкаДанных;
            Блокировка.Добавить("Справочник.НастройкиШаблонов").УстановитьЗначение("Ссылка", Ссылка);
            Блокировка.Заблокировать();
            Настройки = Ссылка.ПолучитьОбъект();
            Если Настройки = Неопределено Или Настройки.ПометкаУдаления
                Или Настройки.ПредметныйРаздел <> ПредметныйРаздел Или Настройки.НастройкиJSON <> ИсходныйJSON
                Или Настройки.Наименование <> ИсходноеНаименование Тогда
                ВызватьИсключение "Шаблон изменён в другом окне. Откройте его заново.";
            КонецЕсли;
        Иначе
            Настройки = СоздатьЭлемент();
        КонецЕсли;
        Настройки.Наименование = Наименование;
        Настройки.ПредметныйРаздел = ПредметныйРаздел;
        Настройки.НастройкиJSON = JSONНастроек;
        Настройки.HTML = HTML;
        Настройки.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("HTML,НастройкиШаблона", HTML, Настройки.Ссылка);
КонецФункции

Функция СформироватьHTMLИзJSON(JSONНастроек, ПредметныйРаздел) Экспорт
    Если СтрДлина(JSONНастроек) > 12000000 Тогда
        ВызватьИсключение "Уменьшите объём шаблона. Допустимо до 12 МБ настроек.";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(JSONНастроек);
    Макет = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат СформироватьHTML(Макет, ПредметныйРаздел);
КонецФункции

Функция СформироватьHTML(Макет, ПредметныйРаздел) Экспорт
    Если ТипЗнч(Макет) <> Тип("Структура") Или Не Макет.Свойство("width") Или Не Макет.Свойство("rows") Тогда
        ВызватьИсключение "Укажите ширину документа и строки с областями.";
    КонецЕсли;
    ШиринаДокумента = Пиксели(Макет.width, 1, 4000);
    Если ТипЗнч(Макет.rows) <> Тип("Массив") Или Макет.rows.Количество() = 0 Тогда
        ВызватьИсключение "Добавьте хотя бы одну область.";
    КонецЕсли;
    Параметры = Справочники.ПараметрыШаблонов.ПараметрыРаздела(ПредметныйРаздел);
    ДопустимыеИмена = Новый Соответствие;
    Для Каждого Параметр Из Параметры Цикл
        ДопустимыеИмена.Вставить(Параметр.Наименование, Истина);
    КонецЦикла;
    Части = Новый Массив;
    Части.Добавить("<div style=""width:" + ШиринаДокумента + ";"">");
    НомерСтроки = 0;
    Для Каждого СтрокаОбластей Из Макет.rows Цикл
        НомерСтроки = НомерСтроки + 1;
        Если ТипЗнч(СтрокаОбластей) <> Тип("Массив") Или СтрокаОбластей.Количество() = 0 Тогда
            ВызватьИсключение "Добавьте область в строку " + Строка(НомерСтроки) + ".";
        КонецЕсли;
        Части.Добавить(HTMLСтроки(СтрокаОбластей, Макет.width, НомерСтроки, ДопустимыеИмена));
    КонецЦикла;
    Части.Добавить("</div>");
    Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

Функция HTMLСтроки(СтрокаОбластей, ШиринаДокумента, НомерСтроки, ДопустимыеИмена)
    Ячейки = Новый Массив;
    ВысотаСтроки = 0;
    ЗанятаяШирина = 0;
    РастягиваемыхОбластей = 0;
    Для Каждого Область Из СтрокаОбластей Цикл
        Если Область.kind = "icon" Тогда
            ЗанятаяШирина = ЗанятаяШирина + Область.size;
            ВысотаСтроки = Макс(ВысотаСтроки, Область.size);
        Иначе
            ВысотаСтроки = Макс(ВысотаСтроки, Область.height);
            Если Область.fullWidth = Истина Тогда
                РастягиваемыхОбластей = РастягиваемыхОбластей + 1;
            Иначе
                ЗанятаяШирина = ЗанятаяШирина + Область.width;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    СвободнаяШирина = ШиринаДокумента - ЗанятаяШирина;
    Если СвободнаяШирина < РастягиваемыхОбластей Тогда
        ВызватьИсключение "В строке " + Строка(НомерСтроки) + " суммарная ширина областей превышает ширину документа.";
    КонецЕсли;
    ШиринаСтроки = 0;
    Для Каждого Область Из СтрокаОбластей Цикл
        Если Область.kind = "icon" Тогда
            Ширина = Область.size;
            Высота = Область.size;
        Иначе
            Ширина = Область.width;
            Высота = Область.height;
            Если Область.fullWidth = Истина Тогда
                Ширина = Цел((СвободнаяШирина + РастягиваемыхОбластей - 1) / РастягиваемыхОбластей);
                СвободнаяШирина = СвободнаяШирина - Ширина;
                РастягиваемыхОбластей = РастягиваемыхОбластей - 1;
            КонецЕсли;
            ПолнаяВысота = Ложь;
            Если Область.Свойство("fullHeight", ПолнаяВысота) И ПолнаяВысота = Истина Тогда
                Высота = ВысотаСтроки;
            КонецЕсли;
        КонецЕсли;
        ШиринаОбласти = Пиксели(Ширина, 1, 4000);
        ШиринаСтроки = ШиринаСтроки + Ширина;
        Если ШиринаСтроки > ШиринаДокумента Тогда
            ВызватьИсключение "В строке " + Строка(НомерСтроки) + " суммарная ширина областей превышает ширину документа.";
        КонецЕсли;
        ВысотаОбласти = Пиксели(Высота, 1, 4000);
        Ячейки.Добавить("<td valign=""top"" style=""padding:0;width:" + ШиринаОбласти + ";"">"
            + "<div style=""width:" + ШиринаОбласти + ";height:" + ВысотаОбласти + ";overflow:hidden;"">"
            + HTMLОбласти(Область, ДопустимыеИмена) + "</div></td>");
    КонецЦикла;
    Возврат "<table role=""presentation"" cellpadding=""0"" cellspacing=""0"" style=""table-layout:fixed;width:"
        + Пиксели(ШиринаСтроки, 1, 4000) + ";""><tbody><tr>"
        + СтрСоединить(Ячейки) + "</tr></tbody></table>";
КонецФункции

// Подстановка в готовый HTML. Если хотя бы один параметр не вычислен, результат Неопределено.
Функция ПодставитьПараметры(Настройки, Рассылка = Неопределено) Экспорт
    HTML = Настройки.HTML;
    Значения = Новый Соответствие;
    Для Каждого Параметр Из Справочники.ПараметрыШаблонов.ПараметрыРаздела(Настройки.ПредметныйРаздел) Цикл
        Значения.Вставить(Экранировать(Параметр.Наименование), Параметр);
    КонецЦикла;
    Результат = Новый Массив;
    Начало = 1;
    Позиция = СтрНайти(HTML, "{");
    Пока Позиция > 0 Цикл
        КонецМетки = СтрНайти(HTML, "}", НаправлениеПоиска.СНачала, Позиция);
        Если КонецМетки = 0 Тогда
            Возврат Неопределено;
        КонецЕсли;
        Имя = Сред(HTML, Позиция + 1, КонецМетки - Позиция - 1);
        Параметр = Значения.Получить(Имя);
        Если Параметр = Неопределено Тогда
            Возврат Неопределено;
        КонецЕсли;
        Значение = Справочники.ПараметрыШаблонов.ЗначениеПараметраРаздела(Параметр, Настройки.ПредметныйРаздел, Рассылка);
        Если Значение = Неопределено Тогда
            Возврат Неопределено;
        КонецЕсли;
        Результат.Добавить(Сред(HTML, Начало, Позиция - Начало));
        Результат.Добавить(Экранировать(Строка(Значение)));
        Начало = КонецМетки + 1;
        Если Начало > СтрДлина(HTML) Тогда
            Прервать;
        КонецЕсли;
        Позиция = СтрНайти(HTML, "{", НаправлениеПоиска.СНачала, Начало);
    КонецЦикла;
    Результат.Добавить(Сред(HTML, Начало));
    Возврат СтрСоединить(Результат);
КонецФункции

Функция HTMLОбласти(Область, ДопустимыеИмена)
    ТипОбласти = ИзСписка(Область.kind, "text,button,image,icon");
    Стиль = "box-sizing:border-box;display:block;width:100%;height:100%;overflow:auto;";
    Если ТипОбласти = "icon" Тогда
        Возврат HTMLИзображения(Область, Стиль, "center center");
    КонецЕсли;
    Выравнивание = Неопределено;
    Если Не Область.Свойство("align", Выравнивание) Тогда
        Выравнивание = "left";
    КонецЕсли;
    Выравнивание = ИзСписка(Выравнивание, "left,center,right");
    Вертикаль = Неопределено;
    Если Не Область.Свойство("verticalAlign", Вертикаль) Тогда
        Вертикаль = ?(ТипОбласти = "image", "middle", "top");
    КонецЕсли;
    Вертикаль = ИзСписка(Вертикаль, "top,middle,bottom");
    Если ТипОбласти = "text" Тогда
        Обводка = Неопределено;
        Если Не Область.Свойство("border", Обводка) Тогда
            Обводка = "none";
        КонецЕсли;
        Стиль = Стиль + "overflow-wrap:break-word;white-space:pre-wrap;text-align:" + Выравнивание
            + ";background-color:" + ЦветHTML(Область.fill)
            + ";border:1px " + ИзСписка(Обводка, "none,solid,dashed,dotted") + " #777;";
        Возврат HTMLТекстовогоБлока("div", "", Стиль, Вертикаль, HTMLТекста(Область.runs, ДопустимыеИмена));
    КонецЕсли;

    Стиль = Стиль + "border-radius:" + Пиксели(Область.radius, 0, 300)
        + ";border-style:" + ИзСписка(Область.border, "none,solid,dashed,dotted")
        + ";border-width:1px;border-color:#777;padding:" + Пиксели(Область.padding, 0, 200) + ";";
    Если ТипОбласти = "image" Тогда
        Возврат HTMLИзображения(Область, Стиль, Выравнивание + " " + ?(Вертикаль = "middle", "center", Вертикаль));
    КонецЕсли;

    Ссылка = АдресHTML(Область.href, Ложь);
    Тег = ?(ПустаяСтрока(Ссылка), "div", "a");
    АтрибутСсылки = ?(ПустаяСтрока(Ссылка), "", " href=""" + Ссылка + """");
    Стиль = Стиль + "white-space:pre-wrap;overflow-wrap:break-word;text-align:" + Выравнивание + ";"
        + "background-color:" + ЦветHTML(Область.fill) + ";" + СтильТекста(Область.style);
    МеткиТекста(Область.text, ДопустимыеИмена);
    Возврат HTMLТекстовогоБлока(Тег, АтрибутСсылки, Стиль, Вертикаль, Экранировать(Область.text));
КонецФункции

Функция HTMLТекстовогоБлока(Тег, Атрибуты, Стиль, Вертикаль, Содержимое)
    СтильСодержимого = "flex:none;";
    Если Вертикаль <> "top" Тогда
        СтильСодержимого = СтильСодержимого + "margin-top:auto;";
    КонецЕсли;
    Если Вертикаль = "middle" Тогда
        СтильСодержимого = СтильСодержимого + "margin-bottom:auto;";
    КонецЕсли;
    Возврат "<" + Тег + Атрибуты + " style=""" + Стиль + "display:flex;flex-direction:column;"">"
        + "<div style=""" + СтильСодержимого + """>" + Содержимое + "</div></" + Тег + ">";
КонецФункции

Функция HTMLИзображения(Область, Стиль, Выравнивание)
    Источник = АдресHTML(Область.src, Истина);
    Если ПустаяСтрока(Источник) Тогда
        ВызватьИсключение "Укажите URL изображения или загрузите файл.";
    КонецЕсли;
    Ссылка = АдресHTML(Область.href, Ложь);
    Содержимое = "<img src=""" + Источник + """ alt="""" style=""" + Стиль
        + "object-fit:contain;object-position:" + Выравнивание + ";"">";
    Если ПустаяСтрока(Ссылка) Тогда
        Возврат Содержимое;
    КонецЕсли;
    Возврат "<a style=""display:block;width:100%;height:100%;"" href=""" + Ссылка + """>" + Содержимое + "</a>";
КонецФункции

Функция МеткиТекста(Текст, ДопустимыеИмена)
    Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) > 20000 Тогда
        ВызватьИсключение "В каждой области допускается до 20 000 символов текста.";
    КонецЕсли;
    Метки = Новый Массив;
    НачалоМетки = 0;
    Для Позиция = 1 По СтрДлина(Текст) Цикл
        Знак = Сред(Текст, Позиция, 1);
        Если Знак = "{" Тогда
            Если НачалоМетки <> 0 Тогда
                ВызватьИсключение "Вложенные фигурные скобки в параметре.";
            КонецЕсли;
            НачалоМетки = Позиция;
        ИначеЕсли Знак = "}" Тогда
            Если НачалоМетки = 0 Тогда
                ВызватьИсключение "Закрывающая фигурная скобка без открывающей.";
            КонецЕсли;
            Имя = Сред(Текст, НачалоМетки + 1, Позиция - НачалоМетки - 1);
            Если ДопустимыеИмена.Получить(Имя) = Неопределено Тогда
                ВызватьИсключение "Параметр недоступен в выбранном разделе: {" + Имя + "}";
            КонецЕсли;
            Метки.Добавить(Новый Структура("Начало,Конец", НачалоМетки, Позиция));
            НачалоМетки = 0;
        КонецЕсли;
    КонецЦикла;
    Если НачалоМетки <> 0 Тогда
        ВызватьИсключение "Открывающая фигурная скобка без закрывающей.";
    КонецЕсли;
    Возврат Метки;
КонецФункции

Функция HTMLТекста(Фрагменты, ДопустимыеИмена)
    Если ТипЗнч(Фрагменты) <> Тип("Массив") Или Фрагменты.Количество() > 2000 Тогда
        ВызватьИсключение "Слишком много фрагментов форматирования в области текста.";
    КонецЕсли;
    Тексты = Новый Массив;
    Для Каждого Фрагмент Из Фрагменты Цикл
        Тексты.Добавить(Фрагмент.text);
    КонецЦикла;
    Текст = СтрСоединить(Тексты);
    Метки = МеткиТекста(Текст, ДопустимыеИмена);
    Части = Новый Массив;
    Позиция = 1;
    КонецФрагмента = 0;
    НомерМетки = 0;
    Для Каждого Фрагмент Из Фрагменты Цикл
        КонецФрагмента = КонецФрагмента + СтрДлина(Фрагмент.text);
        Если Позиция > КонецФрагмента Тогда
            Продолжить;
        КонецЕсли;
        Части.Добавить("<span style=""" + СтильТекста(Фрагмент.style) + """>");
        Пока НомерМетки < Метки.Количество() И Метки[НомерМетки].Начало <= КонецФрагмента Цикл
            // Метка целиком наследует стиль первого символа.
            КонецМетки = Метки[НомерМетки].Конец;
            Части.Добавить(Экранировать(Сред(Текст, Позиция, КонецМетки - Позиция + 1)));
            Позиция = КонецМетки + 1;
            НомерМетки = НомерМетки + 1;
        КонецЦикла;
        Если Позиция <= КонецФрагмента Тогда
            Части.Добавить(Экранировать(Сред(Текст, Позиция, КонецФрагмента - Позиция + 1)));
            Позиция = КонецФрагмента + 1;
        КонецЕсли;
        Части.Добавить("</span>");
    КонецЦикла;
    Возврат СтрСоединить(Части);
КонецФункции

Функция СтильТекста(Стиль)
    Шрифт = ИзСписка(Стиль.font, "Arial,Calibri,Georgia,Tahoma,Times New Roman,Verdana");
    Возврат "font-family:" + Шрифт + ";font-size:" + Пиксели(Стиль.size, 8, 100) + ";color:" + ЦветHTML(Стиль.color)
        + ";font-weight:" + ?(Стиль.bold = Истина, "bold", "normal")
        + ";font-style:" + ?(Стиль.italic = Истина, "italic", "normal")
        + ";text-decoration:" + ?(Стиль.underline = Истина, "underline", "none") + ";";
КонецФункции

Функция ИзСписка(Значение, Варианты)
    Если СтрРазделить(Варианты, ",").Найти(Значение) = Неопределено Тогда
        ВызватьИсключение "Недопустимая настройка области.";
    КонецЕсли;
    Возврат Значение;
КонецФункции

Функция Пиксели(Значение, Минимум, Максимум)
    Если ТипЗнч(Значение) <> Тип("Число") Или Значение < Минимум Или Значение > Максимум Или Цел(Значение) <> Значение Тогда
        ВызватьИсключение "Размер области или шрифта вне допустимого диапазона.";
    КонецЕсли;
    Возврат Формат(Значение, "ЧГ=0;ЧН=0") + "px";
КонецФункции

Функция ЦветHTML(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 7 Или Лев(Значение, 1) <> "#" Тогда
        ВызватьИсключение "Недопустимый цвет.";
    КонецЕсли;
    Для Позиция = 2 По 7 Цикл
        Если СтрНайти("0123456789abcdef", НРег(Сред(Значение, Позиция, 1))) = 0 Тогда
            ВызватьИсключение "Недопустимый цвет.";
        КонецЕсли;
    КонецЦикла;
    Возврат Значение;
КонецФункции

Функция АдресHTML(Знач Значение, ЭтоИзображение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "Недопустимый адрес.";
    КонецЕсли;
    Значение = СокрЛП(Значение);
    Если ПустаяСтрока(Значение) Тогда
        Возврат "";
    КонецЕсли;
    Если ЭтоИзображение И Лев(Значение, 5) = "data:" Тогда
        Части = СтрРазделить(Значение, ",");
        Если Части.Количество() <> 2 Или СтрДлина(Части[1]) > 2800000 Или ПустаяСтрока(Части[1]) Тогда
            ВызватьИсключение "Недопустимый размер файла изображения.";
        КонецЕсли;
        ИзСписка(Части[0], "data:image/png;base64,data:image/jpeg;base64,data:image/gif;base64,data:image/webp;base64,data:image/x-icon;base64");
        Base64Значение(Части[1]);
        Возврат Экранировать(Значение);
    КонецЕсли;
    Если СтрДлина(Значение) > 2048 Или СтрНайти(Значение, "{") > 0 Или СтрНайти(Значение, "}") > 0
        Или СтрНайти(Значение, Символы.ВК) > 0 Или СтрНайти(Значение, Символы.ПС) > 0
        Или (НРег(Лев(Значение, 8)) <> "https://" И НРег(Лев(Значение, 7)) <> "http://") Тогда
        ВызватьИсключение "Укажите адрес с http:// или https://.";
    КонецЕсли;
    Возврат Экранировать(Значение);
КонецФункции

Функция Экранировать(Знач Текст)
    Возврат СообщенияИнтерфейсаПКМП.ЭкранироватьHTML(Текст);
КонецФункции
