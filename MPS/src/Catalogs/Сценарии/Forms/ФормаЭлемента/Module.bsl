
&НаКлиенте
Перем АктивныйЭлементГС;
&НаСервере
Перем ГСиТочки;

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ИзменениеЗаголовковКнопокУправленияГС(Элементы.КП_ГрафическаяСхема);
	
	ВидимостьПериодаВыполнения();
	
	ПолучитьСтатус();
	
	ИнициализироватьСоответствиеГСиТочки();
КонецПроцедуры

&НаСервере 
Процедура ИнициализироватьСоответствиеГСиТочки()
	
	ГСиТочки = Новый ТаблицаЗначений;
	ГСиТочки.Колонки.Добавить("ИмяТочки",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150)));
	ГСиТочки.Колонки.Добавить("ЭлементТочки",Новый ОписаниеТипов);
	ГСиТочки.Колонки.Добавить("Точка",	Метаданные.ОпределяемыеТипы.ТочкиСценария.Тип);
	ГСиТочки.Колонки.Добавить("Удален",Новый ОписаниеТипов("Булево"));

	Если Не Объект.Ссылка.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СценарииТочки.ИмяТочки КАК ИмяТочки,
		|	СценарииТочки.Точка КАК Точка,
		|	ЛОЖЬ КАК Удален
		|ИЗ
		|	Справочник.Сценарии.Точки КАК СценарииТочки
		|ГДЕ
		|	СценарииТочки.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

		РезультатЗапроса = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НоваяТочка = ГСиТочки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяТочка, ВыборкаДетальныеЗаписи);
			НоваяТочка.ЭлементТочки = ГС.ЭлементыГрафическойСхемы.Найти(НоваяТочка.ИмяТочки);
		КонецЦикла;
	КонецЕсли;
	
	Если не ГС.ЭлементыГрафическойСхемы.Количество() = 0 Тогда
		Для каждого ЭлементГС из ГС.ЭлементыГрафическойСхемы Цикл
			мсСоответствияПоИмени = ГСиТочки.НайтиСтроки(Новый Структура("ИмяТочки", ЭлементГС.Имя));
			Если мсСоответствияПоИмени.Количество() = 0 Тогда
				НоваяТочка = ГСиТочки.Добавить();
				НоваяТочка.ИмяТочки = ЭлементГС.Имя;
				НоваяТочка.ЭлементТочки = ЭлементГС;
			КонецЕсли;	 
		КонецЦИкла;	
	КонецЕсли;	
	
	АдресГСиТочки = ПоместитьВоВременноеХранилище(ГСиТочки, УникальныйИдентификатор);
	
КонецПроцедуры	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.СхемаПроцесса = Новый ХранилищеЗначения(ГС);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ГС = ТекущийОбъект.СхемаПроцесса.Получить();
	
	Если ГС <> Неопределено Тогда
		Элементы.ГС.Доступность = Истина;
	Иначе
		Элементы.ГС.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

